<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_biometric_device_tree" model="ir.ui.view">
        <field name="name">attendance.biometric.device.list</field>
        <field name="model">attendance.biometric.device</field>
        <field name="arch" type="xml">
            <list string="Biometric devices">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="work_location_id"/>
                <field name="active"/>
                <field name="last_seen_ip" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_biometric_device_form" model="ir.ui.view">
        <field name="name">attendance.biometric.device.form</field>
        <field name="model">attendance.biometric.device</field>
        <field name="arch" type="xml">
            <form string="Biometric device">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="work_location_id"/>
                        <field name="device_key" widget="password"/>
                        <field name="last_seen_ip" readonly="1"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_biometric_device" model="ir.actions.act_window">
        <field name="name">Biometric devices</field>
        <field name="res_model">attendance.biometric.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_attendance_biometric_event_tree" model="ir.ui.view">
        <field name="name">attendance.biometric.event.list</field>
        <field name="model">attendance.biometric.event</field>
        <field name="arch" type="xml">
            <list string="Biometric events" create="false">
                <field name="name"/>
                <field name="create_date" string="Received at"/>
                <field name="device_id"/>
                <field name="staff_key"/>
                <field name="direction"/>
                <field name="event_time"/>
                <field name="state"/>
                <field name="attendance_id"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_biometric_event_form" model="ir.ui.view">
        <field name="name">attendance.biometric.event.form</field>
        <field name="model">attendance.biometric.event</field>
        <field name="arch" type="xml">
            <form string="Biometric event" create="false">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        <field name="device_id" readonly="1"/>
                        <field name="staff_key" readonly="1"/>
                        <field name="direction" readonly="1"/>
                        <field name="event_time" readonly="1"/>
                        <field name="state" readonly="1"/>
                        <field name="process_attempts" readonly="1"/>
                        <field name="next_retry_at" readonly="1"/>
                        <field name="attendance_id" readonly="1"/>
                        <field name="last_error" readonly="1"/>
                        <field name="payload_json" readonly="1" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_biometric_event" model="ir.actions.act_window">
        <field name="name">Biometric events</field>
        <field name="res_model">attendance.biometric.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
