<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_attendance_core" model="ir.ui.view">
        <field name="name">res.company.form.attendance.core</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Berkeley Workforce" name="attendance_core_page" groups="hr.group_hr_manager,base.group_system">
                    <group string="Maps">
                        <field name="attendance_google_maps_api_key" password="True"/>
                    </group>
                    <group string="SMS (Twilio — storage only)">
                        <field name="attendance_twilio_account_sid"/>
                        <field name="attendance_twilio_auth_token" password="True"/>
                        <field name="attendance_twilio_from_number"/>
                    </group>
                    <group string="Operations">
                        <field name="attendance_geofence_alerts"/>
                        <field name="attendance_location_log_retention_days"/>
                        <field name="attendance_biometric_event_retention_days"/>
                    </group>
                    <group string="Odoo → Odoo replication">
                        <field name="attendance_odoo_sync_enabled"/>
                    </group>
                    <group string="Scheduled export S3 (optional)" groups="base.group_system">
                        <field name="attendance_export_s3_bucket"/>
                        <field name="attendance_export_s3_region"/>
                        <field name="attendance_export_s3_access_key"/>
                        <field name="attendance_export_s3_secret_key" password="True"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
