<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_view_form_attendance_core" model="ir.ui.view">
        <field name="name">hr.attendance.form.attendance.core</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="check_work_location_id" options="{'no_create': True}"/>
                <field name="attendance_job_code_id" options="{'no_create': True}"
                       groups="hr.group_hr_user,hr_attendance.group_hr_attendance_officer"/>
                <field name="break_minutes"
                       groups="hr.group_hr_user,hr_attendance.group_hr_attendance_officer"/>
                <field name="work_context_note"/>
                <field name="review_status" groups="hr.group_hr_user"/>
                <field name="review_reason" groups="hr.group_hr_user" invisible="review_status in ('none', 'approved')"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_attendance_core_approve" type="object" string="Approve review" class="btn-primary"
                        groups="hr_attendance.group_hr_attendance_manager"
                        invisible="review_status != 'pending'"/>
                <button name="action_attendance_core_reject" type="object" string="Reject review"
                        groups="hr_attendance.group_hr_attendance_manager"
                        invisible="review_status != 'pending'"/>
            </xpath>
        </field>
    </record>
</odoo>
