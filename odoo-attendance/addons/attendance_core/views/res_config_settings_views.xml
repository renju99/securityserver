<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_attendance_core" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.attendance.core</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="Berkeley Workforce"
                    string="Berkeley Workforce"
                    name="attendance_core_integration_settings"
                    groups="hr.group_hr_manager,base.group_system"
                >
                    <block title="Legacy standalone app (JWT / organisations)" name="bw_legacy_migration_block">
                        <setting string="Migration notes" help="Replace legacy org switcher with Odoo companies and users.">
                            <field name="bw_legacy_migration_html" colspan="2" nolabel="1" readonly="1"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
