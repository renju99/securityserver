<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_attendance_core" model="ir.ui.view">
        <field name="name">hr.employee.form.attendance.core</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mobile_phone']" position="after">
                <field name="attendance_face_image" widget="image" groups="hr.group_hr_user"/>
                <field name="attendance_face_match_threshold" groups="hr.group_hr_user"/>
                <field name="attendance_face_descriptor_json" groups="hr.group_hr_user" readonly="1"/>
                <button name="action_bw_face_compute_descriptor" type="object" string="Compute face descriptor" class="btn-secondary" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>
</odoo>
