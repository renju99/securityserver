<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_geofence_alert_tree" model="ir.ui.view">
        <field name="name">attendance.geofence.alert.list</field>
        <field name="model">attendance.geofence.alert</field>
        <field name="arch" type="xml">
            <list string="Geofence alerts">
                <field name="name"/>
                <field name="create_date"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <field name="distance_meters"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_geofence_alert_form" model="ir.ui.view">
        <field name="name">attendance.geofence.alert.form</field>
        <field name="model">attendance.geofence.alert</field>
        <field name="arch" type="xml">
            <form string="Geofence alert">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="work_location_id"/>
                        <field name="attendance_id"/>
                        <field name="latitude"/>
                        <field name="longitude"/>
                        <field name="distance_meters"/>
                        <field name="message"/>
                        <field name="state"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_geofence_alert" model="ir.actions.act_window">
        <field name="name">Geofence alerts</field>
        <field name="res_model">attendance.geofence.alert</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
