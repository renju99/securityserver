<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Job codes -->
    <record id="view_attendance_job_code_tree" model="ir.ui.view">
        <field name="name">attendance.job.code.list</field>
        <field name="model">attendance.job.code</field>
        <field name="arch" type="xml">
            <list string="Job codes">
                <field name="code"/>
                <field name="name"/>
                <field name="work_location_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_job_code_form" model="ir.ui.view">
        <field name="name">attendance.job.code.form</field>
        <field name="model">attendance.job.code</field>
        <field name="arch" type="xml">
            <form string="Job code">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="work_location_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_job_code" model="ir.actions.act_window">
        <field name="name">Job codes</field>
        <field name="res_model">attendance.job.code</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Policies -->
    <record id="view_attendance_policy_rule_tree" model="ir.ui.view">
        <field name="name">attendance.policy.rule.list</field>
        <field name="model">attendance.policy.rule</field>
        <field name="arch" type="xml">
            <list string="Policies">
                <field name="name"/>
                <field name="work_location_id"/>
                <field name="resource_calendar_id"/>
                <field name="require_approval_manual"/>
                <field name="require_approval_offline"/>
                <field name="require_approval_kiosk"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_policy_rule_form" model="ir.ui.view">
        <field name="name">attendance.policy.rule.form</field>
        <field name="model">attendance.policy.rule</field>
        <field name="arch" type="xml">
            <form string="Attendance policy">
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="work_location_id"/>
                        <field name="resource_calendar_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Approval">
                        <field name="require_approval_manual"/>
                        <field name="require_approval_offline"/>
                        <field name="require_approval_kiosk"/>
                    </group>
                    <group string="Breaks / overtime (reference)">
                        <field name="overtime_after_minutes"/>
                        <field name="paid_break_minutes"/>
                        <field name="unpaid_break_minutes"/>
                        <field name="max_shift_minutes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_policy_rule" model="ir.actions.act_window">
        <field name="name">Attendance policies</field>
        <field name="res_model">attendance.policy.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Public holidays -->
    <record id="view_attendance_public_holiday_tree" model="ir.ui.view">
        <field name="name">attendance.public.holiday.list</field>
        <field name="model">attendance.public.holiday</field>
        <field name="arch" type="xml">
            <list string="Public holidays">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="work_location_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_public_holiday_form" model="ir.ui.view">
        <field name="name">attendance.public.holiday.form</field>
        <field name="model">attendance.public.holiday</field>
        <field name="arch" type="xml">
            <form string="Public holiday">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="work_location_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_public_holiday" model="ir.actions.act_window">
        <field name="name">Public holidays</field>
        <field name="res_model">attendance.public.holiday</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Report presets -->
    <record id="view_attendance_report_preset_tree" model="ir.ui.view">
        <field name="name">attendance.report.preset.list</field>
        <field name="model">attendance.report.preset</field>
        <field name="arch" type="xml">
            <list string="Report presets">
                <field name="name"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_report_preset_form" model="ir.ui.view">
        <field name="name">attendance.report.preset.form</field>
        <field name="model">attendance.report.preset</field>
        <field name="arch" type="xml">
            <form string="Report preset">
                <header>
                    <button name="action_open_attendances" type="object" string="Open attendances" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="user_id"/>
                        <field name="domain_char" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_report_preset" model="ir.actions.act_window">
        <field name="name">Report presets</field>
        <field name="res_model">attendance.report.preset</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Scheduled exports -->
    <record id="view_attendance_scheduled_export_tree" model="ir.ui.view">
        <field name="name">attendance.scheduled.export.list</field>
        <field name="model">attendance.scheduled.export</field>
        <field name="arch" type="xml">
            <list string="Scheduled exports">
                <field name="name"/>
                <field name="preset_id"/>
                <field name="interval_number"/>
                <field name="interval_type"/>
                <field name="next_run"/>
                <field name="last_run"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_scheduled_export_form" model="ir.ui.view">
        <field name="name">attendance.scheduled.export.form</field>
        <field name="model">attendance.scheduled.export</field>
        <field name="arch" type="xml">
            <form string="Scheduled export">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="preset_id"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="interval_number"/>
                        <field name="interval_type"/>
                        <field name="next_run"/>
                        <field name="last_run" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_scheduled_export" model="ir.actions.act_window">
        <field name="name">Scheduled CSV exports</field>
        <field name="res_model">attendance.scheduled.export</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Roster -->
    <record id="view_attendance_roster_template_tree" model="ir.ui.view">
        <field name="name">attendance.roster.template.list</field>
        <field name="model">attendance.roster.template</field>
        <field name="arch" type="xml">
            <list string="Roster templates">
                <field name="name"/>
                <field name="work_location_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_roster_template_form" model="ir.ui.view">
        <field name="name">attendance.roster.template.form</field>
        <field name="model">attendance.roster.template</field>
        <field name="arch" type="xml">
            <form string="Roster template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="work_location_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="weekday"/>
                            <field name="time_from" widget="float_time"/>
                            <field name="time_to" widget="float_time"/>
                            <field name="resource_calendar_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_roster_template" model="ir.actions.act_window">
        <field name="name">Roster templates</field>
        <field name="res_model">attendance.roster.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_attendance_roster_assignment_tree" model="ir.ui.view">
        <field name="name">attendance.roster.assignment.list</field>
        <field name="model">attendance.roster.assignment</field>
        <field name="arch" type="xml">
            <list string="Roster assignments">
                <field name="employee_id"/>
                <field name="template_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_roster_assignment_calendar" model="ir.ui.view">
        <field name="name">attendance.roster.assignment.calendar</field>
        <field name="model">attendance.roster.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Roster" date_start="date_start" date_stop="date_stop" color="employee_id" mode="month">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="template_id"/>
            </calendar>
        </field>
    </record>
    <record id="view_attendance_roster_assignment_form" model="ir.ui.view">
        <field name="name">attendance.roster.assignment.form</field>
        <field name="model">attendance.roster.assignment</field>
        <field name="arch" type="xml">
            <form string="Roster assignment">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="template_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_roster_assignment" model="ir.actions.act_window">
        <field name="name">Roster assignments</field>
        <field name="res_model">attendance.roster.assignment</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <!-- Location logs -->
    <record id="view_attendance_location_log_tree" model="ir.ui.view">
        <field name="name">attendance.location.log.list</field>
        <field name="model">attendance.location.log</field>
        <field name="arch" type="xml">
            <list string="Location logs">
                <field name="event_time"/>
                <field name="employee_id"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="speed" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_location_log_form" model="ir.ui.view">
        <field name="name">attendance.location.log.form</field>
        <field name="model">attendance.location.log</field>
        <field name="arch" type="xml">
            <form string="Location log">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="event_time"/>
                        <field name="latitude"/>
                        <field name="longitude"/>
                        <field name="speed"/>
                        <field name="raw_json" widget="json"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_attendance_location_log" model="ir.actions.act_window">
        <field name="name">Location logs</field>
        <field name="res_model">attendance.location.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_attendance_location_map_client" model="ir.actions.client">
        <field name="name">Location map</field>
        <field name="tag">attendance_location_map</field>
        <field name="target">current</field>
        <field name="binding_model_id" ref="attendance_core.model_attendance_location_log"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_attendance_live_location_map" model="ir.actions.client">
        <field name="name">Live location map</field>
        <field name="tag">attendance_live_location_map</field>
        <field name="target">current</field>
    </record>

    <record id="action_attendance_location_history_map" model="ir.actions.client">
        <field name="name">Past location track</field>
        <field name="tag">attendance_location_history_map</field>
        <field name="target">current</field>
    </record>

    <!-- Bulk checkout wizard -->
    <record id="view_attendance_bulk_checkout_wizard_form" model="ir.ui.view">
        <field name="name">attendance.bulk.checkout.wizard.form</field>
        <field name="model">attendance.bulk.checkout.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk check-out">
                <group>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="checkout_time"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_attendance_bulk_checkout_wizard" model="ir.actions.act_window">
        <field name="name">Bulk check-out</field>
        <field name="res_model">attendance.bulk.checkout.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_bw_portal_punch_url" model="ir.actions.act_url">
        <field name="name">My punch (portal)</field>
        <field name="url">/my/berkeley_workforce</field>
        <field name="target">new</field>
    </record>
</odoo>
