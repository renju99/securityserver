<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_metrics_snapshot_tree" model="ir.ui.view">
        <field name="name">attendance.metrics.snapshot.list</field>
        <field name="model">attendance.metrics.snapshot</field>
        <field name="arch" type="xml">
            <list string="HR metrics snapshots">
                <field name="snapshot_time"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="open_attendance_count"/>
                <field name="pending_review_count"/>
                <field name="biometric_pending_count"/>
                <field name="geofence_open_alert_count"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_metrics_snapshot_graph" model="ir.ui.view">
        <field name="name">attendance.metrics.snapshot.graph</field>
        <field name="model">attendance.metrics.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Metrics" sample="1">
                <field name="company_id"/>
                <field name="open_attendance_count" type="measure"/>
                <field name="pending_review_count" type="measure"/>
                <field name="biometric_pending_count" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_attendance_metrics_snapshot" model="ir.actions.act_window">
        <field name="name">HR metrics</field>
        <field name="res_model">attendance.metrics.snapshot</field>
        <field name="view_mode">graph,list</field>
    </record>

    <record id="view_attendance_daily_mobility_tree" model="ir.ui.view">
        <field name="name">attendance.daily.mobility.list</field>
        <field name="model">attendance.daily.mobility</field>
        <field name="arch" type="xml">
            <list string="Daily mobility">
                <field name="day"/>
                <field name="employee_id"/>
                <field name="route_distance_km"/>
                <field name="idle_gap_minutes"/>
                <field name="point_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_daily_mobility_pivot" model="ir.ui.view">
        <field name="name">attendance.daily.mobility.pivot</field>
        <field name="model">attendance.daily.mobility</field>
        <field name="arch" type="xml">
            <pivot string="Mobility" sample="1">
                <field name="day" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="route_distance_km" type="measure"/>
                <field name="idle_gap_minutes" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_attendance_daily_mobility" model="ir.actions.act_window">
        <field name="name">Route &amp; idle analytics</field>
        <field name="res_model">attendance.daily.mobility</field>
        <field name="view_mode">pivot,list</field>
    </record>
</odoo>
