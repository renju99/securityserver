<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_bw_metrics" model="ir.cron">
        <field name="name">Berkeley Workforce: collect HR metrics</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="model_id" ref="attendance_core.model_attendance_metrics_snapshot"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
env['attendance.metrics.snapshot'].sudo().cron_collect_metrics()
        ]]></field>
    </record>
    <record id="ir_cron_bw_mobility" model="ir.cron">
        <field name="name">Berkeley Workforce: rebuild daily mobility</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="model_id" ref="attendance_core.model_attendance_daily_mobility"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
env['attendance.daily.mobility'].sudo().cron_rebuild_mobility(days_back=2)
        ]]></field>
    </record>
    <record id="ir_cron_bw_cleanup" model="ir.cron">
        <field name="name">Berkeley Workforce: retention cleanup</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="model_id" ref="attendance_core.model_attendance_metrics_snapshot"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
env['attendance.metrics.snapshot'].sudo().cron_cleanup_retention()
        ]]></field>
    </record>
</odoo>
