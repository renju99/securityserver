<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_attendance_biometric_process" model="ir.cron">
            <field name="name">Berkeley Workforce: process biometric events</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="model_id" ref="model_attendance_biometric_event"/>
            <field name="state">code</field>
            <field name="code">env['attendance.biometric.event'].sudo().cron_process_pending_events()</field>
        </record>
    </data>
</odoo>
