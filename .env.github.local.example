# Local GitHub credentials (this example file is safe to commit; copy and fill secrets locally).
#
# 1) Copy:  cp .env.github.local.example .env.github.local
# 2) Put your PAT in .env.github.local (that file is gitignored).
# 3) Before git push over HTTPS, load it in your shell only:
#      set -a && source .env.github.local && set +a
#
# Use a fine-grained token with minimum scopes (e.g. Contents: Read/Write for this repo only).
# Do not paste tokens into chat, CI logs, or remote URLs that get saved in shell history.

GITHUB_TOKEN=
