<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bid_board" model="ir.module.category">
        <field name="name">Bid Board</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_bid_board_user" model="res.groups">
        <field name="name">Bid Board User</field>
        <field name="category_id" ref="sales_bid_board.module_category_bid_board"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bid_board_reviewer" model="res.groups">
        <field name="name">Bid Board Reviewer</field>
        <field name="category_id" ref="sales_bid_board.module_category_bid_board"/>
        <field name="implied_ids" eval="[(4, ref('sales_bid_board.group_bid_board_user'))]"/>
    </record>

    <record id="group_bid_board_manager" model="res.groups">
        <field name="name">Bid Board Manager</field>
        <field name="category_id" ref="sales_bid_board.module_category_bid_board"/>
        <field name="implied_ids" eval="[(4, ref('sales_bid_board.group_bid_board_reviewer'))]"/>
    </record>
</odoo>
