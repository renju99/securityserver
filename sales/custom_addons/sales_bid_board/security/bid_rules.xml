    <!-- Record visibility: rules for groups a user has are OR-combined. -->
    <!-- Salesperson: own enquiries (creator or assigned sales rep). -->
    <record id="rule_bid_project_salesperson_scope" model="ir.rule">
        <field name="name">Bid Project Salesperson Scope</field>
        <field name="model_id" ref="model_bid_project"/>
        <field name="domain_force">
            ['|',('create_uid','=',user.id),('sales_rep','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('sales_bid_board.group_bid_board_salesperson'))]"/>
    </record>

    <!-- Team leader: enquiries tied to their CRM sales team (rep’s team or source lead’s team). -->
    <record id="rule_bid_project_team_leader_scope" model="ir.rule">
        <field name="name">Bid Project Team Leader Scope</field>
        <field name="model_id" ref="model_bid_project"/>
        <field name="domain_force">
            ['|',('sales_rep.crm_team_member_ids.crm_team_id.user_id','=',user.id),('crm_lead_id.team_id.user_id','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('sales_bid_board.group_bid_board_team_leader'))]"/>
    </record>

    <record id="rule_bid_project_sales_manager_all" model="ir.rule">
        <field name="name">Bid Project Sales Manager All</field>
        <field name="model_id" ref="model_bid_project"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('sales_bid_board.group_bid_board_sales_manager'))]"/>
    </record>

