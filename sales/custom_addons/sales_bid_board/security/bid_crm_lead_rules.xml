<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Bid Board–scoped CRM visibility. Combined with standard Sales/CRM rules via OR:
        users who also have broad CRM groups may see more than these domains alone.
        Prefer assigning the minimal CRM role needed plus the matching Bid Board group.
    -->
    <record id="rule_crm_lead_bid_board_salesperson_scope" model="ir.rule">
        <field name="name">CRM Lead Bid Board Salesperson (own)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">
            ['|',('user_id','=',user.id),('create_uid','=',user.id)]
        </field>
        <field name="groups" eval="[(4, ref('sales_bid_board.group_bid_board_salesperson'))]"/>
    </record>

    <record id="rule_crm_lead_bid_board_sales_manager_all" model="ir.rule">
        <field name="name">CRM Lead Bid Board Sales Manager (all)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('sales_bid_board.group_bid_board_sales_manager'))]"/>
    </record>
</odoo>
