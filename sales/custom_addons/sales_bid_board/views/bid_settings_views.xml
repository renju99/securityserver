<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_bid_board_email_crons" model="ir.actions.act_window">
        <field name="name">Bid Board Email Cron Jobs</field>
        <field name="res_model">ir.cron</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="view_bid_board_settings_form" model="ir.ui.view">
        <field name="name">bid.board.settings.form</field>
        <field name="model">bid.board.settings</field>
        <field name="arch" type="xml">
            <form string="Bid Board Settings">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Email Configuration">
                        <field name="notification_email_from" placeholder='"Berkeley UAE" &lt;noreply@berkeleyuae.com&gt;'/>
                        <label for="test_notification_recipient" string="Test email"/>
                        <div class="o_row">
                            <field name="test_notification_recipient" class="oe_inline"/>
                            <button
                                name="action_send_test_notification_email"
                                type="object"
                                string="Send test email"
                                class="btn-primary ms-2"
                                groups="sales_bid_board.group_bid_board_cso"
                            />
                        </div>
                        <field name="cso_approver_emails"/>
                        <field name="notify_cso_on_all_submissions"/>
                        <field name="commercial_manager_email"/>
                        <field name="bid_manager_email"/>
                        <field name="notify_creator_on_approval"/>
                        <field name="pending_review_sla_days"/>
                    </group>
                    <group string="Decision Controls">
                        <field name="submit_review_min_score"/>
                    </group>
                    <group string="AI Market Analysis">
                        <field name="market_analysis_enabled"/>
                        <field name="market_analysis_provider" readonly="not market_analysis_enabled"/>
                        <field name="market_analysis_model" readonly="not market_analysis_enabled"/>
                        <field name="market_analysis_api_key"
                               password="True"
                               readonly="not market_analysis_enabled"/>
                        <field name="market_analysis_timeout_seconds"
                               readonly="not market_analysis_enabled"/>
                        <field name="market_analysis_prompt_version"
                               readonly="not market_analysis_enabled"/>
                        <field name="market_analysis_prompt_template"
                               placeholder="Optional system prompt override for advanced tuning."
                               readonly="not market_analysis_enabled"/>
                        <separator string="External Market Data"/>
                        <field name="external_market_enabled"/>
                        <field name="external_market_gemini_direct" readonly="not external_market_enabled"/>
                        <field name="external_market_provider"
                               readonly="not external_market_enabled or external_market_gemini_direct"/>
                        <field name="external_market_api_key"
                               password="True"
                               readonly="not external_market_enabled or external_market_gemini_direct or external_market_provider != 'google_search_api'"/>
                        <field name="external_market_news_limit" readonly="not external_market_enabled"/>
                        <field name="external_market_timeout_seconds" readonly="not external_market_enabled"/>
                    </group>
                    <group string="Automation">
                        <button
                            name="%(action_bid_board_email_crons)d"
                            type="action"
                            string="Open Bid Board Email Cron Jobs"
                            class="btn-secondary"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bid_board_settings_tree" model="ir.ui.view">
        <field name="name">bid.board.settings.tree</field>
        <field name="model">bid.board.settings</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="name"/>
                <field name="notification_email_from"/>
                <field name="cso_approver_emails"/>
                <field name="notify_cso_on_all_submissions"/>
                <field name="commercial_manager_email"/>
                <field name="bid_manager_email"/>
                <field name="notify_creator_on_approval"/>
                <field name="pending_review_sla_days"/>
            </list>
        </field>
    </record>

    <delete id="action_bid_board_settings" model="ir.actions.act_window"/>
    <record id="action_bid_board_settings" model="ir.actions.server">
        <field name="name">Settings</field>
        <field name="model_id" ref="model_bid_board_settings"/>
        <field name="state">code</field>
        <field name="code">
rec = env["bid.board.settings"].get_singleton()
action = rec.get_formview_action()
action["target"] = "current"
        </field>
    </record>
</odoo>
