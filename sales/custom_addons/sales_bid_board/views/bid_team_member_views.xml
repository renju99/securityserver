<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bid_team_member_tree" model="ir.ui.view">
        <field name="name">bid.team.member.tree</field>
        <field name="model">bid.team.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="department"/>
                <field name="role"/>
                <field name="user_id"/>
                <field name="email"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bid_team_member_form" model="ir.ui.view">
        <field name="name">bid.team.member.form</field>
        <field name="model">bid.team.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="department"/>
                        <field name="role"/>
                        <field name="user_id"/>
                        <field name="email"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bid_team_members" model="ir.actions.act_window">
        <field name="name">Team</field>
        <field name="res_model">bid.team.member</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bid_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">bid.team.member</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
