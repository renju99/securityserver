<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bid_proposal_tree" model="ir.ui.view">
        <field name="name">bid.proposal.list</field>
        <field name="model">bid.proposal</field>
        <field name="arch" type="xml">
            <list string="Proposals" sample="1">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_company"/>
                <field name="project_id"/>
                <field name="enquiry_code" optional="show"/>
                <field name="sales_user_id" widget="many2one_avatar_user"/>
                <field name="revision_number" optional="show"/>
                <field name="outcome_status" widget="badge"
                       decoration-success="outcome_status == 'won'"
                       decoration-danger="outcome_status == 'lost'"
                       decoration-info="outcome_status == 'open'"
                       decoration-primary="outcome_status == 'submitted'"
                       decoration-warning="outcome_status == 'revision'"/>
                <field name="deadline_date" optional="show"/>
                <field name="decision_date" optional="hide"/>
                <field name="scope_total" string="Scope %" optional="hide"/>
                <field name="contract_volume_total" string="Contract value (total)" sum="Total" optional="show"/>
                <field name="contract_start_date" optional="show"/>
                <field name="contract_expiry_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bid_proposal_form" model="ir.ui.view">
        <field name="name">bid.proposal.form</field>
        <field name="model">bid.proposal</field>
        <field name="arch" type="xml">
            <form string="Proposal">
                <header>
                    <button name="action_proposal_set_outcome_open"
                            type="object"
                            string="Set to Open"
                            class="btn-secondary"
                            invisible="outcome_status == 'open'"
                            groups="sales_bid_board.group_bid_board_salesperson"/>
                    <button name="action_proposal_set_outcome_submitted"
                            type="object"
                            string="Mark as submitted"
                            class="btn-primary"
                            invisible="outcome_status in ('submitted', 'won', 'lost')"
                            groups="sales_bid_board.group_bid_board_salesperson"/>
                    <button name="action_proposal_set_outcome_revision"
                            type="object"
                            string="In revision"
                            class="btn-secondary"
                            invisible="outcome_status != 'submitted'"
                            groups="sales_bid_board.group_bid_board_salesperson"/>
                    <button name="action_proposal_set_outcome_won"
                            type="object"
                            string="Mark as Won"
                            class="btn-primary"
                            invisible="outcome_status == 'won'"
                            groups="sales_bid_board.group_bid_board_salesperson"/>
                    <button name="action_proposal_set_outcome_lost"
                            type="object"
                            string="Mark as Lost"
                            class="btn-secondary"
                            invisible="outcome_status == 'lost'"
                            groups="sales_bid_board.group_bid_board_salesperson"/>
                    <field name="outcome_status" widget="statusbar"
                           options="{'clickable': True}"
                           statusbar_visible="open,submitted,revision,won,lost"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Proposal title"/></h1>
                    </div>
                    <group string="Enquiry link">
                        <group>
                            <field name="reference"/>
                            <field name="project_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="enquiry_code"/>
                            <field name="sales_user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" name="register">
                            <group string="Client">
                                <group>
                                    <field name="partner_company"/>
                                    <field name="parent_company"/>
                                    <field name="key_account_name"/>
                                </group>
                                <group>
                                    <field name="industry"/>
                                    <field name="city"/>
                                    <field name="customer_type"/>
                                    <field name="new_sales_fy"/>
                                </group>
                            </group>
                            <group string="Scope &amp; services">
                                <field name="project_description" colspan="2" nolabel="1" placeholder="Summary of scope, buildings, and what is being tendered."/>
                                <field name="services_offered" colspan="2" nolabel="1"
                                       placeholder="Filled from the linked Bid / No-Bid enquiry scope %; updates when the source enquiry changes."/>
                                <group string="Scope of work % (from enquiry)" colspan="2">
                                    <group>
                                        <field name="scope_cleaning" readonly="1"/>
                                        <field name="scope_maintenance" readonly="1"/>
                                        <field name="scope_security" readonly="1"/>
                                        <field name="scope_landscaping" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="scope_laundry" readonly="1"/>
                                        <field name="scope_support" readonly="1"/>
                                        <field name="scope_others" readonly="1"/>
                                        <field name="scope_total" readonly="1"/>
                                    </group>
                                </group>
                            </group>
                            <group string="Tender &amp; value">
                                <group>
                                    <field name="service_procurement_option"/>
                                    <field name="tender_type"/>
                                    <field name="contract_volume_total"/>
                                    <field name="contract_duration_months"/>
                                    <field name="contract_volume_annual"/>
                                </group>
                                <group>
                                    <field name="gm_percent"/>
                                    <field name="win_probability"/>
                                    <field name="outcome_status" readonly="1"/>
                                    <field name="revision_number"/>
                                </group>
                            </group>
                            <group string="Dates">
                                <group string="Pipeline &amp; offer">
                                    <field name="deadline_date"/>
                                    <field name="deadline_one_month_notified_at" readonly="1"/>
                                    <field name="initial_offer_date"/>
                                    <field name="revision_date"/>
                                    <field name="decision_date"/>
                                    <field name="expected_start_date"/>
                                </group>
                                <group string="Awarded contract">
                                    <field name="contract_start_date"/>
                                    <field name="contract_expiry_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Scope of work (from enquiry)" name="scope">
                            <group>
                                <group>
                                    <field name="scope_cleaning" readonly="1"/>
                                    <field name="scope_maintenance" readonly="1"/>
                                    <field name="scope_security" readonly="1"/>
                                    <field name="scope_landscaping" readonly="1"/>
                                </group>
                                <group>
                                    <field name="scope_laundry" readonly="1"/>
                                    <field name="scope_support" readonly="1"/>
                                    <field name="scope_others" readonly="1"/>
                                    <field name="scope_total" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Month (optional)" name="months">
                            <group>
                                <field name="offer_month"/>
                                <field name="decision_month"/>
                                <field name="starting_month"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bid_proposal_search" model="ir.ui.view">
        <field name="name">bid.proposal.search</field>
        <field name="model">bid.proposal</field>
        <field name="arch" type="xml">
            <search string="Proposals">
                <field name="name"/>
                <field name="reference"/>
                <field name="partner_company"/>
                <field name="project_id"/>
                <field name="sales_user_id"/>
                <field name="deadline_date"/>
                <filter name="open" string="Open" domain="[('outcome_status', '=', 'open')]"/>
                <filter name="submitted" string="Submitted" domain="[('outcome_status', '=', 'submitted')]"/>
                <filter name="revision" string="Revision" domain="[('outcome_status', '=', 'revision')]"/>
                <filter name="pipeline_open" string="In pipeline" domain="[('outcome_status', 'in', ('open', 'submitted', 'revision'))]"/>
                <filter name="won" string="Won" domain="[('outcome_status', '=', 'won')]"/>
                <filter name="lost" string="Lost" domain="[('outcome_status', '=', 'lost')]"/>
                <filter name="active_contract" string="Active contract" domain="[('is_active_contract', '=', True)]"/>
                <separator/>
                <filter name="my_proposals" string="My proposals" domain="[('sales_user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_outcome" string="Status" context="{'group_by': 'outcome_status'}"/>
                    <filter name="group_sales" string="Salesperson" context="{'group_by': 'sales_user_id'}"/>
                    <filter name="group_project" string="Enquiry" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bid_proposals" model="ir.actions.act_window">
        <field name="name">Proposals</field>
        <field name="res_model">bid.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bid_proposal_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a proposal from an enquiry after CSO approves a Bid decision.
            </p>
        </field>
    </record>

    <record id="action_bid_proposals_active_contracts" model="ir.actions.act_window">
        <field name="name">Active contracts</field>
        <field name="res_model">bid.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("is_active_contract", "=", True)]</field>
        <field name="search_view_id" ref="view_bid_proposal_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Won proposals appear here when <strong>Contract Start</strong> and <strong>Expiry Date</strong> are set and today falls in that range.
            </p>
        </field>
    </record>
</odoo>
