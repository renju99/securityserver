<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bid_notification_tree" model="ir.ui.view">
        <field name="name">bid.notification.tree</field>
        <field name="model">bid.notification</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="deadline_date"/>
                <field name="notify_team"/>
                <field name="state"/>
                <field name="last_reminder_at"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_bid_notification_form" model="ir.ui.view">
        <field name="name">bid.notification.form</field>
        <field name="model">bid.notification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="project_id"/>
                        <field name="deadline_date" readonly="1"/>
                        <field name="notify_team"/>
                        <field name="state"/>
                        <field name="last_reminder_at"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bid_notifications" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">bid.notification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
