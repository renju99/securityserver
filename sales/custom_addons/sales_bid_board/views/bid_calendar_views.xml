<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Calendar colors (bid_calendar_color, 0–11): Odoo default palette.
        1 red (overdue), 2 orange (≤7d), 3 yellow (≤30d), 4 green (later open work),
        5 neutral, 8 blue (intake / default), 10 won / approved path, 11 lost / declined / closed review.
        Submissions: 2 pending review, 3 change requested, 10 approved, 11 declined, 5 draft.
    -->
    <record id="view_bid_project_calendar" model="ir.ui.view">
        <field name="name">bid.project.calendar</field>
        <field name="model">bid.project</field>
        <field name="arch" type="xml">
            <calendar string="Bid / No Bid"
                      date_start="bid_calendar_start"
                      color="bid_calendar_color"
                      mode="month"
                      event_open_popup="1"
                      quick_create="0">
                <field name="name"/>
                <field name="code"/>
                <field name="client_name"/>
                <field name="review_status"/>
                <field name="decision_final"/>
                <field name="deadline_datetime"/>
            </calendar>
        </field>
    </record>

    <record id="view_bid_submission_calendar" model="ir.ui.view">
        <field name="name">bid.submission.calendar</field>
        <field name="model">bid.submission</field>
        <field name="arch" type="xml">
            <calendar string="Submitted for review"
                      date_start="bid_calendar_start"
                      color="bid_calendar_color"
                      mode="month"
                      event_open_popup="1"
                      quick_create="0">
                <field name="name"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="submitted_date"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="view_bid_proposal_calendar" model="ir.ui.view">
        <field name="name">bid.proposal.calendar</field>
        <field name="model">bid.proposal</field>
        <field name="arch" type="xml">
            <calendar string="Proposals"
                      date_start="proposal_deadline_calendar_start"
                      color="bid_calendar_color"
                      mode="month"
                      event_open_popup="1"
                      quick_create="0">
                <field name="name"/>
                <field name="deadline_date"/>
                <field name="reference"/>
                <field name="partner_company"/>
                <field name="sales_user_id" widget="many2one_avatar_user"/>
                <field name="outcome_status"/>
                <field name="revision_number"/>
                <field name="project_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_crm_lead_calendar_bid_board" model="ir.ui.view">
        <field name="name">crm.lead.calendar.bid.board</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <calendar string="Leads — expected close or received"
                      date_start="bid_calendar_start"
                      color="bid_calendar_color"
                      mode="month"
                      event_open_popup="1"
                      quick_create="0">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="user_id"/>
                <field name="date_deadline"/>
            </calendar>
        </field>
    </record>

    <record id="action_bid_projects" model="ir.actions.act_window">
        <field name="view_mode">list,calendar,form</field>
    </record>
    <record id="action_bid_no_bid" model="ir.actions.act_window">
        <field name="view_mode">list,calendar,form</field>
    </record>
    <record id="action_bid_board_leads" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,calendar,form,activity</field>
    </record>
    <!--
        Odoo orders views from ir.actions.act_window.view by sequence first, then appends any
        mode from view_mode that is missing. A single calendar line put Calendar first; define
        list/kanban/calendar/form explicitly so the switcher is List → Kanban → Calendar → …
    -->
    <record id="action_bid_board_leads_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="act_window_id" ref="action_bid_board_leads"/>
    </record>
    <record id="action_bid_board_leads_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="crm.view_crm_lead_kanban"/>
        <field name="act_window_id" ref="action_bid_board_leads"/>
    </record>
    <record id="action_bid_board_leads_calendar_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_crm_lead_calendar_bid_board"/>
        <field name="act_window_id" ref="action_bid_board_leads"/>
    </record>
    <record id="action_bid_board_leads_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="crm.crm_lead_view_form"/>
        <field name="act_window_id" ref="action_bid_board_leads"/>
    </record>
    <record id="action_bid_proposals" model="ir.actions.act_window">
        <field name="view_mode">list,calendar,form</field>
    </record>
    <!-- List → Calendar (deadline dates) → Form, same pattern as multi-view actions elsewhere. -->
    <record id="action_bid_proposals_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_bid_proposal_tree"/>
        <field name="act_window_id" ref="action_bid_proposals"/>
    </record>
    <record id="action_bid_proposals_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_bid_proposal_calendar"/>
        <field name="act_window_id" ref="action_bid_proposals"/>
    </record>
    <record id="action_bid_proposals_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_bid_proposal_form"/>
        <field name="act_window_id" ref="action_bid_proposals"/>
    </record>
    <record id="action_bid_submissions" model="ir.actions.act_window">
        <field name="view_mode">list,calendar,form</field>
    </record>
    <record id="action_bid_reviewer_queue" model="ir.actions.act_window">
        <field name="view_mode">list,calendar,form</field>
    </record>
</odoo>
