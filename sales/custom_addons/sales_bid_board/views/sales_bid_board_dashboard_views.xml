<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_sales_bid_board_dashboard_tree" model="ir.ui.view">
            <field name="name">sales_bid_board.dashboard.tree</field>
            <field name="model">sales_bid_board.dashboard</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_sales_bid_board_dashboard_form" model="ir.ui.view">
            <field name="name">sales_bid_board.dashboard.form</field>
            <field name="model">sales_bid_board.dashboard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sales_bid_board_dashboard_admin" model="ir.actions.act_window">
            <field name="name">Dashboard Config</field>
            <field name="res_model">sales_bid_board.dashboard</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
