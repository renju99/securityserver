<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bid_project_tree" model="ir.ui.view">
        <field name="name">bid.project.tree</field>
        <field name="model">bid.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="crm_lead_id" optional="hide"/>
                <field name="client_name"/>
                <field name="sales_rep"/>
                <field name="review_status"/>
                <field name="stage_id"/>
                <field name="deadline_date"/>
                <field name="project_lead_id"/>
                <field name="progress"/>
                <field name="score_overall"/>
                <field name="decision_final"/>
                <field name="state"/>
                <field name="contract_value" string="Contract value" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bid_project_form" model="ir.ui.view">
        <field name="name">bid.project.form</field>
        <field name="model">bid.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Non-stored computes must appear in the arch or OWL never loads them and header modifiers stay wrong. -->
                    <field name="can_non_cso_actions" invisible="1"/>
                    <field name="can_submit_for_review" invisible="1"/>
                    <field name="can_show_submit_review_button" invisible="1"/>
                    <field name="can_cso_review" invisible="1"/>
                    <button name="action_save_draft"
                            string="Save Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="not can_non_cso_actions"/>
                    <button name="action_submit_for_review"
                            string="Submit for Review"
                            type="object"
                            class="btn-primary"
                            invisible="not can_show_submit_review_button"/>
                    <button name="action_open_change_request_wizard"
                            string="Request Change"
                            type="object"
                            class="btn-secondary"
                            groups="sales_bid_board.group_bid_board_salesperson"
                            invisible="not can_cso_review"/>
                    <button name="action_decline_review"
                            string="Decline"
                            type="object"
                            class="btn-secondary"
                            groups="sales_bid_board.group_bid_board_salesperson"
                            invisible="not can_cso_review"/>
                    <button name="action_approve_review"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            groups="sales_bid_board.group_bid_board_salesperson"
                            invisible="not can_cso_review"/>
                    <button name="action_create_proposal"
                            string="Create proposal"
                            type="object"
                            class="btn-secondary"
                            groups="sales_bid_board.group_bid_board_salesperson"
                            invisible="not context.get('from_bid_no_bid') or review_status != 'approved' or decision_final != 'bid'"/>
                    <field name="review_status" widget="statusbar"
                           statusbar_visible="draft,pending_review,change_requested,approved,declined"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_proposals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                string="Proposals"/>
                    </div>
                    <notebook>
                        <page string="Project Info">
                            <group col="3">
                                <group>
                                    <field name="sales_rep"/>
                                    <field name="client_name"/>
                                    <field name="contract_duration"/>
                                    <field name="contract_type"/>
                                    <field name="performance_bond"/>
                                </group>
                                <group>
                                    <field name="code" readonly="1"/>
                                    <field name="emirate"/>
                                    <field name="contract_value"/>
                                    <field name="threshold"/>
                                    <field name="kpi"/>
                                </group>
                                <group>
                                    <field name="name"/>
                                    <field name="crm_lead_id" readonly="1"/>
                                    <field name="industry"/>
                                    <field name="deadline_date"/>
                                    <field name="tender_bond"/>
                                    <field name="state"/>
                                </group>
                            </group>
                            <group col="2">
                                <group>
                                    <field name="project_lead_id"/>
                                </group>
                                <group>
                                    <field name="team_member_ids" widget="many2many_tags"/>
                                    <field name="progress"/>
                                </group>
                            </group>
                            <group string="Scope of Work (%)" col="4">
                                <field name="scope_cleaning"/>
                                <field name="scope_maintenance"/>
                                <field name="scope_security"/>
                                <field name="scope_landscaping"/>
                                <field name="scope_laundry"/>
                                <field name="scope_support"/>
                                <field name="scope_others"/>
                                <field name="scope_total" readonly="1"/>
                            </group>
                            <group>
                                <field name="description" placeholder="Project notes and remarks..."/>
                            </group>
                        </page>
                        <page string="Scorecard">
                            <field name="criteria_line_ids">
                                <list editable="bottom">
                                    <field name="category"/>
                                    <field name="name"/>
                                    <field name="option_1_text"/>
                                    <field name="option_2_text"/>
                                    <field name="option_3_text"/>
                                    <field name="score"/>
                                    <field name="weight"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Decision Sheet">
                            <!-- Standard stacked fields (not col=5); narrow viewports stay readable. -->
                            <group string="Category scores">
                                <field name="score_strategy" string="Strategy" readonly="1"/>
                                <field name="score_customer" string="Customer" readonly="1"/>
                                <field name="score_commercial" string="Commercial" readonly="1"/>
                                <field name="score_finance" string="Finance" readonly="1"/>
                                <field name="score_operations" string="Operations" readonly="1"/>
                            </group>

                            <group string="Overall Recommendation">
                                <field name="score_overall" readonly="1"/>
                                <field name="recommendation_text" readonly="1"/>
                                <field name="recommendation_note" readonly="1"/>
                                <field name="decision_final" readonly="1"/>
                                <field name="review_status" readonly="1"/>
                            </group>
                        </page>
                        <page string="Change Requests">
                            <field name="change_request_ids">
                                <list editable="bottom">
                                    <field name="reviewer_id"/>
                                    <field name="priority"/>
                                    <field name="comments"/>
                                    <field name="resolved"/>
                                    <field name="resolved_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Submissions">
                            <field name="submission_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="owner_id"/>
                                    <field name="submitted_date"/>
                                    <field name="status"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Proposals" name="proposals">
                            <!-- No embedded One2many here: avoids web client "field undefined" when workers/registry lag. -->
                            <group>
                                <group>
                                    <button name="action_view_proposals"
                                            type="object"
                                            string="View proposals for this enquiry"
                                            class="btn-primary"
                                            colspan="2"/>
                                </group>
                                <group>
                                    <button name="action_create_proposal"
                                            type="object"
                                            string="Create proposal"
                                            class="btn-secondary"
                                            colspan="2"
                                            groups="sales_bid_board.group_bid_board_salesperson"
                                            invisible="not context.get('from_bid_no_bid') or review_status != 'approved' or decision_final != 'bid'"/>
                                </group>
                            </group>
                            <div class="alert alert-secondary mb-2" role="alert"
                                 invisible="context.get('from_bid_no_bid') or review_status != 'approved' or decision_final != 'bid'">
                                To use <strong>Create proposal</strong>, open this enquiry from the
                                <strong>Bid / No Bid</strong> menu (after CSO approval with a Bid decision).
                            </div>
                            <div class="alert alert-info mb-0" role="alert"
                                 invisible="review_status == 'approved' and decision_final == 'bid'">
                                Proposals are available after CSO approves a <strong>Bid</strong> decision.
                                Open the enquiry from <strong>Bid / No Bid</strong> to create one, or use
                                <strong>View proposals</strong> to open the list for this enquiry.
                            </div>
                        </page>
                        <page string="Notifications">
                            <field name="notification_ids">
                                <list editable="bottom">
                                    <field name="notify_team"/>
                                    <field name="deadline_date"/>
                                    <field name="state"/>
                                    <field name="last_reminder_at"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bid_project_search" model="ir.ui.view">
        <field name="name">bid.project.search</field>
        <field name="model">bid.project</field>
        <field name="arch" type="xml">
            <search string="Project Search">
                <field name="name"/>
                <field name="client_name"/>
                <field name="crm_lead_id"/>
                <field name="project_lead_id"/>
                <field name="emirate"/>
                <field name="industry"/>
                <field name="review_status"/>
                <filter name="filter_all" string="All" domain="[]"/>
                <filter name="filter_active" string="Active" domain="[('state','=','active')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state','=','completed')]"/>
                <filter name="filter_declined" string="Declined" domain="[('state','=','declined')]"/>
                <filter name="filter_priority" string="Priority" domain="[('state','=','priority')]"/>
                <separator/>
                <filter name="filter_pending_review" string="Pending Review" domain="[('review_status','=','pending_review')]"/>
                <filter name="filter_change_requested" string="Change Requested" domain="[('review_status','=','change_requested')]"/>
                <separator/>
                <filter name="group_stage" string="Stage" context="{'group_by':'stage_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                <filter name="group_lead" string="Project Lead" context="{'group_by':'project_lead_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_bid_project_wizard_form" model="ir.ui.view">
        <field name="name">bid.project.create.wizard.form</field>
        <field name="model">bid.project.create.wizard</field>
        <field name="arch" type="xml">
            <form string="New Enquiry">
                <group>
                    <field name="name"/>
                    <field name="client_name"/>
                    <field name="project_lead_id"/>
                    <field name="team_member_ids" widget="many2many_tags"/>
                    <field name="deadline_datetime"/>
                    <field name="state"/>
                    <field name="progress"/>
                </group>
                <footer>
                    <button name="action_create_project" string="Save Enquiry" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_bid_change_request_wizard_form" model="ir.ui.view">
        <field name="name">bid.change.request.wizard.form</field>
        <field name="model">bid.change.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Change">
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="priority"/>
                    <field name="comments" placeholder="Enter CSO comments for required changes..."/>
                </group>
                <footer>
                    <button name="action_submit_change_request" string="Submit Request" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bid_projects" model="ir.actions.act_window">
        <field name="name">Enquiries</field>
        <field name="res_model">bid.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bid_no_bid" model="ir.actions.act_window">
        <field name="name">Bid / No Bid</field>
        <field name="res_model">bid.project</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_all': 1, 'from_bid_no_bid': 1}</field>
        <field name="search_view_id" ref="view_bid_project_search"/>
    </record>

    <record id="action_bid_reviewer_queue" model="ir.actions.act_window">
        <field name="name">Review</field>
        <field name="res_model">bid.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bid_project_search"/>
        <field name="domain">[('review_status','in',('pending_review','change_requested'))]</field>
    </record>

    <record id="action_bid_reports" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">bid.project</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_bid_project_search"/>
    </record>

    <record id="action_bid_new_project_wizard" model="ir.actions.act_window">
        <field name="name">New Enquiry</field>
        <field name="res_model">bid.project.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_bid_board_leads" model="ir.actions.act_window">
        <field name="name">Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="domain">[('type', '=', 'lead')]</field>
        <field name="context">{'default_type': 'lead'}</field>
    </record>
</odoo>
