<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bid_project_tree" model="ir.ui.view">
        <field name="name">bid.project.tree</field>
        <field name="model">bid.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="crm_lead_id" optional="hide"/>
                <field name="sector" optional="hide"/>
                <field name="industry" optional="hide"/>
                <field name="emirate" optional="hide"/>
                <field name="contract_type" optional="hide"/>
                <field name="contract_duration" optional="hide"/>
                <field name="create_date" optional="hide"/>
                <field name="reviewed_on" optional="hide"/>
                <field name="client_name"/>
                <field name="sales_rep"/>
                <field name="review_status"/>
                <field name="stage_id"/>
                <field name="deadline_datetime"/>
                <field name="project_lead_id"/>
                <field name="progress"/>
                <field name="score_overall"/>
                <field name="decision_final"/>
                <field name="outcome_status" widget="badge"
                       decoration-success="outcome_status == 'won'"
                       decoration-danger="outcome_status == 'lost'"
                       decoration-info="outcome_status == 'open'"
                       decoration-muted="outcome_status == 'closed'"/>
                <field name="is_priority" optional="show"/>
                <field name="contract_value" string="Contract value" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bid_project_form" model="ir.ui.view">
        <field name="name">bid.project.form</field>
        <field name="model">bid.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Non-stored computes must appear in the arch or OWL never loads them and header modifiers stay wrong. -->
                    <field name="can_non_cso_actions" invisible="1"/>
                    <field name="can_submit_for_review" invisible="1"/>
                    <field name="can_show_submit_review_button" invisible="1"/>
                    <field name="can_cso_review" invisible="1"/>
                    <button name="action_save_draft"
                            string="Save Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="not can_non_cso_actions"/>
                    <button name="action_submit_for_review"
                            string="Submit for Review"
                            type="object"
                            class="btn-primary"
                            invisible="not can_show_submit_review_button"/>
                    <button name="action_open_change_request_wizard"
                            string="Request Change"
                            type="object"
                            class="btn-secondary"
                            groups="sales_bid_board.group_bid_board_cso,base.group_system"
                            invisible="not can_cso_review"/>
                    <button name="action_open_decline_review_wizard"
                            string="Decline"
                            type="object"
                            class="btn-secondary"
                            groups="sales_bid_board.group_bid_board_cso,base.group_system"
                            invisible="not can_cso_review"/>
                    <button name="action_approve_review"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            groups="sales_bid_board.group_bid_board_cso,base.group_system"
                            invisible="not can_cso_review"/>
                    <button name="action_create_proposal"
                            string="Create proposal"
                            type="object"
                            class="btn-secondary"
                            groups="sales_bid_board.group_bid_board_salesperson"
                            invisible="review_status != 'approved' or decision_final != 'bid'"/>
                    <field name="review_status" widget="statusbar"
                           statusbar_visible="draft,pending_review,change_requested,approved,declined"/>
                    <field name="outcome_status" widget="statusbar"
                           options="{'clickable': true}"
                           statusbar_visible="open,won,lost,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_proposals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                string="Proposals"/>
                    </div>
                    <notebook>
                        <page string="Project Info">
                            <!-- col="2" throughout keeps column edges aligned with RFP, scope, and team blocks. -->
                            <group string="Overview" col="2">
                                <group string="Project">
                                    <field name="name"/>
                                    <field name="code" readonly="1"/>
                                    <field name="client_name"/>
                                    <field name="client_website" placeholder="https://client.com or client.com"/>
                                    <field name="sector"/>
                                    <field name="crm_lead_id" readonly="1"/>
                                    <field name="sales_rep"/>
                                </group>
                                <group string="Commercial &amp; deadlines">
                                    <field name="emirate"/>
                                    <field name="industry"/>
                                    <field name="contract_duration"/>
                                    <field name="contract_type"/>
                                    <field name="threshold"/>
                                    <field name="contract_value"/>
                                    <field name="is_priority"/>
                                    <field name="deadline_datetime"/>
                                </group>
                            </group>
                            <group string="RFP &amp; site" col="2">
                                <group>
                                    <field name="rfp_received_date"/>
                                    <field name="site_visit_date"/>
                                </group>
                                <group>
                                    <field name="project_structure"/>
                                    <field name="age_of_facility"/>
                                </group>
                            </group>
                            <group string="Scope &amp; delivery" col="2">
                                <group string="Scope inputs">
                                    <field name="assets_list_provided"/>
                                    <field name="spare_consumables"/>
                                    <field name="subcontractors"/>
                                </group>
                                <group string="Commercial terms">
                                    <field name="input_output_based"/>
                                    <field name="tender_bond"/>
                                    <field name="performance_bond"/>
                                </group>
                            </group>
                            <group string="KPI &amp; penalties">
                                <field name="kpi_penalty_mechanism"
                                       string="KPI / penalty mechanism"
                                       placeholder="Maximum penalty caps, KPI definitions, and penalty mechanism as in the RFP."/>
                            </group>
                            <group string="Team" col="2">
                                <group>
                                    <field name="project_lead_id"/>
                                </group>
                                <group>
                                    <field name="team_member_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group string="Preparation progress">
                                <field name="progress" nolabel="1"
                                       placeholder="e.g. 30% — scope drafted; waiting on commercial sign-off"/>
                            </group>
                            <group string="Scope of work (%)" col="2">
                                <group>
                                    <field name="scope_cleaning"/>
                                    <field name="scope_security"/>
                                    <field name="scope_laundry"/>
                                    <field name="scope_others"/>
                                </group>
                                <group>
                                    <field name="scope_maintenance"/>
                                    <field name="scope_landscaping"/>
                                    <field name="scope_support"/>
                                    <field name="scope_total" readonly="1"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="description" nolabel="1" placeholder="Project notes and remarks..."/>
                            </group>
                        </page>
                        <page string="Scorecard">
                            <field name="criteria_line_ids">
                                <list editable="bottom">
                                    <field name="category"/>
                                    <field name="name"/>
                                    <field name="option_1_text"/>
                                    <field name="option_2_text"/>
                                    <field name="option_3_text"/>
                                    <field name="score"/>
                                    <field name="weight"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Decision Sheet">
                            <!-- Standard stacked fields (not col=5); narrow viewports stay readable. -->
                            <group string="Category scores">
                                <field name="score_strategy" string="Strategy" readonly="1"/>
                                <field name="score_customer" string="Customer" readonly="1"/>
                                <field name="score_commercial" string="Commercial" readonly="1"/>
                                <field name="score_finance" string="Finance" readonly="1"/>
                                <field name="score_operations" string="Operations" readonly="1"/>
                            </group>

                            <group string="Overall Recommendation">
                                <field name="score_overall" readonly="1"/>
                                <field name="recommendation_text" readonly="1"/>
                                <field name="recommendation_note" readonly="1"/>
                                <field name="decision_final" readonly="1"/>
                                <field name="review_status" readonly="1"/>
                                <field name="outcome_status" readonly="1"/>
                                <field name="is_priority" readonly="1"/>
                            </group>
                            <group string="CSO decline" invisible="review_status != 'declined'">
                                <field name="cso_decline_justification" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Market Analysis">
                            <field name="market_analysis_status" invisible="1"/>
                            <field name="market_external_status" invisible="1"/>
                            <group string="Generation" col="2">
                                <group>
                                    <field name="market_analysis_status" readonly="1"/>
                                    <field name="market_analysis_generated_on" readonly="1"/>
                                    <field name="market_analysis_generated_by" readonly="1"/>
                                    <field name="market_analysis_model" readonly="1"/>
                                    <field name="market_analysis_confidence" readonly="1"/>
                                    <field name="market_analysis_includes_external" readonly="1"/>
                                </group>
                                <group>
                                    <button name="action_generate_market_analysis"
                                            string="Generate Analysis"
                                            type="object"
                                            class="btn-primary"
                                            invisible="market_analysis_status == 'ready'"/>
                                    <button name="action_generate_market_analysis"
                                            string="Regenerate Analysis"
                                            type="object"
                                            class="btn-secondary"
                                            invisible="market_analysis_status != 'ready'"/>
                                    <button name="action_fetch_external_market_data"
                                            string="Fetch External Market Data"
                                            type="object"
                                            class="btn-secondary"
                                            invisible="market_external_status == 'ready'"/>
                                    <button name="action_fetch_external_market_data"
                                            string="Refresh External Data"
                                            type="object"
                                            class="btn-secondary"
                                            invisible="market_external_status != 'ready'"/>
                                    <button name="action_generate_combined_market_analysis"
                                            string="Generate Combined Analysis"
                                            type="object"
                                            class="btn-primary"
                                            invisible="market_external_status != 'ready'"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                This analysis is AI-assisted. It uses internal enquiry fields and, when enabled,
                                curated external market signals. It does not override the scorecard decision.
                            </div>
                            <group string="External Market Intelligence">
                                <field name="market_external_fetched_on" readonly="1"/>
                                <field name="market_external_provider" readonly="1"/>
                                <field name="market_external_summary" readonly="1" nolabel="1"/>
                                <field name="market_external_last_error"
                                       readonly="1"
                                       nolabel="1"
                                       invisible="market_external_status != 'failed'"/>
                            </group>
                            <group string="Summary">
                                <field name="market_analysis_summary" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Opportunity Signals">
                                <field name="market_analysis_opportunity_signals" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Risk Signals">
                                <field name="market_analysis_risk_signals" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Competition View">
                                <field name="market_analysis_competition_view" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Pricing Pressure View">
                                <field name="market_analysis_pricing_view" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Decision Support">
                                <field name="market_analysis_bid_support" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Missing Information">
                                <field name="market_analysis_missing_info" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Disclaimer">
                                <field name="market_analysis_disclaimer" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Last Error" invisible="market_analysis_status != 'failed'">
                                <field name="market_analysis_last_error" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Change Requests">
                            <field name="change_request_ids">
                                <list editable="bottom">
                                    <field name="reviewer_id"/>
                                    <field name="priority"/>
                                    <field name="comments"/>
                                    <field name="resolved"/>
                                    <field name="resolved_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Submissions">
                            <field name="submission_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="owner_id"/>
                                    <field name="submitted_date"/>
                                    <field name="status"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Proposals" name="proposals">
                            <!-- No embedded One2many here: avoids web client "field undefined" when workers/registry lag. -->
                            <group>
                                <group>
                                    <button name="action_view_proposals"
                                            type="object"
                                            string="View proposals for this enquiry"
                                            class="btn-primary"
                                            colspan="2"/>
                                </group>
                                <group>
                                    <button name="action_create_proposal"
                                            type="object"
                                            string="Create proposal"
                                            class="btn-secondary"
                                            colspan="2"
                                            groups="sales_bid_board.group_bid_board_salesperson"
                                            invisible="review_status != 'approved' or decision_final != 'bid'"/>
                                </group>
                            </group>
                            <div class="alert alert-info mb-0" role="alert"
                                 invisible="review_status == 'approved' and decision_final == 'bid'">
                                After CSO approves with a <strong>Bid</strong> decision, use
                                <strong>Create proposal</strong> (header or this tab) or
                                <strong>View proposals</strong> for this enquiry.
                            </div>
                        </page>
                        <page string="Notifications">
                            <field name="notification_ids">
                                <list editable="bottom">
                                    <field name="notify_team"/>
                                    <field name="deadline_date"/>
                                    <field name="state"/>
                                    <field name="last_reminder_at"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bid_project_search" model="ir.ui.view">
        <field name="name">bid.project.search</field>
        <field name="model">bid.project</field>
        <field name="arch" type="xml">
            <search string="Project Search">
                <field name="name"/>
                <field name="client_name"/>
                <field name="crm_lead_id"/>
                <field name="project_lead_id"/>
                <field name="emirate"/>
                <field name="industry"/>
                <field name="review_status"/>
                <field name="outcome_status"/>
                <filter name="filter_all" string="All" domain="[]"/>
                <filter name="filter_outcome_open" string="Bid: Open" domain="[('outcome_status','=','open')]"/>
                <filter name="filter_outcome_won" string="Bid: Won" domain="[('outcome_status','=','won')]"/>
                <filter name="filter_outcome_lost" string="Bid: Lost" domain="[('outcome_status','=','lost')]"/>
                <filter name="filter_outcome_closed" string="Bid: Closed" domain="[('outcome_status','=','closed')]"/>
                <filter name="filter_priority" string="Priority" domain="[('is_priority','=',True)]"/>
                <separator/>
                <filter name="filter_pending_review" string="Pending Review" domain="[('review_status','=','pending_review')]"/>
                <filter name="filter_change_requested" string="Change Requested" domain="[('review_status','=','change_requested')]"/>
                <separator/>
                <filter name="group_stage" string="Stage" context="{'group_by':'stage_id'}"/>
                <filter name="group_outcome_status" string="Bid status" context="{'group_by':'outcome_status'}"/>
                <filter name="group_lead" string="Project Lead" context="{'group_by':'project_lead_id'}"/>
                <separator/>
                <filter name="group_sales_rep" string="Sales Rep" context="{'group_by':'sales_rep'}"/>
                <filter name="group_review_status" string="Review Status" context="{'group_by':'review_status'}"/>
                <filter name="group_decision_final" string="Bid / No Bid (system)" context="{'group_by':'decision_final'}"/>
                <filter name="group_industry" string="Industry" context="{'group_by':'industry'}"/>
                <filter name="group_emirate" string="Emirate" context="{'group_by':'emirate'}"/>
                <filter name="group_contract_type" string="Contract Type" context="{'group_by':'contract_type'}"/>
                <filter name="group_contract_duration" string="Contract Duration" context="{'group_by':'contract_duration'}"/>
                <filter name="group_threshold" string="Threshold" context="{'group_by':'threshold'}"/>
                <filter name="group_tender_bond" string="Tender Bond" context="{'group_by':'tender_bond'}"/>
                <filter name="group_performance_bond" string="Performance Bond" context="{'group_by':'performance_bond'}"/>
                <filter name="group_kpi" string="KPI in RFP" context="{'group_by':'kpi'}"/>
                <filter name="group_reviewed_by" string="CSO Reviewer" context="{'group_by':'reviewed_by_id'}"/>
                <separator/>
                <filter name="group_create_month" string="Created (month)" context="{'group_by':'create_date:month'}"/>
                <filter name="group_deadline_month" string="Deadline (month)" context="{'group_by':'deadline_datetime:month'}"/>
                <filter name="group_reviewed_on_month" string="Review date (month)" context="{'group_by':'reviewed_on:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_bid_project_pivot" model="ir.ui.view">
        <field name="name">bid.project.pivot</field>
        <field name="model">bid.project</field>
        <field name="arch" type="xml">
            <pivot string="Bid / No Bid Projects" sample="1">
                <field name="stage_id" type="row"/>
                <field name="review_status" type="col"/>
                <field name="contract_value" type="measure"/>
                <field name="score_overall" type="measure"/>
                <field name="proposal_count" type="measure" invisible="1"/>
                <field name="scope_total" type="measure" invisible="1"/>
                <field name="scope_cleaning" type="measure" invisible="1"/>
                <field name="scope_maintenance" type="measure" invisible="1"/>
                <field name="scope_security" type="measure" invisible="1"/>
                <field name="scope_landscaping" type="measure" invisible="1"/>
                <field name="scope_laundry" type="measure" invisible="1"/>
                <field name="scope_support" type="measure" invisible="1"/>
                <field name="scope_others" type="measure" invisible="1"/>
                <field name="score_strategy" type="measure" invisible="1"/>
                <field name="score_customer" type="measure" invisible="1"/>
                <field name="score_commercial" type="measure" invisible="1"/>
                <field name="score_finance" type="measure" invisible="1"/>
                <field name="score_operations" type="measure" invisible="1"/>
            </pivot>
        </field>
    </record>

    <record id="view_bid_project_graph" model="ir.ui.view">
        <field name="name">bid.project.graph</field>
        <field name="model">bid.project</field>
        <field name="arch" type="xml">
            <graph string="Bid / No Bid Projects" type="bar" sample="1">
                <field name="stage_id"/>
                <field name="review_status"/>
                <field name="contract_value" type="measure"/>
                <field name="score_overall" type="measure" invisible="1"/>
                <field name="proposal_count" type="measure" invisible="1"/>
                <field name="scope_total" type="measure" invisible="1"/>
                <field name="scope_cleaning" type="measure" invisible="1"/>
                <field name="scope_maintenance" type="measure" invisible="1"/>
                <field name="scope_security" type="measure" invisible="1"/>
                <field name="scope_landscaping" type="measure" invisible="1"/>
                <field name="scope_laundry" type="measure" invisible="1"/>
                <field name="scope_support" type="measure" invisible="1"/>
                <field name="scope_others" type="measure" invisible="1"/>
                <field name="score_strategy" type="measure" invisible="1"/>
                <field name="score_customer" type="measure" invisible="1"/>
                <field name="score_commercial" type="measure" invisible="1"/>
                <field name="score_finance" type="measure" invisible="1"/>
                <field name="score_operations" type="measure" invisible="1"/>
            </graph>
        </field>
    </record>

    <record id="view_bid_project_wizard_form" model="ir.ui.view">
        <field name="name">bid.project.create.wizard.form</field>
        <field name="model">bid.project.create.wizard</field>
        <field name="arch" type="xml">
            <form string="New Enquiry">
                <group>
                    <field name="name" string="Project Name"/>
                    <field name="client_name"/>
                    <field name="project_lead_id"/>
                    <field name="team_member_ids" widget="many2many_tags"/>
                    <field name="deadline_datetime"/>
                    <field name="is_priority"/>
                    <field name="progress" placeholder="e.g. Starting — outline next steps"/>
                </group>
                <footer>
                    <button name="action_create_project" string="Save Enquiry" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_bid_change_request_wizard_form" model="ir.ui.view">
        <field name="name">bid.change.request.wizard.form</field>
        <field name="model">bid.change.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Change">
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="priority"/>
                    <field name="comments" placeholder="Enter CSO comments for required changes..."/>
                </group>
                <footer>
                    <button name="action_submit_change_request" string="Submit Request" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_bid_decline_review_wizard_form" model="ir.ui.view">
        <field name="name">bid.decline.review.wizard.form</field>
        <field name="model">bid.decline.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Decline enquiry">
                <group>
                    <field name="project_id" invisible="1"/>
                    <field name="justification"
                           placeholder="Explain why this enquiry is being declined. This will be stored and shared with notified contacts."/>
                </group>
                <footer>
                    <button name="action_confirm_decline" string="Decline" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bid_projects" model="ir.actions.act_window">
        <field name="name">All Records</field>
        <field name="res_model">bid.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bid_no_bid" model="ir.actions.act_window">
        <field name="name">Bid / No Bid</field>
        <field name="res_model">bid.project</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_all': 1, 'from_bid_no_bid': 1}</field>
        <field name="search_view_id" ref="view_bid_project_search"/>
    </record>

    <record id="action_bid_reviewer_queue" model="ir.actions.act_window">
        <field name="name">Review</field>
        <field name="res_model">bid.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bid_project_search"/>
        <field name="domain">[('review_status','in',('pending_review','change_requested'))]</field>
    </record>

    <record id="action_bid_reports" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">bid.project</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_bid_project_search"/>
        <field name="context">{'search_default_filter_all': 1}</field>
    </record>

    <record id="action_bid_reports_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_bid_project_pivot"/>
        <field name="act_window_id" ref="action_bid_reports"/>
    </record>
    <record id="action_bid_reports_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_bid_project_graph"/>
        <field name="act_window_id" ref="action_bid_reports"/>
    </record>
    <record id="action_bid_reports_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_bid_project_tree"/>
        <field name="act_window_id" ref="action_bid_reports"/>
    </record>

    <record id="action_bid_new_project_wizard" model="ir.actions.act_window">
        <field name="name">New Enquiry</field>
        <field name="res_model">bid.project.create.wizard</field>
        <field name="view_mode">form</field>
