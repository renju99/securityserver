<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bid_submission_tree" model="ir.ui.view">
        <field name="name">bid.submission.tree</field>
        <field name="model">bid.submission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="submitted_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_bid_submission_form" model="ir.ui.view">
        <field name="name">bid.submission.form</field>
        <field name="model">bid.submission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="owner_id"/>
                        <field name="submitted_date"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bid_submissions" model="ir.actions.act_window">
        <field name="name">Submissions</field>
        <field name="res_model">bid.submission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
