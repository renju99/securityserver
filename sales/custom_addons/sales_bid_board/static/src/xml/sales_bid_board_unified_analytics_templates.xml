<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sales_bid_board.BidBoardUnifiedAnalytics">
        <Layout className="'o_bid_board_unified_analytics_layout h-100'" display="layoutDisplay">
            <div class="o_bid_board_unified_analytics p-3" style="height: calc(100vh - 110px); overflow-y: auto; overflow-x: hidden;">
                <div class="d-flex justify-content-between align-items-center mb-3 bg-primary text-white rounded p-3 flex-wrap gap-2">
                    <div>
                        <h2 class="mb-1 text-white"><i class="fa fa-line-chart me-2"/>Bid Board Analytics</h2>
                        <div class="text-white" style="font-size: 13px; opacity: 0.9;">Leads, enquiries, proposals, performance, and activity in one place</div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button t-if="state.activeTab === 'enquiries'" class="btn btn-outline-light" t-on-click="exportPdf" t-att-disabled="state.loading">
                            <i class="fa fa-file-pdf-o me-1"/>Export PDF (enquiries)
                        </button>
                        <button class="btn btn-outline-light" t-on-click="clearFilters" t-att-disabled="state.loading"><i class="fa fa-eraser me-1"/>Reset</button>
                        <button class="btn btn-outline-light" t-on-click="loadActiveTab" t-att-disabled="state.loading"><i class="fa fa-refresh me-1"/>Refresh</button>
                    </div>
                </div>

                <ul class="nav nav-tabs mb-3 flex-wrap">
                    <t t-foreach="state.tabDefs" t-as="t" t-key="t.key">
                        <li class="nav-item">
                            <a href="#" class="nav-link" t-att-class="state.activeTab === t.key ? 'active' : ''"
                               t-on-click.prevent="() => this.selectTab(t.key)"><t t-esc="t.label"/></a>
                        </li>
                    </t>
                </ul>

                <div class="card mb-3 shadow-sm">
                    <div class="card-header"><i class="fa fa-filter me-2"/>Filters</div>
                    <div class="card-body">
                        <div class="row g-2 mb-2">
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label small">From</label>
                                <input type="date" class="form-control form-control-sm" t-att-value="state.globalFilters.date_from"
                                       t-on-change="(ev) => this.onGlobalChange('date_from', ev.target.value)"/>
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label small">To</label>
                                <input type="date" class="form-control form-control-sm" t-att-value="state.globalFilters.date_to"
                                       t-on-change="(ev) => this.onGlobalChange('date_to', ev.target.value)"/>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label small">Sales rep (where applicable)</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onGlobalChange('sales_rep_id', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.sales_reps" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.globalFilters.sales_rep_id == o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select>
                            </div>
                            <div t-if="state.activeTab === 'leads'" class="col-lg-3 col-md-6">
                                <label class="form-label small">Sales team</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onGlobalChange('team_id', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.teams" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.globalFilters.team_id == o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select>
                            </div>
                            <div t-if="state.activeTab === 'proposals'" class="col-lg-2 col-md-4">
                                <label class="form-label small">Industry</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onGlobalChange('industry', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.industries" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.globalFilters.industry === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select>
                            </div>
                            <div t-if="state.activeTab === 'proposals'" class="col-lg-2 col-md-4">
                                <label class="form-label small">Emirate</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onGlobalChange('emirate', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.emirates" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.globalFilters.emirate === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div t-if="state.activeTab === 'enquiries'" class="row g-2 border-top pt-2">
                            <div class="col-12 small text-muted mb-1">Enquiry-specific</div>
                            <div class="col-lg-2 col-md-4"><label class="form-label small">Bid status</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('outcome_status', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.outcome_statuses" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.outcome_status === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-3 col-md-6"><label class="form-label small">Review status</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('review_status', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.review_statuses" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.review_status === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-3 col-md-6"><label class="form-label small">Decision</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('decision_final', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.decisions" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.decision_final === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-2 col-md-4"><label class="form-label small">Industry</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('industry', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.industries" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.industry === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-2 col-md-4"><label class="form-label small">Emirate</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('emirate', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.emirates" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.emirate === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-2 col-md-4"><label class="form-label small">Stage</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('stage_id', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.stages" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.stage_id == o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-3 col-md-6"><label class="form-label small">Sales rep</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('sales_rep_id', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.sales_reps" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.sales_rep_id == o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-3 col-md-6"><label class="form-label small">Project lead</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('project_lead_id', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.project_leads" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.project_lead_id == o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                        </div>

                        <div t-if="state.activeTab === 'by_rep'" class="row g-2 border-top pt-2">
                            <div class="col-12 small text-muted mb-1">Rep breakdown filters</div>
                            <div class="col-lg-2 col-md-4"><label class="form-label small">Industry</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('industry', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.industries" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.industry === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-2 col-md-4"><label class="form-label small">Emirate</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('emirate', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.emirates" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.emirate === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-2 col-md-4"><label class="form-label small">Bid status</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('outcome_status', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.outcome_statuses" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.outcome_status === o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                            <div class="col-lg-3 col-md-6"><label class="form-label small">Focus sales rep</label>
                                <select class="form-select form-select-sm" t-on-change="(ev) => this.onEnquiryChange('sales_rep_id', ev.target.value)">
                                    <option value="">All</option>
                                    <t t-foreach="state.filterOptions.sales_reps" t-as="o" t-key="o.value">
                                        <option t-att-value="o.value" t-att-selected="state.enquiryFilters.sales_rep_id == o.value"><t t-esc="o.label"/></option>
                                    </t>
                                </select></div>
                        </div>
                    </div>
                </div>

                <div t-if="state.loading" class="text-center py-5"><i class="fa fa-spinner fa-spin fa-3x text-primary"/></div>
                <div t-if="state.error and !state.loading" class="alert alert-danger"><t t-esc="state.error"/></div>

                <div t-if="!state.loading and !state.error and state.tabPayload">
                    <div class="row g-3 mb-3">
                        <t t-foreach="state.tabPayload.kpis or []" t-as="kpi" t-key="kpi.name">
                            <div t-att-class="state.activeTab === 'by_rep' ? 'col-lg-3 col-md-6' : 'col-lg-2 col-md-4 col-sm-6'">
                                <div class="card h-100 shadow-sm" t-att-class="kpi.action ? 'cursor-pointer' : ''" t-on-click="() => this.onKpiClick(kpi)">
                                    <div class="card-body">
                                        <div class="small text-muted mb-1"><i t-if="kpi.icon" t-att-class="'fa me-1 ' + kpi.icon"/><t t-esc="kpi.name"/></div>
                                        <div class="h4 mb-0"><t t-esc="kpi.value"/><t t-esc="kpi.suffix || ''"/></div>
                                        <div t-if="kpi.previous_value !== undefined" class="small mt-1" t-att-class="this.getVariance(kpi.value, kpi.previous_value) >= 0 ? 'text-success' : 'text-danger'">
                                            <t t-esc="Math.abs(this.getVariance(kpi.value, kpi.previous_value)).toFixed(1)"/>% vs previous
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="row g-3 mb-3" t-if="state.tabPayload.charts and state.tabPayload.charts.length">
                        <t t-foreach="state.tabPayload.charts" t-as="chart" t-key="chart.title">
                            <div class="col-lg-6">
                                <div class="card shadow-sm">
                                    <div class="card-header bg-light"><t t-esc="chart.title"/></div>
                                    <div class="card-body">
                                        <div style="position: relative; height: 260px;">
                                            <canvas t-attf-id="sbb_u_{{state.activeTab}}_{{chart_index}}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="row g-3">
                        <t t-foreach="state.tabPayload.tables or []" t-as="table" t-key="table.title">
                            <div class="col-12">
                                <div class="card shadow-sm">
                                    <div class="card-header bg-light"><t t-esc="table.title"/></div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <t t-foreach="table.columns" t-as="col" t-key="col"><th><t t-esc="col"/></th></t>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-if="table.rows and table.rows.length">
                                                        <t t-foreach="table.rows" t-as="row" t-key="row.id">
                                                            <tr t-on-click="() => this.onRowClick(table, row)" t-att-class="table.res_model ? 'cursor-pointer' : ''">
                                                                <t t-foreach="row.data" t-as="cell" t-key="cell_index"><td><t t-esc="cell"/></td></t>
                                                            </tr>
                                                        </t>
                                                    </t>
                                                    <t t-else=""><tr><td t-att-colspan="table.columns.length" class="text-center text-muted py-3">No data</td></tr></t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </Layout>
    </t>
</templates>
