<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bid_project_decision_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="company" t-value="env.company"/>
                    <t t-set="base_url" t-value="env['ir.config_parameter'].sudo().get_param('web.base.url', '')"/>
                    <t t-set="logo_data" t-value="company.logo_web or company.logo"/>
                    <t t-set="decision_label" t-value="dict(o._fields['decision_final'].selection).get(o.decision_final, o.decision_final or '')"/>
                    <t t-set="review_status_label" t-value="dict(o._fields['review_status'].selection).get(o.review_status, o.review_status or '')"/>
                    <t t-set="outcome_label" t-value="dict(o._fields['outcome_status'].selection).get(o.outcome_status, o.outcome_status or '')"/>
                    <div class="page">
                        <div style="border:1px solid #dbe5f2; border-radius:12px; margin-bottom:14px; overflow:hidden;">
                            <table style="width:100%; border-collapse:collapse; background:#ffffff;">
                                <tr>
                                    <td style="width:180px; vertical-align:middle; text-align:center; padding:16px; border-right:1px solid #e6edf7;">
                                        <img t-if="logo_data"
                                             t-att-src="image_data_uri(logo_data)"
                                             style="max-height:72px; max-width:150px;"
                                             alt="Company Logo"/>
                                        <img t-elif="company and base_url"
                                             t-att-src="'%s/web/image/res.company/%s/logo' % (base_url, company.id)"
                                             style="max-height:72px; max-width:150px;"
                                             alt="Company Logo"/>
                                        <div t-else="" style="font-size:11px; color:#94a3b8;">Logo not configured</div>
                                    </td>
                                    <td style="vertical-align:top; padding:16px 18px; background:linear-gradient(180deg, #f7faff 0%, #ffffff 70%);">
                                        <h2 style="margin:0; color:#0f2b57; font-size:32px; line-height:1.1;">Bid / No Bid Decision Sheet</h2>
                                        <div style="font-size:14px; color:#334155; margin-top:6px;">
                                            <strong t-esc="company.name or ''"/>
                                        </div>
                                        <div style="font-size:12px; color:#64748b; margin-top:8px;">
                                            Project: <strong t-esc="o.name"/> (<span t-esc="o.code or 'N/A'"/>)
                                            <span style="margin:0 6px; color:#94a3b8;">|</span>
                                            Generated: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div style="margin-bottom:14px;">
                            <table style="width:100%; border-collapse:separate; border-spacing:10px 0;">
                                <tr>
                                    <td style="width:25%; border:1px solid #dbe5f2; border-radius:10px; padding:12px 12px;">
                                        <div style="font-size:11px; color:#64748b; text-transform:uppercase;">Client</div>
                                        <div style="font-size:16px; color:#0f172a; margin-top:4px;" t-esc="o.client_name or '-'"/>
                                    </td>
                                    <td style="width:25%; border:1px solid #dbe5f2; border-radius:10px; padding:12px 12px;">
                                        <div style="font-size:11px; color:#64748b; text-transform:uppercase;">Sales Rep</div>
                                        <div style="font-size:16px; color:#0f172a; margin-top:4px;" t-esc="o.sales_rep.name or '-'"/>
                                    </td>
                                    <td style="width:25%; border:1px solid #dbe5f2; border-radius:10px; padding:12px 12px;">
                                        <div style="font-size:11px; color:#64748b; text-transform:uppercase;">Project Lead</div>
                                        <div style="font-size:16px; color:#0f172a; margin-top:4px;" t-esc="o.project_lead_id.name or '-'"/>
                                    </td>
                                    <td style="width:25%; border:1px solid #dbe5f2; border-radius:10px; padding:12px 12px;">
                                        <div style="font-size:11px; color:#64748b; text-transform:uppercase;">Deadline</div>
                                        <div style="font-size:16px; color:#0f172a; margin-top:4px;">
                                            <t t-if="o.deadline_datetime">
                                                <span t-field="o.deadline_datetime"/>
                                            </t>
                                            <t t-else="">-</t>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div style="border:1px solid #dbe5f2; border-radius:12px; padding:14px; margin-bottom:14px;">
                            <h3 style="margin:0 0 10px 0; color:#0f2b57; font-size:22px;">Category Scores</h3>
                            <table style="width:100%; border-collapse:collapse;">
                                <thead>
                                    <tr style="background:#f7faff;">
                                        <th style="border-bottom:1px solid #dbe5f2; padding:9px 8px; text-align:left; color:#334155; font-size:12px; text-transform:uppercase;">Category</th>
                                        <th style="border-bottom:1px solid #dbe5f2; padding:9px 8px; text-align:right; color:#334155; font-size:12px; text-transform:uppercase;">Score (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px;">Strategy</td>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px; text-align:right;" t-esc="'%.2f' % (o.score_strategy or 0.0)"/>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px;">Customer</td>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px; text-align:right;" t-esc="'%.2f' % (o.score_customer or 0.0)"/>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px;">Commercial</td>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px; text-align:right;" t-esc="'%.2f' % (o.score_commercial or 0.0)"/>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px;">Finance</td>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px; text-align:right;" t-esc="'%.2f' % (o.score_finance or 0.0)"/>
                                    </tr>
                                    <tr>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px;">Operations</td>
                                        <td style="border-bottom:1px solid #edf2f7; padding:9px 8px; text-align:right;" t-esc="'%.2f' % (o.score_operations or 0.0)"/>
                                    </tr>
                                    <tr style="background:#f7faff;">
                                        <td style="padding:10px 8px; border-top:2px solid #dbe5f2;"><strong>Overall</strong></td>
                                        <td style="padding:10px 8px; text-align:right; border-top:2px solid #dbe5f2; color:#0f2b57; font-size:17px;">
                                            <strong t-esc="'%.2f' % (o.score_overall or 0.0)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div style="border:1px solid #dbe5f2; border-radius:12px; padding:14px;">
                            <h3 style="margin:0 0 12px 0; color:#0f2b57; font-size:22px;">Final Recommendation</h3>
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="padding:7px 0; width:170px; color:#475569;"><strong>Decision</strong></td>
                                    <td style="padding:6px 0;">
                                        <span t-if="o.decision_final == 'bid'"
                                              style="display:inline-block; padding:5px 10px; border-radius:999px; background:#e8f7ee; color:#0f7b3f; border:1px solid #bde5ca;"
                                              t-esc="decision_label"/>
                                        <span t-if="o.decision_final == 'no_bid'"
                                              style="display:inline-block; padding:5px 10px; border-radius:999px; background:#fdecec; color:#b42318; border:1px solid #f6c4c4;"
                                              t-esc="decision_label"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:7px 0; color:#475569;"><strong>Recommendation</strong></td>
                                    <td style="padding:7px 0; font-size:16px; color:#0f172a;" t-esc="o.recommendation_text or ''"/>
                                </tr>
                                <tr t-if="o.recommendation_note">
                                    <td style="padding:7px 0; color:#475569;"><strong>Note</strong></td>
                                    <td style="padding:7px 0;" t-esc="o.recommendation_note"/>
                                </tr>
                            </table>
                            <div style="margin-top:12px; border-top:1px solid #edf2f7; padding-top:10px; color:#64748b; font-size:12px;">
                                Current workflow: <strong t-esc="review_status_label"/> | Bid status: <strong t-esc="outcome_label"/><t t-if="o.is_priority"> (priority)</t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_bid_project_decision_sheet" model="ir.actions.report">
        <field name="name">Bid Decision Sheet</field>
        <field name="model">bid.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sales_bid_board.report_bid_project_decision_sheet</field>
        <field name="binding_model_id" ref="model_bid_project"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
