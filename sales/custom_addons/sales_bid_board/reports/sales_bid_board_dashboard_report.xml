<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sales_bid_board_dashboard_pdf" name="Sales Bid Board Dashboard Report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-set="filter_params" t-value="context.get('filter_params', {}) if context else {}"/>
                    <t t-set="report_data" t-value="docs[0].get_report_data(filter_params) if docs and len(docs) > 0 else env['sales_bid_board.dashboard'].get_report_data(filter_params)"/>
                    <t t-set="kpis_list" t-value="report_data.get('kpis', []) if report_data else []"/>
                    <t t-set="charts_list" t-value="report_data.get('charts', []) if report_data else []"/>
                    <t t-set="tables_list" t-value="report_data.get('tables', []) if report_data else []"/>

                    <h2 style="text-align:center;">Sales Bid Board Dashboard</h2>
                    <p style="text-align:center;color:#666;">
                        Generated by <t t-esc="env.user.name"/> on
                        <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                    </p>

                    <h4>KPIs</h4>
                    <table style="width:100%;border-collapse:collapse;">
                        <tbody>
                            <tr>
                                <t t-foreach="kpis_list" t-as="kpi">
                                    <td style="border:1px solid #ddd;padding:8px;">
                                        <strong><t t-esc="kpi.get('name', '')"/></strong><br/>
                                        <span style="font-size:16px;"><t t-esc="kpi.get('value', 0)"/> <t t-esc="kpi.get('suffix', '')"/></span>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>

                    <h4 style="margin-top:14px;">Charts Data</h4>
                    <t t-foreach="charts_list" t-as="chart">
                        <p><strong><t t-esc="chart.get('title', 'Chart')"/></strong></p>
                        <table style="width:100%;border-collapse:collapse;margin-bottom:8px;">
                            <thead>
                                <tr>
                                    <th style="border:1px solid #ddd;padding:6px;text-align:left;">Label</th>
                                    <th style="border:1px solid #ddd;padding:6px;text-align:left;">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="labels" t-value="chart.get('labels', [])"/>
                                <t t-set="dataset" t-value="chart.get('datasets', [])[0].get('data', []) if chart.get('datasets') else []"/>
                                <t t-foreach="range(len(labels))" t-as="idx">
                                    <tr>
                                        <td style="border:1px solid #ddd;padding:6px;"><t t-esc="labels[idx]"/></td>
                                        <td style="border:1px solid #ddd;padding:6px;"><t t-esc="dataset[idx] if idx &lt; len(dataset) else 0"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <h4 style="margin-top:14px;">Tables</h4>
                    <t t-foreach="tables_list" t-as="table">
                        <p><strong><t t-esc="table.get('title', 'Table')"/></strong></p>
                        <table style="width:100%;border-collapse:collapse;margin-bottom:8px;">
                            <thead>
                                <tr>
                                    <t t-foreach="table.get('columns', [])" t-as="col">
                                        <th style="border:1px solid #ddd;padding:6px;text-align:left;"><t t-esc="col"/></th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="table.get('rows', [])" t-as="row">
                                    <tr>
                                        <t t-foreach="row.get('data', [])" t-as="cell">
                                            <td style="border:1px solid #ddd;padding:6px;"><t t-esc="cell"/></td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_sales_bid_board_dashboard" model="ir.actions.report">
        <field name="name">Sales Bid Board Dashboard</field>
        <field name="model">sales_bid_board.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sales_bid_board.report_sales_bid_board_dashboard_pdf</field>
        <field name="binding_model_id" ref="model_sales_bid_board_dashboard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
