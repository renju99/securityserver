<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        PDF tuned for wkhtmltopdf (border-collapse, explicit borders).
        Colours aligned with Odoo Enterprise defaults: purple #714B67 / #875A7B, neutral greys.
    -->
    <template id="report_sales_bid_board_dashboard_pdf" name="Sales Bid Board Dashboard Report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-set="company"       t-value="env.company"/>
                    <t t-set="base_url"      t-value="env['ir.config_parameter'].sudo().get_param('web.base.url', '')"/>
                    <t t-set="logo_data"     t-value="company.logo_web or company.logo"/>
                    <t t-set="filter_params" t-value="context.get('filter_params', {}) if context else {}"/>
                    <t t-set="report_data"   t-value="docs[0].get_report_data(filter_params) if docs and len(docs) > 0 else env['sales_bid_board.dashboard'].get_report_data(filter_params)"/>
                    <t t-set="kpis_list"     t-value="report_data.get('kpis', [])   if report_data else []"/>
                    <t t-set="charts_list"   t-value="report_data.get('charts', []) if report_data else []"/>
                    <t t-set="tables_list"   t-value="report_data.get('tables', []) if report_data else []"/>
                    <t t-set="report_heading" t-value="context.get('bid_board_analytics_report_title') if context and context.get('bid_board_analytics_report_title') else 'Bid Board Analytics'"/>

                    <!-- Header: Enterprise lilac panel + primary purple -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:14px; border:2px solid #875A7B;">
                        <tr>
                            <td style="width:170px; vertical-align:middle; text-align:center; padding:16px; border-right:2px solid #cbb8c3; background:#f4eef1;">
                                <img t-if="logo_data"
                                     t-att-src="image_data_uri(logo_data)"
                                     style="max-height:64px; max-width:130px;"
                                     alt="Company Logo"/>
                                <img t-elif="company and base_url"
                                     t-att-src="'%s/web/image/res.company/%s/logo' % (base_url, company.id)"
                                     style="max-height:64px; max-width:130px;"
                                     alt="Company Logo"/>
                                <div t-else="" style="font-size:10px; color:#6c757d;">No logo</div>
                            </td>
                            <td style="vertical-align:middle; padding:16px 18px; background:#714B67;">
                                <div style="font-size:9px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#e8d7e3; margin-bottom:4px;">
                                    Bid Board Analytics Report
                                </div>
                                <h2 style="margin:0; color:#ffffff; font-size:20px; font-weight:700; line-height:1.2;">
                                    <t t-esc="report_heading"/>
                                </h2>
                                <div style="margin-top:6px; font-size:11px; color:#ffffff;">
                                    <strong t-esc="company.name or ''"/>
                                    <span style="margin:0 6px; color:#d4c4d0;">|</span>
                                    Generated by <t t-esc="env.user.name"/>
                                    <span style="margin:0 6px; color:#d4c4d0;">|</span>
                                    <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %b %Y, %H:%M')"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Filters -->
                    <t t-if="filter_params">
                        <table style="width:100%; border-collapse:collapse; margin-bottom:12px; border:1px solid #875A7B;">
                            <tr>
                                <td style="padding:9px 12px; background:#f4eef1; font-size:11px; color:#212529; border-bottom:1px solid #cbb8c3;">
                                    <strong style="color:#714B67;">Active filters</strong>
                                    <t t-if="filter_params.get('date_from')">
                                        <span style="margin-left:6px; border:1px solid #875A7B; background:#ffffff; color:#714B67; padding:2px 7px; font-weight:600;">From: <t t-esc="filter_params.get('date_from')"/></span>
                                    </t>
                                    <t t-if="filter_params.get('date_to')">
                                        <span style="margin-left:4px; border:1px solid #875A7B; background:#ffffff; color:#714B67; padding:2px 7px; font-weight:600;">To: <t t-esc="filter_params.get('date_to')"/></span>
                                    </t>
                                    <t t-if="filter_params.get('outcome_status')">
                                        <span style="margin-left:4px; border:1px solid #16a34a; background:#ffffff; color:#14532d; padding:2px 7px; font-weight:600;">Bid status: <t t-esc="filter_params.get('outcome_status')"/></span>
                                    </t>
                                    <t t-if="filter_params.get('review_status')">
                                        <span style="margin-left:4px; border:1px solid #d97706; background:#ffffff; color:#92400e; padding:2px 7px; font-weight:600;">Review: <t t-esc="filter_params.get('review_status')"/></span>
                                    </t>
                                    <t t-if="filter_params.get('decision_final')">
                                        <span style="margin-left:4px; border:1px solid #7c3aed; background:#ffffff; color:#5b21b6; padding:2px 7px; font-weight:600;">Decision: <t t-esc="filter_params.get('decision_final')"/></span>
                                    </t>
                                    <t t-if="filter_params.get('industry')">
                                        <span style="margin-left:4px; border:1px solid #15803d; background:#ffffff; color:#14532d; padding:2px 7px; font-weight:600;">Industry: <t t-esc="filter_params.get('industry')"/></span>
                                    </t>
                                    <t t-if="filter_params.get('emirate')">
                                        <span style="margin-left:4px; border:1px solid #ea580c; background:#ffffff; color:#9a3412; padding:2px 7px; font-weight:600;">Emirate: <t t-esc="filter_params.get('emirate')"/></span>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </t>

                    <!-- KPI grid -->
                    <t t-if="kpis_list">
                        <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
                            <tr>
                                <td style="border-left:5px solid #714B67; padding:4px 0 4px 10px; font-size:12px; font-weight:700; color:#714B67; text-transform:uppercase;">
                                    Key Performance Indicators
                                </td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px; border:2px solid #6c757d;">
                            <t t-set="kpi_rows" t-value="[kpis_list[i:i+4] for i in range(0, len(kpis_list), 4)]"/>
                            <t t-foreach="kpi_rows" t-as="krow">
                                <tr>
                                    <t t-foreach="krow" t-as="kpi">
                                        <t t-set="kcolor" t-value="kpi.get('color', 'primary')"/>
                                        <!-- Enterprise: primary = Odoo purple; other KPI colours match Odoo semantic hues -->
                                        <t t-set="accent" t-value="'#714B67' if kcolor == 'primary' else ('#198754' if kcolor == 'success' else ('#d97706' if kcolor == 'warning' else ('#dc3545' if kcolor == 'danger' else ('#875A7B' if kcolor == 'info' else '#495057'))))"/>
                                        <t t-set="tint" t-value="'#f4eef1' if kcolor == 'primary' else ('#ecfdf5' if kcolor == 'success' else ('#fffbeb' if kcolor == 'warning' else ('#fef2f2' if kcolor == 'danger' else ('#f0ecf2' if kcolor == 'info' else '#f8f9fa'))))"/>
                                        <td t-att-style="'width:25%; border:1px solid #ced4da; vertical-align:top; padding:0; background:' + tint + ';'">
                                            <div t-att-style="'height:5px; background:' + accent + ';'"></div>
                                            <div style="padding:10px 12px; background:#ffffff;">
                                                <div style="font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:#495057; margin-bottom:4px;">
                                                    <t t-esc="kpi.get('name', '')"/>
                                                </div>
                                                <div t-att-style="'font-size:20px; font-weight:700; color:' + accent + '; line-height:1.1;'">
                                                    <t t-esc="kpi.get('value', 0)"/><t t-if="kpi.get('suffix')" t-esc="' ' + kpi.get('suffix', '')"/>
                                                </div>
                                                <t t-if="kpi.get('previous_value') not in (None, False, 0, '')">
                                                    <t t-set="prev_v" t-value="kpi.get('previous_value', 0) or 0"/>
                                                    <t t-set="curr_v" t-value="kpi.get('value', 0) or 0"/>
                                                    <t t-set="var_pct" t-value="round(((curr_v - prev_v) / prev_v * 100), 1) if prev_v else 0"/>
                                                    <div t-att-style="'margin-top:4px; font-size:9px; color:' + ('#198754' if var_pct >= 0 else '#dc3545') + '; font-weight:600;'">
                                                        <t t-esc="('+' if var_pct >= 0 else '') + str(var_pct) + chr(37) + ' vs previous'"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </td>
                                    </t>
                                    <t t-set="pad_cols" t-value="4 - len(krow)"/>
                                    <t t-foreach="range(pad_cols)" t-as="pc">
                                        <td style="width:25%; border:1px solid #ced4da; background:#f8f9fa;">&#160;</td>
                                    </t>
                                </tr>
                            </t>
                        </table>
                    </t>

                    <!-- Charts -->
                    <t t-if="charts_list">
                        <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
                            <tr>
                                <td style="border-left:5px solid #714B67; padding:4px 0 4px 10px; font-size:12px; font-weight:700; color:#714B67; text-transform:uppercase;">
                                    Charts &amp; Breakdowns
                                </td>
                            </tr>
                        </table>
                        <t t-set="chart_pairs" t-value="[charts_list[i:i+2] for i in range(0, len(charts_list), 2)]"/>
                        <t t-foreach="chart_pairs" t-as="cpair">
                            <table style="width:100%; border-collapse:collapse; margin-bottom:12px; border:2px solid #6c757d;">
                                <tr>
                                    <t t-foreach="cpair" t-as="chart">
                                        <td style="width:50%; border:1px solid #ced4da; vertical-align:top; padding:0; background:#ffffff;">
                                            <table style="width:100%; border-collapse:collapse;">
                                                <tr>
                                                    <td style="padding:8px 12px; background:#875A7B; border-bottom:1px solid #714B67; font-size:10px; font-weight:700; color:#ffffff; text-transform:uppercase;">
                                                        <t t-esc="chart.get('title', 'Chart')"/>
                                                    </td>
                                                </tr>
                                            </table>
                                            <t t-set="labels"  t-value="chart.get('labels', [])"/>
                                            <t t-set="dataset" t-value="chart.get('datasets', [])[0].get('data', []) if chart.get('datasets') else []"/>
                                            <t t-set="max_val" t-value="max(dataset) if dataset else 1"/>
                                            <t t-set="max_val" t-value="max_val if max_val else 1"/>
                                            <table style="width:100%; border-collapse:collapse; font-size:10px;">
                                                <thead>
                                                    <tr>
                                                        <th style="width:38%; border:1px solid #ced4da; padding:6px 8px; text-align:left; background:#ece6ef; color:#412e3d; font-weight:700; text-transform:uppercase;">Label</th>
                                                        <th style="width:14%; border:1px solid #ced4da; padding:6px 8px; text-align:right; background:#ece6ef; color:#412e3d; font-weight:700; text-transform:uppercase;">Value</th>
                                                        <th style="width:48%; border:1px solid #ced4da; padding:6px 8px; text-align:left; background:#ece6ef; color:#412e3d; font-weight:700; text-transform:uppercase;">Share</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="range(len(labels))" t-as="idx">
                                                        <t t-set="val" t-value="dataset[idx] if idx &lt; len(dataset) else 0"/>
                                                        <t t-set="val" t-value="val if val else 0"/>
                                                        <t t-set="bar_pct" t-value="int(round(val / max_val * 100)) if max_val else 0"/>
                                                        <tr t-att-style="'background:' + ('#f8f9fa' if idx % 2 == 0 else '#ffffff') + ';'">
                                                            <td style="border:1px solid #dee2e6; padding:5px 8px; color:#212529;">
                                                                <t t-esc="labels[idx]"/>
                                                            </td>
                                                            <td style="border:1px solid #dee2e6; padding:5px 8px; text-align:right; font-weight:700; color:#714B67;">
                                                                <t t-esc="val"/>
                                                            </td>
                                                            <td style="border:1px solid #dee2e6; padding:5px 8px; vertical-align:middle;">
                                                                <table style="width:100%; border-collapse:collapse;"><tr>
                                                                    <td style="width:100%; padding:0; border:none; background:#e9ecef;">
                                                                        <div t-att-style="'height:8px; background:#a384a2; width:' + str(bar_pct) + chr(37) + ';'"></div>
                                                                    </td>
                                                                </tr></table>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                    <t t-if="not labels">
                                                        <tr>
                                                            <td colspan="3" style="border:1px solid #ced4da; padding:10px; text-align:center; color:#6c757d; background:#f8f9fa;">No data</td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </td>
                                    </t>
                                    <t t-if="len(cpair) == 1">
                                        <td style="width:50%; border:1px solid #ced4da; background:#f8f9fa;">&#160;</td>
                                    </t>
                                </tr>
                            </table>
                        </t>
                    </t>

                    <!-- Detail tables -->
                    <t t-if="tables_list">
                        <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
                            <tr>
                                <td style="border-left:5px solid #714B67; padding:4px 0 4px 10px; font-size:12px; font-weight:700; color:#714B67; text-transform:uppercase;">
                                    Detail Tables
                                </td>
                            </tr>
                        </table>
                        <t t-foreach="tables_list" t-as="table">
                            <table style="width:100%; border-collapse:collapse; margin-bottom:12px; border:2px solid #6c757d;">
                                <tr>
                                    <td t-att-colspan="len(table.get('columns', []) or [1])"
                                        style="padding:8px 12px; background:#714B67; border-bottom:1px solid #5a3d52; font-size:10px; font-weight:700; color:#ffffff; text-transform:uppercase;">
                                        <t t-esc="table.get('title', 'Table')"/>
                                    </td>
                                </tr>
                                <t t-if="table.get('columns')">
                                    <tr>
                                        <t t-foreach="table.get('columns', [])" t-as="col">
                                            <th style="border:1px solid #ced4da; padding:6px 8px; text-align:left; background:#ece6ef; color:#412e3d; font-size:9px; font-weight:700; text-transform:uppercase;">
                                                <t t-esc="col"/>
                                            </th>
                                        </t>
                                    </tr>
                                </t>
                                <t t-if="table.get('rows')">
                                    <t t-foreach="table.get('rows', [])" t-as="row">
                                        <tr t-att-style="'background:' + ('#f8f9fa' if row_index % 2 == 0 else '#ffffff') + ';'">
                                            <t t-foreach="row.get('data', [])" t-as="cell">
                                                <td style="border:1px solid #dee2e6; padding:5px 8px; color:#212529; font-size:10px;">
                                                    <t t-esc="cell"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td t-att-colspan="len(table.get('columns', [])) or 1"
                                            style="border:1px solid #ced4da; padding:12px; text-align:center; color:#6c757d; font-size:10px; background:#f8f9fa;">
                                            No records found for the selected filters.
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </t>
                    </t>

                    <!-- Footer -->
                    <table style="width:100%; border-collapse:collapse; margin-top:14px; border-top:2px solid #6c757d;">
                        <tr>
                            <td style="padding:8px 0; font-size:9px; color:#6c757d; text-align:left; border:none;">
                                <strong style="color:#714B67;" t-esc="company.name or ''"/>
                                <span style="color:#868e96;"> — Bid Board Analytics</span>
                            </td>
                            <td style="padding:8px 0; font-size:9px; color:#6c757d; text-align:right; border:none;">
                                Confidential — internal use only
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>

    <record id="action_report_sales_bid_board_dashboard" model="ir.actions.report">
        <field name="name">Sales Bid Board Dashboard</field>
        <field name="model">sales_bid_board.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sales_bid_board.report_sales_bid_board_dashboard_pdf</field>
        <field name="binding_model_id" ref="model_sales_bid_board_dashboard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
