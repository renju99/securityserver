<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Legacy: RFP codes now use per–emirate/year sequences (bid.project.rfp.<emirate>.<year>). Kept for DBs that still reference this code. -->
    <record id="seq_bid_project" model="ir.sequence">
        <field name="name">Bid Project (legacy)</field>
        <field name="code">bid.project</field>
        <field name="prefix">BID-</field>
        <field name="padding">5</field>
    </record>

    <record id="bid_project_stage_new" model="bid.project.stage">
        <field name="name">New</field>
        <field name="sequence">10</field>
    </record>
    <record id="bid_project_stage_review" model="bid.project.stage">
        <field name="name">Qualified</field>
        <field name="sequence">20</field>
    </record>
    <record id="bid_project_stage_submission" model="bid.project.stage">
        <field name="name">Proposition</field>
        <field name="sequence">30</field>
    </record>
    <record id="bid_project_stage_done" model="bid.project.stage">
        <field name="name">Won</field>
        <field name="sequence">40</field>
        <field name="fold">True</field>
    </record>
</odoo>
