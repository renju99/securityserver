<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_bid_governance_sla_notifications" model="ir.cron">
        <field name="name">Bid Board Governance SLA Notifications</field>
        <field name="model_id" ref="model_bid_project"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_governance_sla_notifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_bid_deadline_notification_reminders" model="ir.cron">
        <field name="name">Bid Board Deadline Notification Reminders</field>
        <field name="model_id" ref="model_bid_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_deadline_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_bid_proposal_deadline_one_month" model="ir.cron">
        <field name="name">Bid Board Proposal deadline (30-day) reminder</field>
        <field name="model_id" ref="model_bid_proposal"/>
        <field name="state">code</field>
        <field name="code">model._cron_proposal_deadline_one_month_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
