    "@vladmandic/face-api": "^1.7.15",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "luxon": "^3.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "exceljs": "^4.4.0",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
