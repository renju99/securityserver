POSTGRES_USER=user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=attendance
DATABASE_URL=postgres://user:change_me_db_password@db:5432/attendance
REDIS_URL=redis://redis:6379
# Defaults to REDIS_URL in the API. Keep this set when scaling API replicas horizontally.
SOCKET_IO_REDIS_URL=redis://redis:6379
SOCKET_IO_REDIS_REQUIRED=true

JWT_SECRET=change_me_super_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_COOKIE_SECURE=true
TRUST_PROXY_HOPS=1

CORS_ORIGINS=https://attendance.berkeleyuae.com
# Optional: hostnames allowed for CORS without listing full origins (e.g. VM public IP, internal DNS).
# CORS_ALLOW_HOSTNAMES=20.123.45.67,attendance-internal.local
# false = reject requests with no Origin (curl, some probes). Browsers always send Origin for cross-origin calls.
CORS_ALLOW_NO_ORIGIN=false
REQUEST_BODY_LIMIT=10mb

# Public HTTPS origin (no trailing slash). Used by HR wizard connection tests and safe if the API cannot infer Host.
# Also allows Socket.IO / REST CORS for any scheme/port on this hostname (e.g. http://… vs https://…).
PUBLIC_APP_URL=https://attendance.berkeleyuae.com
# Optional: extra public base URL for links in emails/notifications (often same as PUBLIC_APP_URL).
# APP_PUBLIC_URL=

# Optional (web image build arg): absolute origin for HR Socket.IO if the dashboard is not served from the API host.
# VITE_SOCKET_BASE_URL=https://attendance.berkeleyuae.com

# Required in production (API exits on startup if missing or still the dev default).
# RA08 / generic bridges: Authorization: Bearer <BIOMETRIC_INGEST_TOKEN>
BIOMETRIC_INGEST_TOKEN=replace_with_long_random_secret
BIOMETRIC_ATTENDANCE_INTERVAL_MS=10000
BIOMETRIC_ATTENDANCE_BATCH_SIZE=50
BIOMETRIC_ATTENDANCE_MAX_ATTEMPTS=20
BIOMETRIC_ATTENDANCE_RETRY_BASE_SECONDS=30
BIOMETRIC_ATTENDANCE_RETRY_MAX_SECONDS=900

ODOO_SYNC_INTERVAL_MS=15000
ODOO_SYNC_BATCH_SIZE=25
ODOO_SYNC_MAX_ATTEMPTS=288
ODOO_SYNC_RETRY_BASE_SECONDS=30
ODOO_SYNC_RETRY_MAX_SECONDS=900

# ZKTeco iClock push: terminals call https://YOUR-SITE/iclock/... (nginx in frontend proxies to API)
ZK_ICLOCK_ENABLED=true
# Optional: comma-separated SN allowlist (empty = all registered device_key values accepted when pushing)
# ZK_ICLOCK_ALLOWED_SN=
# ZK_ATTLOG_STAFF_PREFIX=

# ZKTeco TCP pull (same time as iClock push — both supported). Polls HR terminals type ZKTeco_TCP with IP; harmless if none.
ZK_TCP_PULL_ENABLED=true
ZK_TCP_PULL_CRON=*/3 * * * *
ZK_TCP_PULL_TIMEOUT_MS=20000
ZK_TCP_PULL_UDP_INPORT=4000

# Email / SMS / scheduled exports (see backend/.env.example for full list)
# Outbound mail: HR Admin → Email settings per org (not SENDGRID_*/SMTP_* on the host).
# SCHEDULED_EXPORT_SFTP_* optional; SCHEDULED_EXPORT_S3_* + AWS_* optional; SCHEDULED_EXPORT_PGP_PUBLIC_KEY_ARMORED optional
