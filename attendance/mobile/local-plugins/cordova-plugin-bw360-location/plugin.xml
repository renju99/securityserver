<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-bw360-location"
        version="1.0.0">

    <name>BW360Location</name>
    <description>Native foreground-service based background location tracking for Berkeley Workforce 360.</description>
    <license>Apache-2.0</license>
    <keywords>cordova,location,gps,background,foreground-service</keywords>

    <engines>
        <engine name="cordova-android" version=">=12.0.0" />
    </engines>

    <js-module src="www/BW360Location.js" name="BW360Location">
        <clobbers target="BW360Location" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="BW360Location">
                <param name="android-package" value="com.berkeleyuae.bw360location.BW360LocationPlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
            <uses-permission android:name="android.permission.WAKE_LOCK" />
            <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
            <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <service
                android:name="com.berkeleyuae.bw360location.LocationForegroundService"
                android:enabled="true"
                android:exported="false"
                android:foregroundServiceType="location"
                android:stopWithTask="false" />
        </config-file>

        <framework src="com.google.android.gms:play-services-location:21.3.0" />
        <framework src="androidx.core:core:1.13.1" />

        <source-file src="src/android/BW360LocationPlugin.java"
            target-dir="src/com/berkeleyuae/bw360location" />
        <source-file src="src/android/LocationForegroundService.java"
            target-dir="src/com/berkeleyuae/bw360location" />
    </platform>
</plugin>
