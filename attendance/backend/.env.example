APP_TIMEZONE=Asia/Dubai
PORT=3000
NODE_ENV=development
# Required if you run seed.js with NODE_ENV=production (never use a fixed dev password in prod)
# SEED_DEMO_PASSWORD=change_me_for_demo_accounts
DATABASE_URL=postgres://user:password@db:5432/attendance
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=lax
JWT_REFRESH_COOKIE_MAX_AGE_MS=2592000000
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://attendance.berkeleyuae.com
CORS_ALLOW_NO_ORIGIN=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
LOC_RATE_LIMIT_WINDOW_MS=60000
LOC_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
LOCATION_UPDATE_MIN_INTERVAL_MS=10000
LOCATION_BATCH_FLUSH_MS=5000
BIOMETRIC_INGEST_TOKEN=attendance_secret_token
BIOMETRIC_STALE_MINS=10
BIOMETRIC_OFFLINE_MINS=30
# Public origin for HR wizard connection tests (optional if reverse proxy sends X-Forwarded-Host)
# PUBLIC_APP_URL=https://attendance.example.com
# ZKTeco iClock push → https://YOUR-HOST/iclock/ (device_key in HR = terminal SN)
ZK_ICLOCK_ENABLED=true
# ZK_ICLOCK_ALLOWED_SN=SN1,SN2
# ZK_ATTLOG_STAFF_PREFIX=
LATE_THRESHOLD_MINS=15
AUTO_CHECKOUT_GRACE_HOURS=2
AUTO_CHECKOUT_NO_SHIFT_HOURS=10
DATA_RETENTION_DAYS=180
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
PG_SLOW_QUERY_MS=500
PG_POOL_METRICS_INTERVAL_MS=60000
FACE_AUTH_SIMILARITY_THRESHOLD=0.78
FACE_AUTH_MAX_FAILED_ATTEMPTS=5
FACE_AUTH_LOCK_MINUTES=15
ODOO_SYNC_INTERVAL_MS=15000
ODOO_SYNC_BATCH_SIZE=25
ODOO_SYNC_MAX_ATTEMPTS=10
ODOO_SYNC_RETRY_BASE_SECONDS=30
ODOO_SYNC_RETRY_MAX_SECONDS=900
KIOSK_FACE_CACHE_TTL_MS=60000
KIOSK_FACE_SHORTLIST_SIZE=250
KIOSK_FACE_SIGNATURE_BITS=24
KIOSK_DEVICE_MIN_INTERVAL_MS=1500
KIOSK_DEVICE_LAST_SEEN_UPDATE_MS=30000
KIOSK_IP_WINDOW_MS=60000
KIOSK_IP_WINDOW_MAX=1200
REDIS_URL=redis://attendance_redis:6379
KIOSK_FACE_WARMER_INTERVAL_MS=30000
KIOSK_FACE_WARMER_TOP_SITES=10
