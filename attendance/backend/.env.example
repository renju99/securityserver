APP_TIMEZONE=Asia/Dubai
PORT=3000
NODE_ENV=development
# Required if you run seed.js with NODE_ENV=production (never use a fixed dev password in prod)
# SEED_DEMO_PASSWORD=change_me_for_demo_accounts
DATABASE_URL=postgres://user:password@db:5432/attendance
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=lax
JWT_REFRESH_COOKIE_MAX_AGE_MS=2592000000
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://attendance.berkeleyuae.com
CORS_ALLOW_NO_ORIGIN=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
LOC_RATE_LIMIT_WINDOW_MS=60000
LOC_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
LOCATION_UPDATE_MIN_INTERVAL_MS=10000
LOCATION_BATCH_FLUSH_MS=5000
REQUEST_BODY_LIMIT=10mb
BIOMETRIC_INGEST_TOKEN=attendance_secret_token
BIOMETRIC_STALE_MINS=10
BIOMETRIC_OFFLINE_MINS=30
# Public origin for HR wizard connection tests (optional if reverse proxy sends X-Forwarded-Host)
# PUBLIC_APP_URL=https://attendance.example.com
# ZKTeco iClock push → https://YOUR-HOST/iclock/ (device_key in HR = terminal SN)
ZK_ICLOCK_ENABLED=true
# ZK_ICLOCK_ALLOWED_SN=SN1,SN2
# ZK_ATTLOG_STAFF_PREFIX=
# ZKTeco TCP poll (node-zklib — same ZK wire protocol as PHP packages like jmrashed/zkteco). Default on with iClock push; set false to disable.
# ZK_TCP_PULL_ENABLED=true
# ZK_TCP_PULL_CRON=*/3 * * * *
# ZK_TCP_PULL_TIMEOUT_MS=20000
# ZK_TCP_PULL_UDP_INPORT=4000

# Outbound email for approvals, scheduled exports, etc.: configure in the app under HR Admin → Email & messaging (per organization). Keys and SMTP settings are stored in the database for that org; the API process does not read SENDGRID_* or SMTP_* from .env for those sends.

# Scheduled export attachment size cap (email path); SFTP/S3/webhook ignore this cap.
# SCHEDULED_EXPORT_MAX_ATTACHMENT_MB=25

# Optional PGP encrypt attachment when schedule has encryptAttachmentPgp (armored public key).
# SCHEDULED_EXPORT_PGP_PUBLIC_KEY_ARMORED=-----BEGIN PGP PUBLIC KEY BLOCK-----...

# Optional S3 upload when schedule has s3Upload (uses default AWS credential chain or env below).
# SCHEDULED_EXPORT_S3_BUCKET=your-bucket
# SCHEDULED_EXPORT_S3_KEY_PREFIX=reports
# SCHEDULED_EXPORT_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Twilio SMS (optional). NOTIFY_ATTENDANCE_SMS=true sends SMS to employees with phone_e164 on approve/reject.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+971500000000
# NOTIFY_ATTENDANCE_EMAIL=true
# NOTIFY_ATTENDANCE_SMS=false
# NOTIFY_PENDING_DIGEST_ENABLED=true
# NOTIFY_PENDING_DIGEST_CRON=15 7 * * *
# NOTIFY_DIGEST_SMS_TO=+971500000001

# Scheduled report SFTP (optional global; per-schedule flag sftp_upload on each job).
# SCHEDULED_EXPORT_SFTP_HOST=
# SCHEDULED_EXPORT_SFTP_PORT=22
# SCHEDULED_EXPORT_SFTP_USER=
# SCHEDULED_EXPORT_SFTP_PASSWORD=
# SCHEDULED_EXPORT_SFTP_DIR=/reports
# SCHEDULED_EXPORT_SFTP_PRIVATE_KEY=base64-encoded-key-optional

LATE_THRESHOLD_MINS=15
AUTO_CHECKOUT_GRACE_HOURS=2
AUTO_CHECKOUT_NO_SHIFT_HOURS=10
DATA_RETENTION_DAYS=180
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
PG_SLOW_QUERY_MS=500
PG_POOL_METRICS_INTERVAL_MS=60000
FACE_AUTH_SIMILARITY_THRESHOLD=0.78
FACE_AUTH_MAX_FAILED_ATTEMPTS=5
FACE_AUTH_LOCK_MINUTES=15
ODOO_SYNC_INTERVAL_MS=15000
ODOO_SYNC_BATCH_SIZE=25
ODOO_SYNC_MAX_ATTEMPTS=288
ODOO_SYNC_RETRY_BASE_SECONDS=30
ODOO_SYNC_RETRY_MAX_SECONDS=900
BIOMETRIC_ATTENDANCE_INTERVAL_MS=10000
BIOMETRIC_ATTENDANCE_BATCH_SIZE=50
BIOMETRIC_ATTENDANCE_MAX_ATTEMPTS=20
BIOMETRIC_ATTENDANCE_RETRY_BASE_SECONDS=30
BIOMETRIC_ATTENDANCE_RETRY_MAX_SECONDS=900
KIOSK_FACE_CACHE_TTL_MS=60000
KIOSK_FACE_SHORTLIST_SIZE=250
KIOSK_FACE_SIGNATURE_BITS=24
KIOSK_DEVICE_MIN_INTERVAL_MS=1500
KIOSK_DEVICE_LAST_SEEN_UPDATE_MS=30000
KIOSK_IP_WINDOW_MS=60000
KIOSK_IP_WINDOW_MAX=1200
REDIS_URL=redis://attendance_redis:6379
# Optional explicit Socket.IO pub/sub URL. Defaults to REDIS_URL when omitted.
# Required for horizontal API scaling behind a load balancer.
# SOCKET_IO_REDIS_URL=redis://attendance_redis:6379
SOCKET_IO_REDIS_REQUIRED=false
KIOSK_FACE_WARMER_INTERVAL_MS=30000
KIOSK_FACE_WARMER_TOP_SITES=10
