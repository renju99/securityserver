<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Route Optimizer Wizard Form View -->
        <record id="view_route_optimizer_wizard_form" model="ir.ui.view">
            <field name="name">route.optimizer.wizard.form</field>
            <field name="model">route.optimizer.wizard</field>
            <field name="arch" type="xml">
                <form string="Route Optimization">
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="checkpoint_ids" widget="many2many_tags"/>
                            <field name="start_location"/>
                        </group>
                        <group>
                            <field name="custom_start_lat" invisible="start_location != 'custom'"/>
                            <field name="custom_start_lng" invisible="start_location != 'custom'"/>
                            <field name="return_to_start"/>
                        </group>
                    </group>
                    
                    <group invisible="not optimized_route">
                        <group>
                            <field name="total_distance"/>
                        </group>
                        <group>
                            <field name="optimized_route" widget="text"/>
                        </group>
                    </group>
                    
                    <footer>
                        <button string="Optimize Route" 
                                name="action_optimize_route" 
                                type="object" 
                                class="btn-primary"
                                invisible="optimized_route"/>
                        <button string="Show on Map" 
                                name="action_show_route_on_map" 
                                type="object" 
                                class="btn-secondary"
                                invisible="not optimized_route"/>
                        <button string="Close" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Route Optimizer Action -->
        <record id="action_route_optimizer_wizard" model="ir.actions.act_window">
            <field name="name">Optimize Patrol Route</field>
            <field name="res_model">route.optimizer.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_client_site"/>
            <field name="binding_view_types">form</field>
        </record>

    </data>
</odoo>

