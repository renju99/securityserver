<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enhanced Question-Level Pass/Fail Views -->
    
    <!-- Tree view for quiz line responses -->
    <record id="view_slide_slide_partner_quiz_line_tree" model="ir.ui.view">
        <field name="name">slide.slide.partner.quiz.line.tree</field>
        <field name="model">slide.slide.partner.quiz.line</field>
        <field name="arch" type="xml">
            <list string="Question Responses" create="0" edit="0" delete="0"
                  decoration-success="is_correct == True" 
                  decoration-danger="is_correct == False">
                <field name="question_text" string="Question"/>
                <field name="answer_ids" widget="many2many_tags" string="Selected Answer(s)"/>
                <field name="answer_text" string="Text Answer" optional="hide"/>
                <field name="is_correct" invisible="1"/>
                <field name="status" string="Result" widget="badge" 
                       decoration-success="status == 'correct'" 
                       decoration-danger="status == 'incorrect'"/>
                <field name="score" string="Points" optional="hide"/>
            </list>
        </field>
    </record>
    
    <!-- Form view for quiz line responses -->
    <record id="view_slide_slide_partner_quiz_line_form" model="ir.ui.view">
        <field name="name">slide.slide.partner.quiz.line.form</field>
        <field name="model">slide.slide.partner.quiz.line</field>
        <field name="arch" type="xml">
            <form string="Question Response" create="0" edit="0" delete="0">
                <header>
                    <field name="is_correct" invisible="1"/>
                    <div class="alert alert-success mt-2 mb-2" role="alert" invisible="not is_correct">
                        <strong>✓ Correct!</strong> This question was answered correctly.
                    </div>
                    <div class="alert alert-danger mt-2 mb-2" role="alert" invisible="is_correct">
                        <strong>✗ Incorrect.</strong> This question was not answered correctly.
                    </div>
                </header>
                <sheet>
                    <group>
                        <group string="Question">
                            <field name="question_id"/>
                            <field name="question_text" widget="text"/>
                        </group>
                        <group string="Answer">
                            <field name="answer_ids" widget="many2many_tags"/>
                            <field name="answer_text" invisible="not answer_text"/>
                        </group>
                    </group>
                    <group>
                        <group string="Result">
                            <field name="status" widget="badge" 
                                   decoration-success="status == 'correct'" 
                                   decoration-danger="status == 'incorrect'"/>
                            <field name="score"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action to view all quiz responses for an enrollment -->
    <record id="action_enrollment_quiz_responses" model="ir.actions.act_window">
        <field name="name">All Quiz Responses</field>
        <field name="res_model">slide.slide.partner.quiz.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
