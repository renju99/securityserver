<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lost Found Item Form View -->
    <record id="view_lost_found_item_form" model="ir.ui.view">
        <field name="name">lost.found.item.form</field>
        <field name="model">lost.found.item</field>
        <field name="arch" type="xml">
            <form string="Lost &amp; Found Item">
                <header>
                    <button name="action_mark_claimed" string="Mark as Claimed" type="object"
                            class="oe_highlight"
                            invisible="state != 'stored'"/>
                    <button name="action_dispose" string="Dispose" type="object"
                            invisible="state != 'stored'"/>
                    <button name="action_create_incident" string="Create Incident" type="object"
                            invisible="incident_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="stored,claimed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="High Value" bg_color="text-bg-warning"
                            invisible="not is_high_value"/>
                    <widget name="web_ribbon" title="Expiring Soon" bg_color="text-bg-danger"
                            invisible="not is_expiring_soon"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="item_category"/>
                            <field name="description"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="color"/>
                            <field name="serial_number"/>
                            <field name="estimated_value"/>
                        </group>
                        <group>
                            <field name="site_id" options="{'no_create': True}"/>
                            <field name="location_found"/>
                            <field name="found_date"/>
                            <field name="found_by"/>
                            <field name="found_by_contact"/>
                            <field name="guard_logged_by"/>
                            <field name="is_high_value" invisible="1"/>
                            <field name="is_expiring_soon" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Photos">
                            <group>
                                <group>
                                    <field name="photo_1" widget="image" options="{'size': [300, 300]}"/>
                                </group>
                                <group>
                                    <field name="photo_2" widget="image" options="{'size': [300, 300]}"/>
                                </group>
                                <group>
                                    <field name="photo_3" widget="image" options="{'size': [300, 300]}"/>
                                </group>
                            </group>
                            <group>
                                <field name="distinguishing_features" placeholder="Describe unique features for identification..."/>
                            </group>
                        </page>
                        <page string="Storage">
                            <group>
                                <group>
                                    <field name="storage_location"/>
                                    <field name="storage_date"/>
                                    <field name="holding_period_days"/>
                                </group>
                                <group>
                                    <field name="holding_expiry_date"/>
                                    <field name="days_until_expiry"/>
                                </group>
                            </group>
                        </page>
                        <page string="Claim Details" invisible="state not in ['claimed', 'stored']">
                            <group>
                                <group>
                                    <field name="claim_date"/>
                                    <field name="claimant_name"/>
                                    <field name="claimant_id_type"/>
                                    <field name="claimant_id_number"/>
                                </group>
                                <group>
                                    <field name="claimant_phone"/>
                                    <field name="claimant_email"/>
                                    <field name="returned_by"/>
                                </group>
                            </group>
                            <group>
                                <field name="verification_notes" placeholder="How was ownership verified?"/>
                                <field name="verification_questions" placeholder="Questions asked and answers provided..."/>
                            </group>
                            <group>
                                <field name="claimant_signature" widget="image" options="{'size': [200, 100]}"/>
                            </group>
                        </page>
                        <page string="Disposition" invisible="state not in ['disposed', 'donated', 'police', 'lost']">
                            <group>
                                <group>
                                    <field name="disposition_date"/>
                                    <field name="disposition_authorized_by"/>
                                </group>
                                <group>
                                    <field name="disposition_document" filename="disposition_filename"/>
                                </group>
                            </group>
                            <group>
                                <field name="disposition_notes" placeholder="Details of final disposition..."/>
                            </group>
                        </page>
                        <page string="Additional">
                            <group>
                                <field name="incident_id"/>
                                <field name="notes" placeholder="Additional notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Lost Found Item List View -->
    <record id="view_lost_found_item_list" model="ir.ui.view">
        <field name="name">lost.found.item.list</field>
        <field name="model">lost.found.item</field>
        <field name="arch" type="xml">
            <list string="Lost &amp; Found Items" multi_edit="1" sample="1">
                <field name="name"/>
                <field name="item_category"/>
                <field name="description"/>
                <field name="site_id"/>
                <field name="location_found" optional="hide"/>
                <field name="found_date"/>
                <field name="storage_location" optional="show"/>
                <field name="days_until_expiry" optional="show"/>
                <field name="estimated_value" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'claimed'"
                       decoration-info="state == 'stored'"
                       decoration-muted="state in ['disposed', 'donated', 'police']"/>
            </list>
        </field>
    </record>

    <!-- Lost Found Item Kanban View -->
    <record id="view_lost_found_item_kanban" model="ir.ui.view">
        <field name="name">lost.found.item.kanban</field>
        <field name="model">lost.found.item</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="item_category"/>
                <field name="description"/>
                <field name="site_id"/>
                <field name="found_date"/>
                <field name="state"/>
                <field name="is_high_value"/>
                <field name="is_expiring_soon"/>
                <field name="days_until_expiry"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                        <t t-if="record.is_high_value.raw_value">
                                            <span class="badge text-bg-warning ms-1">High Value</span>
                                        </t>
                                        <t t-if="record.is_expiring_soon.raw_value">
                                            <span class="badge text-bg-danger ms-1">Expiring</span>
                                        </t>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="item_category"/> - <field name="site_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-12">
                                        <field name="description"/>
                                    </div>
                                    <div class="col-12 mt-2">
                                        <i class="fa fa-map-marker" title="Location" aria-label="Location"/> <field name="location_found"/>
                                    </div>
                                    <div class="col-12">
                                        <i class="fa fa-clock-o" title="Time" aria-label="Time"/> Days left: <field name="days_until_expiry"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="found_date" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Lost Found Item Search View -->
    <record id="view_lost_found_item_search" model="ir.ui.view">
        <field name="name">lost.found.item.search</field>
        <field name="model">lost.found.item</field>
        <field name="arch" type="xml">
            <search string="Search Lost &amp; Found">
                <field name="name"/>
                <field name="description" filter_domain="[('description', 'ilike', self)]"/>
                <field name="item_category"/>
                <field name="site_id"/>
                <field name="storage_location"/>
                <separator/>
                <filter string="High Value" name="high_value" domain="[('is_high_value', '=', True)]"/>
                <filter string="Expiring Soon" name="expiring_soon" domain="[('is_expiring_soon', '=', True)]"/>
                <separator/>
                <filter string="In Storage" name="stored" domain="[('state', '=', 'stored')]"/>
                <filter string="Claimed" name="claimed" domain="[('state', '=', 'claimed')]"/>
                <filter string="Disposed" name="disposed" domain="[('state', '=', 'disposed')]"/>
                <separator/>
                <filter string="Found This Week" name="this_week"
                        domain="[('found_date', '&gt;=', (context_today() - relativedelta(weeks=1)))]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'item_category'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Found Date" name="group_found_date" context="{'group_by': 'found_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Lost Found Item Action -->
    <record id="action_lost_found_item" model="ir.actions.act_window">
        <field name="name">Lost &amp; Found</field>
        <field name="res_model">lost.found.item</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_stored': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Log your first lost &amp; found item
            </p>
            <p>
                Track lost and found property, manage claims with verification,
                and maintain compliance with legal holding periods.
            </p>
        </field>
    </record>

</odoo>

