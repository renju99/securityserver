<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========================================== -->
    <!-- Portal Guard Location Map Template         -->
    <!-- ========================================== -->
    
    <template id="portal_guard_location_map" name="Live Guard Location Map">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Live Guard Locations</t>
            </t>
            
            <div class="container mt-3">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0">
                                    <i class="fa fa-map-marker"/> Real-Time Guard Tracking
                                </h4>
                            </div>
                            <div class="card-body">
                                <!-- Project Selector -->
                                <div class="form-group mb-3">
                                    <label for="siteSelector">Select Project:</label>
                                    <select id="siteSelector" class="form-control">
                                        <t t-foreach="sites" t-as="site">
                                            <option t-att-value="site.id" t-att-selected="'selected' if site == default_site else None">
                                                <t t-esc="site.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                
                                <!-- Map Container -->
                                <div id="guardLocationMap" style="height: 600px; width: 100%; border: 2px solid #ddd; border-radius: 8px;"></div>
                                
                                <!-- Legend and Info -->
                                <div class="mt-3 row">
                                    <div class="col-md-6">
                                        <h5>Legend</h5>
                                        <ul class="list-unstyled">
                                            <li><span class="badge badge-success">●</span> On Duty</li>
                                            <li><span class="badge badge-secondary">●</span> Off Duty</li>
                                            <li><span class="badge badge-warning">●</span> Low Battery</li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <h5>Active Guards</h5>
                                        <div id="activeGuardsList" class="list-group"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- JavaScript for Live Map -->
            <script type="text/javascript">
                odoo.define('guardpro.portal_live_map', function (require) {
                    'use strict';
                    
                    var publicWidget = require('web.public.widget');
                    var ajax = require('web.ajax');
                    
                    var GuardLiveMap = publicWidget.Widget.extend({
                        selector: '#guardLocationMap',
                        
                        start: function () {
                            var self = this;
                            this.map = null;
                            this.markers = {};
                            this.refreshInterval = null;
                            
                            // Initialize map
                            this.initMap();
                            
                            // Initial load
                            this.refreshLocations();
                            
                            // Auto-refresh every 30 seconds
                            this.refreshInterval = setInterval(function() {
                                self.refreshLocations();
                            }, 30000);
                            
                            // Site selector change
                            $('#siteSelector').on('change', function() {
                                self.refreshLocations();
                            });
                            
                            return this._super.apply(this, arguments);
                        },
                        
                        initMap: function() {
                            // Initialize Leaflet map (or Google Maps if preferred)
                            // This is a placeholder - implement with actual map library
                            console.log('Map initialized');
                        },
                        
                        refreshLocations: function() {
                            var self = this;
                            var siteId = $('#siteSelector').val();
                            
                            ajax.jsonRpc('/my/guards/locations', 'call', {
                                'site_id': siteId
                            }).then(function(result) {
                                if (result.locations) {
                                    self.updateMarkers(result.locations);
                                    self.updateGuardsList(result.locations);
                                }
                            });
                        },
                        
                        updateMarkers: function(locations) {
                            // Update map markers
                            // Implementation depends on map library
                            console.log('Updating markers:', locations);
                        },
                        
                        updateGuardsList: function(locations) {
                            var $list = $('#activeGuardsList');
                            $list.empty();
                            
                            locations.forEach(function(loc) {
                                var isLive = loc.is_live === true;
                                var badgeClass = isLive ? 'badge-success' : 'badge-danger';
                                var statusText = isLive ? 'Live' : 'Last known';
                                var batteryWarning = loc.battery_level &lt; 20 ? ' <i class="fa fa-battery-quarter text-warning"/>' : '';
                                
                                $list.append(
                                    '<div class="list-group-item">' +
                                    '<span class="badge ' + badgeClass + '">●</span> ' +
                                    '<strong>' + loc.guard_name + '</strong> ' +
                                    '<small class="' + (isLive ? 'text-success' : 'text-danger') + '">' + statusText + '</small>' +
                                    batteryWarning +
                                    '<br/><small class="text-muted">' + loc.time_since_update + '</small>' +
                                    '</div>'
                                );
                            });
                        },
                        
                        destroy: function() {
                            if (this.refreshInterval) {
                                clearInterval(this.refreshInterval);
                            }
                            this._super.apply(this, arguments);
                        }
                    });
                    
                    publicWidget.registry.GuardLiveMap = GuardLiveMap;
                    
                    return GuardLiveMap;
                });
            </script>
        </t>
    </template>
    
    <!-- ========================================== -->
    <!-- Portal My Incidents List                   -->
    <!-- ========================================== -->
    
    <template id="portal_my_incidents" name="My Incidents">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Incidents</t>
                <t t-set="searchbar_sortings" t-value="sortby_options"/>
                <t t-set="sortby" t-value="sortby"/>
                <t t-set="searchbar_filters" t-value="filterby_options"/>
                <t t-set="filterby" t-value="filterby"/>
            </t>
            
            <div class="container mt-3">
                <t t-if="not incidents">
                    <div class="alert alert-info">
                        No incidents found.
                    </div>
                </t>
                <t t-else="">
                    <div class="row">
                        <t t-foreach="incidents" t-as="incident">
                            <div class="col-md-12 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <h5>
                                                    <a t-attf-href="/my/incident/#{incident.id}">
                                                        <t t-esc="incident.title"/>
                                                    </a>
                                                </h5>
                                                <p class="text-muted mb-1">
                                                    <i class="fa fa-calendar"/> <t t-esc="incident.incident_datetime"/>
                                                    <span class="ml-3">
                                                        <i class="fa fa-map-marker"/> <t t-esc="incident.site_id.name"/>
                                                    </span>
                                                </p>
                                                <t t-if="incident.last_update_description">
                                                    <p class="mb-0">
                                                        <strong>Latest Update:</strong>
                                                        <t t-esc="incident.last_update_description[:100]"/>...
                                                    </p>
                                                </t>
                                            </div>
                                            <div class="col-md-4 text-right">
                                                <t t-set="severity_class" t-value="'danger' if incident.severity == 'critical' else 'warning' if incident.severity == 'high' else 'info'"/>
                                                <span t-attf-class="badge badge-#{severity_class} badge-lg">
                                                    <t t-esc="incident.severity.upper()"/>
                                                </span>
                                                <br/>
                                                <span class="badge badge-secondary mt-2">
                                                    <t t-esc="incident.status.replace('_', ' ').title()"/>
                                                </span>
                                                <br/>
                                                <small class="text-muted">
                                                    <t t-esc="incident.status_update_count"/> updates
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    
                    <!-- Pager -->
                    <div t-if="pager" class="mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </t>
            </div>
        </t>
    </template>
    
    <!-- ========================================== -->
    <!-- Portal Incident Detail with Live Updates   -->
    <!-- ========================================== -->
    
    <template id="portal_incident_detail" name="Incident Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            
            <div class="container mt-3">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h3><t t-esc="incident.title"/></h3>
                                <p class="mb-0 text-muted">
                                    Incident #<t t-esc="incident.name"/>
                                </p>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong>Date/Time:</strong><br/>
                                        <t t-esc="incident.incident_datetime"/>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Project:</strong><br/>
                                        <t t-esc="incident.site_id.name"/>
                                    </div>
                                </div>
                                
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong>Severity:</strong><br/>
                                        <t t-set="severity_class" t-value="'danger' if incident.severity == 'critical' else 'warning' if incident.severity == 'high' else 'info'"/>
                                        <span t-attf-class="badge badge-#{severity_class}">
                                            <t t-esc="incident.severity.upper()"/>
                                        </span>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Status:</strong><br/>
                                        <span class="badge badge-secondary">
                                            <t t-esc="incident.status.replace('_', ' ').title()"/>
                                        </span>
                                    </div>
                                </div>
                                
                                <hr/>
                                
                                <h5>Description</h5>
                                <div t-field="incident.description"/>
                                
                                <t t-if="incident.location">
                                    <hr/>
                                    <h5>Location</h5>
                                    <p><t t-esc="incident.location"/></p>
                                </t>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fa fa-refresh"/> Status Updates
                                </h5>
                            </div>
                            <div class="card-body" id="statusUpdatesContainer">
                                <t t-if="not status_updates">
                                    <p class="text-muted">No status updates yet.</p>
                                </t>
                                <t t-else="">
                                    <div class="timeline">
                                        <t t-foreach="status_updates" t-as="update">
                                            <div class="timeline-item mb-3 pb-3 border-bottom">
                                                <small class="text-muted">
                                                    <i class="fa fa-clock-o"/> <t t-esc="update.update_datetime"/>
                                                </small>
                                                <h6 class="mt-1 mb-1"><t t-esc="update.title"/></h6>
                                                <p class="mb-0"><t t-esc="update.description"/></p>
                                                <small class="text-muted">
                                                    by <t t-esc="update.updated_by_id.name"/>
                                                </small>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                        
                        <!-- Auto-refresh notice -->
                        <div class="alert alert-info mt-3">
                            <i class="fa fa-info-circle"/> Updates refresh automatically every 60 seconds
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- JavaScript for auto-refresh -->
            <script type="text/javascript">
                odoo.define('guardpro.portal_incident_live', function (require) {
                    'use strict';
                    
                    var ajax = require('web.ajax');
                    
                    var incidentId = <t t-esc="incident.id"/>;
                    
                    function refreshUpdates() {
                        ajax.jsonRpc('/my/incident/' + incidentId + '/updates', 'call', {}).then(function(result) {
                            if (result.updates) {
                                // Update UI with new updates
                                console.log('Refreshed updates:', result);
                            }
                        });
                    }
                    
                    // Auto-refresh every 60 seconds
                    setInterval(refreshUpdates, 60000);
                });
            </script>
        </t>
    </template>
    
    <!-- ========================================== -->
    <!-- No Project Access Warning                     -->
    <!-- ========================================== -->
    
    <template id="portal_no_site_access" name="No Project Access">
        <t t-call="portal.portal_layout">
            <div class="container mt-5">
                <div class="alert alert-warning text-center">
                    <h4><i class="fa fa-exclamation-triangle"/> No Project Access</h4>
                    <p>You do not have access to any sites. Please contact your administrator.</p>
                </div>
            </div>
        </t>
    </template>
    
</odoo>

