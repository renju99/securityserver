<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- CCTV Camera List View -->
        <record id="view_cctv_camera_list" model="ir.ui.view">
            <field name="name">cctv.camera.list</field>
            <field name="model">cctv.camera</field>
            <field name="arch" type="xml">
                <list string="CCTV Cameras">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="site_id"/>
                    <field name="camera_type" optional="show"/>
                    <field name="status" widget="badge" decoration-success="status == 'online'" decoration-danger="status == 'offline'" decoration-warning="status == 'maintenance'"/>
                    <field name="is_active" widget="boolean_toggle"/>
                    <field name="stream_type" optional="hide"/>
                    <button name="action_play_stream" type="object" 
                            string="Play" 
                            class="btn-primary"
                            icon="fa-play"
                            invisible="status != 'online' or not is_active"
                            title="Play Camera Stream"/>
                </list>
            </field>
        </record>

        <!-- CCTV Camera Monitoring List View (with Play button) -->
        <record id="view_cctv_camera_monitoring_list" model="ir.ui.view">
            <field name="name">cctv.camera.monitoring.list</field>
            <field name="model">cctv.camera</field>
            <field name="arch" type="xml">
                <list string="Available CCTV Cameras">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="site_id"/>
                    <field name="camera_type" optional="show"/>
                    <field name="status" widget="badge" decoration-success="status == 'online'" decoration-danger="status == 'offline'" decoration-warning="status == 'maintenance'"/>
                    <field name="is_active" widget="boolean_toggle"/>
                    <field name="stream_type" optional="hide"/>
                    <button name="action_play_stream" type="object" 
                            string="Play" 
                            class="btn-primary"
                            icon="fa-play"
                            invisible="status != 'online' or not is_active"
                            title="Play Camera Stream"/>
                </list>
            </field>
        </record>

        <!-- CCTV Camera Kanban View -->
        <record id="view_cctv_camera_kanban" model="ir.ui.view">
            <field name="name">cctv.camera.kanban</field>
            <field name="model">cctv.camera</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status" class="o_kanban_small_column">
                    <field name="status"/>
                    <field name="name"/>
                    <field name="site_id"/>
                    <field name="camera_type"/>
                    <field name="is_active"/>
                    <progressbar field="status" colors='{"online": "success", "offline": "danger", "maintenance": "warning"}'/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <div class="o_kanban_record_subtitle">
                                                <field name="site_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="row">
                                            <div class="col-6">
                                                <span class="text-muted">Type:</span>
                                                <field name="camera_type"/>
                                            </div>
                                            <div class="col-6">
                                                <span class="text-muted">Status:</span>
                                                <field name="status" widget="badge"/>
                                            </div>
                                        </div>
                                        <div class="row mt-2" t-if="record.checkpoint_id.raw_value">
                                            <div class="col-12">
                                                <span class="text-muted">Checkpoint:</span>
                                                <field name="checkpoint_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="is_active" widget="boolean_toggle"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- CCTV Camera Monitoring Kanban View (with Play button) -->
        <record id="view_cctv_camera_monitoring_kanban" model="ir.ui.view">
            <field name="name">cctv.camera.monitoring.kanban</field>
            <field name="model">cctv.camera</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status" class="o_kanban_small_column">
                    <field name="status"/>
                    <field name="name"/>
                    <field name="site_id"/>
                    <field name="camera_type"/>
                    <field name="is_active"/>
                    <progressbar field="status" colors='{"online": "success", "offline": "danger", "maintenance": "warning"}'/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <div class="o_kanban_record_subtitle">
                                                <field name="site_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="row">
                                            <div class="col-6">
                                                <span class="text-muted">Type:</span>
                                                <field name="camera_type"/>
                                            </div>
                                            <div class="col-6">
                                                <span class="text-muted">Status:</span>
                                                <field name="status" widget="badge"/>
                                            </div>
                                        </div>
                                        <div class="row mt-2" t-if="record.checkpoint_id.raw_value">
                                            <div class="col-12">
                                                <span class="text-muted">Checkpoint:</span>
                                                <field name="checkpoint_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="is_active" widget="boolean_toggle"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <button name="action_play_stream" type="object" 
                                                    class="btn btn-primary btn-sm" 
                                                    string="Play"
                                                    invisible="status != 'online' or not is_active"
                                                    title="Play Camera Stream"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- CCTV Camera Form View -->
        <record id="view_cctv_camera_form" model="ir.ui.view">
            <field name="name">cctv.camera.form</field>
            <field name="model">cctv.camera</field>
            <field name="arch" type="xml">
                <form string="CCTV Camera">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="online,offline,maintenance,error"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="site_id" options="{'no_create': True}"/>
                                <field name="checkpoint_id" domain="[('site_id', '=', site_id)]" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="camera_type"/>
                                <field name="status"/>
                                <field name="is_active"/>
                                <field name="manufacturer"/>
                                <field name="model"/>
                            </group>
                        </group>
                        <group string="Streaming Configuration">
                            <group>
                                <field name="stream_type"/>
                                <field name="stream_url" placeholder="rtsp://192.168.1.100:554/stream1 or http://example.com/stream"/>
                            </group>
                            <group>
                                <field name="ip_address"/>
                                <field name="port"/>
                            </group>
                        </group>
                        <group string="Authentication" invisible="not username and not password">
                            <group>
                                <field name="username"/>
                                <field name="password" password="True"/>
                            </group>
                        </group>
                        <group string="Location Details">
                            <field name="location_description" placeholder="e.g., Main entrance, facing north, covers parking lot"/>
                        </group>
                        <notebook>
                            <page string="Stream Preview" name="preview">
                                <div class="alert alert-info" role="alert">
                                    <strong>Stream URL:</strong> <field name="stream_url" readonly="1"/>
                                    <br/>
                                    <small>To view the camera stream, configure your CCTV system to provide a web-accessible URL (HTTP/HTTPS, HLS, or WebRTC).</small>
                                </div>
                                <div invisible="stream_type not in ('iframe', 'http', 'hls')" class="mt-3">
                                    <p><strong>Stream Preview:</strong></p>
                                    <p class="text-muted">Copy the stream URL above and open it in your browser or CCTV management software.</p>
                                    <p class="text-muted">For web-accessible streams (HTTP/HTTPS, HLS), you can open the URL directly in a new browser tab.</p>
                                </div>
                                <div invisible="stream_type in ('iframe', 'http', 'hls')" class="alert alert-warning mt-3" role="alert">
                                    <p><strong>Stream Preview Not Available</strong></p>
                                    <p>Stream preview is only available for HTTP/HTTPS, HLS, or iFrame stream types.</p>
                                    <p>For RTSP streams, use a compatible video player or CCTV management software.</p>
                                    <p>Copy the stream URL above and use it with your preferred CCTV viewing application.</p>
                                </div>
                            </page>
                            <page string="Notes">
                                <field name="notes" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- CCTV Camera Search View -->
        <record id="view_cctv_camera_search" model="ir.ui.view">
            <field name="name">cctv.camera.search</field>
            <field name="model">cctv.camera</field>
            <field name="arch" type="xml">
                <search string="CCTV Cameras">
                    <field name="name" string="Camera Name"/>
                    <field name="code" string="Camera Code"/>
                    <field name="site_id"/>
                    <field name="checkpoint_id"/>
                    <field name="camera_type"/>
                    <field name="manufacturer"/>
                    <field name="ip_address"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                    <filter string="Online" name="online" domain="[('status', '=', 'online')]"/>
                    <filter string="Offline" name="offline" domain="[('status', '=', 'offline')]"/>
                    <filter string="Maintenance" name="maintenance" domain="[('status', '=', 'maintenance')]"/>
                    <separator/>
                    <filter string="PTZ Cameras" name="ptz" domain="[('camera_type', '=', 'ptz')]"/>
                    <filter string="Fixed Cameras" name="fixed" domain="[('camera_type', '=', 'fixed')]"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('is_active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Project" name="group_site" context="{'group_by': 'site_id'}"/>
                        <filter string="Camera Type" name="group_type" context="{'group_by': 'camera_type'}"/>
                        <filter string="Manufacturer" name="group_manufacturer" context="{'group_by': 'manufacturer'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- CCTV Camera Action -->
        <record id="action_cctv_camera" model="ir.actions.act_window">
            <field name="name">CCTV Cameras</field>
            <field name="res_model">cctv.camera</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_cctv_camera_search"/>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first CCTV camera
                </p>
                <p>
                    Add CCTV cameras to monitor your sites. Configure stream URLs, camera types, and link them to specific sites and checkpoints.
                </p>
            </field>
        </record>

        <!-- CCTV Monitoring Action (for viewing available cameras) -->
        <record id="action_cctv_monitoring" model="ir.actions.act_window">
            <field name="name">CCTV Monitoring</field>
            <field name="res_model">cctv.camera</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_cctv_camera_search"/>
            <field name="context">{'search_default_active': 1, 'search_default_online': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No cameras available
                </p>
                <p>
                    Select a camera from the list and click "Play" to view the live stream.
                </p>
            </field>
        </record>

        <!-- CCTV Monitoring Action View Records -->
        <record id="action_cctv_monitoring_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_cctv_camera_monitoring_kanban"/>
            <field name="act_window_id" ref="action_cctv_monitoring"/>
        </record>

        <record id="action_cctv_monitoring_view_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_cctv_camera_monitoring_list"/>
            <field name="act_window_id" ref="action_cctv_monitoring"/>
        </record>

        <record id="action_cctv_monitoring_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_cctv_camera_form"/>
            <field name="act_window_id" ref="action_cctv_monitoring"/>
        </record>
    </data>
</odoo>
