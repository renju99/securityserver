<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Client Site List View -->
        <record id="view_client_site_list" model="ir.ui.view">
            <field name="name">client.site.list</field>
            <field name="model">client.site</field>
            <field name="arch" type="xml">
                <list string="Client Sites" sample="1">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="client_id"/>
                    <field name="site_type" optional="show"/>
                    <field name="city" optional="hide"/>
                    <field name="is_community" widget="boolean_toggle" optional="show"/>
                    <field name="active_resident_count" optional="hide" string="Residents"/>
                    <field name="guards_required"/>
                    <field name="active_guards"/>
                    <field name="status" widget="badge" 
                           decoration-success="status == 'active'"
                           decoration-muted="status == 'inactive'"/>
                    <field name="total_shifts" optional="hide"/>
                    <field name="total_incidents" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Client Site Form View -->
        <record id="view_client_site_form" model="ir.ui.view">
            <field name="name">client.site.form</field>
            <field name="model">client.site</field>
            <field name="arch" type="xml">
                <form string="Client Site">
                    <header>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_shifts" type="object" class="oe_stat_button" icon="fa-calendar">
                                <field name="total_shifts" widget="statinfo" string="Shifts"/>
                            </button>
                            <button name="action_view_incidents" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                                <field name="total_incidents" widget="statinfo" string="Incidents"/>
                            </button>
                            <button name="action_view_checkpoints" type="object" class="oe_stat_button" icon="fa-map-marker">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Checkpoints</span>
                                </div>
                            </button>
                            <button name="action_view_residents" type="object" class="oe_stat_button" icon="fa-users" invisible="not is_community">
                                <field name="active_resident_count" widget="statinfo" string="Active Residents"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Site Name"/></h1>
                            <label for="code"/>
                            <h3><field name="code" placeholder="Site Code"/></h3>
                        </div>
                        <group>
                            <group string="Client Information">
                                <field name="client_id"/>
                                <field name="manager_id"/>
                                <field name="site_manager"/>
                                <field name="site_phone"/>
                                <field name="site_email"/>
                            </group>
                            <group string="Contract">
                                <field name="contract_start"/>
                                <field name="contract_end"/>
                                <field name="guards_required"/>
                                <field name="armed_required"/>
                            </group>
                        </group>
                        <group string="Site Type">
                            <group>
                                <field name="site_type"/>
                                <field name="is_community" string="Is Community/Residential"/>
                                <field name="resident_count" readonly="1" invisible="not is_community"/>
                                <field name="active_resident_count" readonly="1" invisible="not is_community"/>
                            </group>
                        </group>
                        <group string="Address">
                            <group>
                                <field name="street"/>
                                <field name="street2"/>
                                <field name="city"/>
                            </group>
                            <group>
                                <field name="state_id"/>
                                <field name="zip"/>
                                <field name="country_id"/>
                            </group>
                        </group>
                        <group string="GPS Coordinates">
                            <group>
                                <field name="latitude"/>
                                <field name="longitude"/>
                            </group>
                            <group>
                                <field name="geofence_enabled"/>
                                <field name="geofence_type"/>
                                <field name="geofence_radius" invisible="geofence_type != 'circle'"/>
                                <field name="geofence_polygon" invisible="geofence_type != 'polygon'" widget="text"/>
                                <field name="geofence_map" invisible="1"/>
                                <button name="action_open_geofence_map" type="object" string="Mark Geofence on Map" class="oe_link" icon="fa-map-marker" 
                                        help="Open interactive map to mark geofence boundary"/>
                            </group>
                        </group>
                        <group string="Emergency Contact">
                            <field name="emergency_contact"/>
                            <field name="emergency_phone"/>
                        </group>
                        <notebook>
                            <page string="Instructions">
                                <group>
                                    <field name="access_instructions" widget="text"/>
                                    <field name="parking_instructions" widget="text"/>
                                    <field name="special_instructions" widget="text"/>
                                </group>
                            </page>
                            <page string="Site Map">
                                <field name="site_map" widget="image"/>
                                <field name="site_photos" widget="many2many_binary"/>
                            </page>
                            <page string="Notes">
                                <field name="notes" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Client Site Kanban View -->
        <record id="view_client_site_kanban" model="ir.ui.view">
            <field name="name">client.site.kanban</field>
            <field name="model">client.site</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="client_id"/>
                    <field name="site_type"/>
                    <field name="status"/>
                    <field name="active_guards"/>
                    <field name="guards_required"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click oe_kanban_color_{{record.color.raw_value}}">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="client_id"/> - <field name="code"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="status" widget="badge"/>
                                        <t t-if="record.site_type.raw_value">
                                            <span class="badge badge-secondary ms-1"><field name="site_type"/></span>
                                        </t>
                                    </div>
                                    <div>
                                        Guards: <field name="active_guards"/> / <field name="guards_required"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Client Site Search View -->
        <record id="view_client_site_search" model="ir.ui.view">
            <field name="name">client.site.search</field>
            <field name="model">client.site</field>
            <field name="arch" type="xml">
                <search string="Sites">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="client_id"/>
                    <field name="city"/>
                    <field name="site_type"/>
                    <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                    <filter string="Inactive" name="inactive" domain="[('status', '=', 'inactive')]"/>
                    <separator/>
                    <filter string="Community/Residential Sites" name="community" domain="[('is_community', '=', True)]"/>
                    <filter string="Commercial Sites" name="commercial" domain="[('is_community', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                        <filter name="group_city" string="City" context="{'group_by': 'city'}"/>
                        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                        <filter name="group_site_type" string="Site Type" context="{'group_by': 'site_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Client Site Action -->
        <record id="action_client_site" model="ir.actions.act_window">
            <field name="name">Client Sites</field>
            <field name="res_model">client.site</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first client site
                </p>
                <p>
                    Manage client locations with geofencing and checkpoint tracking.
                </p>
            </field>
        </record>
    </data>
</odoo>

