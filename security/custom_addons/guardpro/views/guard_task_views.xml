<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Guard Task Form View -->
    <record id="view_guard_task_form" model="ir.ui.view">
        <field name="name">guard.task.form</field>
        <field name="model">guard.task</field>
        <field name="arch" type="xml">
            <form string="Guard Task">
                <header>
                    <button name="action_assign" string="Assign" type="object" 
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Task" type="object" 
                            class="oe_highlight"
                            invisible="state != 'assigned'"/>
                    <button name="action_complete" string="Mark Complete" type="object" 
                            class="oe_highlight"
                            invisible="state not in ['assigned', 'in_progress']"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['completed', 'cancelled']"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,assigned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Archive button temporarily disabled due to field validation issues during update -->
                        <!-- <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button> -->
                    </div>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" 
                            invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success" 
                            invisible="state != 'completed'"/>
                    <group>
                        <group>
                            <field name="template_id" options="{'no_create': True}" placeholder="Select a template to auto-fill..."/>
                            <field name="name" placeholder="e.g., Morning Perimeter Check"/>
                            <field name="task_type"/>
                            <field name="site_id" options="{'no_create': True}"/>
                            <field name="assigned_to"/>
                            <field name="shift_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="due_date"/>
                            <field name="completed_date" invisible="state != 'completed'"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="completion_percentage" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter detailed task instructions..."/>
                        </page>
                        <page string="Checklist">
                            <field name="checklist_ids"/>
                            <group>
                                <field name="total_checklist_items"/>
                                <field name="completed_checklist_items"/>
                            </group>
                        </page>
                        <page string="Completion Details" invisible="state != 'completed'">
                            <group>
                                <group>
                                    <field name="completion_notes" placeholder="Add any relevant notes about task completion..."/>
                                    <field name="completed_by"/>
                                </group>
                                <group>
                                    <field name="completion_photo" widget="image" options="{'size': [300, 300]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Audit Trail">
                            <group>
                                <group>
                                    <field name="created_by"/>
                                    <field name="create_date"/>
                                </group>
                                <group>
                                    <field name="write_uid"/>
                                    <field name="write_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Guard Task List View -->
    <record id="view_guard_task_list" model="ir.ui.view">
        <field name="name">guard.task.list</field>
        <field name="model">guard.task</field>
        <field name="arch" type="xml">
            <list string="Guard Tasks" multi_edit="1" sample="1">
                <field name="name"/>
                <field name="task_type"/>
                <field name="site_id"/>
                <field name="assigned_to"/>
                <field name="priority" widget="priority"/>
                <field name="due_date"/>
                <field name="completion_percentage" widget="progressbar"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Guard Task Kanban View -->
    <record id="view_guard_task_kanban" model="ir.ui.view">
        <field name="name">guard.task.kanban</field>
        <field name="model">guard.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="task_type"/>
                <field name="site_id"/>
                <field name="assigned_to"/>
                <field name="priority"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="is_overdue"/>
                <field name="completion_percentage"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="site_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <i class="fa fa-tasks" title="Tasks" aria-label="Tasks"/> <field name="task_type"/>
                                    </div>
                                    <div class="col-6">
                                        <i class="fa fa-user" title="User" aria-label="User"/> <field name="assigned_to"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <field name="completion_percentage" widget="progressbar"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <t t-if="record.is_overdue.raw_value">
                                        <span class="badge text-bg-danger">
                                            <i class="fa fa-clock-o" title="Time" aria-label="Time"/> Overdue
                                        </span>
                                    </t>
                                    <field name="due_date" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Guard Task Calendar View -->
    <record id="view_guard_task_calendar" model="ir.ui.view">
        <field name="name">guard.task.calendar</field>
        <field name="model">guard.task</field>
        <field name="arch" type="xml">
            <calendar string="Tasks" date_start="due_date" color="priority" mode="month">
                <field name="name"/>
                <field name="site_id"/>
                <field name="assigned_to"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Guard Task Search View -->
    <record id="view_guard_task_search" model="ir.ui.view">
        <field name="name">guard.task.search</field>
        <field name="model">guard.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name" string="Task" filter_domain="[('name', 'ilike', self)]"/>
                <field name="site_id"/>
                <field name="assigned_to"/>
                <field name="task_type"/>
                <separator/>
                <filter string="My Tasks" name="my_tasks" 
                        domain="[('assigned_to.user_id', '=', uid)]"/>
                <filter string="Overdue" name="overdue" 
                        domain="[('is_overdue', '=', True)]"/>
                <filter string="Urgent" name="urgent" 
                        domain="[('priority', '=', '3')]"/>
                <separator/>
                <filter string="Draft" name="draft" 
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="assigned" 
                        domain="[('state', '=', 'assigned')]"/>
                <filter string="In Progress" name="in_progress" 
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" 
                        domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="Due Today" name="due_today"
                        domain="[('due_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('due_date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="Due This Week" name="due_this_week"
                        domain="[('due_date', '&gt;=', (context_today() - relativedelta(weeks=1)))]"/>
                <separator/>
                <!-- <filter string="Archived" name="archived" domain="[('active', '=', False)]"/> -->
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Assigned To" name="group_assigned" context="{'group_by': 'assigned_to'}"/>
                    <filter string="Task Type" name="group_type" context="{'group_by': 'task_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Due Date" name="group_due_date" context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Guard Task Pivot View -->
    <record id="view_guard_task_pivot" model="ir.ui.view">
        <field name="name">guard.task.pivot</field>
        <field name="model">guard.task</field>
        <field name="arch" type="xml">
            <pivot string="Task Analysis" sample="1">
                <field name="site_id" type="row"/>
                <field name="state" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Guard Task Graph View -->
    <record id="view_guard_task_graph" model="ir.ui.view">
        <field name="name">guard.task.graph</field>
        <field name="model">guard.task</field>
        <field name="arch" type="xml">
            <graph string="Task Statistics" sample="1">
                <field name="task_type"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Guard Task Action -->
    <record id="action_guard_task" model="ir.actions.act_window">
        <field name="name">Tasks &amp; Post Orders</field>
        <field name="res_model">guard.task</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_my_tasks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first guard task
            </p>
            <p>
                Tasks and post orders help you manage daily duties and ensure
                guards complete their assigned responsibilities.
            </p>
        </field>
    </record>

    <!-- Task Template Form View -->
    <record id="view_guard_task_template_form" model="ir.ui.view">
        <field name="name">guard.task.template.form</field>
        <field name="model">guard.task.template</field>
        <field name="arch" type="xml">
            <form string="Task Template">
                <sheet>
                    <!-- Temporarily commented out due to Odoo 18 view validation
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_task" string="Create Task" type="object" 
                                class="oe_stat_button" icon="fa-plus-square">
                        </button>
                    </div>
                    -->
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="task_type"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <!-- Temporarily commented out due to Odoo 18 view validation
                        <page string="Checklist Template">
                            <field name="checklist_template_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="mandatory"/>
                                </list>
                            </field>
                        </page>
                        -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Template List View -->
    <record id="view_guard_task_template_list" model="ir.ui.view">
        <field name="name">guard.task.template.list</field>
        <field name="model">guard.task.template</field>
        <field name="arch" type="xml">
            <list string="Task Templates">
                <field name="name"/>
                <field name="task_type"/>
                <field name="priority" widget="priority"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Task Template Action -->
    <record id="action_guard_task_template" model="ir.actions.act_window">
        <field name="name">Task Templates</field>
        <field name="res_model">guard.task.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task template
            </p>
            <p>
                Task templates allow you to quickly create recurring tasks
                with pre-defined checklists.
            </p>
        </field>
    </record>

    <!-- Guard Task Checklist Views -->
    <record id="view_guard_task_checklist_tree" model="ir.ui.view">
        <field name="name">guard.task.checklist.tree</field>
        <field name="model">guard.task.checklist</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="mandatory"/>
                <field name="completed" widget="boolean_toggle"/>
                <field name="photo" widget="image" options="{'size': [32, 32]}" string="Evidence"/>
                <field name="completed_date" optional="hide"/>
                <field name="completed_by" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_guard_task_checklist_form" model="ir.ui.view">
        <field name="name">guard.task.checklist.form</field>
        <field name="model">guard.task.checklist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="mandatory"/>
                            <field name="completed"/>
                        </group>
                        <group>
                            <field name="completed_date" readonly="1"/>
                            <field name="completed_by" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Add notes..."/>
                    </group>
                    <group string="Photo Evidence">
                        <field name="photo" widget="image" options="{'size': [400, 400]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

