<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Package Management Form View -->
    <record id="view_package_management_form" model="ir.ui.view">
        <field name="name">package.management.form</field>
        <field name="model">package.management</field>
        <field name="arch" type="xml">
            <form string="Package Management">
                <header>
                    <button name="action_notify_recipient" string="Notify Recipient" type="object"
                            class="oe_highlight"
                            invisible="state != 'received'"/>
                    <button name="action_mark_collected" string="Collect Package" type="object"
                            class="btn-primary"
                            invisible="state not in ['received', 'notified']"/>
                    <button name="action_return_to_sender" string="Return to Sender" type="object"
                            invisible="state == 'collected'"/>
                    <button name="action_report_issue" string="Report Issue" type="object"
                            icon="fa-exclamation-triangle"
                            invisible="incident_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,notified,collected"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Damaged" bg_color="text-bg-warning"
                            invisible="not is_damaged"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="package_type"/>
                            <field name="size"/>
                            <field name="weight"/>
                            <field name="tracking_number"/>
                            <field name="barcode"/>
                            <field name="courier"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                        <group>
                            <field name="site_id" options="{'no_create': True}"/>
                            <field name="building"/>
                            <field name="floor"/>
                            <field name="unit_number"/>
                            <field name="storage_location"/>
                            <field name="received_date"/>
                            <field name="received_by"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recipient Information">
                            <group>
                                <group>
                                    <field name="recipient_name"/>
                                    <field name="recipient_phone"/>
                                    <field name="recipient_email"/>
                                    <field name="recipient_alternate_contact"/>
                                    <field name="requires_signature" widget="boolean_toggle"/>
                                </group>
                                <group>
                                    <field name="notification_sent_date"/>
                                    <field name="expected_pickup_date"/>
                                    <field name="pickup_date"/>
                                    <field name="handed_over_by"/>
                                </group>
                            </group>
                        </page>
                        <page string="Pickup Details" invisible="state != 'collected'">
                            <group>
                                <group>
                                    <field name="id_verified" widget="boolean_toggle"/>
                                    <field name="id_type" invisible="not id_verified"/>
                                    <field name="id_number" invisible="not id_verified"/>
                                </group>
                                <group>
                                    <field name="signature" widget="image" options="{'size': [300, 150]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Package Details">
                            <group>
                                <group>
                                    <field name="sender_name"/>
                                    <field name="sender_contact"/>
                                    <field name="dimensions"/>
                                </group>
                                <group>
                                    <field name="requires_refrigeration" widget="boolean_toggle"/>
                                    <field name="is_perishable" widget="boolean_toggle"/>
                                    <field name="is_fragile" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page string="Photos">
                            <group>
                                <group>
                                    <field name="package_photo" widget="image" options="{'size': [300, 300]}"/>
                                </group>
                                <group>
                                    <field name="label_photo" widget="image" options="{'size': [300, 300]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Damage Report" invisible="not is_damaged">
                            <group>
                                <group>
                                    <field name="is_damaged" widget="boolean_toggle"/>
                                    <field name="damage_notes" placeholder="Describe the damage..."/>
                                </group>
                                <group>
                                    <field name="damage_photo" widget="image" options="{'size': [300, 300]}"/>
                                    <field name="incident_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Additional">
                            <group>
                                <field name="notes" placeholder="Additional notes..."/>
                                <field name="days_in_storage"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Package Management List View -->
    <record id="view_package_management_list" model="ir.ui.view">
        <field name="name">package.management.list</field>
        <field name="model">package.management</field>
        <field name="arch" type="xml">
            <list string="Packages" multi_edit="1" sample="1">
                <header>
                    <button name="action_bulk_notify" string="Bulk Notify Recipients" type="object"
                            class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="package_type"/>
                <field name="recipient_name"/>
                <field name="unit_number"/>
                <field name="site_id"/>
                <field name="received_date"/>
                <field name="courier" optional="hide"/>
                <field name="tracking_number" optional="hide"/>
                <field name="days_in_storage" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'collected'"
                       decoration-info="state == 'notified'"
                       decoration-warning="state == 'received'"
                       decoration-danger="state in ['lost', 'damaged']"/>
            </list>
        </field>
    </record>

    <!-- Package Management Kanban View -->
    <record id="view_package_management_kanban" model="ir.ui.view">
        <field name="name">package.management.kanban</field>
        <field name="model">package.management</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="package_type"/>
                <field name="recipient_name"/>
                <field name="state"/>
                <field name="is_overdue"/>
                <field name="days_in_storage"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                        <t t-if="record.is_overdue.raw_value">
                                            <span class="badge text-bg-danger ms-1">Overdue</span>
                                        </t>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="package_type"/> - <field name="recipient_name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-12">
                                        <i class="fa fa-building"/> Unit: <field name="unit_number"/>
                                    </div>
                                    <div class="col-12">
                                        <i class="fa fa-clock-o" title="Time" aria-label="Time"/> <field name="days_in_storage"/> days in storage
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Package Management Search View -->
    <record id="view_package_management_search" model="ir.ui.view">
        <field name="name">package.management.search</field>
        <field name="model">package.management</field>
        <field name="arch" type="xml">
            <search string="Search Packages">
                <field name="name"/>
                <field name="recipient_name"/>
                <field name="unit_number"/>
                <field name="tracking_number"/>
                <field name="barcode"/>
                <separator/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Damaged" name="damaged" domain="[('is_damaged', '=', True)]"/>
                <separator/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Notified" name="notified" domain="[('state', '=', 'notified')]"/>
                <filter string="Collected" name="collected" domain="[('state', '=', 'collected')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('received_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Package Type" name="group_type" context="{'group_by': 'package_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Received Date" name="group_date" context="{'group_by': 'received_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Package Management Action -->
    <record id="action_package_management" model="ir.actions.act_window">
        <field name="name">Package Management</field>
        <field name="res_model">package.management</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_received': 1, 'search_default_notified': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Log your first package
            </p>
            <p>
                Track packages and deliveries from receipt to pickup, with
                automated notifications to recipients.
            </p>
        </field>
    </record>

</odoo>

