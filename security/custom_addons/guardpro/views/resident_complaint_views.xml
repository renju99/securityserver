<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Resident Complaint List View -->
    <record id="view_resident_complaint_list" model="ir.ui.view">
        <field name="name">resident.complaint.list</field>
        <field name="model">resident.complaint</field>
        <field name="arch" type="xml">
            <list string="Resident Complaints" create="true" edit="true" delete="true">
                <field name="name"/>
                <field name="resident_id"/>
                <field name="subject"/>
                <field name="category"/>
                <field name="priority" widget="badge" decoration-info="priority == 'low'" 
                       decoration-warning="priority == 'normal'" decoration-danger="priority in ('high', 'urgent')"/>
                <field name="status" widget="badge" decoration-info="status == 'draft'" 
                       decoration-warning="status in ('submitted', 'under_review')" 
                       decoration-success="status == 'resolved'" decoration-muted="status == 'closed'"/>
                <field name="submitted_date"/>
                <field name="assigned_to_id"/>
            </list>
        </field>
    </record>

    <!-- Resident Complaint Form View -->
    <record id="view_resident_complaint_form" model="ir.ui.view">
        <field name="name">resident.complaint.form</field>
        <field name="model">resident.complaint</field>
        <field name="arch" type="xml">
            <form string="Resident Complaint">
                <header>
                    <button name="action_submit" type="object" string="Submit Complaint"
                            invisible="status != 'draft'" class="btn-primary"/>
                    <button name="action_under_review" type="object" string="Mark Under Review"
                            invisible="status not in ('submitted')" 
                            groups="guardpro.group_guardpro_supervisor,guardpro.group_guardpro_manager"/>
                    <button name="action_in_progress" type="object" string="Start Working"
                            invisible="status not in ('submitted', 'under_review')" 
                            groups="guardpro.group_guardpro_supervisor,guardpro.group_guardpro_manager"/>
                    <button name="action_resolve" type="object" string="Mark Resolved"
                            invisible="status not in ('in_progress')" class="btn-success"
                            groups="guardpro.group_guardpro_supervisor,guardpro.group_guardpro_manager"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="status not in ('resolved')" 
                            groups="guardpro.group_guardpro_manager"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="status not in ('closed', 'resolved')" 
                            groups="guardpro.group_guardpro_resident_user,guardpro.group_guardpro_manager"/>
                    <field name="status" widget="statusbar" 
                           statusbar_visible="draft,submitted,under_review,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Placeholder for future stat buttons -->
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="subject" placeholder="Brief subject/title of the complaint" 
                                   readonly="status not in ('draft')"/>
                        </h3>
                    </div>
                    
                    <group>
                        <group string="Complaint Information">
                            <field name="resident_id" readonly="status not in ('draft')"/>
                            <field name="site_id"/>
                            <field name="client_id"/>
                            <field name="category" readonly="status not in ('draft')"/>
                            <field name="priority" readonly="status not in ('draft')"/>
                        </group>
                        <group string="Location &amp; Assignment">
                            <field name="building"/>
                            <field name="unit_number"/>
                            <field name="location" placeholder="e.g., Main entrance, Parking lot B"/>
                            <field name="assigned_to_id" 
                                   groups="guardpro.group_guardpro_supervisor,guardpro.group_guardpro_manager"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" widget="html" 
                                   placeholder="Please provide detailed information about your complaint or issue..."
                                   readonly="status not in ('draft')"/>
                        </page>
                        
                        <page string="Management Response" name="response">
                            <group>
                                <field name="management_response" widget="html" 
                                       placeholder="Management will respond here..."
                                       readonly="status in ('draft', 'cancelled')"/>
                            </group>
                        </page>
                        
                        <page string="Resolution" name="resolution" 
                              invisible="status not in ('in_progress', 'resolved', 'closed')">
                            <group>
                                <field name="resolution_notes" widget="html"
                                       groups="guardpro.group_guardpro_supervisor,guardpro.group_guardpro_manager"/>
                                <field name="satisfaction_rating" 
                                       invisible="status not in ('resolved', 'closed')"/>
                            </group>
                        </page>
                        
                        <page string="Timeline" name="timeline">
                            <group>
                                <group>
                                    <field name="submitted_date" readonly="1"/>
                                    <field name="reviewed_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="resolved_date" readonly="1"/>
                                    <field name="closed_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary" 
                                   nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Resident Complaint Search View -->
    <record id="view_resident_complaint_search" model="ir.ui.view">
        <field name="name">resident.complaint.search</field>
        <field name="model">resident.complaint</field>
        <field name="arch" type="xml">
            <search string="Search Complaints">
                <field name="name" string="Reference"/>
                <field name="resident_id"/>
                <field name="subject"/>
                <field name="site_id"/>
                <field name="category"/>
                <filter string="My Complaints" name="my_complaints" 
                        domain="[('resident_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('status', '=', 'submitted')]"/>
                <filter string="Under Review" name="under_review" domain="[('status', '=', 'under_review')]"/>
                <filter string="In Progress" name="in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Resolved" name="resolved" domain="[('status', '=', 'resolved')]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', 'urgent')]"/>
                <filter string="High Priority" name="high" domain="[('priority', '=', 'high')]"/>
                <group expand="0" string="Group By">
                    <filter string="Resident" name="group_resident" context="{'group_by': 'resident_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Assigned To" name="group_assigned" context="{'group_by': 'assigned_to_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Resident Complaint Kanban View -->
    <record id="view_resident_complaint_kanban" model="ir.ui.view">
        <field name="name">resident.complaint.kanban</field>
        <field name="model">resident.complaint</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status">
                <field name="name"/>
                <field name="resident_id"/>
                <field name="subject"/>
                <field name="category"/>
                <field name="priority"/>
                <field name="status"/>
                <field name="submitted_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="subject"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="category"/>
                                    <span class="badge badge-pill" t-att-class="record.priority.raw_value == 'urgent' ? 'badge-danger' : record.priority.raw_value == 'high' ? 'badge-warning' : 'badge-secondary'">
                                        <field name="priority"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="resident_id"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="submitted_date" widget="date"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Resident Complaint Action -->
    <record id="action_resident_complaint" model="ir.actions.act_window">
        <field name="name">Resident Complaints</field>
        <field name="res_model">resident.complaint</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No complaints found
            </p>
            <p>
                Residents can submit complaints and issues through the portal.
            </p>
        </field>
    </record>

    <!-- Menu Item for Resident Complaints - Defined in guardpro_menus.xml -->

</odoo>

