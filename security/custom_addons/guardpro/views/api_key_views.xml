<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- API Key List View -->
    <record id="view_api_key_list" model="ir.ui.view">
        <field name="name">guardpro.api.key.list</field>
        <field name="model">guardpro.api.key</field>
        <field name="arch" type="xml">
            <list string="API Keys" 
                  decoration-muted="not active or is_expired"
                  decoration-danger="is_expired">
                <field name="name"/>
                <field name="key_prefix"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="request_count"/>
                <field name="last_used"/>
                <field name="expiry_date"/>
                <field name="is_expired" widget="boolean"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- API Key Form View -->
    <record id="view_api_key_form" model="ir.ui.view">
        <field name="name">guardpro.api.key.form</field>
        <field name="model">guardpro.api.key</field>
        <field name="arch" type="xml">
            <form string="API Key">
                <header>
                    <button name="regenerate_key" string="Regenerate Key" type="object" 
                            class="btn-warning" confirm="This will invalidate the current key. Continue?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="not is_expired"/>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-secondary" invisible="active or is_expired"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Mobile App Integration"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="expiry_date"/>
                            <field name="is_expired"/>
                            <field name="request_count" readonly="1"/>
                            <field name="last_used" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="API Key">
                        <field name="key" password="True" widget="CopyClipboardChar"/>
                        <field name="key_prefix" readonly="1"/>
                    </group>
                    
                    <group string="Permissions">
                        <field name="scope_read"/>
                        <field name="scope_write"/>
                        <field name="scope_create"/>
                        <field name="scope_delete"/>
                    </group>
                    
                    <group string="Security">
                        <group>
                            <field name="rate_limit"/>
                            <field name="allowed_ips" placeholder="192.168.1.100, 10.0.0.50"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_api_key" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">guardpro.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an API Key
            </p>
            <p>
                API keys allow external systems to integrate with GuardPro via REST API.
            </p>
        </field>
    </record>

    <!-- Menu (now defined in guardpro_menus.xml) -->
