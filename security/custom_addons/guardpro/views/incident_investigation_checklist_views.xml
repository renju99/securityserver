<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========================================== -->
    <!-- INVESTIGATION CHECKLIST ITEM VIEWS -->
    <!-- ========================================== -->
    
    <!-- Checklist Item List View -->
    <record id="view_investigation_checklist_item_list" model="ir.ui.view">
        <field name="name">incident.investigation.checklist.item.list</field>
        <field name="model">incident.investigation.checklist.item</field>
        <field name="arch" type="xml">
            <list string="Checklist Items" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_id"/>
                <field name="category"/>
                <field name="is_mandatory"/>
                <field name="icon"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Checklist Item Form View -->
    <record id="view_investigation_checklist_item_form" model="ir.ui.view">
        <field name="name">incident.investigation.checklist.item.form</field>
        <field name="model">incident.investigation.checklist.item</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="icon" invisible="1"/>
                            <i t-att-class="'fa ' + icon" style="margin-right: 10px;"/>
                            <field name="name" placeholder="Checklist item name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="sequence"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="is_mandatory"/>
                            <field name="icon"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Detailed description of what needs to be done..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Checklist Item Search View -->
    <record id="view_investigation_checklist_item_search" model="ir.ui.view">
        <field name="name">incident.investigation.checklist.item.search</field>
        <field name="model">incident.investigation.checklist.item</field>
        <field name="arch" type="xml">
            <search string="Checklist Items">
                <field name="name"/>
                <field name="template_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Mandatory" name="mandatory" domain="[('is_mandatory', '=', True)]"/>
                <separator/>
                <filter string="Initial Response" name="initial" domain="[('category', '=', 'initial')]"/>
                <filter string="Evidence Collection" name="evidence" domain="[('category', '=', 'evidence')]"/>
                <filter string="Witness Interviews" name="witness" domain="[('category', '=', 'witness')]"/>
                <filter string="Analysis" name="analysis" domain="[('category', '=', 'analysis')]"/>
                <filter string="Documentation" name="documentation" domain="[('category', '=', 'documentation')]"/>
                <filter string="Follow-up" name="followup" domain="[('category', '=', 'followup')]"/>
                <group expand="0" string="Group By">
                    <filter string="Template" name="group_template" context="{'group_by': 'template_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Checklist Item Action -->
    <record id="action_investigation_checklist_item" model="ir.actions.act_window">
        <field name="name">Checklist Items</field>
        <field name="res_model">incident.investigation.checklist.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first checklist item
            </p>
            <p>
                Checklist items define the steps that investigators should follow for each template.
            </p>
        </field>
    </record>
    
    <!-- ========================================== -->
    <!-- INVESTIGATION CHECKLIST VIEWS -->
    <!-- ========================================== -->
    
    <!-- Checklist List View -->
    <record id="view_investigation_checklist_list" model="ir.ui.view">
        <field name="name">incident.investigation.checklist.list</field>
        <field name="model">incident.investigation.checklist</field>
        <field name="arch" type="xml">
            <list string="Investigation Checklist" editable="bottom" decoration-success="completed" decoration-muted="completed">
                <field name="sequence" widget="handle"/>
                <field name="icon" invisible="1"/>
                <field name="name"/>
                <field name="category" optional="show"/>
                <field name="is_mandatory" optional="show"/>
                <field name="completed" widget="boolean_toggle"/>
                <field name="completed_by" optional="hide" readonly="1"/>
                <field name="completed_date" optional="hide" readonly="1"/>
                <field name="attachment_count" optional="hide"/>
                <field name="photo_count" string="Photos" optional="show"/>
                <field name="notes" optional="hide"/>
                <button name="action_open_item" type="object" string="" icon="fa-camera" 
                        title="Add Photos/Notes" class="btn-info"/>
                <button name="action_toggle_complete" type="object" string="Toggle" icon="fa-check-square" invisible="completed"/>
                <button name="action_toggle_complete" type="object" string="Undo" icon="fa-undo" invisible="not completed"/>
            </list>
        </field>
    </record>
    
    <!-- Checklist Form View -->
    <record id="view_investigation_checklist_form" model="ir.ui.view">
        <field name="name">incident.investigation.checklist.form</field>
        <field name="model">incident.investigation.checklist</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <header>
                    <button name="action_mark_complete" string="Mark Complete" type="object" 
                            invisible="completed" class="btn-primary"/>
                    <button name="action_mark_incomplete" string="Mark Incomplete" type="object" 
                            invisible="not completed" class="btn-secondary"/>
                    <field name="completed" widget="statusbar" statusbar_visible="False,True"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(base.action_attachment)d" type="action" class="oe_stat_button" icon="fa-paperclip"
                                context="{'default_res_model': 'incident.investigation.checklist', 'default_res_id': id}">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="icon" invisible="1"/>
                            <i t-att-class="'fa ' + icon" style="margin-right: 10px;"/>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="investigation_id" readonly="1"/>
                            <field name="category" readonly="1"/>
                            <field name="is_mandatory" readonly="1"/>
                        </group>
                        <group>
                            <field name="completed_by" readonly="1"/>
                            <field name="completed_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" readonly="1"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Add notes or comments about this checklist item..."/>
                    </group>
                    <group string="Photos &amp; Evidence">
                        <field name="photo_ids" widget="many2many_binary" string="Evidence Photos" 
                               options="{'accepted_file_extensions': 'image/*'}"/>
                        <field name="attachment_ids" widget="many2many_binary" string="Documents"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Checklist Kanban View -->
    <record id="view_investigation_checklist_kanban" model="ir.ui.view">
        <field name="name">incident.investigation.checklist.kanban</field>
        <field name="model">incident.investigation.checklist</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="category">
                <field name="icon"/>
                <field name="completed"/>
                <field name="is_mandatory"/>
                <field name="attachment_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <i t-att-class="'fa ' + record.icon.raw_value" style="margin-right: 8px;"/>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span t-if="record.is_mandatory.raw_value" class="badge rounded-pill text-bg-danger">Mandatory</span>
                                <span t-if="record.completed.raw_value" class="badge rounded-pill text-bg-success">
                                    <i class="fa fa-check"/> Completed
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="description"/>
                                <div class="row mt-2" t-if="record.attachment_count.raw_value > 0">
                                    <div class="col-12">
                                        <i class="fa fa-paperclip"/> <field name="attachment_count"/> attachment(s)
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="completed_date" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="completed_by" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Checklist Search View -->
    <record id="view_investigation_checklist_search" model="ir.ui.view">
        <field name="name">incident.investigation.checklist.search</field>
        <field name="model">incident.investigation.checklist</field>
        <field name="arch" type="xml">
            <search string="Investigation Checklist">
                <field name="name"/>
                <field name="investigation_id"/>
                <filter string="Incomplete" name="incomplete" domain="[('completed', '=', False)]"/>
                <filter string="Completed" name="completed" domain="[('completed', '=', True)]"/>
                <separator/>
                <filter string="Mandatory" name="mandatory" domain="[('is_mandatory', '=', True)]"/>
                <separator/>
                <filter string="Initial Response" name="initial" domain="[('category', '=', 'initial')]"/>
                <filter string="Evidence Collection" name="evidence" domain="[('category', '=', 'evidence')]"/>
                <filter string="Witness Interviews" name="witness" domain="[('category', '=', 'witness')]"/>
                <filter string="Analysis" name="analysis" domain="[('category', '=', 'analysis')]"/>
                <filter string="Documentation" name="documentation" domain="[('category', '=', 'documentation')]"/>
                <filter string="Follow-up" name="followup" domain="[('category', '=', 'followup')]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'completed'}"/>
                    <filter string="Investigation" name="group_investigation" context="{'group_by': 'investigation_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Checklist Action -->
    <record id="action_investigation_checklist" model="ir.actions.act_window">
        <field name="name">Investigation Checklist</field>
        <field name="res_model">incident.investigation.checklist</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_incomplete': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No checklist items found
            </p>
            <p>
                Checklist items are automatically generated from investigation templates.
            </p>
        </field>
    </record>
    
    <!-- ========================================== -->
    <!-- INVESTIGATION TEMPLATE VIEWS ENHANCEMENT -->
    <!-- ========================================== -->
    
    <!-- Enhanced Template Form View -->
    <record id="view_investigation_template_form" model="ir.ui.view">
        <field name="name">incident.investigation.template.form</field>
        <field name="model">incident.investigation.template</field>
        <field name="arch" type="xml">
            <form string="Investigation Template">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_investigations" type="object" class="oe_stat_button" icon="fa-search">
                            <field name="usage_count" widget="statinfo" string="Used"/>
                        </button>
                        <button name="%(action_investigation_checklist)d" type="action" class="oe_stat_button" icon="fa-check-square"
                                context="{'search_default_template_id': id}">
                            <field name="checklist_item_count" widget="statinfo" string="Checklist Items"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="icon" invisible="1"/>
                            <i t-att-class="'fa ' + icon" style="margin-right: 10px;"/>
                            <field name="name" placeholder="Template Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="investigation_type"/>
                            <field name="icon"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe when to use this template..."/>
                    </group>
                    <notebook>
                        <page string="Checklist Items" name="checklist">
                            <field name="checklist_item_ids">
                                <list string="Checklist Items" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="is_mandatory"/>
                                    <field name="icon"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Report Templates" name="templates">
                            <group>
                                <field name="executive_summary_template" widget="html"/>
                            </group>
                            <group>
                                <field name="findings_template" widget="html"/>
                            </group>
                            <group>
                                <field name="root_cause_template" widget="html"/>
                            </group>
                            <group>
                                <field name="recommendations_template" widget="html"/>
                            </group>
                            <group>
                                <field name="corrective_actions_template" widget="html"/>
                            </group>
                            <group>
                                <field name="preventive_actions_template" widget="html"/>
                            </group>
                        </page>
                        <page string="Report Structure" name="structure">
                            <group>
                                <group string="Include in Report">
                                    <field name="include_timeline"/>
                                    <field name="include_evidence_list"/>
                                    <field name="include_witness_statements"/>
                                    <field name="include_findings_detail"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this template..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Template List View -->
    <record id="view_investigation_template_list" model="ir.ui.view">
        <field name="name">incident.investigation.template.list</field>
        <field name="model">incident.investigation.template</field>
        <field name="arch" type="xml">
            <list string="Investigation Templates" sample="1">
                <field name="icon" invisible="1"/>
                <field name="name"/>
                <field name="investigation_type"/>
                <field name="checklist_item_count"/>
                <field name="usage_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Template Kanban View -->
    <record id="view_investigation_template_kanban" model="ir.ui.view">
        <field name="name">incident.investigation.template.kanban</field>
        <field name="model">incident.investigation.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="color"/>
                <field name="icon"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('incident.investigation.template', 'image', record.id.raw_value)" 
                                     alt="Template" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <i t-att-class="'fa ' + record.icon.raw_value" style="margin-right: 8px;"/>
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="investigation_type"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="description"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge rounded-pill text-bg-primary">
                                            <i class="fa fa-check-square"/> <field name="checklist_item_count"/> items
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge rounded-pill text-bg-info">
                                            <i class="fa fa-search"/> Used <field name="usage_count"/> times
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Template Search View -->
    <record id="view_investigation_template_search" model="ir.ui.view">
        <field name="name">incident.investigation.template.search</field>
        <field name="model">incident.investigation.template</field>
        <field name="arch" type="xml">
            <search string="Investigation Templates">
                <field name="name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Routine" name="routine" domain="[('investigation_type', '=', 'routine')]"/>
                <filter string="Detailed" name="detailed" domain="[('investigation_type', '=', 'detailed')]"/>
                <filter string="Formal" name="formal" domain="[('investigation_type', '=', 'formal')]"/>
                <filter string="Root Cause" name="root_cause" domain="[('investigation_type', '=', 'root_cause')]"/>
                <filter string="Compliance" name="compliance" domain="[('investigation_type', '=', 'compliance')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'investigation_type'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Template Action -->
    <record id="action_investigation_template" model="ir.actions.act_window">
        <field name="name">Investigation Templates</field>
        <field name="res_model">incident.investigation.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first investigation template
            </p>
            <p>
                Investigation templates provide structured checklists and report formats for different types of incidents.
            </p>
        </field>
    </record>
    
</odoo>
