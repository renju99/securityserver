<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Documentation Page Template - Odoo Documentation Style -->
    <template id="documentation_page" name="GuardLink Documentation">
        <t t-call="web.layout">
            <t t-set="head">
                <!-- Cache-bust so browsers pick up CSS/JS after upgrades -->
                <link rel="stylesheet" href="/guardpro/static/src/css/documentation.css?v=20260323e"/>
                <script src="/guardpro/static/src/js/documentation.js?v=20260323e"></script>
            </t>
            
            <div class="odoo-docs-header">
                <div class="odoo-docs-container">
                    <div class="d-flex align-items-start justify-content-between flex-wrap">
                        <div>
                            <div class="odoo-docs-kicker">GuardLink · Product guide</div>
                            <h1 class="mb-2">
                                <i class="fa fa-book mr-2" style="color: #017e84;"></i>
                                Documentation
                            </h1>
                            <p class="mb-0 lead">Chapters, step-by-step flows, and reference material for security operations on Odoo 18.</p>
                            <div class="mt-3">
                                <span class="badge badge-light mr-2">
                                    <i class="fa fa-code"></i> v18.0.1.1.18
                                </span>
                                <span class="badge badge-light mr-2">
                                    <i class="fa fa-calendar"></i> Mar 2026
                                </span>
                            </div>
                        </div>
                        <div class="text-right d-none d-md-block pt-1">
                            <small class="text-muted" style="color: #5e6c84 !important;">Patrols · Incidents · Compliance · Portal</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="odoo-docs-guide-wrap guardlink-docs-guide">
            <div class="odoo-docs-container">
                <div class="odoo-docs-layout">
                    <!-- Sidebar Navigation -->
                    <nav class="odoo-docs-sidebar">
                        <h3>Documentation</h3>
                        
                        <div class="odoo-docs-search">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="fa fa-search" style="color: #017e84;"></i>
                                    </span>
                                </div>
                                <input type="text"
                                       class="form-control"
                                       placeholder="Search documentation, features, guides..."
                                       id="docSearchInput"
                                       autocomplete="off"/>
                                <div class="input-group-append">
                                    <button class="btn btn-primary"
                                            type="button"
                                            id="docSearchBtn">
                                        <i class="fa fa-search mr-1"></i>Search
                                    </button>
                                </div>
                            </div>
                            <div id="searchResults" class="search-results fade-in"></div>
                            <div class="mt-2 text-muted small">
                                <i class="fa fa-lightbulb-o"></i>
                                Try searching for: "mobile app", "incident reporting", "shift management", "GPS tracking"
                            </div>
                        </div>
                        
                        <t t-foreach="doc_structure" t-as="section_key" t-key="section_key">
                            <t t-set="section_data" t-value="doc_structure[section_key]"/>
                            <div class="section">
                                <div class="section-title" t-esc="section_data.get('title')"/>
                                <div class="section-description" t-esc="section_data.get('description')"/>
                                <ul>
                                    <t t-foreach="section_data.get('sections', [])" t-as="doc" t-key="doc.get('file')">
                                        <li>
                                            <a t-att-class="'nav-link' + (' active' if doc.get('file') == current_file else '')"
                                               t-attf-href="/guardpro/documentation/#{doc.get('file')}">
                                                <t t-esc="doc.get('title')"/>
                                            </a>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </t>
                    </nav>
                    
                    <!-- Main Content -->
                    <main class="odoo-docs-content">
                        <!-- Breadcrumb -->
                        <nav class="odoo-docs-breadcrumb">
                            <i class="fa fa-home mr-1"></i>
                            <a href="/guardpro/documentation">Documentation</a>
                            <span class="separator">›</span>
                            <span t-if="current_page_info">
                                <t t-esc="doc_structure.get(current_section, {}).get('title', '')"/>
                            </span>
                            <span class="separator" t-if="current_page_info">›</span>
                            <span t-if="current_page_info" t-esc="current_page_info.get('title', '')"/>
                        </nav>

                        <!-- Loading Indicator -->
                        <div id="pageLoading" class="text-center py-5" style="display: none;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Loading documentation...</span>
                            </div>
                            <p class="mt-3 text-muted">Loading documentation...</p>
                        </div>
                        
                        <!-- Page Title -->
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="odoo-docs-page-kicker" t-if="current_page_info">Guide</div>
                                <div class="odoo-docs-page-kicker" t-if="not current_page_info">Start here</div>
                                <h1 class="odoo-docs-title" t-if="current_page_info" t-esc="current_page_info.get('title', '')"/>
                                <h1 class="odoo-docs-title" t-if="not current_page_info">
                                    Welcome to the GuardLink guide
                                </h1>

                                <!-- Page Description -->
                                <p class="odoo-docs-description" t-if="current_page_info" t-esc="current_page_info.get('description', '')"/>
                                <p class="odoo-docs-description" t-if="not current_page_info">
                                    Pick a chapter in the sidebar or search. Each page is written so you can follow it top to bottom, like a product guide.
                                </p>
                            </div>

                            <!-- Quick Actions -->
                            <div class="d-none d-md-flex flex-column gap-2">
                                <a href="/web#action=guardpro.action_guardpro_analytics_dashboard_client" class="btn btn-outline-primary btn-sm">
                                    <i class="fa fa-tachometer mr-1"></i> Open GuardLink
                                </a>
                                <button type="button" onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa fa-print mr-1"></i> Print Page
                                </button>
                                <a href="mailto:support@guardlink.app" class="btn btn-outline-info btn-sm">
                                    <i class="fa fa-envelope mr-1"></i> Get Support
                                </a>
                            </div>
                        </div>
                        
                        <!-- Content (documentation-body: shared styles in documentation.css) -->
                        <div class="odoo-docs-body documentation-body guide-prose">
                            <t t-out="content"/>
                        </div>
                        
                        <!-- Footer -->
                        <footer class="odoo-docs-footer text-left">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="text-secondary mb-2 font-weight-bold">
                                        <i class="fa fa-info-circle mr-2"></i>GuardLink documentation
                                    </h6>
                                    <p class="mb-2 text-muted small">
                                        <strong>Version:</strong> 18.0.1.1.18
                                    </p>
                                    <p class="mb-0 text-muted small">
                                        <strong>Last updated:</strong> March 2026
                                    </p>
                                </div>
                                <div class="col-md-6 text-md-right">
                                    <h6 class="text-secondary mb-2 font-weight-bold">Quick links</h6>
                                    <div class="mb-2">
                                        <a href="/guardpro/documentation/GETTING_STARTED.md" class="text-primary mr-3 small">
                                            <i class="fa fa-play-circle mr-1"></i> Chapter 1
                                        </a>
                                        <a href="/guardpro/documentation/QUICK_REFERENCE.md" class="text-primary mr-3 small">
                                            <i class="fa fa-bolt mr-1"></i> Quick reference
                                        </a>
                                        <a href="/guardpro/documentation/INDEX.md" class="text-primary small">
                                            <i class="fa fa-list mr-1"></i> Hub
                                        </a>
                                    </div>
                                    <div>
                                        <a href="mailto:support@guardlink.app" class="text-muted mr-3 small">
                                            <i class="fa fa-envelope mr-1"></i> support@guardlink.app
                                        </a>
                                        <a href="https://guardlink.app/" target="_blank" rel="noopener noreferrer" class="text-muted small">
                                            <i class="fa fa-globe mr-1"></i> Website
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <hr class="my-3" style="border-color: #dfe1e6;" />
                            <div class="text-center">
                                <small class="text-muted">
                                    © 2026 GuardLink · Security operations for Odoo
                                </small>
                            </div>
                        </footer>
                    </main>
                </div>
            </div>
            </div>
            
            <!-- Back to GuardLink Button -->
            <a href="/web#action=guardpro.action_guardpro_analytics_dashboard_client" class="back-to-guardpro" title="Back to GuardLink Dashboard">
                <i class="fa fa-tachometer"></i>
                <span class="d-none d-md-inline ml-2">Dashboard</span>
            </a>

            <!-- Scroll to Top Button -->
            <button id="scrollToTop" class="back-to-guardpro" style="bottom: 120px; right: 2rem; background: #6c757d;" title="Scroll to Top" onclick="window.scrollTo({top: 0, behavior: 'smooth'});">
                <i class="fa fa-arrow-up"></i>
            </button>
        </t>
    </template>
    
    <!-- Client Action to open documentation in new tab -->
    <record id="action_guardpro_documentation" model="ir.actions.act_url">
        <field name="name">GuardLink Documentation</field>
        <field name="url">/guardpro/documentation</field>
        <field name="target">new</field>
    </record>
    
</odoo>