<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_guard_site_list" model="ir.ui.view">
            <field name="name">guard.site.list</field>
            <field name="model">guard.site</field>
            <field name="arch" type="xml">
                <list string="Sites" sample="1">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="client_id" optional="show"/>
                    <field name="city" optional="show"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'active'"
                           decoration-muted="status == 'inactive'"/>
                    <field name="active" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_guard_site_form" model="ir.ui.view">
            <field name="name">guard.site.form</field>
            <field name="model">guard.site</field>
            <field name="arch" type="xml">
                <form string="Site">
                    <header>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Site Name"/></h1>
                            <label for="code"/>
                            <h3><field name="code" placeholder="Site Code"/></h3>
                        </div>
                        <group>
                            <group string="Project">
                                <field name="project_id"/>
                                <field name="client_id"/>
                                <field name="active"/>
                            </group>
                            <group string="GPS (optional)">
                                <field name="latitude"/>
                                <field name="longitude"/>
                            </group>
                        </group>
                        <group string="Address">
                            <group>
                                <field name="street"/>
                                <field name="street2"/>
                                <field name="city"/>
                            </group>
                            <group>
                                <field name="state_id"/>
                                <field name="zip"/>
                                <field name="country_id"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1" placeholder="Site notes..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_guard_site_search" model="ir.ui.view">
            <field name="name">guard.site.search</field>
            <field name="model">guard.site</field>
            <field name="arch" type="xml">
                <search string="Sites">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="project_id"/>
                    <field name="client_id"/>
                    <field name="city"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                        <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_guard_site" model="ir.actions.act_window">
            <field name="name">Sites</field>
            <field name="res_model">guard.site</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first site
                </p>
                <p>
                    Sites belong under a Project (for example NSHAMA).
                    Add zones, buildings, floors and areas after the site is created.
                </p>
            </field>
        </record>
    </data>
</odoo>
