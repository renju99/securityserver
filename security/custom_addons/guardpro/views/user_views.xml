<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Users list: show assigned projects/sites -->
        <record id="res_users_tree_view_guardpro" model="ir.ui.view">
            <field name="name">res.users.list.guardpro.sites</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='login']" position="after">
                    <field name="site_ids"
                           string="Assigned Sites"
                           widget="many2many_tags"
                           optional="show"
                           options="{'no_create': True}"
                           readonly="1"/>
                </xpath>
            </field>
        </record>

        <!-- Extend User Form to Add Assigned Projects, Sites and Zones -->
        <record id="res_users_form_view_guardpro" model="ir.ui.view">
            <field name="name">res.users.form.guardpro</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']" position="inside">
                    <group string="Guard Pro Project &amp; Site Access">
                        <div class="alert alert-info mb-3" role="status">
                            <p><strong>How to Configure User Access:</strong></p>
                            <ol class="mb-2">
                                <li>
                                    <strong>User Type:</strong>
                                    <ul>
                                        <li><strong>Guard Users:</strong> Set to "Portal" (guards access mobile portal)</li>
                                        <li><strong>All Other Users:</strong> Set to "Internal User" (Client User, Supervisor, Manager, Administrator)</li>
                                    </ul>
                                </li>
                                <li>
                                    <strong>Guard Pro Group:</strong> Assign the appropriate group (Guard User, Client User, Supervisor, Manager, or Administrator).
                                </li>
                                <li><strong>Step 1 — Projects:</strong> Select which projects this user can access (e.g. NSHAMA).</li>
                                <li><strong>Step 2 — Sites (optional):</strong> Leave empty to grant <em>all sites</em> under the assigned project(s). If you select specific sites, the user only sees those sites for that project.</li>
                                <li><strong>Step 3 — Zones (optional):</strong> Further limit incidents, tours, checkpoints, and related data to selected zones.</li>
                                <li>Save the user. Administrators see all projects and sites regardless of assignments.</li>
                            </ol>
                        </div>
                        <field name="site_ids"
                               widget="many2many_tags"
                               placeholder="Select projects this user can access..."
                               options="{'no_create': True}"/>
                        <field name="guard_site_ids"
                               widget="many2many_tags"
                               placeholder="Optional — leave empty for all sites under the project(s)..."
                               domain="[('project_id', 'in', site_ids)]"
                               invisible="not site_ids"
                               options="{'no_create': True}"/>
                        <field name="zone_ids"
                               widget="many2many_tags"
                               placeholder="Select zones (optional — limits access to zone-specific data)..."
                               domain="[('site_id', 'in', site_ids)]"
                               invisible="not site_ids"
                               options="{'no_create': True}"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='login']" position="after">
                    <field name="guard_badge_number" readonly="1"
                           invisible="not guard_badge_number"/>
                </xpath>
            </field>
        </record>

        <!-- Dedicated list for Guard Portal Users: show badge next to name -->
        <record id="view_guard_portal_users_list" model="ir.ui.view">
            <field name="name">res.users.guard.portal.list</field>
            <field name="model">res.users</field>
            <field name="priority" eval="16"/>
            <field name="arch" type="xml">
                <list string="Guard Portal Users" create="0" delete="0">
                    <field name="name"/>
                    <field name="guard_badge_number" string="Badge"/>
                    <field name="login"/>
                    <field name="site_ids"
                           string="Assigned Sites"
                           widget="many2many_tags"
                           optional="show"
                           options="{'no_create': True}"/>
                    <field name="lang" optional="show"/>
                    <field name="create_date" string="Created On"/>
                    <field name="login_date" string="Latest authentication"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'new'"
                           decoration-success="state == 'active'"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_guard_portal_users_search" model="ir.ui.view">
            <field name="name">res.users.guard.portal.search</field>
            <field name="model">res.users</field>
            <field name="priority" eval="16"/>
            <field name="arch" type="xml">
                <search string="Guard Portal Users">
                    <field name="name"/>
                    <field name="login"/>
                    <field name="guard_badge_number" string="Badge"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter name="has_badge" string="Has Badge"
                           domain="[('guard_badge_number', '!=', False)]"/>
                </search>
            </field>
        </record>

    </data>
</odoo>
