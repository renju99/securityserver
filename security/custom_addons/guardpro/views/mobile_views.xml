<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mobile-Optimized Kanban View for Shifts -->
    <record id="view_guard_shift_kanban_mobile" model="ir.ui.view">
        <field name="name">guard.shift.kanban.mobile</field>
        <field name="model">guard.shift</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_mobile">
                <field name="name"/>
                <field name="guard_id"/>
                <field name="site_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="status"/>
                <field name="shift_type"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="site_id"/>
                                </strong>
                                <span class="float-end">
                                    <span t-if="record.status.raw_value == 'completed'" class="badge bg-success">Completed</span>
                                    <span t-elif="record.status.raw_value == 'in_progress'" class="badge bg-primary">In Progress</span>
                                    <span t-else="" class="badge bg-secondary"><field name="status"/></span>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted">
                                    <i class="fa fa-clock me-1" title="Time"/>
                                    <field name="start_datetime" widget="datetime"/>
                                    <br/>
                                    to <field name="end_datetime" widget="datetime"/>
                                </div>
                                <div class="mt-2">
                                    <span t-if="record.shift_type.raw_value == 'overtime'" class="badge bg-warning text-dark">Overtime</span>
                                    <span t-elif="record.shift_type.raw_value == 'holiday'" class="badge bg-info">Holiday</span>
                                    <span t-elif="record.shift_type.raw_value == 'emergency'" class="badge bg-danger">Emergency</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Mobile-Optimized Kanban View for Tasks -->
    <record id="view_guard_task_kanban_mobile" model="ir.ui.view">
        <field name="name">guard.task.kanban.mobile</field>
        <field name="model">guard.task</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="site_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="due_date"/>
                <field name="task_type"/>
                <field name="completion_percentage"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <span class="float-end">
                                    <span t-if="record.priority.raw_value == '3'" class="badge bg-danger">Urgent</span>
                                    <span t-elif="record.priority.raw_value == '2'" class="badge bg-warning text-dark">High</span>
                                    <span t-elif="record.priority.raw_value == '1'" class="badge bg-info">Normal</span>
                                    <span t-else="" class="badge bg-secondary">Low</span>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted">
                                    <i class="fa fa-map-marker-alt me-1" title="Location"/>
                                    <field name="site_id"/>
                                </div>
                                <div class="mt-1" t-if="record.due_date.raw_value">
                                    <i class="fa fa-calendar me-1" title="Due Date"/>
                                    Due: <field name="due_date" widget="datetime"/>
                                </div>
                                <div class="mt-2">
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar" role="progressbar" 
                                             t-attf-style="width: {{record.completion_percentage.raw_value}}%"
                                             t-att-aria-valuenow="record.completion_percentage.raw_value"
                                             aria-valuemin="0" aria-valuemax="100"/>
                                    </div>
                                    <small class="text-muted"><field name="completion_percentage"/>% complete</small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Mobile-Optimized Kanban View for Incidents -->
    <record id="view_incident_kanban_mobile" model="ir.ui.view">
        <field name="name">incident.report.kanban.mobile</field>
        <field name="model">incident.report</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_mobile">
                <field name="title"/>
                <field name="category_id"/>
                <field name="severity"/>
                <field name="status"/>
                <field name="incident_datetime"/>
                <field name="guard_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="title"/>
                                </strong>
                                <span class="float-end">
                                    <span t-if="record.severity.raw_value == 'critical'" class="badge bg-danger">Critical</span>
                                    <span t-elif="record.severity.raw_value == 'high'" class="badge bg-warning text-dark">High</span>
                                    <span t-elif="record.severity.raw_value == 'medium'" class="badge bg-info">Medium</span>
                                    <span t-else="" class="badge bg-secondary">Low</span>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted">
                                    <i class="fa fa-clock me-1" title="Time"/>
                                    <field name="incident_datetime" widget="datetime"/>
                                </div>
                                <div class="mt-1">
                                    <i class="fa fa-tag me-1" title="Category"/>
                                    <field name="category_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Mobile-Optimized Form View for Tasks -->
    <record id="view_guard_task_form_mobile" model="ir.ui.view">
        <field name="name">guard.task.form.mobile</field>
        <field name="model">guard.task</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <button name="action_start" string="Start Task" type="object" 
                            class="btn-primary" invisible="state not in ['draft', 'assigned']"/>
                    <button name="action_complete" string="Complete Task" type="object" 
                            class="btn-success" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Task Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="task_type"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="assigned_to"/>
                            <field name="shift_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" widget="html"/>
                    </group>
                    <notebook>
                        <page string="Checklist" name="checklist">
                            <field name="checklist_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="completed" widget="boolean_toggle"/>
                                    <field name="mandatory"/>
                                </list>
                            </field>
                            <div class="mt-3">
                                <field name="completion_percentage" widget="progressbar"/>
                            </div>
                        </page>
                        <page string="Completion" name="completion" invisible="state not in ['completed']">
                            <group>
                                <field name="completed_date"/>
                                <field name="completion_notes"/>
                                <field name="completion_photo" widget="image"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Mobile-Optimized Form View for Incidents -->
    <record id="view_incident_form_mobile" model="ir.ui.view">
        <field name="name">incident.report.form.mobile</field>
        <field name="model">incident.report</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Incident">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Incident Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="severity" widget="priority"/>
                            <field name="incident_datetime"/>
                        </group>
                        <group>
                            <field name="guard_id"/>
                            <field name="site_id"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" widget="html"/>
                    </group>
                    <group string="Photos">
                        <field name="photo_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Mobile Actions -->
    <record id="action_guard_shift_mobile" model="ir.actions.act_window">
        <field name="name">My Shifts</field>
        <field name="res_model">guard.shift</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('guard_id.user_id', '=', uid)]</field>
        <field name="context">{'default_guard_id': uid}</field>
        <field name="view_id" ref="view_guard_shift_kanban_mobile"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No shifts assigned yet
            </p>
        </field>
    </record>

    <record id="action_guard_task_mobile" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">guard.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('assigned_to.user_id', '=', uid)]</field>
        <field name="context">{'default_assigned_to': uid}</field>
        <field name="view_id" ref="view_guard_task_kanban_mobile"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks assigned yet
            </p>
        </field>
    </record>

    <record id="action_incident_mobile" model="ir.actions.act_window">
        <field name="name">My Incidents</field>
        <field name="res_model">incident.report</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('guard_id.user_id', '=', uid)]</field>
        <field name="context">{'default_guard_id': uid}</field>
        <field name="view_id" ref="view_incident_kanban_mobile"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No incidents reported yet
            </p>
        </field>
    </record>
</odoo>

