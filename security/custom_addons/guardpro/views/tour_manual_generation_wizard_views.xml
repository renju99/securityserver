<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Manual Tour Generation Wizard Form View -->
        <record id="view_tour_manual_generation_wizard_form" model="ir.ui.view">
            <field name="name">tour.manual.generation.wizard.form</field>
            <field name="model">tour.manual.generation.wizard</field>
            <field name="arch" type="xml">
                <form string="Manual Tour Generation">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="tour_name" readonly="1"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="tour_id" invisible="1"/>
                                <field name="site_id" invisible="1"/>
                                <field name="tour_code" readonly="1"/>
                                <field name="estimated_duration" widget="float_time" readonly="1"/>
                                <field name="total_checkpoints" readonly="1"/>
                            </group>
                            <group>
                                <field name="guard_id" required="1"/>
                                <field name="start_time" required="1"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="notes" placeholder="Enter any additional notes for this manual tour generation..."/>
                        </group>
                    </sheet>
                    
                    <footer>
                        <button name="action_generate_tour" string="Generate Tour" type="object" 
                                class="btn-primary" icon="fa-play"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Manual Tour Generation Wizard Action -->
        <record id="action_tour_manual_generation_wizard" model="ir.actions.act_window">
            <field name="name">Manual Tour Generation</field>
            <field name="res_model">tour.manual.generation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
