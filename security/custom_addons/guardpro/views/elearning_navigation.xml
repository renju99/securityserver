<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Add "Back to Mobile Dashboard" navigation for Guards in eLearning -->
        
        <!-- Add Mobile Dashboard link in website header for guards -->
        <template id="portal_my_home_guard_mobile_link" inherit_id="portal.portal_my_home" name="Guard Mobile Dashboard Link in Portal">
            <xpath expr="//div[@id='o_portal_sidebar']" position="inside">
                <t t-if="request.env.user.has_group('guardpro.group_guardpro_guard_portal')">
                    <div class="list-group mb-3">
                        <a href="/guardpro/mobile" class="list-group-item list-group-item-action d-flex align-items-center">
                            <i class="fa fa-mobile fa-fw me-2 text-primary"/>
                            <div>
                                <strong>Mobile Dashboard</strong>
                                <small class="d-block text-muted">Return to GuardLink Mobile</small>
                            </div>
                        </a>
                    </div>
                </t>
            </xpath>
        </template>
        
        <!-- Add Mobile Dashboard button in main website navigation for guards -->
        <template id="website_navbar_guard_mobile_link" inherit_id="website.layout" name="Guard Mobile Link in Navbar">
            <xpath expr="//header//nav[hasclass('navbar')]//ul[hasclass('navbar-nav')]" position="inside">
                <t t-if="request.env.user.has_group('guardpro.group_guardpro_guard_portal')">
                    <li class="nav-item">
                        <a href="/guardpro/mobile" class="nav-link">
                            <i class="fa fa-mobile me-1"/> Mobile
                        </a>
                    </li>
                </t>
            </xpath>
        </template>
        
        <!-- Add Mobile Dashboard link in user menu dropdown for guards -->
        <template id="user_menu_guard_mobile_link" inherit_id="portal.user_dropdown" name="Guard Mobile Link in User Menu">
            <xpath expr="//div[hasclass('dropdown-menu')]" position="inside">
                <t t-if="request.env.user.has_group('guardpro.group_guardpro_guard_portal')">
                    <div class="dropdown-divider"/>
                    <a href="/guardpro/mobile" class="dropdown-item" role="menuitem">
                        <i class="fa fa-mobile fa-fw me-2 text-primary"/> Mobile Dashboard
                    </a>
                </t>
            </xpath>
        </template>
        
        <!-- Add floating "Back to Mobile" button on eLearning pages for guards -->
        <template id="slides_floating_mobile_button" inherit_id="website_slides.course_main" priority="99" name="Guard Floating Mobile Button">
            <xpath expr="//div[@id='wrap']" position="inside">
                <t t-if="request.env.user.has_group('guardpro.group_guardpro_guard_portal')">
                    <a href="/guardpro/mobile" 
                       class="btn btn-primary btn-lg guardpro-mobile-floating-btn shadow"
                       title="Return to Mobile Dashboard"
                       style="position: fixed; bottom: 20px; right: 20px; z-index: 1000; border-radius: 50px; padding: 12px 24px;">
                        <i class="fa fa-mobile fa-2x me-2"/> Mobile
                    </a>
                </t>
            </xpath>
        </template>
        
        <!-- Add CSS for guard navigation elements -->
        <template id="elearning_guard_navigation_styles" name="eLearning Guard Navigation Styles" inherit_id="web.assets_frontend">
            <xpath expr="." position="inside">
                <style>
                    /* Guard mobile dashboard floating button */
                    .guardpro-mobile-floating-btn {
                        animation: pulse-shadow 2s infinite;
                    }
                    
                    @keyframes pulse-shadow {
                        0%, 100% {
                            box-shadow: 0 4px 6px rgba(0, 123, 255, 0.3);
                        }
                        50% {
                            box-shadow: 0 6px 12px rgba(0, 123, 255, 0.5);
                        }
                    }
                    
                    .guardpro-mobile-floating-btn:hover {
                        transform: scale(1.05);
                        transition: transform 0.2s ease-in-out;
                    }
                    
                    /* Responsive: Hide on very small screens */
                    @media (max-width: 576px) {
                        .guardpro-mobile-floating-btn {
                            bottom: 10px;
                            right: 10px;
                            padding: 10px 20px;
                        }
                        
                        .guardpro-mobile-floating-btn .fa-2x {
                            font-size: 1.5em;
                        }
                    }
                </style>
            </xpath>
        </template>
        
    </data>
</odoo>

