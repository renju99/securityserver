<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Guard Profile List View -->
        <record id="view_guard_profile_list" model="ir.ui.view">
            <field name="name">guard.profile.list</field>
            <field name="model">guard.profile</field>
            <field name="arch" type="xml">
                <list string="Guards" sample="1">
                    <field name="photo" widget="image" optional="show"/>
                    <field name="badge_number"/>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email" optional="hide"/>
                    <field name="status" widget="badge" 
                           decoration-success="status == 'active'"
                           decoration-warning="status == 'on_leave'"
                           decoration-danger="status in ['suspended', 'terminated']"/>
                    <field name="current_site_id" optional="show"/>
                    <field name="attendance_rate" optional="hide" widget="percentage"/>
                    <field name="rating" optional="hide" widget="priority"/>
                    <field name="total_hours_worked" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Guard Profile Form View -->
        <record id="view_guard_profile_form" model="ir.ui.view">
            <field name="name">guard.profile.form</field>
            <field name="model">guard.profile</field>
            <field name="arch" type="xml">
                <form string="Guard Profile">
                    <header>
                        <button name="%(action_report_guard_id_card)d"
                                string="Print ID Card"
                                type="action"
                                class="oe_highlight"
                                help="Print Guard Identity Card"/>
                        <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                        </div>
                        <field name="photo" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name" string="Guard Name"/>
                            <h1><field name="name" placeholder="Guard Name"/></h1>
                            <label for="badge_number"/>
                            <h3><field name="badge_number" placeholder="Badge Number"/></h3>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="employee_id"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="hire_date"/>
                                <field name="availability"/>
                            </group>
                            <group string="License &amp; Certification">
                                <field name="license_number"/>
                                <field name="license_expiry"/>
                                <field name="certifications" widget="text"/>
                            </group>
                        </group>
                        <group>
                            <group string="Emergency Contact">
                                <field name="emergency_contact"/>
                                <field name="emergency_phone"/>
                            </group>
                            <group string="Current Status">
                                <field name="current_site_id"/>
                                <field name="last_sync"/>
                            </group>
                        </group>
                        <group>
                            <group string="Skills &amp; Qualifications">
                                <field name="skills" widget="many2many_tags"/>
                                <field name="languages"/>
                            </group>
                            <group string="Performance">
                                <field name="rating" widget="priority"/>
                                <field name="attendance_rate" widget="percentage"/>
                                <field name="incident_count"/>
                                <field name="total_hours_worked"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Project Assignments">
                                <group>
                                    <group string="Assigned Projects (Read-Only)" help="Projects assigned to this guard via their user account">
                                        <field name="site_ids" widget="many2many_tags" readonly="1" options="{'color_field': 'color'}"/>
                                    </group>
                                </group>
                                <group>
                                    <div class="alert alert-info" role="alert">
                                        <strong>How to Manage Project Assignments:</strong>
                                        <ul>
                                            <li><strong>Project assignments are managed through the User form:</strong> Go to <em>Settings → Users &amp; Companies → Users</em>, select this guard's user account, and edit the "Assigned Projects" field in the Access Rights tab.</li>
                                            <li><strong>Why this field is read-only:</strong> Project assignments control what data the guard can access in the system. They must be managed centrally through user access controls for security and consistency.</li>
                                            <li><strong>Guard users can only see data from their assigned projects</strong> - this includes shifts, incidents, checkpoints, and tours.</li>
                                        </ul>
                                    </div>
                                </group>
                            </page>
                            <page string="Address">
                                <field name="address" widget="text"/>
                            </page>
                            <page string="Training Records">
                                <field name="training_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="instructor"/>
                                        <field name="hours"/>
                                        <field name="certificate_issued"/>
                                        <field name="expiry_date"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Device Information">
                                <group>
                                    <field name="device_id"/>
                                    <field name="device_model"/>
                                    <field name="app_version"/>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="notes" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Guard Profile Kanban View -->
        <record id="view_guard_profile_kanban" model="ir.ui.view">
            <field name="name">guard.profile.kanban</field>
            <field name="model">guard.profile</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="id"/>
                    <field name="photo"/>
                    <field name="name"/>
                    <field name="badge_number"/>
                    <field name="phone"/>
                    <field name="status"/>
                    <field name="current_site_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <field name="photo" widget="image" options="{'size': [90, 90]}"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_record_subtitle">
                                        Badge: <field name="badge_number"/>
                                    </div>
                                    <div>
                                        <field name="phone"/>
                                    </div>
                                    <div>
                                        <field name="status" widget="badge"/>
                                    </div>
                                    <div t-if="record.current_site_id.raw_value">
                                        Current Project: <field name="current_site_id"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Guard Profile Search View -->
        <record id="view_guard_profile_search" model="ir.ui.view">
            <field name="name">guard.profile.search</field>
            <field name="model">guard.profile</field>
            <field name="arch" type="xml">
                <search string="Guards">
                    <field name="name"/>
                    <field name="badge_number"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="current_site_id"/>
                    <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                    <filter string="On Leave" name="on_leave" domain="[('status', '=', 'on_leave')]"/>
                    <filter string="Suspended" name="suspended" domain="[('status', '=', 'suspended')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                        <filter name="group_site" string="Current Project" context="{'group_by': 'current_site_id'}"/>
                        <filter name="group_availability" string="Availability" context="{'group_by': 'availability'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Guard Profile Action -->
        <record id="action_guard_profile" model="ir.actions.act_window">
            <field name="name">Guards</field>
            <field name="res_model">guard.profile</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first guard profile
                </p>
                <p>
                    Track guard information, certifications, and performance.
                </p>
            </field>
        </record>

        <!-- Guard Skill Views -->
        <record id="view_guard_skill_list" model="ir.ui.view">
            <field name="name">guard.skill.list</field>
            <field name="model">guard.skill</field>
            <field name="arch" type="xml">
                <list string="Guard Skills" editable="bottom">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="requires_certification"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>

        <record id="action_guard_skill" model="ir.actions.act_window">
            <field name="name">Guard Skills</field>
            <field name="res_model">guard.skill</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>

