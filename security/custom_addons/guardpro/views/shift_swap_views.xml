<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shift Swap Request List View -->
    <record id="view_shift_swap_request_list" model="ir.ui.view">
        <field name="name">shift.swap.request.list</field>
        <field name="model">shift.swap.request</field>
        <field name="arch" type="xml">
            <list string="Shift Swap Requests" 
                  decoration-info="status=='draft'" 
                  decoration-warning="status in ('pending', 'accepted')" 
                  decoration-success="status=='completed'"
                  decoration-danger="status=='rejected'"
                  decoration-muted="status=='cancelled'">
                <field name="name"/>
                <field name="requesting_guard_id"/>
                <field name="target_guard_id"/>
                <field name="shift_id"/>
                <field name="site_id"/>
                <field name="swap_date"/>
                <field name="status" 
                       decoration-info="status=='draft'"
                       decoration-warning="status in ('pending', 'accepted')"
                       decoration-success="status=='completed'"
                       decoration-danger="status=='rejected'"
                       decoration-muted="status=='cancelled'"
                       widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Shift Swap Request Form View -->
    <record id="view_shift_swap_request_form" model="ir.ui.view">
        <field name="name">shift.swap.request.form</field>
        <field name="model">shift.swap.request</field>
        <field name="arch" type="xml">
            <form string="Shift Swap Request">
                <header>
                    <button name="action_submit" type="object" string="Submit Request" 
                            class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_accept" type="object" string="Accept" 
                            class="oe_highlight" invisible="status != 'pending'"/>
                    <button name="action_reject_by_guard" type="object" string="Reject" 
                            invisible="status != 'pending'"/>
                    <button name="action_approve" type="object" string="Approve" 
                            class="oe_highlight" invisible="status != 'accepted'"
                            groups="guardpro.group_guardpro_supervisor"/>
                    <button name="action_reject_by_supervisor" type="object" string="Reject" 
                            invisible="status != 'accepted'"
                            groups="guardpro.group_guardpro_supervisor"/>
                    <button name="action_cancel" type="object" string="Cancel" 
                            invisible="status not in ('draft', 'pending', 'accepted')"/>
                    <field name="status" widget="statusbar" 
                           statusbar_visible="draft,pending,accepted,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(guardpro.action_guard_shift)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-calendar"
                                context="{'search_default_shift_id': shift_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Shift</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Request Details">
                            <field name="requesting_guard_id" 
                                   readonly="status != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="target_guard_id" 
                                   readonly="status != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="shift_id" 
                                   readonly="status != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="site_id"/>
                            <field name="swap_date"/>
                        </group>
                        <group string="Optional Compensation">
                            <field name="compensation_shift_id" 
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    
                    <group string="Reason for Swap">
                        <field name="reason" readonly="status != 'draft'" nolabel="1" placeholder="Explain why you need this shift swap..."/>
                    </group>
                    
                    <notebook>
                        <page string="Response &amp; Approval" invisible="status == 'draft'">
                            <group>
                                <group string="Guard Response" invisible="status not in ('rejected', 'accepted', 'completed')">
                                    <field name="guard_response" nolabel="1" 
                                           placeholder="Guard's response to the swap request..."/>
                                </group>
                                <group string="Supervisor Approval" 
                                       invisible="status not in ('rejected', 'completed')"
                                       groups="guardpro.group_guardpro_supervisor">
                                    <field name="supervisor_id"/>
                                    <field name="supervisor_notes" nolabel="1" 
                                           placeholder="Supervisor notes or rejection reason..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Shift Swap Request Kanban View -->
    <record id="view_shift_swap_request_kanban" model="ir.ui.view">
        <field name="name">shift.swap.request.kanban</field>
        <field name="model">shift.swap.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="requesting_guard_id"/>
                <field name="target_guard_id"/>
                <field name="swap_date"/>
                <field name="status"/>
                <field name="site_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <i class="fa fa-calendar" title="Date" aria-label="Date"/> <field name="swap_date"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="status" widget="label_selection" 
                                           options="{'classes': {'draft': 'secondary', 'pending': 'warning', 'accepted': 'info', 'completed': 'success', 'rejected': 'danger', 'cancelled': 'default'}}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-user" title="User" aria-label="User"/> <field name="requesting_guard_id"/> 
                                    <i class="fa fa-exchange" title="Exchange" aria-label="Exchange"/> 
                                    <field name="target_guard_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-map-marker" title="Location" aria-label="Location"/> <field name="site_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Shift Swap Request Search View -->
    <record id="view_shift_swap_request_search" model="ir.ui.view">
        <field name="name">shift.swap.request.search</field>
        <field name="model">shift.swap.request</field>
        <field name="arch" type="xml">
            <search string="Search Shift Swap Requests">
                <field name="name"/>
                <field name="requesting_guard_id"/>
                <field name="target_guard_id"/>
                <field name="site_id"/>
                <field name="shift_id"/>
                
                <filter string="My Requests" name="my_requests" 
                        domain="[('requesting_guard_id.user_id', '=', uid)]"/>
                <filter string="Pending My Approval" name="pending_my_approval" 
                        domain="[('target_guard_id.user_id', '=', uid), ('status', '=', 'pending')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Accepted" name="accepted" domain="[('status', '=', 'accepted')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Rejected" name="rejected" domain="[('status', '=', 'rejected')]"/>
                <separator/>
                <filter string="This Week" name="this_week" 
                        domain="[('swap_date', '>=', (context_today() - relativedelta(weeks=1)))]"/>
                <filter string="Next Week" name="next_week" 
                        domain="[('swap_date', '>=', context_today()), 
                                 ('swap_date', '&lt;', (context_today() + relativedelta(weeks=1)))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Requesting Guard" name="group_requesting" context="{'group_by': 'requesting_guard_id'}"/>
                    <filter string="Target Guard" name="group_target" context="{'group_by': 'target_guard_id'}"/>
                    <filter string="Site" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Swap Date" name="group_date" context="{'group_by': 'swap_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Shift Swap Request Action -->
    <record id="action_shift_swap_request" model="ir.actions.act_window">
        <field name="name">Shift Swap Requests</field>
        <field name="res_model">shift.swap.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Shift Swap Request
            </p>
            <p>
                Request to swap shifts with other guards. Requests must be approved by supervisors.
            </p>
        </field>
    </record>

