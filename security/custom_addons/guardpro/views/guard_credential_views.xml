<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Guard Credential Tree View -->
    <record id="view_guard_credential_list" model="ir.ui.view">
        <field name="name">guard.credential.list</field>
        <field name="model">guard.credential</field>
        <field name="arch" type="xml">
            <list string="Guard Credentials" default_order="expiry_date asc">
                <field name="guard_name"/>
                <field name="credential_type_id"/>
                <field name="credential_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_until_expiry" optional="show"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'valid'" 
                       decoration-warning="state == 'expiring_soon'"
                       decoration-danger="state in ['expired', 'revoked']"/>
                <field name="compliance_status" widget="badge"
                       decoration-success="compliance_status == 'compliant'"
                       decoration-warning="compliance_status == 'warning'"
                       decoration-danger="compliance_status == 'non_compliant'"/>
            </list>
        </field>
    </record>

    <!-- Guard Credential Form View -->
    <record id="view_guard_credential_form" model="ir.ui.view">
        <field name="name">guard.credential.form</field>
        <field name="model">guard.credential</field>
        <field name="arch" type="xml">
            <form string="Guard Credential">
                <header>
                    <button name="action_verify" string="Verify" type="object" class="oe_highlight" 
                            invisible="state != 'pending'"/>
                    <button name="action_suspend" string="Suspend" type="object" 
                            invisible="state not in ['valid', 'expiring_soon']" 
                            confirm="Are you sure you want to suspend this credential?"/>
                    <button name="action_revoke" string="Revoke" type="object" 
                            invisible="state in ['revoked', 'expired']" 
                            confirm="Are you sure you want to revoke this credential? This action should be used for permanent revocation."/>
                    <button name="action_reactivate" string="Reactivate" type="object" 
                            invisible="state != 'suspended'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,valid,expiring_soon,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Expiring Soon" bg_color="text-bg-warning" invisible="state != 'expiring_soon'"/>
                    <widget name="web_ribbon" title="Suspended" bg_color="text-bg-secondary" invisible="state != 'suspended'"/>
                    <widget name="web_ribbon" title="Revoked" bg_color="text-bg-danger" invisible="state != 'revoked'"/>
                    
                    <group>
                        <group>
                            <field name="guard_id" options="{'no_create': True}"/>
                            <field name="credential_type_id" options="{'no_create': True}"/>
                            <field name="credential_number"/>
                            <field name="credential_category" invisible="1"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_until_expiry" invisible="1"/>
                            <field name="compliance_status" widget="badge" 
                                   decoration-success="compliance_status == 'compliant'"
                                   decoration-warning="compliance_status == 'warning'"
                                   decoration-danger="compliance_status == 'non_compliant'"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Issuing Information" name="issuing_info">
                            <group>
                                <group>
                                    <field name="issuing_authority"/>
                                    <field name="issuing_country"/>
                                    <field name="issuing_state"/>
                                </group>
                                <group>
                                    <field name="is_mandatory" readonly="1"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Verification" name="verification">
                            <group>
                                <group>
                                    <field name="verified_by_id" readonly="1"/>
                                    <field name="verification_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="verification_notes" placeholder="Verification notes..."/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Guard Credential Kanban View -->
    <record id="view_guard_credential_kanban" model="ir.ui.view">
        <field name="name">guard.credential.kanban</field>
        <field name="model">guard.credential</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="guard_name"/>
                <field name="credential_type_id"/>
                <field name="credential_number"/>
                <field name="expiry_date"/>
                <field name="state"/>
                <field name="compliance_status"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <div class="o_kanban_details">
                            <div class="o_kanban_record_title">
                                <strong><field name="guard_name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="credential_type_id"/>
                            </div>
                            <div>
                                <span>Number: </span><field name="credential_number"/>
                            </div>
                            <div>
                                <span>Expires: </span><field name="expiry_date"/>
                            </div>
                            <div>
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Guard Credential Search View -->
    <record id="view_guard_credential_search" model="ir.ui.view">
        <field name="name">guard.credential.search</field>
        <field name="model">guard.credential</field>
        <field name="arch" type="xml">
            <search string="Guard Credentials">
                <field name="guard_id"/>
                <field name="credential_type_id"/>
                <field name="credential_number"/>
                <field name="issuing_authority"/>
                <filter string="Valid" name="filter_valid" domain="[('state', '=', 'valid')]"/>
                <filter string="Expiring Soon" name="filter_expiring" domain="[('state', '=', 'expiring_soon')]"/>
                <filter string="Expired" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Pending Verification" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Suspended/Revoked" name="filter_suspended" domain="[('state', 'in', ['suspended', 'revoked'])]"/>
                <separator/>
                <filter string="Mandatory" name="filter_mandatory" domain="[('is_mandatory', '=', True)]"/>
                <separator/>
                <filter string="Expiring in 30 Days" name="filter_expiring_30" domain="[('days_until_expiry', '&lt;=', 30), ('days_until_expiry', '&gt;=', 0)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Guard" name="group_guard" context="{'group_by': 'guard_id'}"/>
                    <filter string="Credential Type" name="group_type" context="{'group_by': 'credential_type_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Compliance" name="group_compliance" context="{'group_by': 'compliance_status'}"/>
                    <filter string="Expiry Month" name="group_expiry" context="{'group_by': 'expiry_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Guard Credential Action -->
    <record id="action_guard_credential" model="ir.actions.act_window">
        <field name="name">Guard Credentials</field>
        <field name="res_model">guard.credential</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_valid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new credential
            </p>
            <p>
                Track security licenses, certifications, and credentials for guards.
            </p>
        </field>
    </record>

</odoo>

