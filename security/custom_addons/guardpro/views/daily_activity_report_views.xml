<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily Activity Report Form View -->
    <record id="view_daily_activity_report_form" model="ir.ui.view">
        <field name="name">daily.activity.report.form</field>
        <field name="model">daily.activity.report</field>
        <field name="arch" type="xml">
            <form string="Daily Activity Report">
                <header>
                    <button name="action_refresh_data" string="Refresh Data" type="object"
                            icon="fa-refresh"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" string="Submit for Review" type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'submitted'"/>
                    <button name="action_send_to_client" string="Send to Client" type="object"
                            icon="fa-envelope"
                            invisible="state not in ['approved', 'sent'] or sent_to_client"/>
                    <button name="action_generate_pdf" string="Download PDF" type="object"
                            icon="fa-file-pdf-o"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,sent"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_incident_report)d" type="action"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                context="{'search_default_site_id': site_id, 'search_default_report_date': report_date}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="incident_count"/></span>
                                <span class="o_stat_text">Incidents</span>
                            </div>
                        </button>
                        <button name="%(action_tour_log)d" type="action"
                                class="oe_stat_button" icon="fa-route"
                                context="{'search_default_site_id': site_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="tour_count"/></span>
                                <span class="o_stat_text">Tours</span>
                            </div>
                        </button>
                        <button name="%(action_visitor_management)d" type="action"
                                class="oe_stat_button" icon="fa-users"
                                context="{'search_default_site_id': site_id, 'search_default_report_date': report_date}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="visitor_count"/></span>
                                <span class="o_stat_text">Visitors</span>
                            </div>
                        </button>
                        <button name="%(action_guard_task)d" type="action"
                                class="oe_stat_button" icon="fa-tasks"
                                context="{'search_default_site_id': site_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="task_completed_count"/>/<field name="task_count"/>
                                </span>
                                <span class="o_stat_text">Tasks Done</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Sent to Client" bg_color="text-bg-success"
                            invisible="not sent_to_client"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="site_id" options="{'no_create': True}"/>
                            <field name="report_date"/>
                            <field name="shift_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="weather_conditions"/>
                            <field name="auto_send" invisible="1"/>
                            <field name="client_email" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary Statistics">
                            <group>
                                <group string="Incidents">
                                    <field name="total_incidents"/>
                                    <field name="critical_incidents"/>
                                </group>
                                <group string="Security Tours">
                                    <field name="tours_completed"/>
                                    <field name="tours_missed"/>
                                </group>
                            </group>
                            <group>
                                <group string="Personnel">
                                    <field name="guards_on_duty_count"/>
                                </group>
                                <group string="Other Activities">
                                    <field name="package_count"/>
                                    <field name="lost_found_count"/>
                                </group>
                            </group>
                        </page>
                        <page string="Incidents" badge="incident_count">
                            <field name="incident_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="incident_datetime"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Security Tours" badge="tour_count">
                            <field name="tour_log_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="tour_id"/>
                                    <field name="guard_id"/>
                                    <field name="start_time"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visitors" badge="visitor_count">
                            <field name="visitor_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="visitor_type"/>
                                    <field name="host_name"/>
                                    <field name="checkin_time"/>
                                    <field name="checkout_time"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attendance" badge="guards_on_duty_count">
                            <field name="attendance_ids" mode="list">
                                <list>
                                    <field name="guard_id"/>
                                    <field name="checkin_time"/>
                                    <field name="checkout_time"/>
                                    <field name="hours_worked"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tasks" badge="task_count">
                            <field name="task_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="task_type"/>
                                    <field name="assigned_to"/>
                                    <field name="due_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Packages" badge="package_count">
                            <field name="package_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="package_type"/>
                                    <field name="recipient_name"/>
                                    <field name="received_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lost &amp; Found" badge="lost_found_count">
                            <field name="lost_found_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="item_category"/>
                                    <field name="description"/>
                                    <field name="found_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes &amp; Observations">
                            <group>
                                <field name="special_notes" placeholder="Enter special notes, observations, or concerns for the day..."/>
                            </group>
                        </page>
                        <page string="Handover">
                            <group>
                                <field name="handover_notes" placeholder="Enter handover notes for the next shift..."/>
                            </group>
                        </page>
                        <page string="Review Details" invisible="state in ['draft', 'submitted']">
                            <group>
                                <group>
                                    <field name="submitted_by"/>
                                    <field name="submitted_date"/>
                                </group>
                                <group>
                                    <field name="reviewed_by"/>
                                    <field name="reviewed_date"/>
                                </group>
                            </group>
                            <group>
                                <field name="review_notes" placeholder="Reviewer comments..."/>
                            </group>
                            <group>
                                <group>
                                    <field name="sent_to_client" widget="boolean_toggle"/>
                                    <field name="sent_date" invisible="not sent_to_client"/>
                                </group>
                            </group>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Daily Activity Report List View -->
    <record id="view_daily_activity_report_list" model="ir.ui.view">
        <field name="name">daily.activity.report.list</field>
        <field name="model">daily.activity.report</field>
        <field name="arch" type="xml">
            <list string="Daily Activity Reports" multi_edit="1" sample="1">
                <field name="name"/>
                <field name="site_id"/>
                <field name="report_date"/>
                <field name="incident_count" optional="show"/>
                <field name="tour_count" optional="show"/>
                <field name="visitor_count" optional="hide"/>
                <field name="guards_on_duty_count" optional="hide"/>
                <field name="submitted_by" optional="hide"/>
                <field name="reviewed_by" optional="hide"/>
                <field name="sent_to_client" widget="boolean_toggle" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-info="state == 'approved'"
                       decoration-warning="state == 'submitted'"
                       decoration-muted="state == 'draft'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Daily Activity Report Kanban View -->
    <record id="view_daily_activity_report_kanban" model="ir.ui.view">
        <field name="name">daily.activity.report.kanban</field>
        <field name="model">daily.activity.report</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="site_id"/>
                <field name="report_date"/>
                <field name="incident_count"/>
                <field name="tour_count"/>
                <field name="state"/>
                <field name="sent_to_client"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                        <t t-if="record.sent_to_client.raw_value">
                                            <span class="badge text-bg-success ms-1">Sent</span>
                                        </t>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="site_id"/> - <field name="report_date"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <i class="fa fa-exclamation-triangle" title="Warning" aria-label="Warning"/> <field name="incident_count"/> Incidents
                                    </div>
                                    <div class="col-6">
                                        <i class="fa fa-map-signs" title="Route" aria-label="Route"/> <field name="tour_count"/> Tours
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Daily Activity Report Calendar View -->
    <record id="view_daily_activity_report_calendar" model="ir.ui.view">
        <field name="name">daily.activity.report.calendar</field>
        <field name="model">daily.activity.report</field>
        <field name="arch" type="xml">
            <calendar string="Daily Activity Reports" date_start="report_date" color="state" mode="month">
                <field name="name"/>
                <field name="site_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Daily Activity Report Search View -->
    <record id="view_daily_activity_report_search" model="ir.ui.view">
        <field name="name">daily.activity.report.search</field>
        <field name="model">daily.activity.report</field>
        <field name="arch" type="xml">
            <search string="Search Daily Activity Reports">
                <field name="name"/>
                <field name="site_id"/>
                <field name="report_date"/>
                <separator/>
                <filter string="Pending Review" name="pending_review"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Not Sent" name="not_sent"
                        domain="[('state', '=', 'approved'), ('sent_to_client', '=', False)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('report_date', '=', context_today())]"/>
                <filter string="Yesterday" name="yesterday"
                        domain="[('report_date', '=', (context_today() - relativedelta(days=1)))]"/>
                <filter string="This Week" name="this_week"
                        domain="[('report_date', '&gt;=', (context_today() - relativedelta(weeks=1)))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('report_date', '&gt;=', context_today() + relativedelta(day=1))]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Report Date" name="group_date" context="{'group_by': 'report_date'}"/>
                    <filter string="Submitted By" name="group_submitted" context="{'group_by': 'submitted_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Daily Activity Report Pivot View -->
    <record id="view_daily_activity_report_pivot" model="ir.ui.view">
        <field name="name">daily.activity.report.pivot</field>
        <field name="model">daily.activity.report</field>
        <field name="arch" type="xml">
            <pivot string="DAR Analysis" sample="1">
                <field name="site_id" type="row"/>
                <field name="report_date" type="col" interval="month"/>
                <field name="incident_count" type="measure"/>
                <field name="tour_count" type="measure"/>
                <field name="visitor_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Daily Activity Report Graph View -->
    <record id="view_daily_activity_report_graph" model="ir.ui.view">
        <field name="name">daily.activity.report.graph</field>
        <field name="model">daily.activity.report</field>
        <field name="arch" type="xml">
            <graph string="DAR Statistics" sample="1" type="line">
                <field name="report_date" interval="day"/>
                <field name="incident_count" type="measure"/>
                <field name="tour_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Daily Activity Report Action -->
    <record id="action_daily_activity_report" model="ir.actions.act_window">
        <field name="name">Daily Activity Reports</field>
        <field name="res_model">daily.activity.report</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_this_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Daily Activity Report
            </p>
            <p>
                Daily Activity Reports consolidate all site activities including
                incidents, patrols, visitors, and tasks into comprehensive reports
                that can be sent to clients.
            </p>
        </field>
    </record>

    <!-- Client Project Form View Extension -->
    <record id="view_client_site_form_dar_settings" model="ir.ui.view">
        <field name="name">client.site.form.dar.settings</field>
        <field name="model">client.site</field>
        <field name="inherit_id" ref="view_client_site_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="DAR Settings">
                    <group>
                        <group>
                            <field name="auto_send_dar" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="dar_recipient_emails" placeholder="email1@example.com, email2@example.com"
                                   invisible="not auto_send_dar"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>

