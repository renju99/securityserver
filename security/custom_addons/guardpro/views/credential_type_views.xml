<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Credential Type Tree View -->
    <record id="view_credential_type_list" model="ir.ui.view">
        <field name="name">credential.type.list</field>
        <field name="model">guard.credential.type</field>
        <field name="arch" type="xml">
            <list string="Credential Types" default_order="category,name">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="validity_period"/>
                <field name="renewal_notice_days"/>
                <field name="is_mandatory" widget="boolean_toggle"/>
                <field name="credential_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Credential Type Form View -->
    <record id="view_credential_type_form" model="ir.ui.view">
        <field name="name">credential.type.form</field>
        <field name="model">guard.credential.type</field>
        <field name="arch" type="xml">
            <form string="Credential Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_guard_credential)d" type="action" class="oe_stat_button" icon="fa-certificate"
                                context="{'default_credential_type_id': id, 'search_default_credential_type_id': id}">
                            <field name="credential_count" widget="statinfo" string="Credentials"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., Security License Level 2"/>
                            <field name="code" placeholder="e.g., SEC-L2"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="validity_period" widget="integer"/>
                            <field name="renewal_notice_days" widget="integer"/>
                            <field name="is_mandatory"/>
                            <field name="requires_verification"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="issuing_authority" placeholder="e.g., State Police Department"/>
                        <field name="description" placeholder="Additional information about this credential..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Credential Type Search View -->
    <record id="view_credential_type_search" model="ir.ui.view">
        <field name="name">credential.type.search</field>
        <field name="model">guard.credential.type</field>
        <field name="arch" type="xml">
            <search string="Credential Types">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <filter string="Licenses" name="filter_licenses" domain="[('category', '=', 'license')]"/>
                <filter string="Certifications" name="filter_certifications" domain="[('category', '=', 'certification')]"/>
                <filter string="Work Permits" name="filter_permits" domain="[('category', '=', 'permit')]"/>
                <filter string="Mandatory" name="filter_mandatory" domain="[('is_mandatory', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Mandatory" name="group_mandatory" context="{'group_by': 'is_mandatory'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Credential Type Action -->
    <record id="action_credential_type" model="ir.actions.act_window">
        <field name="name">Credential Types</field>
        <field name="res_model">guard.credential.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first credential type
            </p>
            <p>
                Define the types of credentials, licenses, and certifications that guards need to hold.
            </p>
        </field>
    </record>

</odoo>

