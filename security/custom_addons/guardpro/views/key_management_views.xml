<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Key Register Form View -->
    <record id="view_key_register_form" model="ir.ui.view">
        <field name="name">key.register.form</field>
        <field name="model">key.register</field>
        <field name="arch" type="xml">
            <form string="Key Register">
                <header>
                    <button name="action_issue_key" string="Issue Key" type="object"
                            class="oe_highlight"
                            invisible="status != 'available'"/>
                    <button name="action_return_key" string="Return Key" type="object"
                            class="oe_highlight"
                            invisible="status != 'issued'"/>
                    <button name="action_mark_lost" string="Mark as Lost" type="object"
                            class="btn-danger"
                            invisible="status in ['lost', 'decommissioned']"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="available,issued"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Available" bg_color="text-bg-success"
                            invisible="status != 'available'"/>
                    <widget name="web_ribbon" title="Issued" bg_color="text-bg-info"
                            invisible="status != 'issued'"/>
                    <widget name="web_ribbon" title="Lost" bg_color="text-bg-danger"
                            invisible="status != 'lost'"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="key_type"/>
                            <field name="site_id" options="{'no_create': True}"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="key_number"/>
                            <field name="key_tag_color"/>
                            <field name="current_holder" readonly="1"/>
                            <field name="days_issued" invisible="status != 'issued'"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Detailed description of the key..."/>
                    </group>
                    <notebook>
                        <page string="Duplicate Key">
                            <group>
                                <group>
                                    <field name="duplicate_available" widget="boolean_toggle"/>
                                    <field name="duplicate_location" invisible="not duplicate_available"/>
                                </group>
                            </group>
                        </page>
                        <page string="Transaction History">
                            <field name="transaction_ids">
                                <list>
                                    <field name="issued_to_type"/>
                                    <field name="issued_to_name"/>
                                    <field name="issue_date"/>
                                    <field name="expected_return"/>
                                    <field name="return_date"/>
                                    <field name="is_overdue" widget="boolean_toggle"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'returned'"
                                           decoration-info="state == 'active'"
                                           decoration-danger="state == 'lost'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Key Register List View -->
    <record id="view_key_register_list" model="ir.ui.view">
        <field name="name">key.register.list</field>
        <field name="model">key.register</field>
        <field name="arch" type="xml">
            <list string="Key Register" sample="1">
                <field name="name"/>
                <field name="key_type"/>
                <field name="site_id"/>
                <field name="location"/>
                <field name="current_holder"/>
                <field name="days_issued" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-info="status == 'issued'"
                       decoration-danger="status in ['lost', 'damaged']"
                       decoration-muted="status == 'decommissioned'"/>
            </list>
        </field>
    </record>

    <!-- Key Register Kanban View -->
    <record id="view_key_register_kanban" model="ir.ui.view">
        <field name="name">key.register.kanban</field>
        <field name="model">key.register</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="key_type"/>
                <field name="site_id"/>
                <field name="location"/>
                <field name="status"/>
                <field name="current_holder"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="key_type"/> - <field name="site_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-12">
                                        <i class="fa fa-map-marker" title="Location" aria-label="Location"/> <field name="location"/>
                                    </div>
                                    <div class="col-12" t-if="record.current_holder.raw_value">
                                        <i class="fa fa-user" title="User" aria-label="User"/> Holder: <field name="current_holder"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Key Register Action -->
    <record id="action_key_register" model="ir.actions.act_window">
        <field name="name">Key Register</field>
        <field name="res_model">key.register</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first key
            </p>
            <p>
                Track physical keys with issuance logs, return tracking,
                and automated overdue reminders.
            </p>
        </field>
    </record>

    <!-- Key Transaction Form View -->
    <record id="view_key_transaction_form" model="ir.ui.view">
        <field name="name">key.transaction.form</field>
        <field name="model">key.transaction</field>
        <field name="arch" type="xml">
            <form string="Key Transaction">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,returned"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <group>
                        <group>
                            <field name="key_id"/>
                            <field name="issued_to_type"/>
                            <field name="issued_to_name"/>
                            <field name="guard_id" invisible="issued_to_type != 'guard'"/>
                            <field name="issued_to_phone"/>
                            <field name="issued_to_id_number"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expected_return"/>
                            <field name="return_date"/>
                            <field name="returned_to"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="overdue_days" invisible="not is_overdue"/>
                        </group>
                    </group>
                    <group>
                        <field name="purpose" placeholder="Reason for key issuance..."/>
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                    <group>
                        <field name="signature" widget="image" options="{'size': [300, 150]}"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Key Transaction List View -->
    <record id="view_key_transaction_list" model="ir.ui.view">
        <field name="name">key.transaction.list</field>
        <field name="model">key.transaction</field>
        <field name="arch" type="xml">
            <list string="Key Transactions" sample="1">
                <field name="key_id"/>
                <field name="issued_to_type"/>
                <field name="issued_to_name"/>
                <field name="issue_date"/>
                <field name="expected_return"/>
                <field name="return_date"/>
                <field name="is_overdue" widget="boolean_toggle"/>
                <field name="overdue_days" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'returned'"
                       decoration-info="state == 'active'"
                       decoration-danger="state == 'lost'"/>
            </list>
        </field>
    </record>

    <!-- Key Transaction Action -->
    <record id="action_key_transaction" model="ir.actions.act_window">
        <field name="name">Key Transactions</field>
        <field name="res_model">key.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="domain">[('state', '=', 'active')]</field>
    </record>

</odoo>

