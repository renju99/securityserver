<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Knowledge Article List View -->
    <record id="view_knowledge_article_list" model="ir.ui.view">
        <field name="name">knowledge.article.list</field>
        <field name="model">knowledge.article</field>
        <field name="arch" type="xml">
            <list string="Knowledge Base" decoration-muted="not is_published">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="article_type" widget="badge"/>
                <field name="category_id"/>
                <field name="version"/>
                <field name="view_count"/>
                <field name="acknowledgment_count"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Knowledge Article Form View -->
    <record id="view_knowledge_article_form" model="ir.ui.view">
        <field name="name">knowledge.article.form</field>
        <field name="model">knowledge.article</field>
        <field name="arch" type="xml">
            <form string="Knowledge Article">
                <header>
                    <button name="action_new_version" string="Create New Version" 
                            type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Not Published" bg_color="text-bg-warning" invisible="is_published"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Article Title"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="article_type"/>
                            <field name="category_id"/>
                            <field name="version"/>
                            <field name="revision_date"/>
                        </group>
                        <group>
                            <field name="is_published"/>
                            <field name="access_level"/>
                            <field name="acknowledgment_required"/>
                            <field name="view_count" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="summary" placeholder="Brief summary of this article..."/>
                    </group>
                    
                    <notebook>
                        <page string="Content">
                            <field name="content" widget="html"/>
                        </page>
                        
                        <page string="Sites">
                            <field name="site_ids" widget="many2many_tags"/>
                            <div class="alert alert-info" role="alert">
                                Leave empty to make this article available for all sites.
                            </div>
                        </page>
                        
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        
                        <page string="Tags">
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </page>
                        
                        <page string="Acknowledgments" invisible="not acknowledgment_required">
                            <field name="acknowledgment_ids">
                                <list string="Acknowledgments" create="false">
                                    <field name="guard_id"/>
                                    <field name="acknowledged_date"/>
                                    <field name="article_version"/>
                                    <field name="needs_reacknowledgment" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Knowledge Article Kanban View -->
    <record id="view_knowledge_article_kanban" model="ir.ui.view">
        <field name="name">knowledge.article.kanban</field>
        <field name="model">knowledge.article</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" class="o_kanban_small_column">
                <field name="name"/>
                <field name="article_type"/>
                <field name="view_count"/>
                <field name="is_published"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="article_type" widget="badge"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="mt-1">
                                    <i class="fa fa-eye" title="View" aria-label="View"/> <field name="view_count"/> views
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_knowledge_article" model="ir.actions.act_window">
        <field name="name">Knowledge Base</field>
        <field name="res_model">knowledge.article</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_is_published': 1}</field>
    </record>

    <!-- Menus (now defined in guardpro_menus.xml) -->
    <!--
    <menuitem id="menu_knowledge_root" 
              name="Knowledge Base" 
