<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Guard Vaccination PDF Report Template -->
    <template id="guard_vaccination_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2>Vaccination Certificate</h2>
                            </div>
                        </div>

                        <!-- Reference and Status -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <h4>Certificate No: <span t-field="o.certificate_number"/></h4>
                            </div>
                            <div class="col-6 text-end">
                                <h5>
                                    Status: 
                                    <t t-if="o.status == 'valid'">
                                        <span class="badge bg-success">Valid</span>
                                    </t>
                                    <t t-elif="o.status == 'expired'">
                                        <span class="badge bg-danger">Expired</span>
                                    </t>
                                    <t t-elif="o.status == 'due_soon'">
                                        <span class="badge bg-warning">Booster Due Soon</span>
                                    </t>
                                </h5>
                            </div>
                        </div>

                        <!-- Guard Information -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Recipient Information</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Name:</strong></td>
                                        <td t-field="o.guard_id.name"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Employee ID:</strong></td>
                                        <td t-field="o.guard_id.employee_id"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Vaccination Details -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Vaccination Details</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Vaccine Name:</strong></td>
                                        <td t-field="o.vaccine_name"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Vaccine Type:</strong></td>
                                        <td><span t-field="o.vaccine_type"/></td>
                                    </tr>
                                    <tr t-if="o.manufacturer">
                                        <td><strong>Manufacturer:</strong></td>
                                        <td t-field="o.manufacturer"/>
                                    </tr>
                                    <tr t-if="o.batch_number">
                                        <td><strong>Batch/Lot Number:</strong></td>
                                        <td t-field="o.batch_number"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Dose Number:</strong></td>
                                        <td t-field="o.dose_number"/>
                                    </tr>
                                    <tr t-if="o.total_doses">
                                        <td><strong>Total Doses in Series:</strong></td>
                                        <td t-field="o.total_doses"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Administration Details -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Administration Details</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Vaccination Date:</strong></td>
                                        <td t-field="o.vaccination_date"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Vaccination Center:</strong></td>
                                        <td t-field="o.vaccination_center"/>
                                    </tr>
                                    <tr t-if="o.vaccinator_name">
                                        <td><strong>Administered By:</strong></td>
                                        <td t-field="o.vaccinator_name"/>
                                    </tr>
                                    <tr t-if="o.site_administered">
                                        <td><strong>Site of Administration:</strong></td>
                                        <td t-field="o.site_administered"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Validity -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Validity Period</h5>
                                <table class="table table-bordered">
                                    <tr t-if="o.expiry_date">
                                        <td width="30%"><strong>Valid Until:</strong></td>
                                        <td t-field="o.expiry_date"/>
                                    </tr>
                                    <tr t-if="o.next_dose_due">
                                        <td><strong>Next Dose/Booster Due:</strong></td>
                                        <td t-field="o.next_dose_due"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Certificate Image -->
                        <div class="row mt-3" t-if="o.certificate_image">
                            <div class="col-12 text-center">
                                <h5>Official Certificate</h5>
                                <img t-att-src="image_data_uri(o.certificate_image)" 
                                     style="max-width: 100%; max-height: 400px; border: 2px solid #ccc;"/>
                            </div>
                        </div>

                        <!-- Verification QR Code -->
                        <div class="row mt-3" t-if="o.verification_qr_code">
                            <div class="col-12 text-center">
                                <strong>Verification QR Code:</strong><br/>
                                <img t-att-src="image_data_uri(o.verification_qr_code)" 
                                     style="max-height: 150px; max-width: 150px;"/>
                                <p class="text-muted small">Scan to verify certificate authenticity</p>
                            </div>
                        </div>

                        <!-- Adverse Reactions -->
                        <div class="row mt-3" t-if="o.adverse_reaction">
                            <div class="col-12">
                                <div class="alert alert-warning">
                                    <strong>Adverse Reaction Reported:</strong>
                                    <p t-field="o.adverse_reaction_details"/>
                                </div>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="row mt-3" t-if="o.notes">
                            <div class="col-12">
                                <strong>Additional Notes:</strong>
                                <p t-field="o.notes"/>
                            </div>
                        </div>

                        <!-- Certification Statement -->
                        <div class="row mt-5">
                            <div class="col-12 text-center">
                                <div class="border p-3">
                                    <p><strong>This is to certify that</strong></p>
                                    <h4 t-field="o.guard_id.name"/>
                                    <p>has received</p>
                                    <h5 t-field="o.vaccine_name"/>
                                    <p>Dose <strong t-field="o.dose_number"/><span t-if="o.total_doses"> of <span t-field="o.total_doses"/></span></p>
                                    <p>on <strong t-field="o.vaccination_date"/></p>
                                    <p>at <strong t-field="o.vaccination_center"/></p>
                                </div>
                            </div>
                        </div>

                        <!-- Signature Section -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <div class="border-top pt-2">
                                    <p><strong>Healthcare Provider:</strong></p>
                                    <p t-if="o.vaccinator_name" t-field="o.vaccinator_name"/>
                                    <p>Facility: <span t-field="o.vaccination_center"/></p>
                                    <p>Date: <span t-field="o.vaccination_date"/></p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border-top pt-2">
                                    <p><strong>Recipient Acknowledgment:</strong></p>
                                    <p t-field="o.guard_id.name"></p>
                                    <p>Signature: ___________________</p>
                                </div>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="row mt-5">
                            <div class="col-12 text-center text-muted">
                                <small>
                                    Vaccination Certificate - Official Health Record
                                    <br/>
                                    This certificate should be kept as a permanent health record
                                </small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Report Definition -->
    <record id="action_report_guard_vaccination" model="ir.actions.report">
        <field name="name">Vaccination Certificate</field>
        <field name="model">guard.vaccination</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.guard_vaccination_report_template</field>
        <field name="report_file">guardpro.guard_vaccination_report_template</field>
        <field name="binding_model_id" ref="model_guard_vaccination"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Vaccination_Certificate_%s' % (object.guard_id.name)</field>
    </record>
</odoo>

