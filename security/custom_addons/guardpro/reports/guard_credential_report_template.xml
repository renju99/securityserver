<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Guard Credential PDF Report Template -->
    <template id="guard_credential_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2>Guard Credential Certificate</h2>
                            </div>
                        </div>

                        <!-- Guard Information -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Guard Information</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Guard Name:</strong></td>
                                        <td t-field="o.guard_id.name"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Employee ID:</strong></td>
                                        <td t-field="o.guard_id.employee_id"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Credential Details -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Credential Details</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Credential Type:</strong></td>
                                        <td t-field="o.credential_type_id.name"/>
                                    </tr>
                                    <tr t-if="o.credential_number">
                                        <td><strong>Credential Number:</strong></td>
                                        <td t-field="o.credential_number"/>
                                    </tr>
                                    <tr t-if="o.issuing_authority">
                                        <td><strong>Issuing Authority:</strong></td>
                                        <td t-field="o.issuing_authority"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Issue Date:</strong></td>
                                        <td t-field="o.issue_date"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Expiry Date:</strong></td>
                                        <td t-field="o.expiry_date"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td>
                                            <t t-if="o.status == 'valid'">
                                                <span class="badge bg-success">Valid</span>
                                            </t>
                                            <t t-elif="o.status == 'expired'">
                                                <span class="badge bg-danger">Expired</span>
                                            </t>
                                            <t t-elif="o.status == 'expiring_soon'">
                                                <span class="badge bg-warning">Expiring Soon</span>
                                            </t>
                                            <t t-elif="o.status == 'revoked'">
                                                <span class="badge bg-dark">Revoked</span>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Certificate Image -->
                        <div class="row mt-3" t-if="o.certificate_image">
                            <div class="col-12 text-center">
                                <h5>Certificate</h5>
                                <img t-att-src="image_data_uri(o.certificate_image)" 
                                     style="max-width: 100%; max-height: 400px; border: 2px solid #ccc;"/>
                            </div>
                        </div>

                        <!-- Verification Details -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5>Verification</h5>
                                <table class="table table-bordered">
                                    <tr t-if="o.verification_date">
                                        <td width="30%"><strong>Last Verified:</strong></td>
                                        <td t-field="o.verification_date"/>
                                    </tr>
                                    <tr t-if="o.verified_by">
                                        <td><strong>Verified By:</strong></td>
                                        <td t-field="o.verified_by.name"/>
                                    </tr>
                                    <tr t-if="o.verification_method">
                                        <td><strong>Verification Method:</strong></td>
                                        <td t-field="o.verification_method"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="row mt-3" t-if="o.notes">
                            <div class="col-12">
                                <strong>Notes:</strong>
                                <p t-field="o.notes"/>
                            </div>
                        </div>

                        <!-- Certification Statement -->
                        <div class="row mt-5">
                            <div class="col-12 text-center">
                                <div class="border p-3">
                                    <p><strong>This is to certify that</strong></p>
                                    <h4 t-field="o.guard_id.name"/>
                                    <p>holds a valid <strong t-field="o.credential_type_id.name"></strong></p>
                                    <p>Valid from <strong t-field="o.issue_date"></strong> to <strong t-field="o.expiry_date"></strong></p>
                                </div>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="row mt-5">
                            <div class="col-12 text-center text-muted">
                                <small>
                                    This credential certificate is issued for verification purposes
                                    <br/>
                                    Please verify authenticity with the issuing authority
                                </small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Report Definition -->
    <record id="action_report_guard_credential" model="ir.actions.report">
        <field name="name">Credential Certificate</field>
        <field name="model">guard.credential</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.guard_credential_report_template</field>
        <field name="report_file">guardpro.guard_credential_report_template</field>
        <field name="binding_model_id" ref="model_guard_credential"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Credential_%s_%s' % (object.guard_id.name, object.credential_type_id.name)</field>
    </record>
</odoo>

