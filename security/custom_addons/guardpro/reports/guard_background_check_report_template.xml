<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Guard Background Check PDF Report Template -->
    <template id="guard_background_check_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2>Background Check Certificate</h2>
                            </div>
                        </div>

                        <!-- Reference and Status -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <h4>Reference: <span t-field="o.reference_number"/></h4>
                            </div>
                            <div class="col-6 text-end">
                                <h5>
                                    Status: 
                                    <t t-if="o.status == 'clear'">
                                        <span class="badge bg-success">Clear</span>
                                    </t>
                                    <t t-elif="o.status == 'pending'">
                                        <span class="badge bg-warning">Pending</span>
                                    </t>
                                    <t t-elif="o.status == 'in_progress'">
                                        <span class="badge bg-info">In Progress</span>
                                    </t>
                                    <t t-elif="o.status == 'flagged'">
                                        <span class="badge bg-warning">Flagged - Review Required</span>
                                    </t>
                                    <t t-elif="o.status == 'failed'">
                                        <span class="badge bg-danger">Failed</span>
                                    </t>
                                    <t t-elif="o.status == 'expired'">
                                        <span class="badge bg-secondary">Expired</span>
                                    </t>
                                </h5>
                            </div>
                        </div>

                        <!-- Guard Information -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Guard Information</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Guard Name:</strong></td>
                                        <td t-field="o.guard_id.name"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Employee ID:</strong></td>
                                        <td t-field="o.guard_id.employee_id"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Background Check Details -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Background Check Details</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Check Type:</strong></td>
                                        <td><span t-field="o.check_type"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Check Date:</strong></td>
                                        <td t-field="o.check_date"/>
                                    </tr>
                                    <tr t-if="o.expiry_date">
                                        <td><strong>Valid Until:</strong></td>
                                        <td t-field="o.expiry_date"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Provider Information -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Provider Information</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Provider Name:</strong></td>
                                        <td t-field="o.provider_name"/>
                                    </tr>
                                    <tr t-if="o.provider_contact">
                                        <td><strong>Provider Contact:</strong></td>
                                        <td t-field="o.provider_contact"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Results -->
                        <div class="row mt-3" t-if="o.status == 'clear'">
                            <div class="col-12">
                                <div class="alert alert-success text-center">
                                    <h4>Background Check: CLEAR</h4>
                                    <p>No adverse findings reported</p>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3" t-if="o.status == 'flagged'">
                            <div class="col-12">
                                <div class="alert alert-warning">
                                    <h5>Review Required</h5>
                                    <p t-if="o.findings" t-field="o.findings"/>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3" t-if="o.status == 'failed'">
                            <div class="col-12">
                                <div class="alert alert-danger">
                                    <h5>Background Check: FAILED</h5>
                                    <p t-if="o.findings" t-field="o.findings"/>
                                </div>
                            </div>
                        </div>

                        <!-- Findings -->
                        <div class="row mt-3" t-if="o.findings and o.status not in ['flagged', 'failed']">
                            <div class="col-12">
                                <h5>Findings</h5>
                                <p t-field="o.findings"/>
                            </div>
                        </div>

                        <!-- Verification Details -->
                        <div class="row mt-3" t-if="o.verification_method">
                            <div class="col-12">
                                <h5>Verification</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Verification Method:</strong></td>
                                        <td t-field="o.verification_method"/>
                                    </tr>
                                    <tr t-if="o.verification_date">
                                        <td><strong>Verification Date:</strong></td>
                                        <td t-field="o.verification_date"/>
                                    </tr>
                                    <tr t-if="o.verified_by">
                                        <td><strong>Verified By:</strong></td>
                                        <td t-field="o.verified_by.name"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Certificate/Documentation -->
                        <div class="row mt-3" t-if="o.certificate_file">
                            <div class="col-12">
                                <p><strong>Certificate Documentation:</strong> Attached</p>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="row mt-3" t-if="o.notes">
                            <div class="col-12">
                                <strong>Additional Notes:</strong>
                                <p t-field="o.notes"/>
                            </div>
                        </div>

                        <!-- Certification Statement -->
                        <div class="row mt-5" t-if="o.status == 'clear'">
                            <div class="col-12 text-center">
                                <div class="border p-3">
                                    <p><strong>This is to certify that</strong></p>
                                    <h4 t-field="o.guard_id.name"/>
                                    <p>has successfully completed a <strong t-field="o.check_type"/> background check</p>
                                    <p>Conducted on <strong t-field="o.check_date"/></p>
                                    <p t-if="o.expiry_date">Valid until <strong t-field="o.expiry_date"/></p>
                                    <p class="mt-3"><strong>Result: CLEAR</strong></p>
                                </div>
                            </div>
                        </div>

                        <!-- Signature Section -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <div class="border-top pt-2">
                                    <p><strong>Provider:</strong></p>
                                    <p t-field="o.provider_name"></p>
                                    <p>Date: <span t-field="o.check_date"/></p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border-top pt-2">
                                    <p><strong>HR Verification:</strong></p>
                                    <p t-if="o.verified_by" t-field="o.verified_by.name"/>
                                    <p t-if="o.verification_date">Date: <span t-field="o.verification_date"/></p>
                                </div>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="row mt-5">
                            <div class="col-12 text-center text-muted">
                                <small>
                                    Background Check Certificate - Confidential HR Document
                                    <br/>
                                    This document contains sensitive personal information
                                </small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Report Definition -->
    <record id="action_report_guard_background_check" model="ir.actions.report">
        <field name="name">Background Check Certificate</field>
        <field name="model">guard.background.check</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.guard_background_check_report_template</field>
        <field name="report_file">guardpro.guard_background_check_report_template</field>
        <field name="binding_model_id" ref="model_guard_background_check"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Background_Check_%s' % (object.reference_number)</field>
    </record>
</odoo>

