<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="incident_found_item_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="stmt-page">
                    <style>
                        .stmt-page { font-family: 'Helvetica', 'Arial', sans-serif; padding: 0; margin: 0; color: #333; }
                        .red-bar { background-color: #a52a2a; color: white; text-align: right; padding: 5px 20px; font-size: 14px; font-weight: bold; }
                        .blue-bar { background-color: #4a90e2; color: white; text-align: right; padding: 5px 20px; font-size: 14px; font-weight: bold; }
                        .stmt-header { margin-top: 20px; margin-bottom: 30px; }
                        .stmt-logo { max-height: 80px; }
                        .stmt-post-name { text-align: right; font-size: 18px; color: #666; }
                        .stmt-formal-title { text-align: center; font-size: 24px; font-weight: bold; text-transform: uppercase; margin: 30px 0; color: #444; }
                        .stmt-table { width: 100%; border-collapse: collapse; margin-bottom: 25px; border: 1px solid #eee; }
                        .stmt-table td { padding: 12px 15px; border: 1px solid #eee; font-size: 14px; vertical-align: top; }
                        .stmt-label { background-color: #f9f9f9; font-weight: bold; width: 260px; color: #555; }
                        .stmt-value { width: auto; color: #000; }
                        .stmt-section-header { font-size: 22px; font-weight: bold; color: #444; margin: 30px 0 15px 0; }
                        .stmt-sig-img { max-height: 120px; display: block; margin: 10px 0; }
                        .stmt-sig-line { border-top: 1px solid #333; margin-top: 5px; padding-top: 5px; width: 100%; font-weight: bold; }
                    </style>

                    <div class="red-bar" t-if="doc.statement_expiry_date">
                        This report contains personal data. It must be deleted on or before
                        <span t-field="doc.statement_expiry_date" t-options='{"widget": "date"}'/>
                    </div>
                    <div class="blue-bar">
                        New Activity // <span t-field="doc.name"/>
                    </div>

                    <div class="container" style="padding: 20px 40px;">
                        <div class="row stmt-header">
                            <div class="col-6">
                                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" class="stmt-logo"/>
                            </div>
                            <div class="col-6 stmt-post-name">
                                <span t-field="doc.site_id.name"/>
                            </div>
                        </div>

                        <div class="stmt-formal-title">
                            FOUND ITEM UAE NTSQD SEC PRO_02_F_002, V. 0 11.11.19
                        </div>

                        <table class="stmt-table">
                            <tr><td class="stmt-label">Category</td><td class="stmt-value"><span t-field="doc.category_id.name"/></td></tr>
                            <tr><td class="stmt-label">Priority</td><td class="stmt-value"><span t-field="doc.severity" style="text-transform: capitalize;"/></td></tr>
                            <tr><td class="stmt-label">Post</td><td class="stmt-value"><span t-field="doc.site_id.name"/></td></tr>
                            <tr><td class="stmt-label">Report Created by</td><td class="stmt-value"><span t-field="doc.guard_id.name"/></td></tr>
                            <tr><td class="stmt-label">Start Date</td><td class="stmt-value"><span t-field="doc.incident_datetime" t-options='{"widget": "datetime"}'/></td></tr>
                        </table>
                        <t t-call="guardpro.incident_map_snippet"/>

                        <div class="stmt-section-header">FOUND ITEM DESCRIPTION</div>
                        <table class="stmt-table">
                            <tr><td class="stmt-label">When the item is Found (Time)</td><td class="stmt-value"><span t-field="doc.found_item_time"/></td></tr>
                            <tr><td class="stmt-label">When the item is Found (Date)</td><td class="stmt-value"><span t-field="doc.found_item_date"/></td></tr>
                            <tr><td class="stmt-label">Name of Person Who Found the Item</td><td class="stmt-value"><span t-field="doc.found_person_name"/></td></tr>
                            <tr><td class="stmt-label">Home Address</td><td class="stmt-value"><span t-field="doc.found_person_home_address"/></td></tr>
                            <tr><td class="stmt-label">Mobile Number</td><td class="stmt-value"><span t-field="doc.found_person_mobile"/></td></tr>
                            <tr><td class="stmt-label">Email Address</td><td class="stmt-value"><span t-field="doc.found_person_email"/></td></tr>
                            <tr><td class="stmt-label">Category of Found Item</td><td class="stmt-value"><span t-field="doc.found_item_category"/></td></tr>
                            <tr><td class="stmt-label">Item(s) Found - Full Description</td><td class="stmt-value"><span t-field="doc.found_item_description"/></td></tr>
                            <tr><td class="stmt-label">Did the security officer inspect the item in your presence?</td><td class="stmt-value"><span t-field="doc.found_item_inspected"/></td></tr>
                            <tr>
                                <td class="stmt-label">Signature of the Person Who Found the Item</td>
                                <td class="stmt-value">
                                    <img t-if="doc.found_item_person_signature" t-att-src="image_data_uri(doc.found_item_person_signature)" class="stmt-sig-img"/>
                                </td>
                            </tr>
                        </table>

                        <div class="stmt-section-header">FOR OFFICE USE ONLY BY SECURITY</div>
                        <table class="stmt-table">
                            <tr><td class="stmt-label">Security Name</td><td class="stmt-value"><span t-field="doc.found_item_security_name"/></td></tr>
                            <tr><td class="stmt-label">Designation</td><td class="stmt-value"><span t-field="doc.found_item_security_designation"/></td></tr>
                            <tr><td class="stmt-label">Did you inform your Supervisor?</td><td class="stmt-value"><span t-field="doc.found_item_supervisor_informed"/></td></tr>
                            <tr><td class="stmt-label">Did you handover the item to lost and found?</td><td class="stmt-value"><span t-field="doc.found_item_handover"/></td></tr>
                            <tr>
                                <td class="stmt-label">Security Officer Signature</td>
                                <td class="stmt-value">
                                    <img t-if="doc.security_officer_signature" t-att-src="image_data_uri(doc.security_officer_signature)" class="stmt-sig-img"/>
                                    <div class="stmt-sig-line">Signature</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="incident_return_form_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="stmt-page">
                    <style>
