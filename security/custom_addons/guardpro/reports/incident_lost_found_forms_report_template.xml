                            <div class="col-6">
                                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" class="stmt-logo"/>
                            </div>
                            <div class="col-6 stmt-post-name">
                                <span t-field="doc.site_id.name"/>
