                            <tr><td class="stmt-label">Report Created by</td><td class="stmt-value"><span t-field="doc.guard_id.name"/></td></tr>
                            <tr><td class="stmt-label">Start Date</td><td class="stmt-value"><span t-field="doc.incident_datetime" t-options='{"widget": "datetime"}'/></td></tr>
                        </table>
                        <t t-call="guardpro.incident_map_snippet"/>

                        <div class="stmt-section-header">RECIPIENT PARTICULARS</div>
                        <table class="stmt-table">
                            <tr><td class="stmt-label">Recipient Name</td><td class="stmt-value"><span t-field="doc.return_recipient_name"/></td></tr>
                            <tr><td class="stmt-label">Recipient Home Address</td><td class="stmt-value"><span t-field="doc.return_recipient_home_address"/></td></tr>
                            <tr><td class="stmt-label">Mobile Number</td><td class="stmt-value"><span t-field="doc.return_recipient_mobile"/></td></tr>
                            <tr><td class="stmt-label">Email Address</td><td class="stmt-value"><span t-field="doc.return_recipient_email"/></td></tr>
                            <tr><td class="stmt-label">Item(s) Received - Full Description</td><td class="stmt-value"><span t-field="doc.return_item_description"/></td></tr>
                            <tr>
                                <td class="stmt-label">Recipient Signature</td>
                                <td class="stmt-value">
                                    <img t-if="doc.return_recipient_signature" t-att-src="image_data_uri(doc.return_recipient_signature)" class="stmt-sig-img"/>
                                    <div class="stmt-sig-line">Signature</div>
                                </td>
                            </tr>
                        </table>

                        <div class="stmt-section-header">FOR OFFICE USE ONLY BY SECURITY</div>
                        <table class="stmt-table">
                            <tr><td class="stmt-label">Category of Lost and Found Items</td><td class="stmt-value"><span t-field="doc.return_item_category"/></td></tr>
                            <tr><td class="stmt-label">Security Name</td><td class="stmt-value"><span t-field="doc.return_security_name"/></td></tr>
                            <tr><td class="stmt-label">Designation</td><td class="stmt-value"><span t-field="doc.return_security_designation"/></td></tr>
                            <tr>
                                <td class="stmt-label">Security Officer Signature</td>
                                <td class="stmt-value">
                                    <img t-if="doc.security_officer_signature" t-att-src="image_data_uri(doc.security_officer_signature)" class="stmt-sig-img"/>
                                    <div class="stmt-sig-line">Signature</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_incident_found_item" model="ir.actions.report">
        <field name="name">Found Item Form</field>
        <field name="model">incident.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.incident_found_item_pdf_template</field>
        <field name="report_file">guardpro.incident_found_item_pdf_template</field>
        <field name="print_report_name">'Found_Item_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_incident_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_incident_return_form" model="ir.actions.report">
        <field name="name">Return Form</field>
        <field name="model">incident.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.incident_return_form_pdf_template</field>
        <field name="report_file">guardpro.incident_return_form_pdf_template</field>
        <field name="print_report_name">'Return_Form_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_incident_report"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
