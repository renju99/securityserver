<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tour Log Report PDF Template -->
    <template id="tour_log_report_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- basic_layout: same pattern as incident PDFs (html_container + article), with in-body logo — avoids missing/clipped standard header -->
                <t t-call="web.basic_layout">
                    <div class="page tour-log-pdf">
                        <style>
                            .tour-log-pdf { font-family: Helvetica, Arial, sans-serif; color: #222; font-size: 13px; line-height: 1.4; }
                            .tour-log-pdf h2 { font-size: 22px; margin: 0 0 8px 0; }
                            .tour-log-pdf h4 { font-size: 15px; margin: 20px 0 10px 0; color: #333; border-bottom: 2px solid #2c5282; padding-bottom: 6px; }
                            .tour-log-pdf .tour-log-letterhead { width: 100%; margin-bottom: 16px; overflow: hidden; }
                            .tour-log-pdf .tour-log-letterhead td { vertical-align: middle; border: none; padding: 0; }
                            .tour-log-pdf table.tour-table { width: 100%; border-collapse: collapse; margin-bottom: 18px; table-layout: fixed; }
                            .tour-log-pdf table.tour-table th,
                            .tour-log-pdf table.tour-table td { border: 1px solid #b0b0b0; padding: 8px 10px; vertical-align: top; word-wrap: break-word; }
                            .tour-log-pdf table.tour-table thead th { background-color: #e8eef4; font-weight: bold; color: #1a365d; text-align: left; }
                            .tour-log-pdf table.tour-table-data tbody tr:nth-child(even) { background-color: #f9fafb; }
                            .tour-log-pdf .tour-label-cell { background-color: #f0f4f8; font-weight: 600; width: 26%; color: #2d3748; }
                            .tour-log-pdf .tour-status-pill { display: inline-block; padding: 4px 14px; border-radius: 20px; font-size: 12px; font-weight: bold;
                                text-transform: uppercase; border: 1px solid #999; }
                            .tour-log-pdf .tour-status-done { background: #c6f6d5; color: #22543d; border-color: #48bb78; }
                            .tour-log-pdf .tour-status-progress { background: #bee3f8; color: #2c5282; border-color: #4299e1; }
                            .tour-log-pdf .tour-status-warn { background: #feebc8; color: #744210; border-color: #ed8936; }
                            .tour-log-pdf .tour-status-bad { background: #fed7d7; color: #742a2a; border-color: #f56565; }
                            .tour-log-pdf .tour-progress { height: 26px; border: 1px solid #cbd5e0; background: #edf2f7; border-radius: 4px; overflow: hidden; }
                            .tour-log-pdf .tour-progress-bar { height: 100%; min-width: 2px; line-height: 26px; text-align: center; font-size: 11px; font-weight: bold; color: #1a202c; }
                            .tour-log-pdf .tour-bar-ok { background: #48bb78; color: #fff; }
                            .tour-log-pdf .tour-bar-mid { background: #ed8936; color: #fff; }
                            .tour-log-pdf .tour-bar-low { background: #f56565; color: #fff; }
                            .tour-log-pdf .tour-badge { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600; border: 1px solid #a0aec0; }
                            .tour-log-pdf .tour-badge-info { background: #e6fffa; color: #234e52; border-color: #38b2ac; }
                            .tour-log-pdf .tour-badge-ok { background: #c6f6d5; color: #22543d; border-color: #48bb78; }
                            .tour-log-pdf .tour-badge-pending { background: #feebc8; color: #744210; border-color: #dd6b20; }
                            .tour-log-pdf .tour-badge-fail { background: #fed7d7; color: #742a2a; border-color: #e53e3e; }
                            .tour-log-pdf .tour-notes-box { border: 1px solid #b0b0b0; padding: 12px 14px; background: #fafafa; min-height: 48px; }
                            .tour-log-pdf table.tour-sig-row { margin-top: 36px; width: 100%; border-collapse: collapse; }
                            .tour-log-pdf table.tour-sig-row td { width: 50%; vertical-align: top; border: none; padding: 8px 16px 0 0; }
                            .tour-log-pdf .text-center { text-align: center; }
                            .tour-log-pdf .text-end { text-align: right; }
                            .tour-log-pdf .text-muted { color: #718096; }
                        </style>
                        <!-- Letterhead-style logo (matches incident / door-lock PDFs) -->
                        <table class="tour-log-letterhead"><tr>
                            <td style="width: 50%;">
                                <img t-if="res_company.logo"
                                     t-att-src="image_data_uri(res_company.logo)"
                                     style="max-height: 70px;"
                                     alt="Company Logo"/>
                            </td>
                            <td class="text-end text-muted" style="width: 50%;">
                                <span t-field="doc.site_id.name"/>
                            </td>
                        </tr></table>
                        <!-- Header -->
                        <div class="text-center" style="margin-bottom: 16px;">
                            <h2><strong>TOUR LOG REPORT</strong></h2>
                            <div class="text-muted" style="font-size: 15px; font-weight: 600;">
                                <span t-field="doc.name"/>
                            </div>
                        </div>

                        <!-- Status Badge -->
                        <div class="text-center" style="margin-bottom: 16px;">
                            <span class="tour-status-pill"
                                  t-att-class="{'tour-status-done': doc.status == 'completed',
                                                'tour-status-progress': doc.status == 'in_progress',
                                                'tour-status-warn': doc.status == 'incomplete',
                                                'tour-status-bad': doc.status == 'missed'}">
                                <t t-esc="doc.status.replace('_', ' ').upper()"/>
                            </span>
                        </div>

                        <!-- Tour Information -->
                        <h4><strong>Tour Details</strong></h4>
                        <table class="tour-table">
                                    <tr>
                                        <td class="tour-label-cell"><strong>Guard</strong></td>
                                        <td><span t-field="doc.guard_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="tour-label-cell"><strong>Site</strong></td>
                                        <td><span t-field="doc.site_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="tour-label-cell"><strong>Shift</strong></td>
                                        <td><span t-field="doc.shift_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="tour-label-cell"><strong>Tour</strong></td>
                                        <td><span t-field="doc.tour_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="tour-label-cell"><strong>Start Time</strong></td>
                                        <td><span t-field="doc.start_time" t-options='{"widget": "datetime"}'/></td>
                                    </tr>
                                    <tr t-if="doc.end_time">
                                        <td class="tour-label-cell"><strong>End Time</strong></td>
                                        <td><span t-field="doc.end_time" t-options='{"widget": "datetime"}'/></td>
                                    </tr>
                                    <tr t-if="doc.duration">
                                        <td class="tour-label-cell"><strong>Duration</strong></td>
                                        <td><t t-esc="'%d minutes' % (doc.duration * 60)"/></td>
                                    </tr>
                                </table>

                        <!-- Progress Statistics -->
                        <h4><strong>Progress Statistics</strong></h4>
                        <table class="tour-table">
                                    <tr>
                                        <td class="tour-label-cell"><strong>Required Checkpoints</strong></td>
                                        <td><t t-esc="doc.expected_checkpoints"/></td>
                                        <td class="tour-label-cell"><strong>Completed</strong></td>
                                        <td><t t-esc="doc.scanned_checkpoints"/></td>
                                    </tr>
                                    <tr>
                                        <td class="tour-label-cell"><strong>Completion Rate</strong></td>
                                        <td colspan="3">
                                            <div class="tour-progress">
                                                <div class="tour-progress-bar"
                                                     t-att-class="{'tour-bar-ok': doc.completion_percentage &gt;= 100,
                                                                   'tour-bar-mid': doc.completion_percentage &gt;= 50 and doc.completion_percentage &lt; 100,
                                                                   'tour-bar-low': doc.completion_percentage &lt; 50}"
                                                     t-attf-style="width: {{doc.completion_percentage}}%">
                                                    <t t-esc="int(round(doc.completion_percentage or 0))"/>%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </table>

                        <!-- Checkpoint Scans -->
                        <t t-if="doc.scan_ids">
                                <h4><strong>Checkpoint Scans</strong></h4>
                                <table class="tour-table tour-table-data">
                                    <thead>
                                        <tr>
                                            <th>Checkpoint</th>
                                            <th>Location</th>
                                            <th>Scan Time</th>
                                            <th>Method</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.scan_ids" t-as="scan">
                                            <td><span t-field="scan.checkpoint_id.name"/></td>
                                            <td><span t-field="scan.checkpoint_id.location_description"/></td>
                                            <td><span t-field="scan.scan_time" t-options='{"widget": "datetime"}'/></td>
                                            <td>
                                                <span class="tour-badge tour-badge-info">
                                                    <t t-esc="scan.scan_type.upper()"/>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="tour-badge"
                                                      t-att-class="{'tour-badge-ok': scan.status == 'verified',
                                                                    'tour-badge-pending': scan.status == 'pending',
                                                                    'tour-badge-fail': scan.status == 'failed'}">
                                                    <t t-esc="scan.status"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                        </t>

                        <!-- Observations -->
                        <t t-if="doc.facility_incident_count">
                                <h4><strong>Facility issues</strong></h4>
                                <table class="tour-table tour-table-data">
                                    <thead>
                                        <tr>
                                            <th>Reference</th>
                                            <th>Checkpoint</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.scan_ids" t-as="fscan">
                                            <tr t-if="fscan.facility_incident_id">
                                                <td><span t-field="fscan.facility_incident_id.name"/></td>
                                                <td><span t-field="fscan.checkpoint_id.name"/></td>
                                                <td><span t-field="fscan.facility_issue_type"/></td>
                                                <td><span t-field="fscan.facility_incident_id.status"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                        </t>
                        <t t-if="doc.checkpoint_findings or doc.observations or doc.issues_found">
                                <h4><strong>Observations</strong></h4>
                                <t t-if="doc.checkpoint_findings">
                                    <p><strong>Checkpoint findings</strong></p>
                                    <div class="tour-notes-box">
                                        <pre style="white-space: pre-wrap; font-family: inherit; margin: 0;"><t t-esc="doc.checkpoint_findings"/></pre>
                                    </div>
                                </t>
                                <t t-if="doc.observations">
                                    <p><strong>Tour summary</strong></p>
                                    <div class="tour-notes-box">
                                        <span t-field="doc.observations"/>
                                    </div>
                                </t>
                                <t t-if="doc.issues_found">
                                    <p><strong>Issues / follow-up</strong></p>
                                    <div class="tour-notes-box">
                                        <span t-field="doc.issues_found"/>
                                    </div>
                                </t>
                        </t>

                        <!-- GPS Tracking Data -->
                        <t t-if="doc.distance_traveled">
                                <h4><strong>GPS Tracking</strong></h4>
                                <table class="tour-table">
                                    <tr>
                                        <td class="tour-label-cell"><strong>Distance Traveled</strong></td>
                                        <td><t t-esc="'%.2f km' % doc.distance_traveled"/></td>
                                    </tr>
                                </table>
                        </t>

                        <!-- Incidents During Tour -->
                        <t t-if="doc.incident_ids">
                                <h4><strong>Incidents Reported During Tour</strong></h4>
                                <table class="tour-table tour-table-data">
                                    <thead>
                                        <tr>
                                            <th>Incident #</th>
                                            <th>Title</th>
                                            <th>Severity</th>
                                            <th>Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.incident_ids" t-as="incident">
                                            <td><span t-field="incident.name"/></td>
                                            <td><span t-field="incident.title"/></td>
                                            <td>
                                                <span class="tour-badge"
                                                      t-att-class="{'tour-badge-fail': incident.severity in ['high', 'critical'],
                                                                    'tour-badge-pending': incident.severity == 'medium',
                                                                    'tour-badge-info': incident.severity == 'low'}">
                                                    <t t-esc="incident.severity"/>
                                                </span>
                                            </td>
                                            <td><span t-field="incident.incident_datetime" t-options='{"widget": "datetime"}'/></td>
                                        </tr>
                                    </tbody>
                                </table>
                        </t>

                        <!-- Notes -->
                        <t t-if="doc.notes">
                                <h4><strong>Notes</strong></h4>
                                <div class="tour-notes-box">
                                    <span t-field="doc.notes"/>
                                </div>
                        </t>

                        <!-- Footer with signature line -->
                        <table class="tour-sig-row"><tr>
                            <td>
                                <p style="margin: 0;">__________________________<br/>
                                   Guard Signature
                                </p>
                            </td>
                            <td>
                                <p style="margin: 0;">__________________________<br/>
                                   Supervisor Signature
                                </p>
                            </td>
                        </tr></table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_tour_log" model="ir.actions.report">
        <field name="name">Tour Log Report</field>
        <field name="model">tour.log</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.tour_log_report_pdf_template</field>
        <field name="report_file">guardpro.tour_log_report_pdf_template</field>
        <field name="print_report_name">'Tour_Log_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_tour_log"/>
        <field name="binding_type">report</field>
    </record>
</odoo>

