<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Report Action Definition -->
    <record id="action_site_security_summary_report" model="ir.actions.report">
        <field name="name">Site Security Summary</field>
        <field name="model">client.site</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.report_site_security_summary_document</field>
        <field name="report_file">guardpro.report_site_security_summary_document</field>
        <field name="binding_model_id" ref="model_client_site"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>
    
    <!-- Report Template -->
    <template id="report_site_security_summary_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        
                        <!-- Report Header -->
                        <div class="row" style="border-bottom: 3px solid #1976d2; padding-bottom: 15px; margin-bottom: 30px;">
                            <div class="col-8">
                                <h1 style="margin: 0; font-size: 28px; color: #1976d2;">SITE SECURITY SUMMARY</h1>
                                <p style="margin: 5px 0 0 0; color: #666; font-size: 14px;">Comprehensive Security Status Report</p>
                            </div>
                            <div class="col-4 text-right">
                                <p style="margin: 5px 0;"><strong>Site:</strong> <t t-esc="o.name"/></p>
                                <p style="margin: 5px 0;"><strong>Report Date:</strong> <t t-esc="get_current_date()"/></p>
                            </div>
                        </div>
                        
                        <!-- Site Information -->
                        <h2 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #1976d2;">Site Information</h2>
                        <table class="table table-sm table-bordered" style="margin-bottom: 30px;">
                            <tr>
                                <th style="width: 30%; background-color: #f5f5f5;">Site Name</th>
                                <td colspan="3"><strong><t t-esc="o.name"/></strong></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Address</th>
                                <td colspan="3">
                                    <t t-esc="o.street or ''"/>
                                    <t t-if="o.street2">, <t t-esc="o.street2"/></t><br/>
                                    <t t-esc="o.city or ''"/>, <t t-esc="o.state_id.name if o.state_id else ''"/> <t t-esc="o.zip or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Client</th>
                                <td><t t-esc="o.client_id.name if o.client_id else 'N/A'"/></td>
                                <th style="background-color: #f5f5f5;">Site Manager</th>
                                <td><t t-esc="o.manager_id.name if o.manager_id else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Site Status</th>
                                <td>
                                    <span t-att-style="'padding: 5px 15px; border-radius: 4px; font-weight: bold; color: white; background-color: %s;' % ('#4caf50' if o.active else '#999')"
                                          t-esc="'Active' if o.active else 'Inactive'"/>
                                </td>
                                <th style="background-color: #f5f5f5;">Site Type</th>
                                <td><t t-esc="dict(o._fields['site_type'].selection).get(o.site_type) if o.site_type else 'Not Specified'"/></td>
                            </tr>
                        </table>
                        
                        <!-- Security Statistics -->
                        <h2 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #1976d2;">Security Statistics</h2>
                        <div class="row" style="margin-bottom: 30px;">
                            <div class="col-3" style="text-align: center; padding: 15px; border: 1px solid #ddd; background-color: #e3f2fd;">
                                <h3 style="margin: 0; font-size: 32px; color: #1976d2;">
                                    <t t-esc="o.active_guards or 0"/>
                                </h3>
                                <p style="margin: 5px 0 0 0; font-size: 12px; color: #666;">Active Guards</p>
                            </div>
                            <div class="col-3" style="text-align: center; padding: 15px; border: 1px solid #ddd; background-color: #fff3e0;">
                                <h3 style="margin: 0; font-size: 32px; color: #ff9800;">
                                    <t t-esc="len(o.shift_ids.filtered(lambda s: s.status in ('scheduled', 'confirmed'))) if o.shift_ids else 0"/>
                                </h3>
                                <p style="margin: 5px 0 0 0; font-size: 12px; color: #666;">Scheduled Shifts</p>
                            </div>
                            <div class="col-3" style="text-align: center; padding: 15px; border: 1px solid #ddd; background-color: #ffebee;">
                                <h3 style="margin: 0; font-size: 32px; color: #d32f2f;">
                                    <t t-esc="len(o.incident_ids.filtered(lambda i: i.status not in ('resolved', 'closed'))) if o.incident_ids else 0"/>
                                </h3>
                                <p style="margin: 5px 0 0 0; font-size: 12px; color: #666;">Open Incidents</p>
                            </div>
                            <div class="col-3" style="text-align: center; padding: 15px; border: 1px solid #ddd; background-color: #e8f5e9;">
                                <h3 style="margin: 0; font-size: 32px; color: #4caf50;">
                                    <t t-esc="len(o.checkpoint_ids) if o.checkpoint_ids else 0"/>
                                </h3>
                                <p style="margin: 5px 0 0 0; font-size: 12px; color: #666;">Checkpoints</p>
                            </div>
                        </div>
                        
                        <!-- Recent Incidents Summary -->
                        <t t-if="o.incident_ids">
                            <h2 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #d32f2f;">Recent Incidents (Last 30 Days)</h2>
                            <t t-set="recent_incidents" t-value="o.incident_ids[:5]"/>
                            <table class="table table-sm table-bordered" style="margin-bottom: 30px;">
                                <thead style="background-color: #f5f5f5;">
                                    <tr>
                                        <th style="width: 20%;">Date</th>
                                        <th style="width: 40%;">Incident</th>
                                        <th style="width: 20%;">Severity</th>
                                        <th style="width: 20%;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="recent_incidents" t-as="incident">
                                        <tr>
                                            <td><t t-esc="format_date(incident.incident_datetime) if incident.incident_datetime else 'N/A'"/></td>
                                            <td><t t-esc="incident.title or incident.name"/></td>
                                            <td>
                                                <span t-att-style="'color: %s; font-weight: bold;' % ('#d32f2f' if incident.severity == 'critical' else '#ff9800' if incident.severity == 'high' else '#666')">
                                                    <t t-if="incident.severity">
                                                        <t t-esc="dict(incident._fields['severity'].selection).get(incident.severity)"/>
                                                    </t>
                                                    <t t-else="">N/A</t>
                                                </span>
                                            </td>
                                            <td>
                                                <t t-if="incident.status">
                                                    <t t-esc="dict(incident._fields['status'].selection).get(incident.status)"/>
                                                </t>
                                                <t t-else="">N/A</t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        
                        <!-- Key Issues/Concerns -->
                        <h2 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #ff9800; margin-top: 30px;">Key Issues &amp; Concerns</h2>
                        <div style="padding: 15px; background-color: #fff3e0; border: 1px solid #ff9800; min-height: 100px; margin-bottom: 20px;">
                            <p style="font-style: italic; color: #666;">To be filled by security manager...</p>
                        </div>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
    
</odoo>










