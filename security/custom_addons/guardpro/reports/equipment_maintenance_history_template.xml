<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="action_equipment_maintenance_history_report" model="ir.actions.report">
        <field name="name">Equipment Maintenance History</field>
        <field name="model">guardpro.equipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.report_equipment_maintenance_history_document</field>
        <field name="report_file">guardpro.report_equipment_maintenance_history_document</field>
        <field name="binding_model_id" ref="model_guardpro_equipment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>
    
    <template id="report_equipment_maintenance_history_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1 style="color: #607d8b;">EQUIPMENT MAINTENANCE HISTORY</h1>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <th style="width: 30%; background-color: #f5f5f5;">Equipment</th>
                                <td><t t-esc="o.name or 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Equipment Type</th>
                                <td><t t-esc="o.equipment_type if hasattr(o, 'equipment_type') else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Serial Number</th>
                                <td><t t-esc="o.serial_number if hasattr(o, 'serial_number') else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Last Maintenance</th>
                                <td><t t-esc="format_date(o.last_maintenance_date) if hasattr(o, 'last_maintenance_date') and o.last_maintenance_date else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Next Maintenance Due</th>
                                <td><t t-esc="format_date(o.next_maintenance_date) if hasattr(o, 'next_maintenance_date') and o.next_maintenance_date else 'N/A'"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
    
</odoo>

