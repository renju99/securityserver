<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="action_emergency_drill_report" model="ir.actions.report">
        <field name="name">Emergency Drill Report</field>
        <field name="model">emergency.procedure</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.report_emergency_drill_document</field>
        <field name="report_file">guardpro.report_emergency_drill_document</field>
        <field name="binding_model_id" ref="model_emergency_procedure"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>
    
    <template id="report_emergency_drill_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row" style="border-bottom: 3px solid #ff5722; padding-bottom: 15px; margin-bottom: 30px;">
                            <div class="col-8">
                                <h1 style="margin: 0; color: #ff5722;">EMERGENCY DRILL REPORT</h1>
                            </div>
                            <div class="col-4 text-right">
                                <p><strong>Drill Date:</strong> <t t-esc="format_date(o.start_time) if o.start_time else 'N/A'"/></p>
                            </div>
                        </div>
                        
                        <table class="table table-sm table-bordered">
                            <tr>
                                <th style="width: 30%; background-color: #f5f5f5;">Emergency Type</th>
                                <td><t t-esc="o.emergency_type or 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Site</th>
                                <td><t t-esc="o.site_id.name if o.site_id else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Drill Status</th>
                                <td><t t-esc="dict(o._fields['status'].selection).get(o.status, 'N/A') if hasattr(o, '_fields') and 'status' in o._fields else 'N/A'"/></td>
                            </tr>
                        </table>
                        
                        <t t-if="o.description">
                            <h3>Drill Scenario:</h3>
                            <div style="padding: 15px; background-color: #fafafa;">
                                <t t-raw="o.description"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
    
</odoo>










