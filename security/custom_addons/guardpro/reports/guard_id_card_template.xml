<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Guard ID Card PDF Template - Simplified for wkhtmltopdf -->
    <template id="guard_id_card_pdf_template">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <!-- Front Side - ID Card -->
                    <table style="width: 3.375in; height: 2.125in; border: 3px solid #2c3e50; 
                                  margin: 20px auto; background: #ffffff; border-collapse: collapse; table-layout: fixed;">
                        <!-- Header Row with Light Blue Background -->
                        <tr style="background-color: #7ec8e3; height: 55px;">
                            <td style="padding: 8px; width: 90px; vertical-align: middle;">
                                <!-- Company Logo -->
                                <t t-if="company_logo">
                                    <img t-att-src="image_data_uri(company_logo)" 
                                         style="max-width: 45px; max-height: 45px; background: white; 
                                                padding: 3px; border-radius: 3px; display: block;"/>
                                </t>
                                <t t-if="not company_logo">
                                    <div style="width: 45px; height: 45px; background: white; 
                                                border-radius: 3px; text-align: center; 
                                                line-height: 45px; font-weight: bold; color: #667eea; 
                                                font-size: 16px;">
                                        <span t-esc="company.name[0:2].upper() if company.name else 'ID'"/>
                                    </div>
                                </t>
                            </td>
                            <td style="padding: 8px 10px; text-align: right; vertical-align: middle; overflow: hidden;">
                                <div style="color: #2c3e50; font-size: 13px; text-transform: uppercase; 
                                            letter-spacing: 0.5px; font-weight: 700; line-height: 1.2; 
                                            white-space: nowrap;">
                                    SECURITY GUARD
                                </div>
                                <div style="color: #2c3e50; font-size: 9px; margin-top: 3px; opacity: 0.85;">
                                    Identification Card
                                </div>
                            </td>
                        </tr>
                        
                        <!-- Content Row -->
                        <tr style="height: 135px;">
                            <td style="padding: 12px 10px; vertical-align: top; width: 90px;">
                                <!-- Photo -->
                                <t t-set="guard_photo" t-value="doc.photo or False"/>
                                <t t-if="guard_photo">
                                    <img t-att-src="image_data_uri(guard_photo)" 
                                         style="width: 70px; height: 90px; object-fit: cover; 
                                                border: 2px solid #ddd; border-radius: 6px; 
                                                background: #f5f5f5; display: block;"/>
                                </t>
                                <t t-if="not guard_photo">
                                    <div style="width: 70px; height: 90px; background: #e8e8e8; 
                                                border: 2px solid #ddd; border-radius: 6px; 
                                                text-align: center; line-height: 90px; 
                                                color: #666; font-size: 36px; font-weight: 700;">
                                        <span t-esc="doc.name[0].upper() if doc.name else '?'"/>
                                    </div>
                                </t>
                            </td>
                            <td style="padding: 12px 12px 12px 8px; vertical-align: top;">
                                <!-- Name -->
                                <div style="font-size: 15px; font-weight: 700; margin-bottom: 8px; 
                                            color: #2c3e50; line-height: 1.2; text-transform: uppercase; 
                                            letter-spacing: 0.3px;">
                                    <span t-field="doc.name"/>
                                </div>
                                
                                <!-- Badge Number -->
                                <div style="font-size: 10px; margin-bottom: 5px; color: #555; line-height: 1.4;">
                                    <strong style="color: #333;">Badge:</strong> <span t-field="doc.badge_number"/>
                                </div>
                                
                                <!-- Phone -->
                                <div style="font-size: 10px; margin-bottom: 10px; color: #555; line-height: 1.4;">
                                    <strong style="color: #333;">Phone:</strong> <span t-field="doc.phone"/>
                                </div>
                                
                                <!-- Status Badge -->
                                <div style="margin-top: 8px;">
                                    <t t-if="doc.status == 'active'">
                                        <span style="display: inline-block; padding: 5px 14px; 
                                                   background: #27ae60; color: white; border-radius: 3px; 
                                                   font-size: 9px; font-weight: 700; text-transform: uppercase; 
                                                   letter-spacing: 0.5px;">
                                            ACTIVE
                                        </span>
                                    </t>
                                    <t t-if="doc.status == 'on_leave'">
                                        <span style="display: inline-block; padding: 5px 14px; 
                                                   background: #f39c12; color: white; border-radius: 3px; 
                                                   font-size: 9px; font-weight: 700; text-transform: uppercase; 
                                                   letter-spacing: 0.5px;">
                                            ON LEAVE
                                        </span>
                                    </t>
                                    <t t-if="doc.status in ['suspended', 'terminated']">
                                        <span style="display: inline-block; padding: 5px 14px; 
                                                   background: #e74c3c; color: white; border-radius: 3px; 
                                                   font-size: 9px; font-weight: 700; text-transform: uppercase; 
                                                   letter-spacing: 0.5px;">
                                            <t t-esc="doc.status.replace('_', ' ').upper()"/>
                                        </span>
                                    </t>
                                </div>
                            </td>
                        </tr>
                        
                        <!-- Footer Row -->
                        <tr style="background-color: #f8f9fa; height: 22px;">
                            <td colspan="2" style="padding: 6px 10px; text-align: center; 
                                                  font-size: 8px; color: #666; border-top: 1px solid #d0d0d0; 
                                                  line-height: 1.3;">
                                <span>Issued: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></span>
                                <t t-if="company.name">
                                    <span style="margin: 0 6px; color: #ccc;">|</span>
                                    <span t-field="company.name"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                    
                    <!-- Back Side of ID Card -->
                    <table style="width: 3.375in; height: 2.125in; border: 3px solid #2c3e50; 
                                  margin: 20px auto 0; background: #ffffff; border-collapse: collapse; 
                                  page-break-inside: avoid; table-layout: fixed;">
                        <!-- Header Row -->
                        <tr style="height: 38px; background-color: #7ec8e3;">
                            <td style="padding: 10px; text-align: center; vertical-align: middle;">
                                <div style="font-size: 11px; font-weight: 700; color: #2c3e50; 
                                            text-transform: uppercase; letter-spacing: 1px;">
                                    ADDITIONAL INFORMATION
                                </div>
                            </td>
                        </tr>
                        
                        <!-- Badge Number Row -->
                        <tr style="height: 70px;">
                            <td style="padding: 12px 15px; text-align: center; vertical-align: middle; 
                                       background-color: #fafafa;">
                                <div style="font-size: 9px; color: #999; margin-bottom: 6px; 
                                            text-align: center;">Badge Number</div>
                                <div style="font-size: 28px; font-weight: 700; color: #2c3e50; 
                                            letter-spacing: 2px; font-family: 'Courier New', monospace; 
                                            text-align: center;">
                                    <span t-field="doc.badge_number"/>
                                </div>
                            </td>
                        </tr>
                        
                        <!-- Emergency Contact Row -->
                        <tr style="height: 52px;">
                            <td style="padding: 12px 15px; vertical-align: middle; background-color: #fafafa;">
                                <t t-if="doc.emergency_contact">
                                    <div style="font-size: 9px; color: #555; margin-bottom: 4px; text-align: center;">
                                        <strong>Emergency Contact:</strong> <span t-field="doc.emergency_contact"/>
                                    </div>
                                    <t t-if="doc.emergency_phone">
                                        <div style="font-size: 9px; color: #777; text-align: center;">
                                            <strong>Phone:</strong> <span t-field="doc.emergency_phone"/>
                                        </div>
                                    </t>
                                </t>
                                <t t-if="not doc.emergency_contact">
                                    <div style="font-size: 9px; color: #999; text-align: center; 
                                                font-style: italic; padding: 8px 0;">
                                        No emergency contact on file
                                    </div>
                                </t>
                            </td>
                        </tr>
                        
                        <!-- Company Info Footer -->
                        <tr style="height: 62px; background-color: #f8f9fa;">
                            <td style="padding: 12px 10px; text-align: center; vertical-align: middle; 
                                      border-top: 1px solid #d0d0d0;">
                                <t t-if="company.name">
                                    <div style="font-size: 10px; color: #2c3e50; font-weight: 700; 
                                                margin-bottom: 4px; line-height: 1.3;">
                                        <span t-field="company.name"/>
                                    </div>
                                </t>
                                <t t-if="company.city">
                                    <div style="font-size: 9px; color: #666; line-height: 1.4;">
                                        <span t-field="company.city"/><t t-if="company.city and company.state_id">, </t><t t-if="company.state_id"><span t-field="company.state_id.name"/></t>
                                    </div>
                                </t>
                                <t t-if="company.phone">
                                    <div style="font-size: 8px; color: #888; margin-top: 3px;">
                                        <span t-field="company.phone"/>
                                    </div>
                                </t>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_guard_id_card" model="ir.actions.report">
        <field name="name">Guard ID Card</field>
        <field name="model">guard.profile</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.guard_id_card_pdf_template</field>
        <field name="report_file">guardpro.guard_id_card_pdf_template</field>
        <field name="print_report_name">'ID_Card_%s' % (object.name.replace(' ', '_'))</field>
        <field name="binding_model_id" ref="model_guard_profile"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="guardpro.paperformat_id_card"/>
    </record>
</odoo>
