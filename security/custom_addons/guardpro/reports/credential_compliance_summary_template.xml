<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="action_credential_compliance_summary_report" model="ir.actions.report">
        <field name="name">Credential Compliance Summary</field>
        <field name="model">guard.credential</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.report_credential_compliance_summary_document</field>
        <field name="report_file">guardpro.report_credential_compliance_summary_document</field>
        <field name="binding_model_id" ref="model_guard_credential"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>
    
    <template id="report_credential_compliance_summary_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1 style="color: #009688;">CREDENTIAL COMPLIANCE SUMMARY</h1>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <th style="width: 30%; background-color: #f5f5f5;">Guard</th>
                                <td><t t-esc="o.guard_id.name if o.guard_id else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Credential Type</th>
                                <td><t t-esc="o.credential_type_id.name if o.credential_type_id else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Issue Date</th>
                                <td><t t-esc="format_date(o.issue_date) if o.issue_date else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Expiry Date</th>
                                <td><strong style="color: #d32f2f;"><t t-esc="format_date(o.expiry_date) if o.expiry_date else 'N/A'"/></strong></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Status</th>
                                <td>
                                    <span t-att-style="'padding: 5px 15px; border-radius: 4px; font-weight: bold; color: white; background-color: %s;' % ('#4caf50' if o.status == 'active' else '#d32f2f')"
                                          t-esc="dict(o._fields['status'].selection).get(o.status, 'N/A') if hasattr(o, '_fields') and 'status' in o._fields else 'N/A'"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
    
</odoo>










