<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Facilities management / UAE operations incident PDF (Dubai-focused) -->
    <template id="incident_fm_uae_operations_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .page h2 { font-size: 18px !important; margin-bottom: 8px !important; }
                            .page h4 { font-size: 13px !important; margin-bottom: 6px !important; margin-top: 8px !important; }
                            .page .table td, .page .table th { font-size: 10px !important; padding: 4px 6px !important; }
                            .page .border { padding: 8px !important; }
                            .page .uae-footnote { font-size: 9px !important; color: #555; margin-top: 12px; }
                        </style>
                        <h2 class="text-center"><strong><span t-field="doc.category_id.name"/></strong></h2>
                        <p class="text-center text-muted" style="font-size: 11px;">Facilities management incident — UAE / Dubai operations</p>
                        <h4 class="text-center text-muted"><span t-field="doc.name"/></h4>

                        <div class="row mt-2">
                            <div class="col-12">
                                <table class="table table-bordered table-sm">
                                    <tr><td width="28%"><strong>Incident number</strong></td><td><span t-field="doc.name"/></td></tr>
                                    <tr><td><strong>Category</strong></td><td><span t-field="doc.category_id.name"/></td></tr>
                                    <tr><td><strong>Title</strong></td><td><span t-field="doc.title"/></td></tr>
                                    <tr><td><strong>Site</strong></td><td><span t-field="doc.site_id.name"/></td></tr>
                                    <tr><td><strong>Reported by</strong></td><td><span t-field="doc.guard_id.name"/></td></tr>
                                    <tr t-if="doc.shift_id"><td><strong>Shift</strong></td><td><span t-field="doc.shift_id.name"/></td></tr>
                                    <tr><td><strong>Incident date/time</strong></td><td><span t-field="doc.incident_datetime" t-options='{"widget": "datetime"}'/></td></tr>
                                    <tr><td><strong>Reported date/time</strong></td><td><span t-field="doc.reported_datetime" t-options='{"widget": "datetime"}'/></td></tr>
                                    <tr><td><strong>Severity</strong></td><td><span t-field="doc.severity"/></td></tr>
                                    <tr><td><strong>Status</strong></td><td><span t-field="doc.status"/></td></tr>
                                    <tr t-if="doc.location"><td><strong>Location</strong></td><td><span t-field="doc.location"/></td></tr>
                                    <tr t-if="doc.latitude"><td><strong>Coordinates</strong></td><td><t t-esc="doc.latitude"/>, <t t-esc="doc.longitude"/></td></tr>
                                    <tr t-if="doc.photo_ids"><td><strong>Photos attached</strong></td><td><t t-esc="len(doc.photo_ids)"/></td></tr>
                                </table>
                            </div>
                        </div>

                        <t t-call="guardpro.incident_map_snippet"/>

                        <div class="row mt-2">
                            <div class="col-12">
                                <h4><strong>Description</strong></h4>
                                <div class="border"><span t-field="doc.description"/></div>
                            </div>
                        </div>

                        <div class="row mt-2" t-if="doc.persons_involved or doc.witnesses">
                            <div class="col-12">
                                <h4><strong>People</strong></h4>
                                <table class="table table-bordered table-sm">
                                    <tr t-if="doc.persons_involved">
                                        <td width="28%"><strong>Persons involved</strong></td>
                                        <td><span t-field="doc.persons_involved"/></td>
                                    </tr>
                                    <tr t-if="doc.witnesses">
                                        <td><strong>Witnesses</strong></td>
                                        <td><span t-field="doc.witnesses"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-2" t-if="doc.immediate_actions">
                            <div class="col-12">
                                <h4><strong>Immediate actions</strong></h4>
                                <div class="border"><span t-field="doc.immediate_actions"/></div>
                            </div>
                        </div>

                        <div class="row mt-2" t-if="doc.police_notified or doc.medical_required or doc.ambulance_called or doc.fire_department or doc.client_notified">
                            <div class="col-12">
                                <h4><strong>Emergency &amp; authorities</strong></h4>
                                <table class="table table-bordered table-sm">
                                    <tr t-if="doc.police_notified">
                                        <td width="28%"><strong>Police notified</strong></td>
                                        <td>Yes <span t-if="doc.police_report_number">— ref. <span t-field="doc.police_report_number"/></span></td>
                                    </tr>
                                    <tr t-if="doc.medical_required">
                                        <td><strong>Medical assistance</strong></td>
                                        <td>Required</td>
                                    </tr>
                                    <tr t-if="doc.ambulance_called">
                                        <td><strong>Ambulance</strong></td>
                                        <td>Called</td>
                                    </tr>
                                    <tr t-if="doc.fire_department">
                                        <td><strong>Fire / Civil Defence</strong></td>
                                        <td>Notified</td>
                                    </tr>
                                    <tr t-if="doc.client_notified">
                                        <td><strong>Client notified</strong></td>
                                        <td>Yes — <span t-field="doc.client_notification_datetime" t-options='{"widget": "datetime"}'/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-2" t-if="doc.injuries or doc.property_damage or doc.estimated_cost">
                            <div class="col-12">
                                <h4><strong>Injuries &amp; damage</strong></h4>
                                <table class="table table-bordered table-sm">
                                    <tr t-if="doc.injuries">
                                        <td width="28%"><strong>Injuries</strong></td>
                                        <td><span t-field="doc.injury_details"/></td>
                                    </tr>
                                    <tr t-if="doc.property_damage">
                                        <td><strong>Property damage</strong></td>
                                        <td><span t-field="doc.damage_details"/></td>
                                    </tr>
                                    <tr t-if="doc.estimated_cost">
                                        <td><strong>Estimated cost</strong></td>
                                        <td><span t-field="doc.estimated_cost" t-options='{"widget": "monetary"}'/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-2" t-if="doc.reviewed_by">
                            <div class="col-12">
                                <h4><strong>Review</strong></h4>
                                <table class="table table-bordered table-sm">
                                    <tr><td width="28%"><strong>Reviewed by</strong></td><td><span t-field="doc.reviewed_by.name"/></td></tr>
                                    <tr><td><strong>Review date</strong></td><td><span t-field="doc.review_datetime" t-options='{"widget": "datetime"}'/></td></tr>
                                    <tr t-if="doc.review_notes"><td><strong>Notes</strong></td><td><span t-field="doc.review_notes"/></td></tr>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-2" t-if="doc.requires_followup">
                            <div class="col-12">
                                <h4><strong>Follow-up</strong></h4>
                                <table class="table table-bordered table-sm">
                                    <tr>
                                        <td width="28%"><strong>Status</strong></td>
                                        <td>
                                            <span t-if="doc.followup_completed">Completed</span>
                                            <span t-else="">Pending</span>
                                        </td>
                                    </tr>
                                    <tr t-if="doc.followup_notes"><td><strong>Notes</strong></td><td><span t-field="doc.followup_notes"/></td></tr>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-2" t-if="doc.notes">
                            <div class="col-12">
                                <h4><strong>Additional notes</strong></h4>
                                <div class="border"><span t-field="doc.notes"/></div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-6">
                                <p>__________________________<br/>Guard signature</p>
                            </div>
                            <div class="col-6">
                                <p>__________________________<br/>Supervisor signature</p>
                            </div>
                        </div>

                        <p class="uae-footnote">
                            Dubai / UAE reference numbers (confirm with your site procedure): Police 999, Ambulance 998, Civil Defence / Fire 997
                            (UAE Government portal u.ae — Handling emergencies). DEWA utility emergencies 991. Dubai Police non-emergency 901.
                            Gas leaks: use your building / utility provider emergency line.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

