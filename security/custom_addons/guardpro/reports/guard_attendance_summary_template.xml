<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Report Action Definition -->
    <record id="action_guard_attendance_summary_report" model="ir.actions.report">
        <field name="name">Guard Attendance Summary</field>
        <field name="model">guard.attendance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.report_guard_attendance_summary_document</field>
        <field name="report_file">guardpro.report_guard_attendance_summary_document</field>
        <field name="binding_model_id" ref="model_guard_attendance"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>
    
    <!-- Report Template -->
    <template id="report_guard_attendance_summary_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        
                        <!-- Report Header -->
                        <div class="row" style="border-bottom: 3px solid #2196f3; padding-bottom: 15px; margin-bottom: 30px;">
                            <div class="col-8">
                                <h1 style="margin: 0; font-size: 28px; color: #2196f3;">GUARD ATTENDANCE SUMMARY</h1>
                                <p style="margin: 5px 0 0 0; color: #666; font-size: 14px;">Time &amp; Attendance Report</p>
                            </div>
                            <div class="col-4 text-right">
                                <p style="margin: 5px 0;"><strong>Guard:</strong> <t t-esc="o.guard_id.name if o.guard_id else 'N/A'"/></p>
                                <p style="margin: 5px 0;"><strong>Date:</strong> <t t-esc="format_date(o.attendance_date) if o.attendance_date else 'N/A'"/></p>
                            </div>
                        </div>
                        
                        <!-- Guard Information -->
                        <table class="table table-sm table-bordered" style="margin-bottom: 30px;">
                            <tr>
                                <th style="width: 25%; background-color: #f5f5f5;">Guard Name</th>
                                <td><strong><t t-esc="o.guard_id.name if o.guard_id else 'N/A'"/></strong></td>
                                <th style="background-color: #f5f5f5;">Employee ID</th>
                                <td><t t-esc="o.guard_id.employee_number if o.guard_id and hasattr(o.guard_id, 'employee_number') else 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Project</th>
                                <td><t t-esc="o.site_id.name if o.site_id else 'N/A'"/></td>
                                <th style="background-color: #f5f5f5;">Shift Reference</th>
                                <td><t t-esc="o.shift_id.name if o.shift_id else 'N/A'"/></td>
                            </tr>
                        </table>
                        
                        <!-- Attendance Details -->
                        <h2 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #2196f3;">Attendance Details</h2>
                        <table class="table table-sm table-bordered" style="margin-bottom: 30px;">
                            <tr>
                                <th style="width: 30%; background-color: #f5f5f5;">Check-In Time</th>
                                <td>
                                    <strong><t t-esc="format_datetime(o.check_in_time) if o.check_in_time else 'N/A'"/></strong>
                                    <t t-if="o.check_in_method">
                                        <br/><small style="color: #666;">Method: <t t-esc="o.check_in_method"/></small>
                                    </t>
                                </td>
                                <th style="background-color: #f5f5f5;">Check-Out Time</th>
                                <td>
                                    <strong><t t-esc="format_datetime(o.check_out_time) if o.check_out_time else 'Not checked out'"/></strong>
                                    <t t-if="o.check_out_method">
                                        <br/><small style="color: #666;">Method: <t t-esc="o.check_out_method"/></small>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Total Hours</th>
                                <td><strong style="font-size: 18px; color: #2196f3;">
                                    <t t-esc="'{:.2f}'.format(o.total_hours) if hasattr(o, 'total_hours') and o.total_hours else 'N/A'"/> hours
                                </strong></td>
                                <th style="background-color: #f5f5f5;">Status</th>
                                <td>
                                    <span t-att-style="'padding: 5px 15px; border-radius: 4px; font-weight: bold; color: white; background-color: %s;' % ('#4caf50' if o.status == 'completed' else '#ff9800' if o.status == 'active' else '#666')"
                                          t-esc="dict(o._fields['status'].selection).get(o.status, 'N/A') if hasattr(o, '_fields') and 'status' in o._fields else 'N/A'"/>
                                </td>
                            </tr>
                        </table>
                        
                        <!-- GPS Verification -->
                        <t t-if="o.check_in_latitude or o.check_out_latitude">
                            <h2 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #2196f3;">GPS Verification</h2>
                            <table class="table table-sm table-bordered" style="margin-bottom: 30px;">
                                <tr>
                                    <th style="width: 30%; background-color: #f5f5f5;">Check-In Location</th>
                                    <td>
                                        <t t-if="o.check_in_latitude and o.check_in_longitude">
                                            Lat: <t t-esc="'{:.6f}'.format(o.check_in_latitude)"/>, 
                                            Lon: <t t-esc="'{:.6f}'.format(o.check_in_longitude)"/>
                                        </t>
                                        <t t-else="">N/A</t>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="background-color: #f5f5f5;">Check-Out Location</th>
                                    <td>
                                        <t t-if="o.check_out_latitude and o.check_out_longitude">
                                            Lat: <t t-esc="'{:.6f}'.format(o.check_out_latitude)"/>, 
                                            Lon: <t t-esc="'{:.6f}'.format(o.check_out_longitude)"/>
                                        </t>
                                        <t t-else="">N/A</t>
                                    </td>
                                </tr>
                            </table>
                        </t>
                        
                        <!-- Notes -->
                        <t t-if="o.notes">
                            <h2 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #2196f3;">Notes</h2>
                            <div style="padding: 15px; background-color: #fafafa; border: 1px solid #ddd; margin-bottom: 30px;">
                                <t t-esc="o.notes"/>
                            </div>
                        </t>
                        
                        <!-- Signatures -->
                        <div class="row" style="margin-top: 80px; page-break-inside: avoid;">
                            <div class="col-6">
                                <div style="border-top: 2px solid #000; padding-top: 10px; margin-top: 50px;">
                                    <p style="margin: 0;"><strong>Guard Signature:</strong></p>
                                    <p style="margin: 5px 0;"><t t-esc="o.guard_id.name if o.guard_id else '_______________________________'"/></p>
                                    <p style="margin: 5px 0;">Date: <t t-esc="format_date(o.attendance_date) if o.attendance_date else '__________'"/></p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="border-top: 2px solid #000; padding-top: 10px; margin-top: 50px;">
                                    <p style="margin: 0;"><strong>Supervisor Approval:</strong></p>
                                    <p style="margin: 5px 0;">_______________________________</p>
                                    <p style="margin: 5px 0;">Date: __________</p>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
    
</odoo>










