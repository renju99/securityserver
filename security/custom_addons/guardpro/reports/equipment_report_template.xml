<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Equipment PDF Report Template -->
    <template id="equipment_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2>Equipment Record</h2>
                                <h4 t-if="o.site_id" t-field="o.site_id.name"/>
                            </div>
                        </div>

                        <!-- Equipment Information -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Equipment Details</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Equipment Name:</strong></td>
                                        <td t-field="o.name"/>
                                    </tr>
                                    <tr t-if="o.equipment_type">
                                        <td><strong>Equipment Type:</strong></td>
                                        <td><span t-field="o.equipment_type"/></td>
                                    </tr>
                                    <tr t-if="o.serial_number">
                                        <td><strong>Serial Number:</strong></td>
                                        <td t-field="o.serial_number"/>
                                    </tr>
                                    <tr t-if="o.asset_number">
                                        <td><strong>Asset Number:</strong></td>
                                        <td t-field="o.asset_number"/>
                                    </tr>
                                    <tr t-if="o.manufacturer">
                                        <td><strong>Manufacturer:</strong></td>
                                        <td t-field="o.manufacturer"/>
                                    </tr>
                                    <tr t-if="o.model">
                                        <td><strong>Model:</strong></td>
                                        <td t-field="o.model"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td>
                                            <t t-if="o.status == 'available'">
                                                <span class="badge bg-success">Available</span>
                                            </t>
                                            <t t-elif="o.status == 'in_use'">
                                                <span class="badge bg-info">In Use</span>
                                            </t>
                                            <t t-elif="o.status == 'maintenance'">
                                                <span class="badge bg-warning">Maintenance</span>
                                            </t>
                                            <t t-elif="o.status == 'broken'">
                                                <span class="badge bg-danger">Broken</span>
                                            </t>
                                            <t t-elif="o.status == 'retired'">
                                                <span class="badge bg-secondary">Retired</span>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Location &amp; Assignment -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Location &amp; Assignment</h5>
                                <table class="table table-bordered">
                                    <tr t-if="o.site_id">
                                        <td width="30%"><strong>Project:</strong></td>
                                        <td t-field="o.site_id.name"/>
                                    </tr>
                                    <tr t-if="o.location">
                                        <td><strong>Location:</strong></td>
                                        <td t-field="o.location"/>
                                    </tr>
                                    <tr t-if="o.assigned_to">
                                        <td><strong>Assigned To:</strong></td>
                                        <td t-field="o.assigned_to.name"/>
                                    </tr>
                                    <tr t-if="o.assignment_date">
                                        <td><strong>Assignment Date:</strong></td>
                                        <td t-field="o.assignment_date"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Purchase &amp; Warranty -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Purchase &amp; Warranty Information</h5>
                                <table class="table table-bordered">
                                    <tr t-if="o.purchase_date">
                                        <td width="30%"><strong>Purchase Date:</strong></td>
                                        <td t-field="o.purchase_date"/>
                                    </tr>
                                    <tr t-if="o.purchase_cost">
                                        <td><strong>Purchase Cost:</strong></td>
                                        <td>
                                            <span t-field="o.purchase_cost"/>
                                            <span t-if="o.currency_id" t-field="o.currency_id.symbol"/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.warranty_expiry">
                                        <td><strong>Warranty Expiry:</strong></td>
                                        <td t-field="o.warranty_expiry"/>
                                    </tr>
                                    <tr t-if="o.supplier_id">
                                        <td><strong>Supplier:</strong></td>
                                        <td t-field="o.supplier_id.name"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Maintenance Schedule -->
                        <div class="row mt-3" t-if="o.last_maintenance_date or o.next_maintenance_date">
                            <div class="col-12">
                                <h5>Maintenance Schedule</h5>
                                <table class="table table-bordered">
                                    <tr t-if="o.last_maintenance_date">
                                        <td width="30%"><strong>Last Maintenance:</strong></td>
                                        <td t-field="o.last_maintenance_date"/>
                                    </tr>
                                    <tr t-if="o.next_maintenance_date">
                                        <td><strong>Next Maintenance:</strong></td>
                                        <td t-field="o.next_maintenance_date"/>
                                    </tr>
                                    <tr t-if="o.maintenance_frequency">
                                        <td><strong>Maintenance Frequency:</strong></td>
                                        <td t-field="o.maintenance_frequency"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Equipment Photo -->
                        <div class="row mt-3" t-if="o.image">
                            <div class="col-12 text-center">
                                <h5>Equipment Photo</h5>
                                <img t-att-src="image_data_uri(o.image)" 
                                     style="max-width: 100%; max-height: 300px; border: 2px solid #ccc;"/>
                            </div>
                        </div>

                        <!-- Specifications -->
                        <div class="row mt-3" t-if="o.specifications">
                            <div class="col-12">
                                <h5>Specifications</h5>
                                <p t-field="o.specifications"/>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="row mt-3" t-if="o.notes">
                            <div class="col-12">
                                <strong>Additional Notes:</strong>
                                <p t-field="o.notes"/>
                            </div>
                        </div>

                        <!-- QR Code for tracking -->
                        <div class="row mt-3" t-if="o.qr_code">
                            <div class="col-12 text-center">
                                <strong>Equipment QR Code:</strong><br/>
                                <img t-att-src="image_data_uri(o.qr_code)" 
                                     style="max-height: 150px; max-width: 150px;"/>
                                <p class="text-muted small">Scan to track equipment</p>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="row mt-5">
                            <div class="col-12 text-center text-muted">
                                <small>
                                    Equipment Record - For Internal Use
                                    <br/>
                                    Report any equipment issues immediately
                                </small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Report Definition -->
    <record id="action_report_equipment" model="ir.actions.report">
        <field name="name">Equipment Record</field>
        <field name="model">guardpro.equipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.equipment_report_template</field>
        <field name="report_file">guardpro.equipment_report_template</field>
        <field name="binding_model_id" ref="model_guardpro_equipment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Equipment_%s' % (object.name)</field>
    </record>
</odoo>

