<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="action_sla_performance_detailed_report" model="ir.actions.report">
        <field name="name">SLA Performance Report</field>
        <field name="model">sla.definition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.report_sla_performance_document</field>
        <field name="report_file">guardpro.report_sla_performance_document</field>
        <field name="binding_model_id" ref="model_sla_definition"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>
    
    <template id="report_sla_performance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row" style="border-bottom: 3px solid #673ab7; padding-bottom: 15px; margin-bottom: 30px;">
                            <div class="col-8">
                                <h1 style="margin: 0; color: #673ab7;">SLA PERFORMANCE REPORT</h1>
                            </div>
                            <div class="col-4 text-right">
                                <p><strong>SLA:</strong> <t t-esc="o.name"/></p>
                                <p><strong>Client:</strong> <t t-esc="o.client_id.name if o.client_id else 'N/A'"/></p>
                            </div>
                        </div>
                        
                        <table class="table table-sm table-bordered">
                            <tr>
                                <th style="width: 30%; background-color: #f5f5f5;">Contract Reference</th>
                                <td><t t-esc="o.contract_reference or 'N/A'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Period</th>
                                <td><t t-esc="format_date(o.start_date) if o.start_date else 'N/A'"/> to <t t-esc="format_date(o.end_date) if o.end_date else 'Ongoing'"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f5f5f5;">Current Compliance</th>
                                <td><strong style="font-size: 18px; color: #4caf50;"><t t-esc="'{:.1f}'.format(o.current_compliance) if o.current_compliance else '0.0'"/>%</strong></td>
                            </tr>
                        </table>
                        
                        <t t-if="o.kpi_ids">
                            <h3>KPI Performance:</h3>
                            <table class="table table-sm table-bordered">
                                <thead style="background-color: #f5f5f5;">
                                    <tr>
                                        <th>KPI Name</th>
                                        <th>Target</th>
                                        <th>Actual</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.kpi_ids[:10]" t-as="kpi">
                                        <tr>
                                            <td><t t-esc="kpi.name if hasattr(kpi, 'name') else 'KPI'"/></td>
                                            <td><t t-esc="kpi.target_value if hasattr(kpi, 'target_value') else 'N/A'"/></td>
                                            <td><t t-esc="kpi.actual_value if hasattr(kpi, 'actual_value') else 'N/A'"/></td>
                                            <td>
                                                <span t-att-style="'color: %s;' % ('#4caf50' if hasattr(kpi, 'is_achieved') and kpi.is_achieved else '#d32f2f')">
                                                    <t t-esc="'Achieved' if hasattr(kpi, 'is_achieved') and kpi.is_achieved else 'Not Met'"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
    
</odoo>










