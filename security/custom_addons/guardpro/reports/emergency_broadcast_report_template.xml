<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Emergency Broadcast PDF Report Template -->
    <template id="emergency_broadcast_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2>Emergency Broadcast Report</h2>
                            </div>
                        </div>

                        <!-- Priority Banner -->
                        <div class="row mb-3">
                            <div class="col-12 text-center">
                                <h4>
                                    Priority: 
                                    <t t-if="o.priority == 'urgent'">
                                        <span class="badge bg-danger" style="font-size: 1.2em;">URGENT</span>
                                    </t>
                                    <t t-elif="o.priority == 'high'">
                                        <span class="badge bg-warning" style="font-size: 1.2em;">HIGH</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge bg-info" style="font-size: 1.2em;">NORMAL</span>
                                    </t>
                                </h4>
                            </div>
                        </div>

                        <!-- Broadcast Details -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Broadcast Information</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Title:</strong></td>
                                        <td><h5 class="mb-0" t-field="o.title"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Broadcast Type:</strong></td>
                                        <td>
                                            <span t-if="o.broadcast_type == 'all'">All Guards</span>
                                            <span t-if="o.broadcast_type == 'by_site'">Guards by Project</span>
                                            <span t-if="o.broadcast_type == 'active_only'">Only Active Guards on Duty</span>
                                        </td>
                                    </tr>
                                    <tr t-if="o.site_id">
                                        <td><strong>Specific Project:</strong></td>
                                        <td t-field="o.site_id.name"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Broadcast Time:</strong></td>
                                        <td t-field="o.create_date"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td>
                                            <t t-if="o.state == 'draft'">
                                                <span class="badge bg-secondary">Draft</span>
                                            </t>
                                            <t t-elif="o.state == 'sent'">
                                                <span class="badge bg-success">Sent</span>
                                            </t>
                                            <t t-elif="o.state == 'expired'">
                                                <span class="badge bg-dark">Expired</span>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Emergency Message -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="alert alert-danger">
                                    <h4>Emergency Message:</h4>
                                    <p class="mb-0" style="font-size: 1.1em;" t-field="o.message"/>
                                </div>
                            </div>
                        </div>

                        <!-- Acknowledgment Statistics -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5>Acknowledgment Statistics</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="30%"><strong>Total Guards Notified:</strong></td>
                                        <td><h5 class="mb-0" t-field="o.total_guards"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Acknowledged:</strong></td>
                                        <td>
                                            <span class="badge bg-success" style="font-size: 1.1em;">
                                                <span t-field="o.acknowledged_count"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Pending:</strong></td>
                                        <td>
                                            <span class="badge bg-warning" style="font-size: 1.1em;">
                                                <span t-field="o.pending_count"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Acknowledgment Rate:</strong></td>
                                        <td>
                                            <t t-if="o.acknowledgment_rate &gt;= 90">
                                                <span class="badge bg-success" style="font-size: 1.1em;">
                                                    <span t-field="o.acknowledgment_rate"/>%
                                                </span>
                                            </t>
                                            <t t-elif="o.acknowledgment_rate &gt;= 70">
                                                <span class="badge bg-info" style="font-size: 1.1em;">
                                                    <span t-field="o.acknowledgment_rate"/>%
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-warning" style="font-size: 1.1em;">
                                                    <span t-field="o.acknowledgment_rate"/>%
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Acknowledgment Details -->
                        <div class="row mt-4" t-if="o.acknowledgment_ids">
                            <div class="col-12">
                                <h5>Guard Acknowledgments</h5>
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr class="table-active">
                                            <th>Guard Name</th>
                                            <th>Project</th>
                                            <th>Acknowledged</th>
                                            <th>Acknowledgment Time</th>
                                            <th>Response Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.acknowledgment_ids" t-as="ack">
                                            <tr>
                                                <td t-field="ack.guard_id.name"/>
                                                <td t-if="ack.guard_id.current_site_id" t-field="ack.guard_id.current_site_id.name"/>
                                                <td t-else="">-</td>
                                                <td>
                                                    <t t-if="ack.acknowledged">
                                                        <span class="badge bg-success">✓ Yes</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-warning">☐ Pending</span>
                                                    </t>
                                                </td>
                                                <td>
                                                    <span t-if="ack.acknowledged_at" t-field="ack.acknowledged_at"/>
                                                    <span t-else="">-</span>
                                                </td>
                                                <td>
                                                    <span t-if="ack.response_time_minutes">
                                                        <span t-field="ack.response_time_minutes"/> min
                                                    </span>
                                                    <span t-else="">-</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pending Guards Alert -->
                        <div class="row mt-3" t-if="o.pending_count &gt; 0">
                            <div class="col-12">
                                <div class="alert alert-warning">
                                    <strong>⚠ Warning:</strong> <span t-field="o.pending_count"/> guard(s) have not yet acknowledged this emergency broadcast.
                                    Follow-up action may be required.
                                </div>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="row mt-5">
                            <div class="col-12 text-center text-muted">
                                <small>
                                    Emergency Broadcast Report - Confidential
                                    <br/>
                                    Document generated for accountability and incident documentation
                                </small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Report Definition -->
    <record id="action_report_emergency_broadcast" model="ir.actions.report">
        <field name="name">Emergency Broadcast Report</field>
        <field name="model">emergency.broadcast</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">guardpro.emergency_broadcast_report_template</field>
        <field name="report_file">guardpro.emergency_broadcast_report_template</field>
        <field name="binding_model_id" ref="model_emergency_broadcast"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Emergency_Broadcast_%s' % (object.title)</field>
    </record>
</odoo>

