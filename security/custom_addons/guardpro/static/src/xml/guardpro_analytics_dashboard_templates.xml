<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Main Dashboard Template -->
    <t t-name="guardpro.DashboardView">
        <div class="o_guardpro_analytics_dashboard_view">
            <!-- Header with Refresh Button -->
            <div class="o_dashboard_header d-flex justify-content-between align-items-center mb-4">
                <div class="o_dashboard_title">
                    <h2 class="mb-0">
                        <i class="fa fa-tachometer me-2"/>
                        GuardPro Analytics Dashboard
                    </h2>
                    <p class="text-muted mb-0">Real-time security operations overview</p>
                </div>
                <div class="o_dashboard_controls">
                    <button class="btn btn-primary" t-on-click="onRefresh" t-att-disabled="state.loading">
                        <i class="fa fa-refresh me-1" t-att-class="{'fa-spin': state.loading}"/>
                        Refresh
                    </button>
                </div>
            </div>

            <!-- Filters Panel -->
            <div class="o_dashboard_filters card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fa fa-filter me-2"/>
                        Filters
                    </h6>
                    <button t-if="hasActiveFilters()" class="btn btn-sm btn-link text-danger p-0" 
                            t-on-click="clearFilters">
                        <i class="fa fa-times me-1"/>
                        Clear All
                    </button>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Period Quick Filters -->
                        <div class="col-md-12">
                            <label class="form-label small text-muted mb-2">
                                <i class="fa fa-calendar me-1"/>
                                Quick Period Select
                            </label>
                            <div class="btn-group" role="group">
                                <button type="button" 
                                        t-att-class="state.filters.period == 'today' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-primary'"
                                        t-on-click="onFilterChange('period', 'today')">
                                    Today
                                </button>
                                <button type="button" 
                                        t-att-class="state.filters.period == 'yesterday' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-primary'"
                                        t-on-click="onFilterChange('period', 'yesterday')">
                                    Yesterday
                                </button>
                                <button type="button" 
                                        t-att-class="state.filters.period == 'last_7_days' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-primary'"
                                        t-on-click="onFilterChange('period', 'last_7_days')">
                                    Last 7 Days
                                </button>
                                <button type="button" 
                                        t-att-class="state.filters.period == 'this_week' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-primary'"
                                        t-on-click="onFilterChange('period', 'this_week')">
                                    This Week
                                </button>
                                <button type="button" 
                                        t-att-class="state.filters.period == 'this_month' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-primary'"
                                        t-on-click="onFilterChange('period', 'this_month')">
                                    This Month
                                </button>
                                <button type="button" 
                                        t-att-class="state.filters.period == 'last_30_days' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-primary'"
                                        t-on-click="onFilterChange('period', 'last_30_days')">
                                    Last 30 Days
                                </button>
                            </div>
                        </div>

                        <!-- Custom Date Range -->
                        <div class="col-md-12">
                            <label class="form-label small text-muted mb-2">
                                <i class="fa fa-calendar-check-o me-1"/>
                                Custom Date Range
                            </label>
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           t-att-value="state.filters.date_from"
                                           t-on-change="(ev) => onDateRangeChange(ev.target.value, state.filters.date_to)"/>
                                </div>
                                <div class="col-md-1 text-center align-self-center">
                                    <i class="fa fa-arrow-right text-muted"/>
                                </div>
                                <div class="col-md-5">
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           t-att-value="state.filters.date_to"
                                           t-on-change="(ev) => onDateRangeChange(state.filters.date_from, ev.target.value)"/>
                                </div>
                                <div class="col-md-1">
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-secondary w-100"
                                            t-on-click="() => onFilterChange('period', 'custom')">
                                        <i class="fa fa-calendar"/>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Site Filter -->
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-2">
                                <i class="fa fa-map-marker me-1"/>
                                Sites
                            </label>
                            <select class="form-select form-select-sm" 
                                    multiple="multiple"
                                    size="3"
                                    t-on-change="(ev) => onMultiSelectChange('site_ids', Array.from(ev.target.selectedOptions).map(opt => parseInt(opt.value)))">
                                <option value="">All Sites</option>
                                <t t-foreach="state.filterOptions.sites" t-as="site" t-key="site.id">
                                    <option t-att-value="site.id" 
                                            t-att-selected="state.filters.site_ids.includes(site.id)">
                                        <t t-esc="site.code ? site.code + ' - ' + site.name : site.name"/>
                                    </option>
                                </t>
                            </select>
                            <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
                        </div>

                        <!-- Guard Filter -->
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-2">
                                <i class="fa fa-user-shield me-1"/>
                                Guards
                            </label>
                            <select class="form-select form-select-sm" 
                                    multiple="multiple"
                                    size="3"
                                    t-on-change="(ev) => onMultiSelectChange('guard_ids', Array.from(ev.target.selectedOptions).map(opt => parseInt(opt.value)))">
                                <option value="">All Guards</option>
                                <t t-foreach="state.filterOptions.guards" t-as="guard" t-key="guard.id">
                                    <option t-att-value="guard.id" 
                                            t-att-selected="state.filters.guard_ids.includes(guard.id)">
                                        <t t-esc="guard.badge_number ? guard.badge_number + ' - ' + guard.name : guard.name"/>
                                    </option>
                                </t>
                            </select>
                            <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
                        </div>

                        <!-- Client Filter -->
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-2">
                                <i class="fa fa-building me-1"/>
                                Clients
                            </label>
                            <select class="form-select form-select-sm" 
                                    multiple="multiple"
                                    size="3"
                                    t-on-change="(ev) => onMultiSelectChange('client_ids', Array.from(ev.target.selectedOptions).map(opt => parseInt(opt.value)))">
                                <option value="">All Clients</option>
                                <t t-foreach="state.filterOptions.clients" t-as="client" t-key="client.id">
                                    <option t-att-value="client.id" 
                                            t-att-selected="state.filters.client_ids.includes(client.id)">
                                        <t t-esc="client.name"/>
                                    </option>
                                </t>
                            </select>
                            <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
                        </div>

                        <!-- Active Filters Summary -->
                        <t t-if="hasActiveFilters()">
                            <div class="col-md-12">
                                <div class="alert alert-info mb-0 py-2">
                                    <i class="fa fa-info-circle me-2"/>
                                    <strong>Active Filters:</strong>
                                    <span class="ms-2">
                                        <t t-if="state.filters.site_ids.length > 0">
                                            <span class="badge bg-primary me-1">
                                                <t t-esc="state.filters.site_ids.length"/> Site(s)
                                            </span>
                                        </t>
                                        <t t-if="state.filters.guard_ids.length > 0">
                                            <span class="badge bg-success me-1">
                                                <t t-esc="state.filters.guard_ids.length"/> Guard(s)
                                            </span>
                                        </t>
                                        <t t-if="state.filters.client_ids.length > 0">
                                            <span class="badge bg-warning me-1">
                                                <t t-esc="state.filters.client_ids.length"/> Client(s)
                                            </span>
                                        </t>
                                        <span class="badge bg-secondary me-1">
                                            <t t-esc="state.filters.date_from"/> to <t t-esc="state.filters.date_to"/>
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Loading State -->
            <div t-if="state.loading" class="o_dashboard_loading text-center py-5">
                <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                <p class="mt-3 text-muted">Loading analytics data...</p>
            </div>

            <!-- Error State -->
            <div t-if="state.error and !state.loading" class="alert alert-danger" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                <t t-esc="state.error"/>
            </div>

            <!-- Dashboard Content -->
            <div t-if="!state.loading and !state.error" class="o_dashboard_content">
                <!-- KPIs Row -->
                <div class="o_dashboard_kpis mb-4">
                    <div class="row g-3">
                        <t t-foreach="state.data.kpis" t-as="kpi" t-key="kpi_index">
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <KPICardWidget data="kpi" onCardClick.bind="onKPICardClick"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="o_dashboard_charts mb-4">
                    <div class="row g-3">
                        <t t-foreach="state.data.charts" t-as="chart" t-key="chart_index">
                            <div t-attf-class="col-lg-{{ chart_index % 3 === 0 ? '12' : '6' }} col-md-6">
                                <ChartWidget data="chart"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Tables Section -->
                <div class="o_dashboard_tables">
                    <div class="row g-3">
                        <t t-foreach="state.data.tables" t-as="table" t-key="table_index">
                            <div class="col-lg-12">
                                <TableWidget data="table"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- KPI Card Template -->
    <t t-name="guardpro.KPICardWidget">
        <div class="o_kpi_card card shadow-sm h-100" t-on-click="onCardClick" 
             t-att-class="props.data.action ? 'cursor-pointer' : ''">
            <div class="card-body d-flex align-items-center">
                <!-- Icon -->
                <div class="o_kpi_icon me-3">
                    <div t-attf-class="o_kpi_icon_wrapper rounded-circle bg-{{props.data.color}}-subtle p-3">
                        <i t-attf-class="fa {{props.data.icon}} fa-2x text-{{props.data.color}}"/>
                    </div>
                </div>
                
                <!-- Content -->
                <div class="o_kpi_content flex-grow-1">
                    <div class="o_kpi_name text-muted small mb-1">
                        <t t-esc="props.data.name"/>
                    </div>
                    <div class="o_kpi_value h3 mb-1 fw-bold">
                        <t t-esc="props.data.value"/>
                        <t t-if="props.data.suffix">
                            <span class="h5 text-muted ms-1">
                                <t t-esc="props.data.suffix"/>
                            </span>
                        </t>
                    </div>
                    <div class="o_kpi_variance small" t-att-class="varianceClass" t-if="variance != 0">
                        <i t-att-class="'fa ' + varianceIcon + ' me-1'"/>
                        <t t-esc="Math.abs(variance)"/>% vs last month
                    </div>
                    <div class="o_kpi_variance small text-muted" t-if="variance == 0">
                        <i class="fa fa-minus me-1"/>
                        No change
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Chart Widget Template -->
    <t t-name="guardpro.ChartWidget">
        <div class="o_chart_widget card shadow-sm h-100">
            <div class="card-header bg-light border-bottom">
                <h5 class="mb-0">
                    <i class="fa fa-bar-chart me-2 text-primary"/>
                    <t t-esc="props.data.title"/>
                </h5>
            </div>
            <div class="card-body p-3">
                <div class="o_chart_container" style="position: relative; height: 300px;">
                    <canvas t-ref="chart"/>
                </div>
            </div>
        </div>
    </t>

    <!-- Table Widget Template -->
    <t t-name="guardpro.TableWidget">
        <div class="o_table_widget card shadow-sm">
            <div class="card-header bg-light border-bottom">
                <h5 class="mb-0">
                    <i class="fa fa-table me-2 text-primary"/>
                    <t t-esc="props.data.title"/>
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <t t-foreach="props.data.columns" t-as="column" t-key="column_index">
                                    <th class="text-nowrap">
                                        <t t-esc="column"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="props.data.rows.length > 0">
                                <t t-foreach="props.data.rows" t-as="row" t-key="row_index">
                                    <tr>
                                        <t t-foreach="row" t-as="cell" t-key="cell_index">
                                            <td class="text-nowrap">
                                                <t t-esc="cell"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td t-att-colspan="props.data.columns.length" class="text-center text-muted py-4">
                                        <i class="fa fa-info-circle me-2"/>
                                        No data available
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>

</templates>

