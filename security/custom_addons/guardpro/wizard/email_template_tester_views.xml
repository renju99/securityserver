<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Email Template Tester Wizard Form View -->
    <record id="view_email_template_tester_form" model="ir.ui.view">
        <field name="name">email.template.tester.form</field>
        <field name="model">email.template.tester</field>
        <field name="arch" type="xml">
            <form string="Email Template Tester">
                <group>
                    <group>
                        <field name="template_id" options="{'no_create': True}"/>
                        <field name="test_record_id"/>
                    </group>
                    <group>
                        <field name="test_mode" widget="radio"/>
                        <field name="test_email"/>
                    </group>
                </group>
                <group>
                    <field name="result_html" nolabel="1"/>
                </group>
                <footer>
                    <button string="Test Single Template" name="action_test_template" type="object" class="btn-primary"/>
                    <button string="Test All Templates" name="action_test_all_templates" type="object" class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Email Template Tester Wizard Action -->
    <record id="action_email_template_tester" model="ir.actions.act_window">
        <field name="name">Email Template Tester</field>
        <field name="res_model">email.template.tester</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>


