<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shift_template_generate_wizard_form" model="ir.ui.view">
        <field name="name">shift.template.generate.wizard.form</field>
        <field name="model">shift.template.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Shifts from Template">
                <group>
                    <field name="template_id" readonly="1"/>
                    <field name="recurrence_summary" readonly="1"/>
                </group>
                <div class="mb-2">
                    <button name="action_preset_this_week" type="object"
                            string="This week" class="btn btn-secondary me-1"/>
                    <button name="action_preset_next_14" type="object"
                            string="Next 14 days" class="btn btn-secondary me-1"/>
                    <button name="action_preset_next_month" type="object"
                            string="Next month" class="btn btn-secondary"/>
                </div>
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="preview_date_count"/>
                    <field name="preview_shift_count"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <i class="fa fa-info-circle" title="Information" aria-label="Information"/>
                    Will create about <strong><field name="preview_shift_count"/></strong>
                    shift(s) on <field name="preview_date_count"/> matching day(s).
                    Existing shifts for the same guard/day/template are updated, not duplicated.
                </div>
                <footer>
                    <button name="action_generate_shifts"
                            string="Generate Shifts"
                            type="object"
                            class="btn-primary"
                            invisible="preview_shift_count &lt;= 0"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shift_template_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Shifts</field>
        <field name="res_model">shift.template.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
