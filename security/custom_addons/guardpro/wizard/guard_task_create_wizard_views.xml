<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Guard Task Create Wizard Form -->
    <record id="view_guard_task_create_wizard_form" model="ir.ui.view">
        <field name="name">guard.task.create.wizard.form</field>
        <field name="model">guard.task.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Task from Template">
                <group>
                    <group>
                        <field name="template_id" options="{'no_create': True}"/>
                        <field name="name"/>
                        <field name="task_type"/>
                        <field name="site_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="assigned_to"/>
                        <field name="shift_id" options="{'no_create': True}"/>
                        <field name="priority" widget="priority"/>
                        <field name="due_date"/>
                    </group>
                </group>
                <group>
                    <field name="description"/>
                </group>
                <footer>
                    <button string="Create Task" name="action_create_task" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

