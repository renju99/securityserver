<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Note: This test data references demo sites (site_nshama_town_square and site_nshama_springs).
        To load these cameras, either:
        1. Enable demo data when installing/upgrading the module, OR
        2. Create the sites manually first (they are defined in demo/client_demo_data.xml)
    -->
    <data noupdate="0">
        
        <!-- CCTV Cameras for NSHAMA Town Square -->
        
