            <field name="code">CCTV-TS-001</field>
            <field name="site_id" ref="site_nshama_town_square"/>
            <field name="camera_type">dome</field>
            <field name="location_description">Main entrance gate - Security booth area, facing north, covers vehicle and pedestrian access</field>
            <field name="stream_url">https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4</field>
            <field name="stream_type">http</field>
            <field name="ip_address">192.168.1.100</field>
            <field name="port" eval="8080"/>
            <field name="manufacturer">Hikvision</field>
            <field name="model">DS-2CD2142FWD-I</field>
            <field name="status">online</field>
            <field name="is_active" eval="True"/>
            <field name="username">admin</field>
            <field name="password">password123</field>
            <field name="notes">24/7 monitoring of main entrance. High priority camera for access control verification. NOTE: This is a test camera using a sample video stream for demonstration purposes.</field>
        </record>

