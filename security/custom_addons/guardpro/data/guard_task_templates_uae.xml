        <!-- 1. PERIMETER PATROL TEMPLATE -->
        <record id="task_template_perimeter_patrol" model="guard.task.template">
            <field name="name">Perimeter Security Patrol</field>
            <field name="task_type">patrol</field>
            <field name="priority">1</field>
            <field name="active" eval="True"/>
            <field name="description"><![CDATA[
                <h3>Perimeter Security Patrol</h3>
                <p><strong>Purpose:</strong> Conduct comprehensive perimeter security patrol to detect and deter unauthorized access, security breaches, and safety hazards.</p>
                
                <h4>Standard Operating Procedure:</h4>
                <ul>
                    <li>Walk the entire perimeter of the facility in a systematic manner</li>
                    <li>Check all access points, gates, and fencing for integrity</li>
                    <li>Inspect lighting systems and report any malfunctions</li>
                    <li>Look for signs of tampering, damage, or unauthorized entry attempts</li>
                    <li>Report any suspicious persons, vehicles, or activities</li>
                    <li>Ensure all emergency exits are accessible and properly secured</li>
                    <li>Document findings in the patrol log</li>
                </ul>
                
                <h4>UAE Compliance Notes:</h4>
                <p>This patrol aligns with UAE Ministry of Interior security standards for facility protection and SIRA (Security Industry Regulatory Agency) requirements for regular security patrols.</p>
            ]]></field>
        </record>

        <record id="checklist_perimeter_1" model="guard.task.checklist.template">
            <field name="template_id" ref="task_template_perimeter_patrol"/>
            <field name="sequence">10</field>
            <field name="name">Inspect main entrance gate and access control systems</field>
            <field name="mandatory" eval="True"/>
        </record>

        <record id="checklist_perimeter_2" model="guard.task.checklist.template">
            <field name="template_id" ref="task_template_perimeter_patrol"/>
            <field name="sequence">20</field>
            <field name="name">Check perimeter fencing for damage or breaches</field>
            <field name="mandatory" eval="True"/>
        </record>

        <record id="checklist_perimeter_3" model="guard.task.checklist.template">
            <field name="template_id" ref="task_template_perimeter_patrol"/>
            <field name="sequence">30</field>
            <field name="name">Verify all perimeter lighting is operational</field>
            <field name="mandatory" eval="True"/>
        </record>

        <record id="checklist_perimeter_4" model="guard.task.checklist.template">
            <field name="template_id" ref="task_template_perimeter_patrol"/>
            <field name="sequence">40</field>
            <field name="name">Inspect emergency exits for proper closure and accessibility</field>
            <field name="mandatory" eval="True"/>
        </record>

        <record id="checklist_perimeter_5" model="guard.task.checklist.template">
            <field name="template_id" ref="task_template_perimeter_patrol"/>
            <field name="sequence">50</field>
            <field name="name">Check for unauthorized vehicles in restricted areas</field>
            <field name="mandatory" eval="True"/>
        </record>

        <record id="checklist_perimeter_6" model="guard.task.checklist.template">
            <field name="template_id" ref="task_template_perimeter_patrol"/>
            <field name="sequence">60</field>
            <field name="name">Document any suspicious activity or security concerns</field>
            <field name="mandatory" eval="True"/>
        </record>

        <!-- 2. ACCESS CONTROL CHECK TEMPLATE -->
        <record id="task_template_access_control" model="guard.task.template">
