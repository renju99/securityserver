<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Incident Categories -->
        <record id="incident_cat_security" model="incident.category">
            <field name="name">Security Breach</field>
            <field name="code">SEC</field>
            <field name="sequence">10</field>
            <field name="color">1</field>
            <field name="description">Unauthorized access, intrusion, or compromise of physical or operational security controls at the site.</field>
        </record>

        <record id="incident_cat_theft" model="incident.category">
            <field name="name">Theft/Burglary</field>
            <field name="code">THEFT</field>
            <field name="sequence">20</field>
            <field name="color">2</field>
            <field name="description">Theft, burglary, or unlawful taking of property belonging to the client, residents, or visitors.</field>
        </record>

        <record id="incident_cat_vandalism" model="incident.category">
            <field name="name">Vandalism</field>
            <field name="code">VAND</field>
            <field name="sequence">30</field>
            <field name="color">3</field>
            <field name="description">Deliberate damage, graffiti, or destruction of property or common-area assets.</field>
        </record>

        <record id="incident_cat_safety" model="incident.category">
            <field name="name">Safety Hazard</field>
            <field name="code">SAFE</field>
            <field name="sequence">40</field>
            <field name="color">9</field>
            <field name="description">Unsafe conditions posing risk of injury (e.g. slips, trips, exposed wiring, blocked exits, unsafe works).</field>
        </record>

        <record id="incident_cat_medical" model="incident.category">
            <field name="name">Medical Emergency</field>
            <field name="code">MED</field>
            <field name="sequence">50</field>
            <field name="color">2</field>
            <field name="description">Medical emergency requiring first aid, ambulance, or coordination with health services.</field>
        </record>

        <record id="incident_cat_fire" model="incident.category">
            <field name="name">Fire/Smoke</field>
            <field name="code">FIRE</field>
            <field name="sequence">60</field>
            <field name="color">1</field>
            <field name="description">Fire, smoke, heat alarm activation, or related emergency response involving Civil Defence or evacuation.</field>
        </record>

        <record id="incident_cat_disturbance" model="incident.category">
            <field name="name">Disturbance/Noise</field>
            <field name="code">DIST</field>
            <field name="sequence">70</field>
            <field name="color">9</field>
            <field name="description">Noise complaints, disorderly conduct, or disruption affecting residents, tenants, or site operations.</field>
        </record>

        <record id="incident_cat_trespassing" model="incident.category">
            <field name="name">Trespassing</field>
            <field name="code">TRESP</field>
            <field name="sequence">80</field>
            <field name="color">3</field>
            <field name="description">Unauthorized persons on site or in restricted areas after warnings or without valid access.</field>
        </record>

        <record id="incident_cat_vehicle" model="incident.category">
            <field name="name">Vehicle Incident</field>
            <field name="code">VEH</field>
            <field name="sequence">90</field>
            <field name="color">7</field>
            <field name="description">Road traffic or parking incident involving a motor vehicle (collision, damage, or dispute on site).</field>
        </record>
        <record id="incident_cat_abandoned_vehicle" model="incident.category">
            <field name="name">Abandoned Vehicle</field>
            <field name="code">ABND_VEH</field>
            <field name="sequence">91</field>
            <field name="color">7</field>
            <field name="description">Vehicle left unattended in violation of site rules, blocking access, or presenting a security concern.</field>
        </record>
        <record id="incident_cat_long_term_parked_vehicle" model="incident.category">
            <field name="name">Long-Term Parked Vehicle</field>
            <field name="code">LT_PARK</field>
            <field name="sequence">92</field>
            <field name="color">7</field>
            <field name="description">Vehicle parked beyond permitted duration or in prohibited parking zones requiring FM or enforcement action.</field>
        </record>
        <record id="incident_cat_double_parking" model="incident.category">
            <field name="name">Double Parking</field>
            <field name="code">DBL_PARK</field>
            <field name="sequence">93</field>
            <field name="color">7</field>
            <field name="description">Vehicle parked alongside another parked vehicle, obstructing the lane or flow of traffic.</field>
        </record>
        <record id="incident_cat_blocking_access" model="incident.category">
            <field name="name">Blocking Access</field>
            <field name="code">BLK_ACCESS</field>
            <field name="sequence">94</field>
            <field name="color">7</field>
            <field name="description">Vehicle blocking a driveway, gate, ramp, fire lane, emergency exit, or other access point.</field>
        </record>
        <record id="incident_cat_illegal_parking" model="incident.category">
            <field name="name">Illegal Parking</field>
            <field name="code">ILLEGAL_PARK</field>
            <field name="sequence">95</field>
            <field name="color">7</field>
            <field name="description">Vehicle parked in a prohibited area or in breach of site parking regulations.</field>
        </record>
        <record id="incident_cat_visitor_parking_misuse" model="incident.category">
            <field name="name">Visitor Parking Misuse</field>
            <field name="code">VIS_PARK</field>
            <field name="sequence">96</field>
            <field name="color">7</field>
            <field name="description">Visitor bay used incorrectly (e.g. by residents, staff, or beyond allowed duration).</field>
        </record>
        <record id="incident_cat_wrongful_parking" model="incident.category">
            <field name="name">Wrongful Parking</field>
            <field name="code">WRONG_PARK</field>
            <field name="sequence">97</field>
            <field name="color">7</field>
            <field name="description">Vehicle parked incorrectly within a bay, across lines, or otherwise wrongfully positioned.</field>
        </record>
        <record id="incident_cat_undesignated_parking" model="incident.category">
            <field name="name">Undesignated Parking</field>
            <field name="code">UNDESIG_PARK</field>
            <field name="sequence">98</field>
            <field name="color">7</field>
            <field name="description">Vehicle parked in an area not designated for parking.</field>
        </record>
        <record id="incident_cat_unauthorized_vehicle" model="incident.category">
            <field name="name">Unauthorized Vehicle</field>
            <field name="code">UNAUTH_VEH</field>
            <field name="sequence">99</field>
            <field name="color">7</field>
            <field name="description">Vehicle on site without valid authorization, sticker, or visitor registration.</field>
        </record>
        <record id="incident_cat_pavement_parking" model="incident.category">
            <field name="name">Parking on Pavement</field>
            <field name="code">PAVEMENT_PARK</field>
            <field name="sequence">100</field>
            <field name="color">7</field>
            <field name="description">Motor vehicle parked on pavement / sidewalk.</field>
        </record>
        <record id="incident_cat_disabled_parking" model="incident.category">
            <field name="name">Disabled Parking Violation</field>
            <field name="code">DISABLED_PARK</field>
            <field name="sequence">101</field>
            <field name="color">7</field>
            <field name="description">Vehicle parked in a disabled / accessible bay without entitlement.</field>
        </record>
        <record id="incident_cat_fire_hydrant_parking" model="incident.category">
            <field name="name">Parking in Front of Fire Hydrant</field>
            <field name="code">FIRE_HYD_PARK</field>
            <field name="sequence">102</field>
            <field name="color">7</field>
            <field name="description">Vehicle parked in front of a fire hydrant or fire service point.</field>
        </record>
        <record id="incident_cat_loading_zone_violation" model="incident.category">
            <field name="name">Loading/Unloading Zone Violation</field>
            <field name="code">LOAD_ZONE</field>
            <field name="sequence">103</field>
            <field name="color">7</field>
            <field name="description">Not complying with loading and unloading in designated areas.</field>
        </record>
        <record id="incident_cat_pedestrian_crossing_stop" model="incident.category">
            <field name="name">Stopping on Pedestrian Crossing</field>
            <field name="code">PED_CROSS</field>
            <field name="sequence">104</field>
            <field name="color">7</field>
            <field name="description">Vehicle stopped on a pedestrian crossing without justified reason.</field>
        </record>
        <record id="incident_cat_overnight_parking" model="incident.category">
            <field name="name">Overnight Parking</field>
            <field name="code">OVERNIGHT_PARK</field>
            <field name="sequence">105</field>
            <field name="color">7</field>
            <field name="description">Vehicle left overnight in a restricted or retail parking area.</field>
        </record>
        <record id="incident_cat_retail_parking_violation" model="incident.category">
            <field name="name">Retail Parking Violation</field>
            <field name="code">RETAIL_PARK</field>
            <field name="sequence">106</field>
            <field name="color">7</field>
            <field name="description">Retail parking rule breach (e.g. tailgating, unpaid exit, lost ticket).</field>
        </record>
        <record id="incident_cat_no_payment_exit" model="incident.category">
            <field name="name">Exit Without Payment</field>
            <field name="code">NO_PAY_EXIT</field>
            <field name="sequence">107</field>
            <field name="color">7</field>
            <field name="description">Vehicle exited paid parking without completing payment.</field>
        </record>
        <record id="incident_cat_lost_parking_ticket" model="incident.category">
            <field name="name">Lost Parking Ticket</field>
            <field name="code">LOST_TICKET</field>
            <field name="sequence">108</field>
            <field name="color">7</field>
            <field name="description">Driver reports a lost parking ticket requiring verification and settlement.</field>
        </record>
        <record id="incident_cat_equipment_handover" model="incident.category">
            <field name="name">Equipment Handover</field>
            <field name="code">EQ_HO</field>
            <field name="sequence">110</field>
            <field name="color">5</field>
            <field name="description">Formal handover of security or operational equipment between shifts, teams, or contractors.</field>
        </record>
        <record id="incident_cat_cctv_handover" model="incident.category">
            <field name="name">CCTV Handover</field>
            <field name="code">CCTV_HO</field>
            <field name="sequence">94</field>
            <field name="color">4</field>
            <field name="description">Handover or status report for CCTV monitoring, recording integrity, or control-room continuity.</field>
        </record>
        <record id="incident_cat_local_authority_visit" model="incident.category">
            <field name="name">Local Authority Visit</field>
            <field name="code">AUTH_VISIT</field>
            <field name="sequence">95</field>
            <field name="color">6</field>
            <field name="description">Official visit or inspection by police, municipality, or other government authority (document agency, purpose, outcome).</field>
        </record>

        <record id="incident_cat_weather" model="incident.category">
            <field name="name">Weather/Natural</field>
            <field name="code">WEATH</field>
            <field name="sequence">100</field>
            <field name="color">10</field>
            <field name="description">Storm, flooding, extreme heat, sandstorm, or other natural event impacting building or site safety.</field>
        </record>

        <record id="incident_cat_facility_patrol" model="incident.category">
            <field name="name">Facility / Maintenance (Patrol)</field>
            <field name="code">FACILITY</field>
            <field name="sequence">105</field>
            <field name="color">3</field>
            <field name="hide_from_guard_incidents" eval="True"/>
            <field name="description">Maintenance or facilities issue reported by a guard during a patrol checkpoint scan. Assign to facilities management for follow-up.</field>
            <field name="notification_emails">facilities@example.com</field>
            <field name="high_priority_notification_enabled" eval="True"/>
        </record>

        <record id="incident_cat_equipment" model="incident.category">
            <field name="name">Equipment Malfunction</field>
            <field name="code">EQUIP</field>
            <field name="sequence">110</field>
            <field name="color">9</field>
            <field name="description">Failure or unsafe operation of building systems or security equipment requiring maintenance or vendor attendance.</field>
        </record>

        <record id="incident_cat_suspicious" model="incident.category">
            <field name="name">Suspicious Activity</field>
            <field name="code">SUSP</field>
            <field name="sequence">120</field>
            <field name="color">9</field>
            <field name="description">Unconfirmed but concerning behaviour, loitering, or reconnaissance warranting observation and reporting.</field>
        </record>

        <record id="incident_cat_statement" model="incident.category">
            <field name="name">Statement</field>
            <field name="code">STMT</field>
            <field name="sequence">130</field>
            <field name="color">4</field>
            <field name="description">Formal written statement from a witness or involved party related to an incident or investigation.</field>
        </record>

        <record id="incident_cat_found_item" model="incident.category">
            <field name="name">Found Item</field>
            <field name="code">FOUND</field>
            <field name="sequence">140</field>
            <field name="color">5</field>
            <field name="description">Item found on site and logged for safekeeping pending owner identification and return.</field>
        </record>

        <record id="incident_cat_return_form" model="incident.category">
            <field name="name">Return Form</field>
            <field name="code">RETURN</field>
            <field name="sequence">150</field>
            <field name="color">6</field>
            <field name="description">Return of a previously found lost item to its owner with handover documentation.</field>
        </record>

        <record id="incident_cat_short_term_letting" model="incident.category">
            <field name="name">Short term letting/Staff accommodation/Commercial activities</field>
            <field name="code">SHORT_LET</field>
            <field name="sequence">160</field>
            <field name="color">8</field>
            <field name="description">Unauthorized short-term letting, misuse of staff accommodation, or unapproved commercial activity on the property.</field>
        </record>

        <record id="incident_cat_illegal_household_staff" model="incident.category">
            <field name="name">Illegal household staff</field>
            <field name="code">ILL_STAFF</field>
            <field name="sequence">170</field>
            <field name="color">8</field>
            <field name="description">Domestic or household staff employed or housed in breach of regulations or community rules.</field>
        </record>

        <record id="incident_cat_violation_moving_policy" model="incident.category">
            <field name="name">Violation of moving-in/out policy</field>
            <field name="code">MOVE_POL</field>
            <field name="sequence">180</field>
            <field name="color">8</field>
            <field name="description">Breach of community rules for moving in or moving out (timing, lifts, damage, access).</field>
        </record>

        <record id="incident_cat_violation_sales_policy" model="incident.category">
            <field name="name">Violation of sales/leasing policy</field>
            <field name="code">SALE_POL</field>
            <field name="sequence">190</field>
            <field name="color">8</field>
            <field name="description">Breach of sales or leasing restrictions (e.g. unauthorized brokerage, advertising, or unit use).</field>
        </record>

        <record id="incident_cat_violation_animal_rules" model="incident.category">
            <field name="name">Violation of animal keeping rules</field>
            <field name="code">ANIMAL</field>
            <field name="sequence">200</field>
            <field name="color">8</field>
            <field name="description">Breach of pet or animal keeping rules (unauthorized species, noise, waste, or leash rules).</field>
        </record>

        <record id="incident_cat_damage_recreation" model="incident.category">
            <field name="name">Damage/Misuse of recreation areas (Eg: parks and playgrounds)</field>
            <field name="code">DMG_REC</field>
            <field name="sequence">210</field>
            <field name="color">8</field>
            <field name="description">Damage or misuse of parks, playgrounds, or other outdoor recreation facilities.</field>
        </record>

        <record id="incident_cat_damage_common_areas" model="incident.category">
            <field name="name">Damage/Misuse of other common areas</field>
            <field name="code">DMG_COM</field>
            <field name="sequence">220</field>
            <field name="color">8</field>
            <field name="description">Damage or misuse of shared corridors, lobbies, amenities, or other common spaces.</field>
        </record>

        <record id="incident_cat_damage_sports_leisure" model="incident.category">
            <field name="name">Damage/Misuse of sports areas/ Leisure Facilities</field>
            <field name="code">DMG_SPT</field>
            <field name="sequence">230</field>
            <field name="color">8</field>
            <field name="description">Damage or misuse of gym, courts, or leisure amenities including equipment and booking rules.</field>
        </record>

        <record id="incident_cat_damage_pools" model="incident.category">
            <field name="name">Damage/Misuse of swimming pools</field>
            <field name="code">DMG_POOL</field>
            <field name="sequence">240</field>
            <field name="color">8</field>
            <field name="description">Damage or misuse of swimming pool, pool deck, or related safety and hygiene rules.</field>
        </record>

        <record id="incident_cat_damage_plants" model="incident.category">
            <field name="name">Damage/Misuse of plants</field>
            <field name="code">DMG_PLNT</field>
            <field name="sequence">250</field>
            <field name="color">8</field>
            <field name="description">Damage to landscaping, trees, planters, or irrigation affecting community appearance or safety.</field>
        </record>

        <record id="incident_cat_poor_garden_maintenance" model="incident.category">
            <field name="name">Poor maintenance of garden and landscape</field>
            <field name="code">GARDEN</field>
            <field name="sequence">260</field>
            <field name="color">8</field>
            <field name="description">Poor upkeep of assigned garden or landscape areas affecting community standards or pest risk.</field>
        </record>

        <record id="incident_cat_improper_home_appearance" model="incident.category">
            <field name="name">Improper home maintenance/appearance</field>
            <field name="code">HOME_APP</field>
            <field name="sequence">270</field>
            <field name="color">8</field>
            <field name="description">Unit exterior or facade not maintained to community appearance or hygiene standards.</field>
        </record>

        <record id="incident_cat_unauth_exterior_major" model="incident.category">
            <field name="name">Unauthorized exterior attachments/alterations (major Alterations)</field>
            <field name="code">EXT_MAJ</field>
            <field name="sequence">280</field>
            <field name="color">8</field>
            <field name="description">Major unauthorized exterior changes (structures, cladding, extensions) without approval.</field>
        </record>

        <record id="incident_cat_unauth_exterior_minor" model="incident.category">
            <field name="name">Unauthorized exterior attachments/alterations (minor alterations)</field>
            <field name="code">EXT_MIN</field>
            <field name="sequence">290</field>
            <field name="color">8</field>
            <field name="description">Minor unauthorized exterior changes (satellite dishes, awnings, fixtures) without approval.</field>
        </record>

        <record id="incident_cat_signage_violation" model="incident.category">
            <field name="name">Violation of terms against signage use</field>
            <field name="code">SIGNAGE</field>
            <field name="sequence">300</field>
            <field name="color">8</field>
            <field name="description">Unauthorized, oversized, or prohibited signage or advertising visible from common areas or exterior.</field>
        </record>

        <record id="incident_cat_terrace_balconies" model="incident.category">
            <field name="name">Misuse of terrace and balconies</field>
            <field name="code">TERRACE</field>
            <field name="sequence">310</field>
            <field name="color">8</field>
            <field name="description">Unsafe or prohibited use of terraces and balconies (BBQ, storage over rail, climbing hazard, etc.).</field>
        </record>

        <record id="incident_cat_inadequate_pest_control" model="incident.category">
            <field name="name">Inadequate pest control</field>
            <field name="code">PEST</field>
            <field name="sequence">320</field>
            <field name="color">8</field>
            <field name="description">Inadequate pest control, infestation, or conditions attracting vermin requiring FM or vendor action.</field>
        </record>

        <record id="incident_cat_misuse_garage" model="incident.category">
            <field name="name">Misuse of garage area</field>
            <field name="code">GARAGE</field>
            <field name="sequence">330</field>
            <field name="color">8</field>
            <field name="description">Misuse of parking garage lanes, storage, or vehicle maintenance in prohibited areas.</field>
        </record>

        <record id="incident_cat_retail_violation" model="incident.category">
            <field name="name">Retail Violation</field>
            <field name="code">RETAIL</field>
            <field name="sequence">340</field>
            <field name="color">8</field>
            <field name="description">Breach of retail or F&amp;B lease or license conditions affecting the development or other tenants.</field>
        </record>

        <record id="incident_cat_other" model="incident.category">
            <field name="name">Other</field>
            <field name="code">OTHER</field>
            <field name="sequence">999</field>
            <field name="color">0</field>
            <field name="description">Incident not covered by a specific category; document circumstances clearly in the report narrative.</field>
        </record>

        <!-- Incident Tags -->
        <record id="incident_tag_urgent" model="incident.tag">
            <field name="name">Urgent</field>
            <field name="color">1</field>
        </record>

        <record id="incident_tag_police" model="incident.tag">
            <field name="name">Police Involved</field>
            <field name="color">2</field>
        </record>

        <record id="incident_tag_injury" model="incident.tag">
            <field name="name">Injury</field>
            <field name="color">1</field>
        </record>

        <record id="incident_tag_damage" model="incident.tag">
            <field name="name">Property Damage</field>
            <field name="color">9</field>
        </record>

        <record id="incident_tag_followup" model="incident.tag">
            <field name="name">Requires Follow-up</field>
            <field name="color">3</field>
        </record>
    </data>
</odoo>
