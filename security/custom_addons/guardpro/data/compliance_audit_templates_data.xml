<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Security Guard Performance Audit Template -->
        <record id="audit_template_guard_performance" model="compliance.audit.template">
            <field name="name">Security Guard Performance Audit</field>
            <field name="description">Comprehensive audit checklist for security guard performance and compliance</field>
            <field name="audit_type">guard</field>
            <field name="frequency">monthly</field>
            <field name="passing_score">80.0</field>
            <field name="active">True</field>
        </record>
        
        <record id="audit_template_item_guard_perf_1" model="compliance.audit.template.item">
            <field name="template_id" ref="audit_template_guard_performance"/>
            <field name="sequence">10</field>
            <field name="description">Guard arrives on time for shift</field>
            <field name="category">punctuality</field>
            <field name="critical">True</field>
            <field name="max_score">10</field>
        </record>
        
        <record id="audit_template_item_guard_perf_2" model="compliance.audit.template.item">
            <field name="template_id" ref="audit_template_guard_performance"/>
            <field name="sequence">20</field>
            <field name="description">Guard is in proper uniform</field>
            <field name="category">appearance</field>
            <field name="critical">True</field>
            <field name="max_score">10</field>
        </record>
        
        <record id="audit_template_item_guard_perf_3" model="compliance.audit.template.item">
            <field name="template_id" ref="audit_template_guard_performance"/>
            <field name="sequence">30</field>
            <field name="description">Guard has all required equipment (radio, flashlight, etc.)</field>
            <field name="category">equipment</field>
            <field name="critical">True</field>
            <field name="max_score">10</field>
        </record>
        
        <record id="audit_template_item_guard_perf_4" model="compliance.audit.template.item">
            <field name="template_id" ref="audit_template_guard_performance"/>
            <field name="sequence">40</field>
