<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Auto check-out forgotten sessions after 13 hours -->
        <record id="cron_auto_checkout_stale_attendance" model="ir.cron">
            <field name="name">GuardLink: Auto Check-Out After 13 Hours</field>
            <field name="model_id" ref="model_guard_attendance"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_checkout_stale_sessions(13)</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
    </data>
</odoo>
