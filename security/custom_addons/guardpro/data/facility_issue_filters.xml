<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="filter_facility_issues_open" model="ir.filters">
            <field name="name">FM – Open issues</field>
            <field name="model_id" ref="guardpro.model_incident_report"/>
            <field name="domain">[('is_facility_patrol', '=', True), ('status', 'not in', ['resolved', 'closed'])]</field>
            <field name="user_id" eval="False"/>
        </record>
    </data>
</odoo>
