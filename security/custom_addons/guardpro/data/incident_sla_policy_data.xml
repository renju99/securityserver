<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default incident response SLA policies (all sites / all categories) -->
        <record id="incident_sla_policy_critical" model="incident.sla.policy">
            <field name="name">Critical - 15 min response</field>
            <field name="sequence">10</field>
            <field name="severity">critical</field>
            <field name="response_time_target">15</field>
            <field name="acknowledgment_time_target">5</field>
            <field name="resolution_time_target">4</field>
            <field name="warning_threshold">60.0</field>
            <field name="critical_threshold">85.0</field>
            <field name="auto_escalate" eval="True"/>
            <field name="level_1_escalation_time">15</field>
            <field name="level_2_escalation_time">30</field>
            <field name="level_3_escalation_time">60</field>
            <field name="description">Default SLA for critical incidents: first response within 15 minutes.</field>
        </record>

        <record id="incident_sla_policy_high" model="incident.sla.policy">
            <field name="name">High - 30 min response</field>
            <field name="sequence">20</field>
            <field name="severity">high</field>
            <field name="response_time_target">30</field>
            <field name="acknowledgment_time_target">10</field>
            <field name="resolution_time_target">8</field>
            <field name="warning_threshold">70.0</field>
            <field name="critical_threshold">90.0</field>
            <field name="auto_escalate" eval="True"/>
            <field name="level_1_escalation_time">30</field>
            <field name="level_2_escalation_time">60</field>
            <field name="level_3_escalation_time">120</field>
            <field name="description">Default SLA for high-severity incidents: first response within 30 minutes.</field>
        </record>

        <record id="incident_sla_policy_medium" model="incident.sla.policy">
            <field name="name">Medium - 60 min response</field>
            <field name="sequence">30</field>
            <field name="severity">medium</field>
            <field name="response_time_target">60</field>
            <field name="acknowledgment_time_target">20</field>
            <field name="resolution_time_target">24</field>
            <field name="warning_threshold">75.0</field>
            <field name="critical_threshold">90.0</field>
            <field name="auto_escalate" eval="True"/>
            <field name="level_1_escalation_time">60</field>
            <field name="level_2_escalation_time">120</field>
            <field name="level_3_escalation_time">240</field>
            <field name="description">Default SLA for medium-severity incidents: first response within 60 minutes.</field>
        </record>

        <record id="incident_sla_policy_low" model="incident.sla.policy">
            <field name="name">Low - 120 min response</field>
            <field name="sequence">40</field>
            <field name="severity">low</field>
            <field name="response_time_target">120</field>
            <field name="acknowledgment_time_target">30</field>
            <field name="resolution_time_target">48</field>
            <field name="warning_threshold">75.0</field>
            <field name="critical_threshold">90.0</field>
            <field name="auto_escalate" eval="True"/>
            <field name="level_1_escalation_time">120</field>
            <field name="level_2_escalation_time">240</field>
            <field name="level_3_escalation_time">480</field>
            <field name="description">Default SLA for low-severity incidents: first response within 2 hours.</field>
        </record>
    </data>
</odoo>
