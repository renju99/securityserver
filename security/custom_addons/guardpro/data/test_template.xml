<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="1">
        <!-- Shift Reminder Email Template -->
        <record id="shift_reminder_email" model="mail.template">
            <field name="name">Shift Reminder</field>
            <field name="model_id" ref="model_guard_shift"/>
            <field name="subject">Shift Reminder: {{ object.site_id.name }} - {{ format_datetime(object.start_datetime, dt_format='short') }}</field><field name="email_from">{{ user.email_formatted }}</field><field name="email_to">{{ object.guard_id.email }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px;"&gt;
                    &lt;h2 style="color: #1976d2;"&gt;Upcoming Shift Reminder&lt;/h2&gt;
                    
                    &lt;p&gt;Hello &lt;t t-out="object.guard_id.name"/&gt;,&lt;/p&gt;
                    
                    &lt;p&gt;This is a reminder about your upcoming shift:&lt;/p&gt;
                    
                    &lt;table style="width: 100%; border-collapse: collapse; margin: 20px 0;"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 30%;"&gt;Site:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.site_id.name"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Start:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="format_datetime(object.start_datetime, dt_format='medium')"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;End:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="format_datetime(object.end_datetime, dt_format='medium')"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Assignment:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.assignment_type"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                    &lt;/table&gt;
                    
                    &lt;t t-if="object.instructions"&gt;
                    &lt;h3&gt;Special Instructions:&lt;/h3&gt;
                    &lt;div style="padding: 15px; background: #fff3e0; border-radius: 5px; margin: 20px 0;"&gt;
                        &lt;t t-out="object.instructions"/&gt;
                    &lt;/div&gt;
                    &lt;/t&gt;
                    
                    &lt;div style="margin-top: 30px;"&gt;
                        &lt;p&gt;Please arrive on time and bring all required equipment.&lt;/p&gt;
                        &lt;p&gt;Thank you!&lt;/p&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            </field></record>

        <!-- Daily Activity Report Email Template -->
        <record id="email_template_dar_to_client" model="mail.template">
            <field name="name">Daily Activity Report to Client</field>
            <field name="model_id" ref="model_daily_activity_report"/>
            <field name="subject">Daily Activity Report - {{ object.site_id.name }} - {{ format_date(object.report_date) }}</field><field name="email_from">{{ user.email_formatted or object.site_id.client_id.email }}</field><field name="email_to">{{ object.client_email or object.site_id.client_id.email }}</field><field name="body_html" type="char">&lt;body&gt;&lt;div&gt;&lt;div style="font-family: Arial, sans-serif; padding: 20px; max-width: 800px; margin: 0 auto;"&gt;
                    &lt;h2 style="color: #1976d2; border-bottom: 3px solid #1976d2; padding-bottom: 10px;"&gt;
                        Daily Activity Report (DAR)
                    &lt;/h2&gt;
                    
                    &lt;p&gt;Dear &lt;t t-out="object.site_id.client_id.name"/&gt;,&lt;/p&gt;
                    
                    &lt;p&gt;Please find attached the Daily Activity Report for &lt;strong&gt;&lt;t t-out="object.site_id.name"/&gt;&lt;/strong&gt; covering activities on &lt;strong&gt;&lt;t t-out="format_date(object.report_date)"/&gt;&lt;/strong&gt;.&lt;/p&gt;
                    
                    &lt;!-- Summary Statistics --&gt;
                    &lt;div style="margin: 30px 0; padding: 20px; background: #f5f5f5; border-radius: 8px;"&gt;
                        &lt;h3 style="margin-top: 0; color: #333;"&gt;Summary Overview&lt;/h3&gt;
                        &lt;table style="width: 100%; border-collapse: collapse;"&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 8px 0; width: 50%;"&gt;&lt;strong&gt;Total Incidents:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 8px 0;"&gt;
                                    &lt;span t-att-style="&amp;quot;padding: 4px 12px; background: &amp;quot; + str(object.total_incidents &amp;gt; 0 and '#ff5722' or '#4caf50') + &amp;quot;; color: white; border-radius: 12px; font-weight: bold;&amp;quot;"&gt;
                                        &lt;t t-out="object.total_incidents"/&gt;
                                    &lt;/span&gt;
                                    &lt;t t-if="object.critical_incidents &amp;gt; 0"&gt;
                                    &lt;span style="margin-left: 10px; padding: 4px 12px; background: #d32f2f; color: white; border-radius: 12px; font-size: 12px;"&gt;
                                        &lt;t t-out="object.critical_incidents"/&gt; Critical
                                    &lt;/span&gt;
                                    &lt;/t&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 8px 0;"&gt;&lt;strong&gt;Security Tours Completed:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 8px 0;"&gt;
                                    &lt;span style="padding: 4px 12px; background: #2196f3; color: white; border-radius: 12px; font-weight: bold;"&gt;
                                        &lt;t t-out="object.tours_completed"/&gt;
                                    &lt;/span&gt;
                                    &lt;t t-if="object.tours_missed &amp;gt; 0"&gt;
                                    &lt;span style="margin-left: 10px; padding: 4px 12px; background: #ff9800; color: white; border-radius: 12px; font-size: 12px;"&gt;
                                        &lt;t t-out="object.tours_missed"/&gt; Missed
                                    &lt;/span&gt;
                                    &lt;/t&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 8px 0;"&gt;&lt;strong&gt;Visitors:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 8px 0;"&gt;
                                    &lt;span style="padding: 4px 12px; background: #9c27b0; color: white; border-radius: 12px; font-weight: bold;"&gt;
                                        &lt;t t-out="object.visitor_count"/&gt;
                                    &lt;/span&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 8px 0;"&gt;&lt;strong&gt;Guards on Duty:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 8px 0;"&gt;
                                    &lt;span style="padding: 4px 12px; background: #009688; color: white; border-radius: 12px; font-weight: bold;"&gt;
                                        &lt;t t-out="object.guards_on_duty_count"/&gt;
                                    &lt;/span&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 8px 0;"&gt;&lt;strong&gt;Tasks Completed:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 8px 0;"&gt;
                                    &lt;span style="padding: 4px 12px; background: #4caf50; color: white; border-radius: 12px; font-weight: bold;"&gt;
                                        &lt;t t-out="object.task_completed_count"/&gt; / &lt;t t-out="object.task_count"/&gt;
                                    &lt;/span&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;
                            &lt;t t-if="object.package_count &amp;gt; 0"&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 8px 0;"&gt;&lt;strong&gt;Packages Received:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 8px 0;"&gt;
                                    &lt;span style="padding: 4px 12px; background: #795548; color: white; border-radius: 12px; font-weight: bold;"&gt;
                                        &lt;t t-out="object.package_count"/&gt;
                                    &lt;/span&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;
                            &lt;/t&gt;
                            &lt;t t-if="object.lost_found_count &amp;gt; 0"&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 8px 0;"&gt;&lt;strong&gt;Lost &amp;amp; Found Items:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 8px 0;"&gt;
                                    &lt;span style="padding: 4px 12px; background: #607d8b; color: white; border-radius: 12px; font-weight: bold;"&gt;
                                        &lt;t t-out="object.lost_found_count"/&gt;
                                    &lt;/span&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;
                            &lt;/t&gt;
                        &lt;/table&gt;
                    &lt;/div&gt;
                    
                    &lt;!-- Weather Conditions --&gt;
                    &lt;t t-if="object.weather_conditions"&gt;
                    &lt;div style="margin: 20px 0; padding: 15px; background: #e3f2fd; border-left: 4px solid #2196f3; border-radius: 4px;"&gt;
                        &lt;strong&gt;Weather Conditions:&lt;/strong&gt; &lt;t t-out="object.weather_conditions"/&gt;
                    &lt;/div&gt;
                    &lt;/t&gt;
                    
                    &lt;!-- Critical Incidents Alert --&gt;
                    &lt;t t-if="object.critical_incidents &amp;gt; 0"&gt;
                    &lt;div style="margin: 20px 0; padding: 15px; background: #ffebee; border-left: 4px solid #d32f2f; border-radius: 4px;"&gt;
                        &lt;strong style="color: #d32f2f;"&gt;⚠ ATTENTION:&lt;/strong&gt; This report contains &lt;strong&gt;&lt;t t-out="object.critical_incidents"/&gt; critical incident(s)&lt;/strong&gt; requiring immediate attention. Please review the attached detailed report.
                    &lt;/div&gt;
                    &lt;/t&gt;
                    
                    &lt;!-- Special Notes --&gt;
                    &lt;t t-if="object.special_notes"&gt;
                    &lt;div style="margin: 20px 0;"&gt;
                        &lt;h3 style="color: #333;"&gt;Special Notes &amp;amp; Observations&lt;/h3&gt;
                        &lt;div style="padding: 15px; background: #fff9c4; border-left: 4px solid #fbc02d; border-radius: 4px;"&gt;
                            &lt;t t-out="object.special_notes"/&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                    &lt;/t&gt;
                    
                    &lt;!-- Attachment Notice --&gt;
                    &lt;div style="margin: 30px 0; padding: 20px; background: #e8f5e9; border-radius: 8px; border: 1px solid #4caf50;"&gt;
                        &lt;h3 style="margin-top: 0; color: #2e7d32;"&gt;📎 Detailed Report Attached&lt;/h3&gt;
                        &lt;p style="margin-bottom: 0;"&gt;
                            A comprehensive PDF report with complete details of all activities, incidents, and observations 
                            is attached to this email for your review and records.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;!-- Review Information --&gt;
                    &lt;t t-if="object.reviewed_by"&gt;
                    &lt;div style="margin: 20px 0; padding: 15px; background: #f5f5f5; border-radius: 4px;"&gt;
                        &lt;table style="width: 100%;"&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 5px 0;"&gt;&lt;strong&gt;Report Submitted By:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 5px 0;"&gt;&lt;t t-out="object.submitted_by.name if object.submitted_by else 'N/A'"/&gt;&lt;/td&gt;
                            &lt;/tr&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 5px 0;"&gt;&lt;strong&gt;Reviewed &amp;amp; Approved By:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 5px 0;"&gt;&lt;t t-out="object.reviewed_by.name"/&gt;&lt;/td&gt;
                            &lt;/tr&gt;
                            &lt;tr&gt;
                                &lt;td style="padding: 5px 0;"&gt;&lt;strong&gt;Approval Date:&lt;/strong&gt;&lt;/td&gt;
                                &lt;td style="padding: 5px 0;"&gt;&lt;t t-out="format_datetime(object.reviewed_date, dt_format='medium') if object.reviewed_date else 'N/A'"/&gt;&lt;/td&gt;
                            &lt;/tr&gt;
                        &lt;/table&gt;
                    &lt;/div&gt;
                    &lt;/t&gt;
                    
                    &lt;div style="margin-top: 40px; padding-top: 20px; border-top: 2px solid #e0e0e0;"&gt;
                        &lt;p style="color: #666; font-size: 14px;"&gt;
                            If you have any questions or concerns regarding this report, please don't hesitate to contact us.
                        &lt;/p&gt;
                        &lt;p style="color: #666; font-size: 14px; margin-bottom: 0;"&gt;
                            &lt;strong&gt;Thank you for choosing our security services.&lt;/strong&gt;
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="margin-top: 20px; padding: 15px; background: #fafafa; border-radius: 4px; text-align: center;"&gt;
                        &lt;p style="margin: 0; color: #999; font-size: 12px;"&gt;
                            This is an automated message from GuardPro Security Management System&lt;br&gt;
                            Report Reference: &lt;t t-out="object.name"/&gt;
                        &lt;/p&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            &lt;/div&gt;&lt;/body&gt;</field></record>
    </data>
</odoo>
