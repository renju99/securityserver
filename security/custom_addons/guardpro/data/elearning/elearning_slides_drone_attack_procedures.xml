        <!-- Module 3: Blast Protection and Building Shelter -->
        <record id="slide_drone_attack_m3_blast_shelter" model="slide.slide">
            <field name="name">Module 3: Blast Protection and Building Shelter</field>
            <field name="channel_id" ref="elearning_course_drone_attack_procedures"/>
