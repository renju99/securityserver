        <!-- Module 2: Civilian Protection and Crowd Control -->
        <record id="slide_drone_attack_m2_crowd_control" model="slide.slide">
            <field name="name">Module 2: Civilian Protection and Crowd Control</field>
            <field name="channel_id" ref="elearning_course_drone_attack_procedures"/>
