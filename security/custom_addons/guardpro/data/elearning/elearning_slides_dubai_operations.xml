        <!-- Module 2: Residential Community Security -->
        <record id="slide_dubai_m2_residential" model="slide.slide">
            <field name="name">Module 2: Residential Community Security</field>
            <field name="channel_id" ref="elearning_course_dubai_operations"/>
            <field name="sequence">20</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.6</field>
            <field name="html_content">
                &lt;h2&gt;Securing Residential Communities in Dubai&lt;/h2&gt;
                
                &lt;h3&gt;Types of Residential Properties:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Gated Communities:&lt;/strong&gt; Emirates Hills, Arabian Ranches, Dubai Marina&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;High-rise Towers:&lt;/strong&gt; Downtown Dubai, JBR, Business Bay&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Villa Compounds:&lt;/strong&gt; Springs, Meadows, Motor City&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Apartment Complexes:&lt;/strong&gt; Various locations&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Gate/Reception Duties:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Resident Verification:&lt;/strong&gt; Check access cards/passes&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Visitor Management:&lt;/strong&gt; Register visitors, issue temporary passes&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Vehicle Registration:&lt;/strong&gt; Log vehicle details&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Delivery Coordination:&lt;/strong&gt; Manage deliveries and couriers&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Contractor Access:&lt;/strong&gt; Verify and escort contractors&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Package Handling:&lt;/strong&gt; Receive and log deliveries&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Domestic Worker Entry Procedures:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Verify domestic worker ID and sponsorship&lt;/li&gt;
                    &lt;li&gt;Check authorization from sponsor/employer&lt;/li&gt;
                    &lt;li&gt;Log entry and exit times&lt;/li&gt;
                    &lt;li&gt;Be respectful and professional&lt;/li&gt;
                    &lt;li&gt;Follow community-specific policies&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Patrol Responsibilities:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Regular patrols of common areas&lt;/li&gt;
                    &lt;li&gt;Check perimeter fencing and gates&lt;/li&gt;
                    &lt;li&gt;Monitor swimming pools and gyms&lt;/li&gt;
                    &lt;li&gt;Inspect parking areas&lt;/li&gt;
                    &lt;li&gt;Check exterior lighting&lt;/li&gt;
                    &lt;li&gt;Report maintenance issues&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Common Residential Issues:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Noise complaints&lt;/li&gt;
                    &lt;li&gt;Parking violations&lt;/li&gt;
                    &lt;li&gt;Pool/facility rule violations&lt;/li&gt;
                    &lt;li&gt;Lost access cards&lt;/li&gt;
                    &lt;li&gt;Domestic disputes&lt;/li&gt;
                    &lt;li&gt;Water leaks/maintenance emergencies&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Emergency Procedures:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Know all emergency exits and assembly points&lt;/li&gt;
                    &lt;li&gt;Maintain emergency contact list&lt;/li&gt;
                    &lt;li&gt;Fire alarm response protocol&lt;/li&gt;
                    &lt;li&gt;Water/gas leak procedures&lt;/li&gt;
                    &lt;li&gt;Medical emergency response&lt;/li&gt;
                    &lt;li&gt;Coordinate with emergency services&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Privacy and Discretion:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Respect resident privacy at all times&lt;/li&gt;
                    &lt;li&gt;Never discuss residents with others&lt;/li&gt;
                    &lt;li&gt;Maintain confidentiality of resident information&lt;/li&gt;
                    &lt;li&gt;Be discreet when dealing with sensitive issues&lt;/li&gt;
                    &lt;li&gt;No photography of residents or properties&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

