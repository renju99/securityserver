        <!-- Module 5: Dubai Climate and Seasonal Considerations -->
        <record id="slide_dubai_m5_climate" model="slide.slide">
            <field name="name">Module 5: Dubai Climate &amp; Seasonal Considerations</field>
            <field name="channel_id" ref="elearning_course_dubai_operations"/>
            <field name="sequence">50</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.4</field>
            <field name="html_content">
                &lt;h2&gt;Working in Dubai's Climate&lt;/h2&gt;
                
                &lt;h3&gt;Dubai Weather Overview:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Summer (May-October):&lt;/strong&gt; Extremely hot, 40-48°C (104-118°F)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Winter (November-April):&lt;/strong&gt; Mild, pleasant, 14-25°C (57-77°F)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Humidity:&lt;/strong&gt; High, especially in summer (60-90%)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Rainfall:&lt;/strong&gt; Minimal, mostly December-March&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Sandstorms:&lt;/strong&gt; Occasional, more common in spring&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Heat Safety for Outdoor Security:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Hydration:&lt;/strong&gt; Drink water every 15-20 minutes&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Shade:&lt;/strong&gt; Take breaks in shaded areas&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Uniform:&lt;/strong&gt; Light-colored, breathable fabric&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Sun Protection:&lt;/strong&gt; Wear cap, sunglasses if permitted&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Rotation:&lt;/strong&gt; Rotate outdoor posts more frequently in summer&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Monitor:&lt;/strong&gt; Watch for signs of heat exhaustion&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Signs of Heat Exhaustion:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Heavy sweating&lt;/li&gt;
                    &lt;li&gt;Weakness or fatigue&lt;/li&gt;
                    &lt;li&gt;Dizziness or fainting&lt;/li&gt;
                    &lt;li&gt;Headache&lt;/li&gt;
                    &lt;li&gt;Nausea or vomiting&lt;/li&gt;
                    &lt;li&gt;Muscle cramps&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Action:&lt;/strong&gt; Move to cool area, drink water, seek medical help&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Sandstorm Procedures:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Close all windows and doors&lt;/li&gt;
                    &lt;li&gt;Secure loose outdoor items&lt;/li&gt;
                    &lt;li&gt;Advise people to stay indoors&lt;/li&gt;
                    &lt;li&gt;Reduce outdoor patrols&lt;/li&gt;
                    &lt;li&gt;Monitor for visibility hazards&lt;/li&gt;
                    &lt;li&gt;Check HVAC systems after storm passes&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Midday Break (Summer):&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;UAE labor law: Outdoor work prohibited 12:30 PM - 3:00 PM (June 15 - Sep 15)&lt;/li&gt;
                    &lt;li&gt;Applies to outdoor workers during hottest hours&lt;/li&gt;
                    &lt;li&gt;Security operations may be exempt but take precautions&lt;/li&gt;
                    &lt;li&gt;Employers must provide shaded rest areas&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Ramadan Considerations:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Working hours may be reduced (2 hours less per day)&lt;/li&gt;
                    &lt;li&gt;Fasting guards need extra hydration after sunset&lt;/li&gt;
                    &lt;li&gt;Be understanding of colleagues who are fasting&lt;/li&gt;
                    &lt;li&gt;Schedule rotations considerately&lt;/li&gt;
                    &lt;li&gt;Evening hours busier (Iftar time around sunset)&lt;/li&gt;
                &lt;/ul&gt;
            </field>
