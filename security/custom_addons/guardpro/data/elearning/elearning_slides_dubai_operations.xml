        <!-- Module 1: Shopping Mall Security -->
        <record id="slide_dubai_m1_mall" model="slide.slide">
            <field name="name">Module 1: Shopping Mall Security in Dubai</field>
            <field name="channel_id" ref="elearning_course_dubai_operations"/>
            <field name="sequence">10</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.6</field>
            <field name="html_content">
                &lt;h2&gt;Security Operations in Dubai Malls&lt;/h2&gt;
                &lt;p&gt;Dubai is home to some of the world's largest and busiest shopping malls. Security operations require specialized knowledge and skills.&lt;/p&gt;
                
                &lt;h3&gt;Major Dubai Malls:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Dubai Mall (world's largest by total area)&lt;/li&gt;
                    &lt;li&gt;Mall of the Emirates&lt;/li&gt;
                    &lt;li&gt;Ibn Battuta Mall&lt;/li&gt;
                    &lt;li&gt;Dubai Festival City Mall&lt;/li&gt;
                    &lt;li&gt;City Centre Deira&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Mall Security Responsibilities:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Access Control:&lt;/strong&gt; Staff and VIP entrances&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Parking Management:&lt;/strong&gt; Monitor parking areas&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Loss Prevention:&lt;/strong&gt; Prevent theft and shoplifting&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Customer Safety:&lt;/strong&gt; Assist shoppers, lost children&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Patrol:&lt;/strong&gt; Regular rounds of all areas&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;CCTV Monitoring:&lt;/strong&gt; Active surveillance&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Emergency Response:&lt;/strong&gt; Fire, medical, evacuation&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Common Mall Incidents:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Shoplifting and theft&lt;/li&gt;
                    &lt;li&gt;Lost children&lt;/li&gt;
                    &lt;li&gt;Medical emergencies&lt;/li&gt;
                    &lt;li&gt;Slip and fall accidents&lt;/li&gt;
                    &lt;li&gt;Disputes between customers&lt;/li&gt;
                    &lt;li&gt;Suspicious packages&lt;/li&gt;
                    &lt;li&gt;Fire alarm activations&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Dress Code Enforcement:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Politely remind visitors of mall dress code&lt;/li&gt;
                    &lt;li&gt;Modest clothing required (shoulders and knees covered)&lt;/li&gt;
                    &lt;li&gt;No offensive language or images on clothing&lt;/li&gt;
                    &lt;li&gt;Swimwear not permitted in public areas&lt;/li&gt;
                    &lt;li&gt;Be respectful and professional when addressing violations&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Lost Child Protocol:&lt;/h3&gt;
                &lt;ol&gt;
                    &lt;li&gt;Stay with child, don't move from location&lt;/li&gt;
                    &lt;li&gt;Radio security control immediately&lt;/li&gt;
                    &lt;li&gt;Gather information: child's name, age, parent description&lt;/li&gt;
                    &lt;li&gt;Keep child calm and comfortable&lt;/li&gt;
                    &lt;li&gt;Security control makes announcement&lt;/li&gt;
                    &lt;li&gt;Escort child to security office&lt;/li&gt;
                    &lt;li&gt;Verify parent identity before release&lt;/li&gt;
                    &lt;li&gt;Document incident&lt;/li&gt;
                &lt;/ol&gt;
                
                &lt;h3&gt;Peak Periods and Special Events:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Dubai Shopping Festival (DSF):&lt;/strong&gt; January-February&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Dubai Summer Surprises (DSS):&lt;/strong&gt; July-August&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Eid Holidays:&lt;/strong&gt; Extremely busy periods&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Weekends:&lt;/strong&gt; Thursday-Saturday high traffic&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Evening Hours:&lt;/strong&gt; 6 PM - 11 PM busiest times&lt;/li&gt;
                    &lt;li&gt;Extra security required during these periods&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Parking Area Security:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Monitor for suspicious activity&lt;/li&gt;
                    &lt;li&gt;Assist with vehicle lockouts&lt;/li&gt;
                    &lt;li&gt;Report abandoned vehicles&lt;/li&gt;
                    &lt;li&gt;Prevent car break-ins&lt;/li&gt;
                    &lt;li&gt;Manage traffic flow&lt;/li&gt;
                    &lt;li&gt;Ensure emergency access lanes clear&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

