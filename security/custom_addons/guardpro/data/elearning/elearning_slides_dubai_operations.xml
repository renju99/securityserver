        <!-- Module 4: Event Security -->
        <record id="slide_dubai_m4_events" model="slide.slide">
            <field name="name">Module 4: Event Security in Dubai</field>
            <field name="channel_id" ref="elearning_course_dubai_operations"/>
            <field name="sequence">40</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.6</field>
            <field name="html_content">
                &lt;h2&gt;Security for Events and Gatherings&lt;/h2&gt;
                
                &lt;h3&gt;Major Event Venues in Dubai:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Dubai World Trade Centre&lt;/li&gt;
                    &lt;li&gt;Dubai International Convention &amp; Exhibition Centre&lt;/li&gt;
                    &lt;li&gt;Coca-Cola Arena&lt;/li&gt;
                    &lt;li&gt;Dubai Opera&lt;/li&gt;
                    &lt;li&gt;Hotels and beach venues&lt;/li&gt;
                    &lt;li&gt;Outdoor festival sites&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Types of Events:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Trade Shows &amp; Exhibitions:&lt;/strong&gt; GITEX, Arab Health, etc.&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Concerts &amp; Performances:&lt;/strong&gt; International artists&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Sports Events:&lt;/strong&gt; Dubai Marathon, tennis, golf&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Festivals:&lt;/strong&gt; Food festivals, cultural events&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Corporate Events:&lt;/strong&gt; Conferences, gala dinners&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Weddings:&lt;/strong&gt; Large-scale celebrations&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Pre-Event Security Planning:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Site survey and risk assessment&lt;/li&gt;
                    &lt;li&gt;Review event layout and floor plan&lt;/li&gt;
                    &lt;li&gt;Identify emergency exits and evacuation routes&lt;/li&gt;
                    &lt;li&gt;Coordinate with Dubai Police if required&lt;/li&gt;
                    &lt;li&gt;Arrange medical standby if needed&lt;/li&gt;
                    &lt;li&gt;Brief security team on specific threats&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Event Security Duties:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Perimeter Control:&lt;/strong&gt; Secure event boundaries&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Entry Screening:&lt;/strong&gt; Ticket verification, bag checks&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Crowd Management:&lt;/strong&gt; Control flow and prevent crowding&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;VIP Protection:&lt;/strong&gt; Secure VIP areas and movements&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Parking Management:&lt;/strong&gt; Direct and secure parking&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Patrol:&lt;/strong&gt; Regular monitoring of all areas&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Crowd Management Techniques:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Use barriers and rope lines effectively&lt;/li&gt;
                    &lt;li&gt;Manage entry and exit flows&lt;/li&gt;
                    &lt;li&gt;Prevent bottlenecks at key points&lt;/li&gt;
                    &lt;li&gt;Monitor crowd density&lt;/li&gt;
                    &lt;li&gt;Identify and prevent crowd surges&lt;/li&gt;
                    &lt;li&gt;Clear communication with crowd&lt;/li&gt;
                    &lt;li&gt;Coordinate with team via radio&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Prohibited Items at Events:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Weapons of any kind&lt;/li&gt;
                    &lt;li&gt;Illegal substances&lt;/li&gt;
                    &lt;li&gt;Alcohol (unless licensed event)&lt;/li&gt;
                    &lt;li&gt;Outside food and beverages (venue policy)&lt;/li&gt;
                    &lt;li&gt;Professional cameras (without authorization)&lt;/li&gt;
                    &lt;li&gt;Laser pointers&lt;/li&gt;
                    &lt;li&gt;Large bags or backpacks&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Emergency Evacuation Procedures:&lt;/h3&gt;
                &lt;ol&gt;
                    &lt;li&gt;Remain calm and professional&lt;/li&gt;
                    &lt;li&gt;Follow venue emergency plan&lt;/li&gt;
                    &lt;li&gt;Direct crowds to nearest safe exit&lt;/li&gt;
                    &lt;li&gt;Prevent panic and stampede&lt;/li&gt;
                    &lt;li&gt;Assist persons with disabilities&lt;/li&gt;
                    &lt;li&gt;Guide to assembly points&lt;/li&gt;
                    &lt;li&gt;Account for all personnel&lt;/li&gt;
                    &lt;li&gt;Coordinate with emergency services&lt;/li&gt;
                &lt;/ol&gt;
                
                &lt;h3&gt;Post-Event Security:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Manage orderly departure&lt;/li&gt;
                    &lt;li&gt;Secure venue after crowd disperses&lt;/li&gt;
                    &lt;li&gt;Check for left-behind items&lt;/li&gt;
                    &lt;li&gt;Report lost and found items&lt;/li&gt;
                    &lt;li&gt;Complete incident reports&lt;/li&gt;
                    &lt;li&gt;Debrief with security team&lt;/li&gt;
                &lt;/ul&gt;
