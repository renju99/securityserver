        <!-- Module 3: Commercial Building Security -->
        <record id="slide_dubai_m3_commercial" model="slide.slide">
            <field name="name">Module 3: Commercial Building &amp; Office Tower Security</field>
            <field name="channel_id" ref="elearning_course_dubai_operations"/>
            <field name="sequence">30</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.6</field>
            <field name="html_content">
                &lt;h2&gt;Office Tower and Commercial Building Security&lt;/h2&gt;
                
                &lt;h3&gt;Major Business Districts in Dubai:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Downtown Dubai (Burj Khalifa area)&lt;/li&gt;
                    &lt;li&gt;Business Bay&lt;/li&gt;
                    &lt;li&gt;Dubai International Financial Centre (DIFC)&lt;/li&gt;
                    &lt;li&gt;Dubai Media City&lt;/li&gt;
                    &lt;li&gt;Dubai Internet City&lt;/li&gt;
                    &lt;li&gt;Jumeirah Lakes Towers (JLT)&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Lobby Security Duties:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Access Control:&lt;/strong&gt; Employee and visitor badge verification&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Visitor Registration:&lt;/strong&gt; Check-in/check-out system&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Visitor Escorts:&lt;/strong&gt; To secured areas when required&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Package Screening:&lt;/strong&gt; X-ray and inspection&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Customer Service:&lt;/strong&gt; Directions and assistance&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;CCTV Monitoring:&lt;/strong&gt; Continuous surveillance&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Elevator and Access Control:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Monitor access card readers&lt;/li&gt;
                    &lt;li&gt;Manage elevator access to secured floors&lt;/li&gt;
                    &lt;li&gt;Escort unauthorized persons off premises&lt;/li&gt;
                    &lt;li&gt;Respond to access control alarms&lt;/li&gt;
                    &lt;li&gt;Verify after-hours access authorization&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;After-Hours Security:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Verify employee authorization for after-hours access&lt;/li&gt;
                    &lt;li&gt;Log all after-hours entries and exits&lt;/li&gt;
                    &lt;li&gt;Conduct regular patrol of all floors&lt;/li&gt;
                    &lt;li&gt;Check all doors and windows&lt;/li&gt;
                    &lt;li&gt;Verify equipment is powered down&lt;/li&gt;
                    &lt;li&gt;Check for water leaks or maintenance issues&lt;/li&gt;
                    &lt;li&gt;Respond to alarm activations&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;VIP and Executive Protection:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Maintain confidentiality of executive schedules&lt;/li&gt;
                    &lt;li&gt;Screen visitors to executive floors&lt;/li&gt;
                    &lt;li&gt;Coordinate with executive protection details&lt;/li&gt;
                    &lt;li&gt;Secure elevator access during VIP arrivals&lt;/li&gt;
                    &lt;li&gt;Be aware of potential threats&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Contractor and Vendor Management:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Verify contractor authorization&lt;/li&gt;
                    &lt;li&gt;Check work permits and insurance&lt;/li&gt;
                    &lt;li&gt;Escort to work areas&lt;/li&gt;
                    &lt;li&gt;Monitor for safety compliance&lt;/li&gt;
                    &lt;li&gt;Log entry and exit with equipment&lt;/li&gt;
                    &lt;li&gt;Inspect work area after completion&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Business Continuity and Emergency:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Know building evacuation plan&lt;/li&gt;
                    &lt;li&gt;Assembly point locations&lt;/li&gt;
                    &lt;li&gt;Emergency contact procedures&lt;/li&gt;
                    &lt;li&gt;Building systems shutdown procedures&lt;/li&gt;
                    &lt;li&gt;Fire warden coordination&lt;/li&gt;
                    &lt;li&gt;Emergency operations center location&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Cybersecurity Awareness:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Never leave workstations unattended and unlocked&lt;/li&gt;
                    &lt;li&gt;Report suspicious persons near server rooms&lt;/li&gt;
                    &lt;li&gt;Ensure visitors don't have unauthorized access to IT areas&lt;/li&gt;
                    &lt;li&gt;Report any USB devices or equipment left behind&lt;/li&gt;
                    &lt;li&gt;Secure disposal of documents&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

