        <!-- Module 2: Customer Service in Multicultural Environment -->
        <record id="slide_uae_m2_service" model="slide.slide">
            <field name="name">Module 2: Customer Service in Dubai's Multicultural Environment</field>
            <field name="channel_id" ref="elearning_course_uae_culture"/>
            <field name="sequence">20</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.5</field>
            <field name="html_content">
                &lt;h2&gt;Serving Dubai's Diverse Population&lt;/h2&gt;
                
                &lt;h3&gt;Dubai's Multicultural Reality:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Over 90% expatriate population&lt;/li&gt;
                    &lt;li&gt;200+ nationalities represented&lt;/li&gt;
                    &lt;li&gt;Major communities: Indian, Pakistani, Filipino, British, Arab, etc.&lt;/li&gt;
                    &lt;li&gt;Multiple languages spoken&lt;/li&gt;
                    &lt;li&gt;Various religious practices&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Cultural Sensitivity Skills:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Open-mindedness:&lt;/strong&gt; Respect all cultures equally&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Non-judgmental:&lt;/strong&gt; Accept differences in customs&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Patience:&lt;/strong&gt; Language barriers may require extra time&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Adaptability:&lt;/strong&gt; Adjust communication style as needed&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Awareness:&lt;/strong&gt; Understand cultural celebrations and customs&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Communicating Across Language Barriers:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Speak slowly and clearly&lt;/li&gt;
                    &lt;li&gt;Use simple, common words&lt;/li&gt;
                    &lt;li&gt;Avoid slang and idioms&lt;/li&gt;
                    &lt;li&gt;Use visual aids when possible&lt;/li&gt;
                    &lt;li&gt;Be patient with accents&lt;/li&gt;
                    &lt;li&gt;Confirm understanding&lt;/li&gt;
                    &lt;li&gt;Use translation apps if needed&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Interacting with VIPs and Dignitaries:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Emirati Royalty:&lt;/strong&gt; Address as "Your Highness" or "Sheikh"&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Government Officials:&lt;/strong&gt; Show extra respect and courtesy&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Diplomatic Personnel:&lt;/strong&gt; Professional and discreet&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Celebrities:&lt;/strong&gt; Protect privacy, no photos&lt;/li&gt;
                    &lt;li&gt;Follow security protocols strictly&lt;/li&gt;
                    &lt;li&gt;Maintain confidentiality&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Gender Considerations:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Conservative Approach:&lt;/strong&gt; When in doubt, be formal&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Eye Contact:&lt;/strong&gt; Brief with opposite gender&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Physical Contact:&lt;/strong&gt; Avoid with opposite gender unless initiated&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Female Searches:&lt;/strong&gt; Only by female security officers&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Abaya/Hijab:&lt;/strong&gt; Respect religious dress&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Handling Special Requests:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Prayer room directions&lt;/li&gt;
                    &lt;li&gt;Halal food inquiries&lt;/li&gt;
                    &lt;li&gt;Gender-segregated facilities&lt;/li&gt;
                    &lt;li&gt;Religious observance accommodations&lt;/li&gt;
                    &lt;li&gt;Cultural event information&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

