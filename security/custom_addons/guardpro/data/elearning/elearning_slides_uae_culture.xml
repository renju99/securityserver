        <!-- Module 1: Understanding UAE Culture -->
        <record id="slide_uae_m1_culture" model="slide.slide">
            <field name="name">Module 1: Understanding UAE Culture &amp; Values</field>
            <field name="channel_id" ref="elearning_course_uae_culture"/>
            <field name="sequence">10</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.6</field>
            <field name="html_content">
                &lt;h2&gt;UAE Culture and Values&lt;/h2&gt;
                
                &lt;h3&gt;About the UAE:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Federation of 7 Emirates established in 1971&lt;/li&gt;
                    &lt;li&gt;Dubai is the most populous emirate&lt;/li&gt;
                    &lt;li&gt;Islam is the official religion&lt;/li&gt;
                    &lt;li&gt;Arabic is the official language&lt;/li&gt;
                    &lt;li&gt;Multicultural society with over 200 nationalities&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Core Emirati Values:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Respect:&lt;/strong&gt; For authority, elders, and traditions&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Hospitality:&lt;/strong&gt; Welcoming and generous to guests&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Family:&lt;/strong&gt; Strong family bonds and loyalty&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Honor:&lt;/strong&gt; Personal and family reputation&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Modesty:&lt;/strong&gt; In dress and behavior&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Islamic Practices to Respect:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Prayer Times:&lt;/strong&gt; 5 daily prayers - Fajr, Dhuhr, Asr, Maghrib, Isha&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Friday:&lt;/strong&gt; Holy day for Muslims (extended Friday prayer)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Ramadan:&lt;/strong&gt; Month of fasting (no eating/drinking in public)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Eid Al Fitr:&lt;/strong&gt; Festival after Ramadan&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Eid Al Adha:&lt;/strong&gt; Festival of Sacrifice&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Dress Code in UAE:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Security Uniform:&lt;/strong&gt; Must be clean and professional&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Off-Duty:&lt;/strong&gt; Dress modestly, no revealing clothing&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Public Places:&lt;/strong&gt; Cover shoulders and knees&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Malls:&lt;/strong&gt; Modest clothing required&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Beaches:&lt;/strong&gt; Swimwear only at beach/pool areas&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Social Etiquette:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Greetings:&lt;/strong&gt; "As-salamu alaykum" (Peace be upon you)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Handshakes:&lt;/strong&gt; Right hand only, wait for women to extend hand first&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Left Hand:&lt;/strong&gt; Considered unclean, avoid giving/receiving with left&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Feet:&lt;/strong&gt; Don't point soles at people or cross legs showing sole&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Personal Space:&lt;/strong&gt; Respect personal space, especially with opposite gender&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Public Affection:&lt;/strong&gt; Not acceptable between opposite genders&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Prohibited Behaviors:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Public intoxication (zero tolerance)&lt;/li&gt;
                    &lt;li&gt;Drug use (severe penalties)&lt;/li&gt;
                    &lt;li&gt;Insulting Islam, UAE leaders, or flag&lt;/li&gt;
                    &lt;li&gt;Photography without permission&lt;/li&gt;
                    &lt;li&gt;Offensive gestures or language&lt;/li&gt;
                    &lt;li&gt;Eating/drinking in public during Ramadan&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

