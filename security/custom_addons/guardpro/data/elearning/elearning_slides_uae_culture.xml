        <!-- Module 3: Basic Arabic for Security Personnel -->
        <record id="slide_uae_m3_arabic" model="slide.slide">
            <field name="name">Module 3: Basic Arabic for Security Personnel</field>
            <field name="channel_id" ref="elearning_course_uae_culture"/>
            <field name="sequence">30</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.6</field>
            <field name="html_content">
                &lt;h2&gt;Essential Arabic Phrases&lt;/h2&gt;
                
                &lt;h3&gt;Basic Greetings:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;As-salamu alaykum&lt;/strong&gt; (as-sa-LAH-mu a-LAY-kum) - Peace be upon you&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Wa alaykumu as-salam&lt;/strong&gt; (wa a-LAY-ku-mu as-sa-LAM) - And peace be upon you too (response)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Sabah al-khair&lt;/strong&gt; (sa-BAH al-KHAIR) - Good morning&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Masaa al-khair&lt;/strong&gt; (ma-SAA al-KHAIR) - Good evening&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Marhaba&lt;/strong&gt; (mar-HA-ba) - Hello/Welcome&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Ahlan wa sahlan&lt;/strong&gt; (AH-lan wa SAH-lan) - Welcome&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Common Courtesies:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Shukran&lt;/strong&gt; (SHUK-ran) - Thank you&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Afwan&lt;/strong&gt; (AF-wan) - You're welcome&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Min fadlak/fadlik&lt;/strong&gt; (min FAD-lak/FAD-lik) - Please (m/f)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Aasif&lt;/strong&gt; (AA-sif) - Sorry&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Ma'assalama&lt;/strong&gt; (ma-as-sa-LA-ma) - Goodbye&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Inshallah&lt;/strong&gt; (in-sha-AL-lah) - God willing&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Security-Related Phrases:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Mumkin musa'adatak?&lt;/strong&gt; - Can I help you?&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Hawiyyah min fadlak&lt;/strong&gt; - ID please&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Waqif!&lt;/strong&gt; (WA-qif) - Stop!&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Mamnu'&lt;/strong&gt; (mam-NU) - Forbidden/Not allowed&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Ila huna faqat&lt;/strong&gt; - Only until here&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Intathir huna&lt;/strong&gt; - Wait here&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Ta'aal ma'i&lt;/strong&gt; - Come with me&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Directions:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Yamin&lt;/strong&gt; (ya-MEEN) - Right&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Yasar&lt;/strong&gt; (ya-SAR) - Left&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Tuul/yaseer&lt;/strong&gt; - Straight&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Foq&lt;/strong&gt; - Up/Upstairs&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Taht&lt;/strong&gt; - Down/Downstairs&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Huna&lt;/strong&gt; (HU-na) - Here&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Hunak&lt;/strong&gt; (hu-NAK) - There&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Emergency Phrases:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Najdah!&lt;/strong&gt; - Help!&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Khatar!&lt;/strong&gt; - Danger!&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Naar!&lt;/strong&gt; - Fire!&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Akhrug!&lt;/strong&gt; - Get out! (evacuation)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Ittisal ash-shurtah&lt;/strong&gt; - Call the police&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Is'aaf&lt;/strong&gt; - Ambulance&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Common Questions:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Hal tatakallam al-ingliziyyah?&lt;/strong&gt; - Do you speak English?&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Ayna...?&lt;/strong&gt; - Where is...?&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Ma ismuk?&lt;/strong&gt; - What is your name?&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Kam?&lt;/strong&gt; - How many?&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Numbers 1-10:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Wahid&lt;/strong&gt; - One&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Ithnain&lt;/strong&gt; - Two&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Thalatha&lt;/strong&gt; - Three&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Arba'a&lt;/strong&gt; - Four&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Khamsa&lt;/strong&gt; - Five&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Sitta&lt;/strong&gt; - Six&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Sab'a&lt;/strong&gt; - Seven&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Thamaniya&lt;/strong&gt; - Eight&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Tis'a&lt;/strong&gt; - Nine&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;'Ashara&lt;/strong&gt; - Ten&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

