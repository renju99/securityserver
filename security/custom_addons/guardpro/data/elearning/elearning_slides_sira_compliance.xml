        <!-- Module 1: Introduction to SIRA -->
        <record id="slide_sira_m1_intro" model="slide.slide">
            <field name="name">Module 1: Introduction to SIRA</field>
            <field name="channel_id" ref="elearning_course_sira_compliance"/>
            <field name="sequence">10</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.5</field>
            <field name="html_content">
                &lt;h2&gt;Security Industry Regulatory Agency (SIRA)&lt;/h2&gt;
                &lt;p&gt;SIRA is the regulatory authority for the security industry in Dubai, established by Law No. 6 of 2019.&lt;/p&gt;
                
                &lt;h3&gt;SIRA's Mission:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Regulate and license security companies in Dubai&lt;/li&gt;
                    &lt;li&gt;Set professional standards for security personnel&lt;/li&gt;
                    &lt;li&gt;Ensure public safety and security&lt;/li&gt;
                    &lt;li&gt;Promote excellence in the security industry&lt;/li&gt;
                    &lt;li&gt;Protect consumer rights&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;SIRA Licensing Categories:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Security Guard:&lt;/strong&gt; Entry-level security personnel&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Security Supervisor:&lt;/strong&gt; Site and team supervision&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Security Manager:&lt;/strong&gt; Strategic security management&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Specialized Roles:&lt;/strong&gt; K9 handlers, close protection, etc.&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Licensing Requirements:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Complete SIRA-approved training program&lt;/li&gt;
                    &lt;li&gt;Pass SIRA certification examination&lt;/li&gt;
                    &lt;li&gt;Background check and security clearance&lt;/li&gt;
                    &lt;li&gt;Medical fitness certificate&lt;/li&gt;
                    &lt;li&gt;Valid UAE residence visa&lt;/li&gt;
                    &lt;li&gt;Minimum age: 21 years&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;License Validity &amp; Renewal:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;SIRA license valid for 2 years&lt;/li&gt;
                    &lt;li&gt;Must renew before expiration&lt;/li&gt;
                    &lt;li&gt;Continuing education required for renewal&lt;/li&gt;
                    &lt;li&gt;Renewal training: 16 hours minimum&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Penalties for Non-Compliance:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Working without valid SIRA license: Heavy fines&lt;/li&gt;
                    &lt;li&gt;License suspension or revocation&lt;/li&gt;
                    &lt;li&gt;Employment ban in security industry&lt;/li&gt;
                    &lt;li&gt;Deportation for serious violations&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

