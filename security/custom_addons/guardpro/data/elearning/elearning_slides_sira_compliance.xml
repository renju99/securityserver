        <!-- Module 3: Professional Conduct Standards -->
        <record id="slide_sira_m3_conduct" model="slide.slide">
            <field name="name">Module 3: SIRA Professional Conduct Standards</field>
            <field name="channel_id" ref="elearning_course_sira_compliance"/>
            <field name="sequence">30</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.5</field>
            <field name="html_content">
                &lt;h2&gt;Professional Standards for Security Personnel&lt;/h2&gt;
                
                &lt;h3&gt;SIRA Code of Conduct:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Integrity:&lt;/strong&gt; Act with honesty and honor&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Professionalism:&lt;/strong&gt; Maintain high standards&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Accountability:&lt;/strong&gt; Take responsibility for actions&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Respect:&lt;/strong&gt; Treat all with dignity&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Competence:&lt;/strong&gt; Maintain skills and knowledge&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Uniform and Appearance Standards:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Wear SIRA-approved uniform at all times on duty&lt;/li&gt;
                    &lt;li&gt;Display SIRA license card visibly&lt;/li&gt;
                    &lt;li&gt;Maintain clean, pressed uniform&lt;/li&gt;
                    &lt;li&gt;Professional grooming (neat hair, trimmed facial hair)&lt;/li&gt;
                    &lt;li&gt;Proper footwear (black, polished shoes)&lt;/li&gt;
                    &lt;li&gt;No unauthorized modifications to uniform&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Mandatory Equipment:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;SIRA license card&lt;/li&gt;
                    &lt;li&gt;Company ID badge&lt;/li&gt;
                    &lt;li&gt;Communication device (radio/phone)&lt;/li&gt;
                    &lt;li&gt;Incident report forms or tablet&lt;/li&gt;
                    &lt;li&gt;Flashlight (for night shifts)&lt;/li&gt;
                    &lt;li&gt;First aid kit (as required)&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Prohibited Activities:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Sleeping or negligence while on duty&lt;/li&gt;
                    &lt;li&gt;Using mobile phone for personal calls&lt;/li&gt;
                    &lt;li&gt;Leaving post without authorization&lt;/li&gt;
                    &lt;li&gt;Alcohol or drug use (zero tolerance)&lt;/li&gt;
                    &lt;li&gt;Accepting bribes or gifts&lt;/li&gt;
                    &lt;li&gt;Disclosing confidential information&lt;/li&gt;
                    &lt;li&gt;Engaging in outside employment during shift&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Reporting Requirements:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Report all incidents immediately&lt;/li&gt;
                    &lt;li&gt;Maintain accurate logs&lt;/li&gt;
                    &lt;li&gt;Complete daily activity reports&lt;/li&gt;
                    &lt;li&gt;Document visitor and vehicle movements&lt;/li&gt;
                    &lt;li&gt;Report suspicious activities to police&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Continuing Professional Development:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Attend mandatory refresher training&lt;/li&gt;
                    &lt;li&gt;Stay updated on SIRA regulations&lt;/li&gt;
                    &lt;li&gt;Participate in company training programs&lt;/li&gt;
                    &lt;li&gt;Maintain physical fitness&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

