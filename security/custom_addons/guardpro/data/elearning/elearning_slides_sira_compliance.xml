        <!-- Module 2: UAE Federal Laws for Security Personnel -->
        <record id="slide_sira_m2_laws" model="slide.slide">
            <field name="name">Module 2: UAE Federal Laws for Security Personnel</field>
            <field name="channel_id" ref="elearning_course_sira_compliance"/>
            <field name="sequence">20</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.6</field>
            <field name="html_content">
                &lt;h2&gt;UAE Legal Framework for Security Operations&lt;/h2&gt;
                
                &lt;h3&gt;Key Federal Laws:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Federal Law No. 3 of 1987:&lt;/strong&gt; UAE Penal Code&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Federal Law No. 5 of 2012:&lt;/strong&gt; Combating Cybercrimes&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Federal Decree Law No. 31 of 2021:&lt;/strong&gt; Labor Relations Law&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Dubai Law No. 6 of 2019:&lt;/strong&gt; Security Industry Regulation&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Security Guard Powers in UAE:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Observe and Report:&lt;/strong&gt; Primary duty&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Access Control:&lt;/strong&gt; Control entry to private property&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Detention:&lt;/strong&gt; Only until police arrive (no arrest power)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Self-Defense:&lt;/strong&gt; Reasonable force only&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Search:&lt;/strong&gt; Only with consent or clear authorization&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Prohibited Actions:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Carrying weapons without proper authorization&lt;/li&gt;
                    &lt;li&gt;Using excessive force&lt;/li&gt;
                    &lt;li&gt;Impersonating police or government officials&lt;/li&gt;
                    &lt;li&gt;Making arrests (this is police authority only)&lt;/li&gt;
                    &lt;li&gt;Violating privacy laws&lt;/li&gt;
                    &lt;li&gt;Discrimination based on nationality, religion, or race&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Use of Force Guidelines:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Minimum Force:&lt;/strong&gt; Use only necessary force&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Proportionate:&lt;/strong&gt; Match level of threat&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Reasonable:&lt;/strong&gt; What a reasonable person would do&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Document:&lt;/strong&gt; Report all use of force incidents&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Privacy and Data Protection:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Respect visitor and employee privacy&lt;/li&gt;
                    &lt;li&gt;Handle personal data confidentially&lt;/li&gt;
                    &lt;li&gt;CCTV must comply with Dubai regulations&lt;/li&gt;
                    &lt;li&gt;Cannot share footage without authorization&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Workplace Rights &amp; Responsibilities:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Right to safe working conditions&lt;/li&gt;
                    &lt;li&gt;Right to timely salary payment&lt;/li&gt;
                    &lt;li&gt;Duty to follow lawful instructions&lt;/li&gt;
                    &lt;li&gt;Duty to report violations&lt;/li&gt;
                    &lt;li&gt;Maximum working hours: 8 hours/day, 48 hours/week&lt;/li&gt;
                    &lt;li&gt;Annual leave: 30 days after one year service&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

