        <!-- Module 4: Dubai Emergency Services -->
        <record id="slide_sira_m4_emergency" model="slide.slide">
            <field name="name">Module 4: Dubai Emergency Services &amp; Protocols</field>
            <field name="channel_id" ref="elearning_course_sira_compliance"/>
            <field name="sequence">40</field>
            <field name="slide_category">article</field>
            <field name="is_published">True</field>
            <field name="completion_time">0.5</field>
            <field name="html_content">
                &lt;h2&gt;Emergency Response in Dubai&lt;/h2&gt;
                
                &lt;h3&gt;Dubai Emergency Numbers:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;999:&lt;/strong&gt; Dubai Police (Emergency)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;998:&lt;/strong&gt; Dubai Civil Defense (Fire)&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;997:&lt;/strong&gt; Dubai Ambulance&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;991:&lt;/strong&gt; Dubai Electricity &amp; Water Emergency&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;901:&lt;/strong&gt; Non-Emergency Police&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;800-4663:&lt;/strong&gt; Dubai Municipality&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;When to Call Emergency Services:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Any crime in progress&lt;/li&gt;
                    &lt;li&gt;Fire or smell of gas&lt;/li&gt;
                    &lt;li&gt;Medical emergency&lt;/li&gt;
                    &lt;li&gt;Traffic accident with injuries&lt;/li&gt;
                    &lt;li&gt;Suspicious packages or items&lt;/li&gt;
                    &lt;li&gt;Security threat or terrorism&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Information to Provide:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;&lt;strong&gt;Location:&lt;/strong&gt; Exact address, landmarks, building name&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Nature:&lt;/strong&gt; Type of emergency&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Details:&lt;/strong&gt; Number of people involved, injuries&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Your Info:&lt;/strong&gt; Name, company, contact number&lt;/li&gt;
                    &lt;li&gt;&lt;strong&gt;Actions Taken:&lt;/strong&gt; What you've done so far&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Police Interaction Protocol:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Be respectful and cooperative&lt;/li&gt;
                    &lt;li&gt;Provide factual information only&lt;/li&gt;
                    &lt;li&gt;Show your SIRA license immediately&lt;/li&gt;
                    &lt;li&gt;Follow all instructions&lt;/li&gt;
                    &lt;li&gt;Do not interfere with investigations&lt;/li&gt;
                    &lt;li&gt;Provide written reports as requested&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Evacuation Procedures:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Know all emergency exits&lt;/li&gt;
                    &lt;li&gt;Assembly points locations&lt;/li&gt;
                    &lt;li&gt;Evacuation routes&lt;/li&gt;
                    &lt;li&gt;Assist people with disabilities&lt;/li&gt;
                    &lt;li&gt;Account for all personnel&lt;/li&gt;
                    &lt;li&gt;Do not re-enter until cleared by authorities&lt;/li&gt;
                &lt;/ul&gt;
                
                &lt;h3&gt;Civil Defense Cooperation:&lt;/h3&gt;
                &lt;ul&gt;
                    &lt;li&gt;Maintain clear access routes&lt;/li&gt;
                    &lt;li&gt;Know location of fire equipment&lt;/li&gt;
                    &lt;li&gt;Provide building access&lt;/li&gt;
                    &lt;li&gt;Share floor plans if requested&lt;/li&gt;
                    &lt;li&gt;Keep crowd at safe distance&lt;/li&gt;
                &lt;/ul&gt;
            </field>
        </record>

