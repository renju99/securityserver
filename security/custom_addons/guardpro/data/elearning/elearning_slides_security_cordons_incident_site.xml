        <!-- Module 4: Crowd Management at Events and Incidents -->
        <record id="slide_cordon_m4_crowd_management" model="slide.slide">
            <field name="name">Module 4: Crowd Management at Events and Incidents</field>
            <field name="channel_id" ref="elearning_course_security_cordons_incident_site"/>
