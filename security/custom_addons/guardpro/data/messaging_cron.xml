<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Auto-End Expired Status Updates -->
        <record id="ir_cron_auto_end_statuses" model="ir.cron">
            <field name="name">GuardLink: Auto-End Expired Status Updates</field>
            <field name="model_id" ref="model_guard_status_update"/>
            <field name="state">code</field>
            <field name="code">model.auto_end_expired_statuses()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

