<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ================================================================ -->
        <!-- GUARDPRO SCHEDULED ACTIONS (CRON JOBS)                          -->
        <!-- ================================================================ -->
        
        <!-- Shift Reminder Notifications -->
        <record id="cron_shift_reminders" model="ir.cron">
            <field name="name">GuardLink: Send Shift Reminders</field>
            <field name="model_id" ref="model_guard_shift"/>
            <field name="state">code</field>
            <field name="code">model.send_shift_reminders()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>

        <!-- Location History Archiving (30 days) -->
        <record id="cron_cleanup_location_history" model="ir.cron">
            <field name="name">GuardLink: Archive Old Location History (30 days)</field>
            <field name="model_id" ref="model_guard_location_history"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_records()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
            <field name="active" eval="False"/>
            <field name="priority">10</field>
        </record>

        <!-- Certification Expiry Alerts -->
        <record id="cron_certification_expiry" model="ir.cron">
            <field name="name">GuardLink: Check Certification Expiry</field>
            <field name="model_id" ref="model_guard_profile"/>
            <field name="state">code</field>
            <field name="code">model.check_certification_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')"/>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>

        <!-- Escalate Critical Incidents -->
        <record id="cron_escalate_incidents" model="ir.cron">
            <field name="name">GuardLink: Escalate Unresponded Critical Incidents</field>
            <field name="model_id" ref="model_incident_report"/>
            <field name="state">code</field>
            <field name="code">model.escalate_critical_incidents()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
            <field name="priority">1</field>
        </record>

        <!-- Check Overdue Tours -->
        <record id="cron_check_overdue_tours" model="ir.cron">
            <field name="name">GuardLink: Check Overdue Tours</field>
            <field name="model_id" ref="model_tour_log"/>
            <field name="state">code</field>
            <field name="code">model.check_overdue_tours()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>

        <!-- Check Equipment Maintenance -->
        <record id="cron_equipment_maintenance" model="ir.cron">
            <field name="name">GuardLink: Equipment Maintenance Reminders</field>
            <field name="model_id" ref="model_guardpro_equipment"/>
            <field name="state">code</field>
            <field name="code">model.send_maintenance_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="active" eval="False"/>
            <field name="priority">10</field>
        </record>

        <!-- Check Missed Check-ins -->
        <record id="cron_missed_checkins" model="ir.cron">
            <field name="name">GuardLink: Alert on Missed Check-ins</field>
            <field name="model_id" ref="model_guard_shift"/>
            <field name="state">code</field>
            <field name="code">model.check_missed_checkins()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>

        <!-- Update Guard Status -->
        <record id="cron_update_guard_status" model="ir.cron">
            <field name="name">GuardLink: Update Guard Status</field>
            <field name="model_id" ref="model_guard_profile"/>
            <field name="state">code</field>
            <field name="code">model.update_guard_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
            <field name="priority">10</field>
        </record>

        <!-- Generate Shifts from Templates - DISABLED: Manual generation only -->
        <record id="cron_generate_template_shifts" model="ir.cron">
            <field name="name">GuardLink: Generate Shifts from Templates (Disabled)</field>
            <field name="model_id" ref="model_shift_template"/>
            <field name="state">code</field>
            <field name="code"># Disabled - Manual generation only</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
            <field name="active" eval="False"/>
            <field name="priority">10</field>
        </record>

        <!-- mail.mail retention: remove email queue rows older than N days (default 365). Does not delete chatter. -->
        <record id="cron_mail_mail_retention" model="ir.cron">
            <field name="name">GuardLink: Purge old mail.mail (retention, default 365 days)</field>
            <field name="model_id" ref="mail.model_mail_mail"/>
            <field name="state">code</field>
            <field name="code">model.guardpro_cron_purge_old_records()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">25</field>
        </record>

        <!-- Push-to-talk temp stream retention: remove stale temp files from interrupted sessions -->
        <record id="cron_ptt_temp_cleanup" model="ir.cron">
            <field name="name">GuardLink: Cleanup stale push-to-talk temp files</field>
            <field name="model_id" ref="model_push_to_talk_message"/>
            <field name="state">code</field>
            <field name="code">model.cron_cleanup_stale_stream_temp_files()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:30:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">22</field>
        </record>

        <!-- OPTIONAL: Equipment Calibration Due Check -->
        <!-- Requires maintenance module to be activated -->
        <!-- Uncomment when activating equipment management integration -->
        <!--
        <record id="cron_equipment_calibration_check" model="ir.cron">
            <field name="name">GuardLink: Check Equipment Calibration Due</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_calibration_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="active" eval="False"/>
            <field name="priority">10</field>
        </record>
        -->

        <!-- Patrol reminders: 30 / 10 minutes before shift start, per assigned tour -->
        <record id="cron_patrol_reminders" model="ir.cron">
            <field name="name">GuardLink: Patrol Start Reminders (30 / 10 min)</field>
            <field name="model_id" ref="model_tour_patrol_reminder"/>
            <field name="state">code</field>
            <field name="code">model.cron_create_from_shifts()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">6</field>
        </record>

    </data>
</odoo>


