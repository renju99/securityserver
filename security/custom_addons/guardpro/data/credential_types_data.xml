<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ================================================================ -->
        <!-- CREDENTIAL TYPE MASTER DATA                                      -->
        <!-- ================================================================ -->
        
        <!-- Security Licenses -->
        <record id="credential_type_security_license_1" model="guard.credential.type">
            <field name="name">Security Guard License - Level 1</field>
            <field name="code">SEC-L1</field>
            <field name="category">license</field>
            <field name="validity_period">365</field>
            <field name="renewal_notice_days">60</field>
            <field name="is_mandatory" eval="True"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">State Police Department</field>
            <field name="description">Basic security guard license required for all guards</field>
        </record>
        
        <record id="credential_type_security_license_2" model="guard.credential.type">
            <field name="name">Security Guard License - Level 2</field>
            <field name="code">SEC-L2</field>
            <field name="category">license</field>
            <field name="validity_period">730</field>
            <field name="renewal_notice_days">60</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">State Police Department</field>
            <field name="description">Advanced security guard license for supervisors</field>
        </record>
        
        <record id="credential_type_armed_guard_license" model="guard.credential.type">
            <field name="name">Armed Security Guard License</field>
            <field name="code">ARMED-SEC</field>
            <field name="category">license</field>
            <field name="validity_period">365</field>
            <field name="renewal_notice_days">90</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">State Police Department</field>
            <field name="description">License for armed security guards to carry firearms</field>
        </record>
        
        <!-- Certifications -->
        <record id="credential_type_first_aid" model="guard.credential.type">
            <field name="name">First Aid Certification</field>
            <field name="code">FIRST-AID</field>
            <field name="category">certification</field>
            <field name="validity_period">730</field>
            <field name="renewal_notice_days">60</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">Red Cross / St. John Ambulance</field>
            <field name="description">Basic first aid and CPR certification</field>
        </record>
        
        <record id="credential_type_cpr" model="guard.credential.type">
            <field name="name">CPR Certification</field>
            <field name="code">CPR</field>
            <field name="category">certification</field>
            <field name="validity_period">365</field>
            <field name="renewal_notice_days">60</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">Red Cross / American Heart Association</field>
            <field name="description">Cardiopulmonary Resuscitation (CPR) certification</field>
        </record>
        
        <record id="credential_type_fire_safety" model="guard.credential.type">
            <field name="name">Fire Safety Certification</field>
            <field name="code">FIRE-SAFETY</field>
            <field name="category">certification</field>
            <field name="validity_period">1095</field>
            <field name="renewal_notice_days">90</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">Local Fire Department</field>
            <field name="description">Fire safety and prevention certification</field>
        </record>
        
        <record id="credential_type_defensive_driving" model="guard.credential.type">
            <field name="name">Defensive Driving Certification</field>
            <field name="code">DEF-DRIVE</field>
            <field name="category">certification</field>
            <field name="validity_period">1095</field>
            <field name="renewal_notice_days">90</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">Defensive Driving School</field>
            <field name="description">Defensive driving for patrol vehicle operators</field>
        </record>
        
        <!-- Work Permits and Visas -->
        <record id="credential_type_work_permit" model="guard.credential.type">
            <field name="name">Work Permit</field>
            <field name="code">WORK-PERMIT</field>
            <field name="category">permit</field>
            <field name="validity_period">365</field>
            <field name="renewal_notice_days">90</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">Immigration Department</field>
            <field name="description">Work authorization for foreign nationals</field>
        </record>
        
        <record id="credential_type_work_visa" model="guard.credential.type">
            <field name="name">Work Visa</field>
            <field name="code">WORK-VISA</field>
            <field name="category">permit</field>
            <field name="validity_period">730</field>
            <field name="renewal_notice_days">120</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">Immigration Services</field>
            <field name="description">Work visa for international workers</field>
        </record>
        
        <!-- Training Certifications -->
        <record id="credential_type_de_escalation" model="guard.credential.type">
            <field name="name">De-escalation Training</field>
            <field name="code">DE-ESC</field>
            <field name="category">training</field>
            <field name="validity_period">730</field>
            <field name="renewal_notice_days">60</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="description">Training in conflict de-escalation techniques</field>
        </record>
        
        <record id="credential_type_active_shooter" model="guard.credential.type">
            <field name="name">Active Shooter Response Training</field>
            <field name="code">ACT-SHOOT</field>
            <field name="category">training</field>
            <field name="validity_period">365</field>
            <field name="renewal_notice_days">60</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="description">Training for active shooter situations</field>
        </record>
        
        <record id="credential_type_customer_service" model="guard.credential.type">
            <field name="name">Customer Service Training</field>
            <field name="code">CUST-SERV</field>
            <field name="category">training</field>
            <field name="validity_period">1095</field>
            <field name="renewal_notice_days">90</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="False"/>
            <field name="description">Customer service and communication skills</field>
        </record>
        
        <!-- Driver's License -->
        <record id="credential_type_drivers_license" model="guard.credential.type">
            <field name="name">Driver's License</field>
            <field name="code">DL</field>
            <field name="category">license</field>
            <field name="validity_period">1825</field>
            <field name="renewal_notice_days">90</field>
            <field name="is_mandatory" eval="False"/>
            <field name="requires_verification" eval="True"/>
            <field name="issuing_authority">Department of Motor Vehicles</field>
            <field name="description">Valid driver's license for patrol vehicle operators</field>
        </record>
        
    </data>
</odoo>

