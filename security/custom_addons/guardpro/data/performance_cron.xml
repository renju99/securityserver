<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron: Auto-calculate monthly performance metrics -->
        <record id="ir_cron_calculate_monthly_performance" model="ir.cron">
            <field name="name">GuardPro: Calculate Monthly Performance Metrics</field>
            <field name="model_id" ref="model_guard_performance_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_calculate_monthly_performance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>

        <!-- Cron: Send performance review reminders -->
        <record id="ir_cron_performance_review_reminders" model="ir.cron">
            <field name="name">GuardPro: Performance Review Reminders</field>
            <field name="model_id" ref="model_guard_performance_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_review_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="priority">15</field>
        </record>

        <!-- Cron: Auto-award performance badges -->
        <record id="ir_cron_award_performance_badges" model="ir.cron">
            <field name="name">GuardPro: Auto-Award Performance Badges</field>
            <field name="model_id" ref="model_guard_performance_badge"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_award_badges()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="priority">20</field>
        </record>

    </data>
</odoo>

