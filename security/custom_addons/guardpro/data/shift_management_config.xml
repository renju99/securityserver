<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Shift Management Configuration Parameters -->
        
        <!-- Minimum Rest Period Between Shifts (in hours) -->
        <record id="shift_minimum_rest_period" model="ir.config_parameter" forcecreate="False">
            <field name="key">guardpro.minimum_rest_period_hours</field>
            <field name="value">8.0</field>
        </record>
        
        <!-- Shift Reminder Lead Time (in minutes) -->
        <record id="shift_reminder_minutes" model="ir.config_parameter" forcecreate="False">
            <field name="key">guardpro.shift_reminder_minutes</field>
            <field name="value">30</field>
        </record>
        
    </data>
</odoo>

