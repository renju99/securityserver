<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Scheduled Action: Check Expiring Certifications -->
        <record id="ir_cron_check_expiring_certifications" model="ir.cron">
            <field name="name">GuardLink: Check Expiring Certifications</field>
            <field name="model_id" ref="model_guard_profile"/>
            <field name="state">code</field>
            <field name="code">model.check_certification_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
    </data>
</odoo>

