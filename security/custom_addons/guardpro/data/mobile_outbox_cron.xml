<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Purge acknowledged + expired outbox rows so the table
             stays tight. Run hourly; cleanup is cheap. -->
        <record id="cron_mobile_outbox_purge" model="ir.cron">
            <field name="name">GuardPro: Purge Mobile Outbox</field>
            <field name="model_id" ref="model_guardpro_mobile_outbox"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_outbox()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <!-- ``numbercall`` was removed from ir.cron in Odoo 17;
                 crons now run indefinitely by default. -->
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
