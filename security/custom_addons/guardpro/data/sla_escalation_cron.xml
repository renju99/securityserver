<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- SLA Breach Monitoring (Every 5 minutes) -->
        <record id="ir_cron_check_sla_breaches" model="ir.cron">
            <field name="name">Incident: Check SLA Breaches</field>
            <field name="model_id" ref="model_incident_report"/>
            <field name="state">code</field>
            <field name="code">model.check_sla_breaches()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
        
        <!-- Progressive Escalation (Every 15 minutes) -->
        <record id="ir_cron_check_progressive_escalation" model="ir.cron">
            <field name="name">Incident: Progressive Escalation</field>
            <field name="model_id" ref="model_incident_report"/>
            <field name="state">code</field>
            <field name="code">model.check_progressive_escalation()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>
        
        <!-- Generate SLA Breach Report (Daily at 8 AM) -->
        <record id="ir_cron_generate_sla_breach_report" model="ir.cron">
            <field name="name">Incident: Daily SLA Breach Report</field>
            <field name="model_id" ref="model_incident_report"/>
            <field name="state">code</field>
            <field name="code">model.generate_daily_sla_breach_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=8, minute=0, second=0)"/>
            <field name="active" eval="True"/>
            <field name="priority">20</field>
        </record>
        
    </data>
</odoo>

