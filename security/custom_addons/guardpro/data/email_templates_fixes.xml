<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="1">
        
        <!-- ================================================================ -->
        <!-- EMAIL TEMPLATE FIXES - Re-enable disabled templates with fixes  -->
        <!-- Created: November 2025                                          -->
        <!-- ================================================================ -->
        
        <!-- 1. SLA Breach Alert - FIXED -->
        <record id="email_template_sla_breach" model="mail.template">
            <field name="name">SLA Performance Breach Alert</field>
            <field name="model_id" ref="model_sla_definition"/>
            <field name="subject">⚠ SLA Breach Alert: {{ object.name or 'SLA Definition' }} - {{ object.site_id.name if object.site_id else 'Site' }}</field><field name="email_from">{{ (user.email_formatted or user.email or '') }}</field><field name="email_to">{{ (object.site_id.client_id.email if object.site_id and object.site_id.client_id else '') }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px;"&gt;
                    &lt;h2 style="color: #f57c00;"&gt;⚠ SLA Performance Alert&lt;/h2&gt;
                    
                    &lt;p&gt;Dear &lt;t t-out="object.site_id.client_id.name if object.site_id and object.site_id.client_id else 'Valued Client'"/&gt;,&lt;/p&gt;
                    
                    &lt;div style="background: #fff3e0; border-left: 4px solid #f57c00; padding: 15px; margin: 20px 0;"&gt;
                        &lt;p style="margin: 0; font-size: 16px;"&gt;
                            &lt;strong&gt;An SLA metric has fallen below the agreed threshold.&lt;/strong&gt;
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;table style="width: 100%; border-collapse: collapse; margin: 20px 0;"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 30%;"&gt;SLA Agreement:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.name or 'N/A'"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;t t-if="object.site_id"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Site:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.site_id.name"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                        &lt;t t-if="hasattr(object, 'start_date') and hasattr(object, 'end_date')"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Period:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;
                                &lt;t t-out="format_date(object.start_date) if object.start_date else 'N/A'"/&gt; to &lt;t t-out="format_date(object.end_date) if object.end_date else 'N/A'"/&gt;
                            &lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                    &lt;/table&gt;
                    
                    &lt;t t-if="hasattr(object, 'kpi_ids') and object.kpi_ids"&gt;
                    &lt;h3&gt;Performance Metrics:&lt;/h3&gt;
                    &lt;table style="width: 100%; border-collapse: collapse; margin: 20px 0;"&gt;
                        &lt;t t-foreach="object.kpi_ids" t-as="kpi"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 40%;"&gt;&lt;t t-out="kpi.metric_name if hasattr(kpi, 'metric_name') else 'Metric'"/&gt;:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;
                                &lt;t t-if="hasattr(kpi, 'actual_value') and hasattr(kpi, 'target_value')"&gt;
                                &lt;strong&gt;
                                    &lt;t t-out="kpi.actual_value"/&gt;%
                                &lt;/strong&gt;
                                / Target: &lt;t t-out="kpi.target_value"/&gt;%
                                &lt;/t&gt;
                                &lt;t t-else=""&gt;
                                N/A
                                &lt;/t&gt;
                            &lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                    &lt;/table&gt;
                    &lt;/t&gt;
                    
                    &lt;t t-if="hasattr(object, 'breach_notes') and object.breach_notes"&gt;
                    &lt;h3&gt;Breach Details:&lt;/h3&gt;
                    &lt;div style="padding: 15px; background: #ffebee; border-radius: 5px; margin: 20px 0;"&gt;
                        &lt;t t-out="object.breach_notes"/&gt;
                    &lt;/div&gt;
                    &lt;/t&gt;
                    
                    &lt;div style="background: #e3f2fd; border-left: 4px solid #2196f3; padding: 15px; margin: 20px 0;"&gt;
                        &lt;h3 style="margin-top: 0; color: #1976d2;"&gt;Corrective Actions:&lt;/h3&gt;
                        &lt;p style="margin-bottom: 0;"&gt;
                            Our team is working to address this performance issue. We will provide a detailed action plan within 24 hours.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="margin-top: 30px;"&gt;
                        &lt;p&gt;If you have any concerns or questions, please contact your account manager immediately.&lt;/p&gt;
                        &lt;p&gt;Thank you for your understanding.&lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="margin-top: 20px; padding: 15px; background: #fafafa; border-radius: 4px; text-align: center;"&gt;
                        &lt;p style="margin: 0; color: #999; font-size: 12px;"&gt;
                            This is an automated message from GuardPro SLA Management System&lt;br/&gt;
                            Report Reference: &lt;t t-out="object.name or 'N/A'"/&gt;
                        &lt;/p&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            </field></record>

        <!-- 2. Key Overdue Return Notification - FIXED -->
        <record id="email_template_key_overdue" model="mail.template">
            <field name="name">Overdue Key Return Notification</field>
            <field name="model_id" ref="model_key_register"/>
            <field name="subject">⚠ Overdue Key Return: {{ object.key_number or 'Key' }}</field><field name="email_from">{{ (user.email_formatted or user.email or '') }}</field><field name="email_to">{{ (object.current_holder_id.email if object.current_holder_id and hasattr(object.current_holder_id, 'email') else object.current_holder_email if hasattr(object, 'current_holder_email') else '') }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px;"&gt;
                    &lt;h2 style="color: #f57c00;"&gt;🔑 Overdue Key Return Notice&lt;/h2&gt;
                    
                    &lt;div style="background: #fff3e0; border-left: 4px solid #f57c00; padding: 15px; margin: 20px 0;"&gt;
                        &lt;p style="margin: 0; font-size: 16px;"&gt;
                            &lt;strong&gt;A key assigned to you is overdue for return.&lt;/strong&gt;
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;table style="width: 100%; border-collapse: collapse; margin: 20px 0;"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 30%;"&gt;Key Number:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;strong&gt;&lt;t t-out="object.key_number or 'N/A'"/&gt;&lt;/strong&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;t t-if="hasattr(object, 'description') and object.description"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Description:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.description"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                        &lt;t t-if="hasattr(object, 'site_id') and object.site_id"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Site:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.site_id.name"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                        &lt;t t-if="hasattr(object, 'location') and object.location"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Authorized For:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.location"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                    &lt;/table&gt;
                    
                    &lt;div style="background: #ffebee; border: 2px solid #d32f2f; padding: 15px; margin: 20px 0; border-radius: 5px;"&gt;
                        &lt;h3 style="margin-top: 0; color: #d32f2f;"&gt;⏰ Overdue Information:&lt;/h3&gt;
                        &lt;p style="margin-bottom: 0;"&gt;
                            This key is overdue for return. Please return it to the security desk immediately to avoid further penalties.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="margin-top: 30px;"&gt;
                        &lt;p&gt;&lt;strong&gt;Action Required:&lt;/strong&gt;&lt;/p&gt;
                        &lt;ul&gt;
                            &lt;li&gt;Return the key to the designated key storage location&lt;/li&gt;
                            &lt;li&gt;Ensure the key is properly signed back in&lt;/li&gt;
                            &lt;li&gt;Contact security if the key is lost or damaged&lt;/li&gt;
                        &lt;/ul&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="background: #e3f2fd; border-left: 4px solid #2196f3; padding: 15px; margin: 20px 0;"&gt;
                        &lt;p style="margin: 0;"&gt;
                            If you have already returned this key, please disregard this message and contact security to update the system.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="margin-top: 20px; padding: 15px; background: #fafafa; border-radius: 4px; text-align: center;"&gt;
                        &lt;p style="margin: 0; color: #999; font-size: 12px;"&gt;
                            This is an automated message from GuardPro Key Management System
                        &lt;/p&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            </field></record>
        
    </data>
</odoo>
