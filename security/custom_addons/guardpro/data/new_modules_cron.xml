<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ================================================================ -->
        <!-- TASK MANAGEMENT CRON JOBS                                        -->
        <!-- ================================================================ -->
        
        <!-- Send Overdue Task Alerts -->
        <record id="cron_overdue_task_alerts" model="ir.cron">
            <field name="name">GuardPro: Send Overdue Task Alerts</field>
            <field name="model_id" ref="model_guard_task"/>
            <field name="state">code</field>
            <field name="code">model.send_overdue_task_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
        
        <!-- ================================================================ -->
        <!-- VISITOR MANAGEMENT CRON JOBS                                     -->
        <!-- ================================================================ -->
        
        <!-- Check Overdue Visitors -->
        <record id="cron_overdue_visitors" model="ir.cron">
            <field name="name">GuardPro: Check Overdue Visitors</field>
            <field name="model_id" ref="model_visitor_management"/>
            <field name="state">code</field>
            <field name="code">model.check_overdue_visitors()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- Auto-Expire Old Visitor Registrations -->
        <record id="cron_expire_visitor_registrations" model="ir.cron">
            <field name="name">GuardPro: Auto-Expire Old Visitor Registrations</field>
            <field name="model_id" ref="model_visitor_management"/>
            <field name="state">code</field>
            <field name="code">model.auto_expire_old_registrations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- Check Expired Watchlist Entries -->
        <record id="cron_expired_watchlist" model="ir.cron">
            <field name="name">GuardPro: Check Expired Watchlist Entries</field>
            <field name="model_id" ref="model_visitor_watchlist"/>
            <field name="state">code</field>
            <field name="code">model.check_expired_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- ================================================================ -->
        <!-- LOST & FOUND CRON JOBS                                          -->
        <!-- ================================================================ -->
        
        <!-- Send Lost & Found Expiry Reminders -->
        <record id="cron_lost_found_expiry_reminders" model="ir.cron">
            <field name="name">GuardPro: Send Lost &amp; Found Expiry Reminders</field>
            <field name="model_id" ref="model_lost_found_item"/>
            <field name="state">code</field>
            <field name="code">model.send_expiry_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
        
        <!-- Auto-Update Expired Lost & Found Items -->
        <record id="cron_lost_found_auto_update_expired" model="ir.cron">
            <field name="name">GuardPro: Auto-Update Expired Lost &amp; Found Items</field>
            <field name="model_id" ref="model_lost_found_item"/>
            <field name="state">code</field>
            <field name="code">model.auto_update_expired_items()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- ================================================================ -->
        <!-- PACKAGE MANAGEMENT CRON JOBS                                     -->
        <!-- ================================================================ -->
        
        <!-- Send Overdue Package Notifications -->
        <record id="cron_overdue_packages" model="ir.cron">
            <field name="name">GuardPro: Send Overdue Package Notifications</field>
            <field name="model_id" ref="model_package_management"/>
            <field name="state">code</field>
            <field name="code">model.send_overdue_notifications()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
        
        <!-- Auto-Mark Unclaimed Packages -->
        <record id="cron_mark_unclaimed_packages" model="ir.cron">
            <field name="name">GuardPro: Auto-Mark Unclaimed Packages</field>
            <field name="model_id" ref="model_package_management"/>
            <field name="state">code</field>
            <field name="code">model.auto_mark_unclaimed()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- ================================================================ -->
        <!-- KEY MANAGEMENT CRON JOBS                                         -->
        <!-- ================================================================ -->
        
        <!-- Send Overdue Key Reminders -->
        <record id="cron_overdue_keys" model="ir.cron">
            <field name="name">GuardPro: Send Overdue Key Reminders</field>
            <field name="model_id" ref="model_key_transaction"/>
            <field name="state">code</field>
            <field name="code">model.send_overdue_reminders()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
        
        <!-- ================================================================ -->
        <!-- COMPLIANCE AUDIT CRON JOBS                                       -->
        <!-- ================================================================ -->
        
        <!-- Send Audit Reminders -->
        <record id="cron_audit_reminders" model="ir.cron">
            <field name="name">GuardPro: Send Audit Reminders</field>
            <field name="model_id" ref="model_compliance_audit"/>
            <field name="state">code</field>
            <field name="code">model.send_audit_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
        
        <!-- Send Overdue Corrective Action Alerts -->
        <record id="cron_overdue_corrective_actions" model="ir.cron">
            <field name="name">GuardPro: Send Overdue Corrective Action Alerts</field>
            <field name="model_id" ref="model_compliance_corrective_action"/>
            <field name="state">code</field>
            <field name="code">model.send_overdue_action_alerts()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
        
        <!-- ================================================================ -->
        <!-- DAILY ACTIVITY REPORT CRON JOBS                                  -->
        <!-- ================================================================ -->
        
        <!-- Auto-Generate Daily Activity Reports -->
        <record id="cron_auto_generate_dars" model="ir.cron">
            <field name="name">GuardPro: Auto-Generate Daily Activity Reports</field>
            <field name="model_id" ref="model_daily_activity_report"/>
            <field name="state">code</field>
            <field name="code">model.auto_generate_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- Auto-Send Approved DARs to Clients -->
        <record id="cron_auto_send_dars" model="ir.cron">
            <field name="name">GuardPro: Auto-Send Approved DARs to Clients</field>
            <field name="model_id" ref="model_daily_activity_report"/>
            <field name="state">code</field>
            <field name="code">model.auto_send_approved_reports()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
        
        <!-- ================================================================ -->
        <!-- SLA MANAGEMENT CRON JOBS                                         -->
        <!-- ================================================================ -->
        
        <!-- Calculate Monthly SLA Performance -->
        <record id="cron_calculate_sla_performance" model="ir.cron">
            <field name="name">GuardPro: Calculate Monthly SLA Performance</field>
            <field name="model_id" ref="model_sla_performance"/>
            <field name="state">code</field>
            <field name="code">model.calculate_monthly_performance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- Send SLA KPI Breach Alerts -->
        <record id="cron_sla_breach_alerts" model="ir.cron">
            <field name="name">GuardPro: Send SLA KPI Breach Alerts</field>
            <field name="model_id" ref="model_sla_performance"/>
            <field name="state">code</field>
            <field name="code">model.send_kpi_breach_alerts()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
        
    </data>
</odoo>

