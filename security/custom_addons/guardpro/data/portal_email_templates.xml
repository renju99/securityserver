<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="1">

        <!-- ========================================== -->
        <!-- Resident Portal Access Email Template      -->
        <!-- ========================================== -->

        <delete model="mail.template" id="email_template_resident_portal_access"/>

        <!-- ========================================== -->
        <!-- Incident Status Update Email Template      -->
        <!-- ========================================== -->

        <record id="email_template_incident_status_update" model="mail.template">
            <field name="name">Incident Status Update Notification</field>
            <field name="model_id" ref="model_incident_status_update"/>
            <field name="subject">Incident Update: {{ object.incident_id.name }} - {{ object.title }}</field><field name="email_from">{{ user.email_formatted }}</field><field name="partner_to">{{ object.client_id.id if object.client_id else '' }}</field>
            <field name="body_html" type="char">&lt;div style="margin: 0px; padding: 0px; font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 13px; color: rgb(34, 34, 34);"&gt;
    &lt;h2 style="color: #875A7B;"&gt;Incident Status Update&lt;/h2&gt;
    
    &lt;div style="background-color: #f9f9f9; padding: 15px; border-left: 4px solid #875A7B; margin: 20px 0px;"&gt;
        &lt;p style="margin: 0; font-size: 16px;"&gt;&lt;strong&gt;&lt;t t-out="object.title"/&gt;&lt;/strong&gt;&lt;/p&gt;
    &lt;/div&gt;
    
    &lt;p&gt;&lt;strong&gt;Incident:&lt;/strong&gt; &lt;t t-out="object.incident_id.name"/&gt;&lt;/p&gt;
    &lt;p&gt;&lt;strong&gt;Site:&lt;/strong&gt; &lt;t t-out="object.site_id.name"/&gt;&lt;/p&gt;
    &lt;p&gt;&lt;strong&gt;Update Time:&lt;/strong&gt; &lt;t t-out="format_datetime(object.update_datetime, dt_format='medium')"/&gt;&lt;/p&gt;
    &lt;p&gt;&lt;strong&gt;Update Type:&lt;/strong&gt; &lt;t t-out="object.update_type.replace('_', ' ').title()"/&gt;&lt;/p&gt;
    
    &lt;t t-if="object.new_status"&gt;
    &lt;p&gt;
        &lt;strong&gt;Status Changed:&lt;/strong&gt; 
        &lt;t t-if="object.old_status"&gt;
        &lt;t t-out="object.old_status.replace('_', ' ').title()"/&gt; → 
        &lt;/t&gt;
        &lt;t t-out="object.new_status.replace('_', ' ').title()"/&gt;
    &lt;/p&gt;
    &lt;/t&gt;
    
    &lt;hr style="margin: 20px 0px; border: 1px solid #eee;"/&gt;
    
    &lt;h3&gt;Update Details:&lt;/h3&gt;
    &lt;p&gt;&lt;t t-out="object.description"/&gt;&lt;/p&gt;
    
    &lt;hr style="margin: 20px 0px; border: 1px solid #eee;"/&gt;
    
    &lt;p&gt;
        &lt;a t-attf-href="{{ object.get_base_url() }}/my/incident/{{ object.incident_id.id }}" style="background-color: #875A7B; padding: 10px 20px; text-decoration: none; color: #fff; border-radius: 5px; display: inline-block;"&gt;
            View Incident Details
        &lt;/a&gt;
    &lt;/p&gt;
    
    &lt;p style="margin-top: 20px; font-size: 11px; color: #999;"&gt;
        This is an automated notification from your security management system.
        You are receiving this because you requested notifications for incident updates.
    &lt;/p&gt;
&lt;/div&gt;
            </field><field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
