<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Paper Format for ID Cards (CR80 standard size: 85.6 x 54 mm) -->
    <record id="paperformat_id_card" model="report.paperformat">
        <field name="name">ID Card (CR80)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">54</field>
        <field name="page_width">86</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>
</odoo>

