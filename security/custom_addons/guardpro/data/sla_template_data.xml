<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ============================================
             SLA Template 1: Basic Residential Security
             ============================================ -->
        <record id="sla_template_basic_residential" model="sla.template">
            <field name="name">Basic Residential Security</field>
            <field name="sequence">10</field>
            <field name="industry">residential</field>
            <field name="service_level">basic</field>
            <field name="default_contract_duration">12</field>
            <field name="penalty_applicable" eval="False"/>
            <field name="description"><![CDATA[
                <h4>Basic Residential Security SLA</h4>
                <p>Ideal for small to medium residential communities requiring fundamental security coverage.</p>
                <ul>
                    <li>Regular patrol monitoring</li>
                    <li>Incident response and reporting</li>
                    <li>Basic guard attendance tracking</li>
                </ul>
            ]]></field>
            <field name="notes">Standard 12-month contract with quarterly reviews</field>
        </record>

        <record id="sla_kpi_basic_res_incident_response" model="sla.kpi.template">
            <field name="sla_template_id" ref="sla_template_basic_residential"/>
            <field name="sequence">10</field>
            <field name="name">Incident Response Time</field>
            <field name="kpi_type">incident_response</field>
            <field name="description">Maximum time for guards to respond to any reported incident</field>
            <field name="target_value">30</field>
            <field name="unit">minutes</field>
            <field name="target_direction">minimize</field>
            <field name="measurement_period">monthly</field>
            <field name="warning_threshold">85</field>
            <field name="critical_threshold">75</field>
            <field name="weight">1.5</field>
            <field name="penalty_applicable" eval="False"/>
        </record>

        <record id="sla_kpi_basic_res_patrol" model="sla.kpi.template">
            <field name="sla_template_id" ref="sla_template_basic_residential"/>
            <field name="sequence">20</field>
            <field name="name">Patrol Completion Rate</field>
            <field name="kpi_type">patrol_completion</field>
            <field name="description">Percentage of scheduled patrols completed on time</field>
            <field name="target_value">90</field>
            <field name="unit">percentage</field>
            <field name="target_direction">maximize</field>
            <field name="measurement_period">monthly</field>
            <field name="warning_threshold">85</field>
            <field name="critical_threshold">80</field>
            <field name="weight">1.0</field>
            <field name="penalty_applicable" eval="False"/>
        </record>

        <record id="sla_kpi_basic_res_punctuality" model="sla.kpi.template">
            <field name="sla_template_id" ref="sla_template_basic_residential"/>
            <field name="sequence">30</field>
            <field name="name">Guard Punctuality</field>
            <field name="kpi_type">guard_punctuality</field>
            <field name="description">Percentage of on-time guard shift check-ins</field>
            <field name="target_value">85</field>
            <field name="unit">percentage</field>
            <field name="target_direction">maximize</field>
            <field name="measurement_period">monthly</field>
            <field name="warning_threshold">80</field>
            <field name="critical_threshold">75</field>
            <field name="weight">0.8</field>
            <field name="penalty_applicable" eval="False"/>
        </record>

