<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="1">
        
        <!-- ================================================================ -->
        <!-- MISSING EMAIL TEMPLATES - GuardLink Module                       -->
        <!-- Created: November 2025                                          -->
        <!-- ================================================================ -->
        
        <!-- 1. Visitor Arrival Notification to Host -->
        <record id="email_template_visitor_arrival" model="mail.template">
            <field name="name">Visitor Arrival Notification</field>
            <field name="model_id" ref="model_visitor_management"/>
            <field name="subject">Visitor Arrival: {{ object.name }} is here to see you</field><field name="email_from">{{ user.email_formatted }}</field><field name="email_to">{{ object.host_email }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px;"&gt;&lt;h2 style="color: #9c27b0;"&gt;Visitor Arrival Notification&lt;/h2&gt;&lt;p&gt;Hello &lt;t t-out="object.host_name"/&gt;,&lt;/p&gt;&lt;p&gt;Your visitor &lt;strong&gt;&lt;t t-out="object.name"/&gt;&lt;/strong&gt; has arrived at &lt;strong&gt;&lt;t t-out="object.site_id.name"/&gt;&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Check-in:&lt;/strong&gt; &lt;t t-out="object.checkin_time"/&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Purpose:&lt;/strong&gt; &lt;t t-out="object.purpose_details"/&gt;&lt;/p&gt;&lt;p&gt;If you did not expect this visitor, contact security immediately.&lt;/p&gt;&lt;/div&gt;</field></record>

        <!-- 2. Credential Compliance Report -->
        <record id="email_template_credential_compliance_report" model="mail.template">
            <field name="name">Credential Compliance Report</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">⚠ Credential Compliance Report - Action Required</field><field name="email_from">{{ user.email_formatted }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px;"&gt;
                    &lt;h2 style="color: #f57c00;"&gt;⚠ Credential Compliance Alert&lt;/h2&gt;
                    
                    &lt;p&gt;Hello,&lt;/p&gt;
                    
                    &lt;div style="background: #fff3e0; border-left: 4px solid #f57c00; padding: 15px; margin: 20px 0;"&gt;
                        &lt;p style="margin: 0; font-size: 16px;"&gt;
                            &lt;strong&gt;Guards with expired or expiring credentials require immediate attention.&lt;/strong&gt;
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;h3&gt;Compliance Status:&lt;/h3&gt;
                    &lt;div style="padding: 15px; background: #ffebee; border-left: 4px solid #d32f2f; margin: 20px 0;"&gt;
                        &lt;p style="margin: 0;"&gt;
                            One or more guards have credentials that are expired or expiring soon. 
                            These guards may not be eligible for shift assignments until compliance is restored.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;h3&gt;Required Actions:&lt;/h3&gt;
                    &lt;ol style="line-height: 1.8;"&gt;
                        &lt;li&gt;Review the credential status in the GuardPro system&lt;/li&gt;
                        &lt;li&gt;Identify all guards with expired or expiring credentials&lt;/li&gt;
                        &lt;li&gt;Contact affected guards to begin renewal process&lt;/li&gt;
                        &lt;li&gt;Schedule required training or testing&lt;/li&gt;
                        &lt;li&gt;Update guard status once compliance is restored&lt;/li&gt;
                    &lt;/ol&gt;
                    
                    &lt;div style="background: #e3f2fd; border-left: 4px solid #2196f3; padding: 15px; margin: 20px 0;"&gt;
                        &lt;h3 style="margin-top: 0; color: #1976d2;"&gt;📊 Access the Report:&lt;/h3&gt;
                        &lt;p style="margin-bottom: 0;"&gt;
                            Please log in to GuardPro and navigate to &lt;strong&gt;Guards → Credentials → Compliance Report&lt;/strong&gt; 
                            for detailed information about all non-compliant credentials.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="background: #fff3e0; border: 2px solid #f57c00; padding: 15px; margin: 20px 0; border-radius: 5px;"&gt;
                        &lt;p style="margin: 0;"&gt;
                            &lt;strong&gt;⏰ IMPORTANT:&lt;/strong&gt; Guards with expired credentials cannot be scheduled for shifts. 
                            Immediate action is required to maintain operational capacity.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="margin-top: 30px;"&gt;
                        &lt;p&gt;If you have any questions or need assistance, please contact your system administrator.&lt;/p&gt;
                        &lt;p&gt;Thank you for your prompt attention to this matter.&lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="margin-top: 20px; padding: 15px; background: #fafafa; border-radius: 4px; text-align: center;"&gt;
                        &lt;p style="margin: 0; color: #999; font-size: 12px;"&gt;
                            This is an automated message from GuardPro Credential Management System
                        &lt;/p&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            </field></record>

        <!-- 3. Incident Escalation Notification -->
        <record id="incident_escalation_email_template" model="mail.template">
            <field name="name">Incident Escalation Notification</field>
            <field name="model_id" ref="model_incident_escalation_log"/>
            <field name="subject">🚨 Incident Escalated: {{ object.incident_id.title }} - {{ object.incident_severity.upper() if object.incident_severity else 'N/A' }}</field><field name="email_from">{{ user.email_formatted }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px; border: 2px solid #d32f2f;"&gt;
    &lt;div style="background: #d32f2f; color: white; padding: 15px; margin: -20px -20px 20px -20px;"&gt;
        &lt;h1 style="margin: 0; font-size: 24px;"&gt;🚨 INCIDENT ESCALATION&lt;/h1&gt;
    &lt;/div&gt;
    &lt;p&gt;
        &lt;t t-if="ctx.get('escalation_user')"&gt;Hello &lt;t t-out="ctx.get('escalation_user').name"/&gt;,&lt;/t&gt;
        &lt;t t-else=""&gt;Hello,&lt;/t&gt;
    &lt;/p&gt;
    &lt;div style="background: #ffebee; border-left: 5px solid #d32f2f; padding: 20px; margin: 20px 0;"&gt;
        &lt;h2 style="margin-top: 0; color: #d32f2f;"&gt;An incident has been escalated to you for immediate attention.&lt;/h2&gt;
    &lt;/div&gt;
    &lt;h3&gt;Incident Details:&lt;/h3&gt;
    &lt;table style="width: 100%; border-collapse: collapse; margin: 20px 0;"&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 30%; background: #f5f5f5;"&gt;Incident Number:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.incident_id.name"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Title:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;strong&gt;&lt;t t-out="object.incident_id.title"/&gt;&lt;/strong&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Severity:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;
                &lt;span t-att-style="'padding: 5px 15px; color: white; border-radius: 3px; font-weight: bold; background: ' + str({'critical':'#d32f2f','high':'#f57c00','medium':'#fbc02d'}.get(object.incident_severity, '#388e3c')) + ';'"&gt;
                    &lt;t t-out="(object.incident_severity or '').upper()"/&gt;
                &lt;/span&gt;
            &lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Category:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.incident_id.category_id.name"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Site:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.incident_id.site_id.name"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Incident Date:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="format_datetime(object.incident_id.incident_datetime, dt_format='medium')"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Escalation Level:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;strong&gt;Level &lt;t t-out="object.escalation_level"/&gt;&lt;/strong&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Escalated By:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.escalated_by_user_id.name"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Escalation Time:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="format_datetime(object.escalation_datetime, dt_format='medium')"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
    &lt;/table&gt;
    &lt;t t-if="object.incident_id.description"&gt;
        &lt;h3 style="color: #d32f2f;"&gt;Incident Description:&lt;/h3&gt;
        &lt;div style="padding: 20px; background: white; border: 2px solid #d32f2f; border-radius: 5px; margin: 20px 0; font-size: 15px;"&gt;
            &lt;t t-out="object.incident_id.description"/&gt;
        &lt;/div&gt;
    &lt;/t&gt;
    &lt;t t-if="object.escalation_reason"&gt;
        &lt;h3 style="color: #f57c00;"&gt;Escalation Reason:&lt;/h3&gt;
        &lt;div style="padding: 15px; background: #fff3e0; border-left: 4px solid #f57c00; border-radius: 5px; margin: 20px 0;"&gt;
            &lt;t t-out="object.escalation_reason"/&gt;
        &lt;/div&gt;
    &lt;/t&gt;
    &lt;t t-if="object.incident_id.immediate_actions"&gt;
        &lt;h3&gt;Actions Taken So Far:&lt;/h3&gt;
        &lt;div style="padding: 15px; background: #e8f5e9; border-left: 4px solid #4caf50; border-radius: 5px; margin: 20px 0;"&gt;
            &lt;t t-out="object.incident_id.immediate_actions"/&gt;
        &lt;/div&gt;
    &lt;/t&gt;
    &lt;div style="background: #fff3e0; border: 2px solid #f57c00; padding: 20px; margin: 30px 0; border-radius: 5px;"&gt;
        &lt;h3 style="margin-top: 0; color: #f57c00;"&gt;⚠ Required Actions:&lt;/h3&gt;
        &lt;ol style="margin-bottom: 0; line-height: 1.8;"&gt;
            &lt;li&gt;Review the complete incident details in GuardPro immediately&lt;/li&gt;
            &lt;li&gt;Assess the situation and determine appropriate response&lt;/li&gt;
            &lt;li&gt;Take necessary corrective actions&lt;/li&gt;
            &lt;li&gt;Update the incident status with your response&lt;/li&gt;
            &lt;li&gt;Document all actions taken in the incident record&lt;/li&gt;
        &lt;/ol&gt;
    &lt;/div&gt;
    &lt;t t-if="object.sla_breach_time"&gt;
        &lt;div style="background: #ffebee; border: 2px solid #d32f2f; padding: 15px; margin: 20px 0; border-radius: 5px;"&gt;
            &lt;p style="margin: 0; color: #d32f2f;"&gt;
                &lt;strong&gt;⏰ SLA BREACH TIME:&lt;/strong&gt; &lt;t t-out="object.sla_breach_time"/&gt; minutes
            &lt;/p&gt;
        &lt;/div&gt;
    &lt;/t&gt;
    &lt;div style="background: #e3f2fd; border-left: 4px solid #2196f3; padding: 15px; margin: 30px 0;"&gt;
        &lt;p style="margin: 0;"&gt;&lt;strong&gt;If this is a life-threatening emergency, call 911 immediately!&lt;/strong&gt;&lt;/p&gt;
    &lt;/div&gt;
    &lt;div style="margin-top: 30px;"&gt;
        &lt;p&gt;&lt;strong&gt;Access the incident:&lt;/strong&gt; Log in to GuardPro and navigate to Incidents → &lt;t t-out="object.incident_id.name"/&gt;&lt;/p&gt;
        &lt;p&gt;For urgent assistance, contact the Operations Center immediately.&lt;/p&gt;
    &lt;/div&gt;
    &lt;div style="margin-top: 20px; padding: 15px; background: #fafafa; border-radius: 4px; text-align: center; border-top: 3px solid #d32f2f;"&gt;
        &lt;p style="margin: 0; color: #d32f2f; font-size: 14px; font-weight: bold;"&gt;URGENT - IMMEDIATE ATTENTION REQUIRED&lt;/p&gt;
        &lt;p style="margin: 5px 0 0 0; color: #999; font-size: 12px;"&gt;
            GuardPro Incident Escalation System&lt;br/&gt;
            Escalation ID: &lt;t t-out="object.display_name"/&gt;
        &lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;</field></record>

        <!-- 4. Visitor Pre-Registration Confirmation -->
        <record id="email_template_visitor_pre_registration" model="mail.template">
            <field name="name">Visitor Pre-Registration Confirmation</field>
            <field name="model_id" ref="model_visitor_management"/>
            <field name="subject">Visit Confirmed: {{ object.site_id.name }} on {{ format_date(object.visit_date) }}</field><field name="email_from">{{ user.email_formatted }}</field><field name="email_to">{{ object.email }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px;"&gt;
    &lt;h2 style="color: #1976d2;"&gt;📝 Visit Pre-Registration Confirmed&lt;/h2&gt;
    &lt;p&gt;Hello &lt;t t-out="object.name"/&gt;,&lt;/p&gt;
    &lt;p&gt;Your visit to &lt;strong&gt;&lt;t t-out="object.site_id.name"/&gt;&lt;/strong&gt; has been pre-registered and confirmed.&lt;/p&gt;
    &lt;table style="width: 100%; border-collapse: collapse; margin: 20px 0;"&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 30%; background: #f5f5f5;"&gt;Site:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.site_id.name"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Visit Date:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="format_date(object.visit_date)"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Expected Duration:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.expected_duration"/&gt; hours&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Host:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.host_name or 'N/A'"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Purpose:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.visit_purpose or object.purpose_details or ''"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; background: #f5f5f5;"&gt;Reference:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;strong&gt;&lt;t t-out="object.name"/&gt;&lt;/strong&gt;&lt;/td&gt;
        &lt;/tr&gt;
    &lt;/table&gt;
    &lt;div style="padding: 15px; background: #e8f5e9; border-left: 4px solid #4caf50; border-radius: 5px; margin: 20px 0;"&gt;
        &lt;h3 style="margin-top: 0; color: #2e7d32;"&gt;✅ You're all set!&lt;/h3&gt;
        &lt;p style="margin-bottom: 0;"&gt;Please bring a valid ID and arrive at the security desk at the scheduled time.&lt;/p&gt;
    &lt;/div&gt;
    &lt;t t-if="object.host_email"&gt;
        &lt;p&gt;If you need to cancel or reschedule, please contact your host at &lt;t t-out="object.host_email"/&gt;.&lt;/p&gt;
    &lt;/t&gt;
    &lt;div style="margin-top: 20px; padding: 15px; background: #fafafa; border-radius: 4px; text-align: center;"&gt;
        &lt;p style="margin: 0; color: #999; font-size: 12px;"&gt;This is an automated message from GuardPro Visitor Management System&lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;</field></record>

        <!-- 5. Key Overdue Reminder -->
        <record id="email_template_key_overdue_reminder" model="mail.template">
            <field name="name">Key Overdue Return Reminder</field>
            <field name="model_id" ref="model_key_register"/>
            <field name="subject">🔑 URGENT: Key Return Overdue - {{ object.key_number }}</field><field name="email_from">{{ user.email_formatted }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px;"&gt;
                    &lt;h2 style="color: #d32f2f;"&gt;🔑 URGENT: Key Return Overdue&lt;/h2&gt;
                    
                    &lt;div style="background: #ffebee; border: 2px solid #d32f2f; padding: 20px; margin: 20px 0; border-radius: 5px;"&gt;
                        &lt;h3 style="margin-top: 0; color: #d32f2f;"&gt;⚠ IMMEDIATE ACTION REQUIRED&lt;/h3&gt;
                        &lt;p style="margin-bottom: 0; font-size: 16px;"&gt;
                            A key issued to you is &lt;strong&gt;OVERDUE FOR RETURN&lt;/strong&gt;. 
                            Please return it to the security desk immediately.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;h3&gt;Key Information:&lt;/h3&gt;
                    &lt;table style="width: 100%; border-collapse: collapse; margin: 20px 0;"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 30%;"&gt;Key Number:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;strong style="color: #d32f2f; font-size: 18px;"&gt;&lt;t t-out="object.key_number"/&gt;&lt;/strong&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;t t-if="object.description"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Description:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.description"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                        &lt;t t-if="object.location"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Authorized For:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.location"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                        &lt;t t-if="object.issue_date"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Issued On:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="format_datetime(object.issue_date, dt_format='medium')"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                        &lt;t t-if="object.expected_return_date"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Was Due:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;
                                &lt;strong style="color: #d32f2f;"&gt;&lt;t t-out="format_datetime(object.expected_return_date, dt_format='medium')"/&gt;&lt;/strong&gt;
                            &lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/t&gt;
                    &lt;/table&gt;
                    
                    &lt;div style="background: #fff3e0; border-left: 4px solid #f57c00; padding: 15px; margin: 20px 0;"&gt;
                        &lt;h3 style="margin-top: 0; color: #f57c00;"&gt;📋 What You Need to Do:&lt;/h3&gt;
                        &lt;ol style="margin-bottom: 0; line-height: 1.8;"&gt;
                            &lt;li&gt;Return the key to the security desk immediately&lt;/li&gt;
                            &lt;li&gt;Ensure the key is properly signed back in&lt;/li&gt;
                            &lt;li&gt;If the key is lost or damaged, contact security immediately&lt;/li&gt;
                            &lt;li&gt;If you still need access, request a new temporary key issuance&lt;/li&gt;
                        &lt;/ol&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="background: #ffebee; border: 2px solid #d32f2f; padding: 15px; margin: 20px 0; border-radius: 5px;"&gt;
                        &lt;p style="margin: 0; color: #d32f2f;"&gt;
                            &lt;strong&gt;⚠ WARNING:&lt;/strong&gt; Failure to return keys on time may result in:
                        &lt;/p&gt;
                        &lt;ul style="line-height: 1.8;"&gt;
                            &lt;li&gt;Suspension of key privileges&lt;/li&gt;
                            &lt;li&gt;Disciplinary action&lt;/li&gt;
                            &lt;li&gt;Cost recovery for lock replacement if key is lost&lt;/li&gt;
                        &lt;/ul&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="background: #e3f2fd; border-left: 4px solid #2196f3; padding: 15px; margin: 20px 0;"&gt;
                        &lt;p style="margin: 0;"&gt;
                            &lt;strong&gt;📞 Need Help?&lt;/strong&gt; If you have already returned this key or have any questions, 
                            please contact the security desk immediately to resolve this matter.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="margin-top: 20px; padding: 15px; background: #fafafa; border-radius: 4px; text-align: center;"&gt;
                        &lt;p style="margin: 0; color: #999; font-size: 12px;"&gt;
                            This is an automated reminder from GuardPro Key Management System
                        &lt;/p&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            </field></record>

        <!-- 6. Lost & Found Item Match Notification -->
        <record id="email_template_lost_found_match" model="mail.template">
            <field name="name">Lost &amp; Found Item Match Notification</field>
            <field name="model_id" ref="model_lost_found_item"/>
            <field name="subject">Item Found: {{ object.item_description }}</field><field name="email_from">{{ user.email_formatted }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px;"&gt;
                    &lt;h2 style="color: #4caf50;"&gt;🎉 Good News - Item Found!&lt;/h2&gt;
                    
                    &lt;div style="background: #e8f5e9; border-left: 4px solid #4caf50; padding: 15px; margin: 20px 0;"&gt;
                        &lt;p style="margin: 0; font-size: 16px;"&gt;
                            &lt;strong&gt;An item matching your description has been found and is being held at our Lost &amp;amp; Found.&lt;/strong&gt;
                        &lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;h3&gt;Item Details:&lt;/h3&gt;
                    &lt;table style="width: 100%; border-collapse: collapse; margin: 20px 0;"&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 30%;"&gt;Item:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.item_description"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Category:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.category.replace('_', ' ').title()"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Found Location:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.found_location or 'N/A'"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Date Found:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="format_datetime(object.found_date, dt_format='medium')"/&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Reference Number:&lt;/td&gt;
                            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;strong&gt;&lt;t t-out="object.name"/&gt;&lt;/strong&gt;&lt;/td&gt;
                        &lt;/tr&gt;
                    &lt;/table&gt;
                    
                    &lt;div style="background: #e3f2fd; border-left: 4px solid #2196f3; padding: 15px; margin: 20px 0;"&gt;
                        &lt;h3 style="margin-top: 0; color: #1976d2;"&gt;📍 How to Claim Your Item:&lt;/h3&gt;
                        &lt;ol style="margin-bottom: 0; line-height: 1.8;"&gt;
                            &lt;li&gt;Visit the security desk at &lt;strong&gt;&lt;t t-out="object.site_id.name"/&gt;&lt;/strong&gt;&lt;/li&gt;
                            &lt;li&gt;Provide your reference number: &lt;strong&gt;&lt;t t-out="object.name"/&gt;&lt;/strong&gt;&lt;/li&gt;
                            &lt;li&gt;Bring a valid photo ID for verification&lt;/li&gt;
                            &lt;li&gt;Be prepared to describe the item and provide proof of ownership&lt;/li&gt;
                            &lt;li&gt;Sign the claim form to receive your item&lt;/li&gt;
                        &lt;/ol&gt;
                    &lt;/div&gt;
                    
                    &lt;t t-if="object.hold_until_date"&gt;
                    &lt;div style="background: #fff3e0; border-left: 4px solid #ff9800; padding: 15px; margin: 20px 0;"&gt;
                        &lt;p style="margin: 0;"&gt;
                            &lt;strong&gt;⏰ IMPORTANT:&lt;/strong&gt; Please claim your item by &lt;strong&gt;&lt;t t-out="format_date(object.hold_until_date)"/&gt;&lt;/strong&gt;. 
                            After this date, unclaimed items may be donated or disposed of according to our policy.
                        &lt;/p&gt;
                    &lt;/div&gt;
                    &lt;/t&gt;
                    
                    &lt;div style="margin-top: 30px;"&gt;
                        &lt;p&gt;If this item does not belong to you, please disregard this message.&lt;/p&gt;
                        &lt;p&gt;If you have any questions, please contact our security desk.&lt;/p&gt;
                    &lt;/div&gt;
                    
                    &lt;div style="margin-top: 20px; padding: 15px; background: #fafafa; border-radius: 4px; text-align: center;"&gt;
                        &lt;p style="margin: 0; color: #999; font-size: 12px;"&gt;
                            This is an automated message from GuardPro Lost &amp;amp; Found Management System
                        &lt;/p&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            </field></record>

        <!-- 7. Equipment Maintenance Due Notification -->
        <record id="email_template_equipment_maintenance_due" model="mail.template">
            <field name="name">Equipment Maintenance Due Notification</field>
            <field name="model_id" ref="model_guardpro_equipment"/>
            <field name="subject">⚠ Maintenance Due: {{ object.name }} - {{ object.category }}</field><field name="email_from">{{ user.email_formatted }}</field><field name="body_html" type="char">&lt;div style="font-family: Arial, sans-serif; padding: 20px;"&gt;
    &lt;h2 style="color: #f57c00;"&gt;⚠ Equipment Maintenance Due&lt;/h2&gt;
    &lt;div style="background: #fff3e0; border-left: 4px solid #f57c00; padding: 15px; margin: 20px 0;"&gt;
        &lt;p style="margin: 0; font-size: 16px;"&gt;
            &lt;strong&gt;Equipment maintenance is due or overdue. Please schedule service immediately.&lt;/strong&gt;
        &lt;/p&gt;
    &lt;/div&gt;
    &lt;h3&gt;Equipment Information:&lt;/h3&gt;
    &lt;table style="width: 100%; border-collapse: collapse; margin: 20px 0;"&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold; width: 30%;"&gt;Equipment ID:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;strong&gt;&lt;t t-out="object.name"/&gt;&lt;/strong&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Category:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="dict(object._fields['category'].selection).get(object.category, object.category or '')"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr t-if="object.serial_number"&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Serial Number:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.serial_number"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr t-if="object.assigned_to"&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Assigned To:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.assigned_to.name"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr t-if="object.assigned_site"&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Location:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="object.assigned_site.name"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr t-if="object.last_maintenance"&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Last Maintenance:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;&lt;t t-out="format_date(object.last_maintenance)"/&gt;&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr t-if="object.next_maintenance"&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;"&gt;Due Date:&lt;/td&gt;
            &lt;td style="padding: 10px; border: 1px solid #ddd;"&gt;
                &lt;strong style="color: #d32f2f;"&gt;&lt;t t-out="format_date(object.next_maintenance)"/&gt;&lt;/strong&gt;
            &lt;/td&gt;
        &lt;/tr&gt;
    &lt;/table&gt;
    &lt;div style="background: #e3f2fd; border-left: 4px solid #2196f3; padding: 15px; margin: 20px 0;"&gt;
        &lt;h3 style="margin-top: 0; color: #1976d2;"&gt;📋 Required Actions:&lt;/h3&gt;
        &lt;ol style="margin-bottom: 0; line-height: 1.8;"&gt;
            &lt;li&gt;Schedule maintenance service immediately&lt;/li&gt;
            &lt;li&gt;Remove equipment from service until maintenance is complete&lt;/li&gt;
            &lt;li&gt;Update maintenance records in the system&lt;/li&gt;
            &lt;li&gt;Return equipment to service only after inspection&lt;/li&gt;
        &lt;/ol&gt;
    &lt;/div&gt;
    &lt;div style="background: #ffebee; border: 2px solid #d32f2f; padding: 15px; margin: 20px 0; border-radius: 5px;"&gt;
        &lt;p style="margin: 0; color: #d32f2f;"&gt;
            &lt;strong&gt;⚠ SAFETY WARNING:&lt;/strong&gt; Operating equipment beyond its maintenance schedule may result in equipment failure, safety hazards, or compliance violations.
        &lt;/p&gt;
    &lt;/div&gt;
    &lt;div style="margin-top: 30px;"&gt;
        &lt;p&gt;Please log in to GuardPro and update the maintenance status once service is completed.&lt;/p&gt;
        &lt;p&gt;For assistance, contact the equipment manager.&lt;/p&gt;
    &lt;/div&gt;
    &lt;div style="margin-top: 20px; padding: 15px; background: #fafafa; border-radius: 4px; text-align: center;"&gt;
        &lt;p style="margin: 0; color: #999; font-size: 12px;"&gt;This is an automated message from GuardPro Equipment Management System&lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;</field></record>

    </data>
</odoo>
