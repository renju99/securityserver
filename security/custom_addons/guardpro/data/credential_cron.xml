<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ================================================================ -->
        <!-- CREDENTIAL MANAGEMENT CRON JOBS                                  -->
        <!-- ================================================================ -->
        
        <!-- Check Expiring Credentials (Daily) -->
        <record id="cron_check_expiring_credentials" model="ir.cron">
            <field name="name">GuardLink: Check Expiring Credentials</field>
            <field name="model_id" ref="model_guard_credential"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiring_credentials()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>
        
        <!-- Send Compliance Report (Weekly on Monday) -->
        <record id="cron_send_compliance_report" model="ir.cron">
            <field name="name">GuardLink: Send Credential Compliance Report</field>
            <field name="model_id" ref="model_guard_credential"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_compliance_report()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="priority">10</field>
        </record>
        
        <!-- Check Expiring Background Checks (Daily) -->
        <record id="cron_check_expiring_background_checks" model="ir.cron">
            <field name="name">GuardLink: Check Expiring Background Checks</field>
            <field name="model_id" ref="model_guard_background_check"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiring_background_checks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>
        
        <!-- Check Expiring Vaccinations (Daily) -->
        <record id="cron_check_expiring_vaccinations" model="ir.cron">
            <field name="name">GuardLink: Check Expiring Vaccinations</field>
            <field name="model_id" ref="model_guard_vaccination"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiring_vaccinations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>
        
        <!-- Send Random Drug Test Notifications (As needed - can be scheduled) -->
        <record id="cron_send_random_test_notifications" model="ir.cron">
            <field name="name">GuardLink: Send Random Drug Test Notifications</field>
            <field name="model_id" ref="model_guard_drug_test"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_random_test_notifications()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="priority">15</field>
        </record>
        
    </data>
</odoo>

