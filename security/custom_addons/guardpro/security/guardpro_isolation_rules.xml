            <field name="name">Non-Admin: PTT Messages via Channel Access</field>
            <field name="model_id" ref="model_push_to_talk_message"/>
            <field name="domain_force">['|', '|', ('channel_id.site_id', 'in', user.site_ids.ids), ('channel_id.supervisor_ids', 'in', [user.id]), ('channel_id.member_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal')), (4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
