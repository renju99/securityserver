        </record>
        <record id="rule_ptt_channel_assigned_sites" model="ir.rule">
            <field name="name">Non-Admin: PTT Channels at Assigned Projects or Membership</field>
            <field name="model_id" ref="model_push_to_talk_channel"/>
            <field name="domain_force">['|', '|', ('site_id', 'in', user.site_ids.ids), ('supervisor_ids', 'in', [user.id]), ('member_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal')), (4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
        </record>

        <record id="rule_ptt_message_admin" model="ir.rule">
            <field name="name">Administrator: All PTT Messages</field>
            <field name="model_id" ref="model_push_to_talk_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
