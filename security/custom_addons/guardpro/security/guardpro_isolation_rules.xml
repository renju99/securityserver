        <record id="rule_guard_conversation_participants" model="ir.rule">
            <field name="name">Non-Admin: Own Conversations Only</field>
            <field name="model_id" ref="model_guard_conversation"/>
            <field name="domain_force">['|', '|', '|', '|', '|', ('guard_id.user_id', '=', user.id), ('guard1_id.user_id', '=', user.id), ('guard2_id.user_id', '=', user.id), ('participant_ids.user_id', '=', user.id), ('supervisor_id', '=', user.id), ('supervisor_participant_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal')), (4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
