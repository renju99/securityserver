        <!-- ========== Push-to-talk ========== -->
        <record id="rule_ptt_channel_admin" model="ir.rule">
            <field name="name">Administrator: All PTT Channels</field>
            <field name="model_id" ref="model_push_to_talk_channel"/>
            <field name="domain_force">[(1, '=', 1)]</field>
