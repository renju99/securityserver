            <field name="model_id" ref="model_guard_message"/>
            <field name="domain_force">['|', '|', '|', '|', ('sender_id', '=', user.id), ('receiver_id', '=', user.id), ('related_site_id', 'in', user.site_ids.ids), ('channel_id.site_id', 'in', user.site_ids.ids), ('broadcast_recipient_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal')), (4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
