            <field name="model_id" ref="model_incident_investigation_evidence_custody"/>
            <field name="domain_force">[('evidence_id.investigation_id.site_id', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal')), (4, ref('group_guardpro_client_user')), (4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
        </record>

        <!-- ========== Buildings / floors / areas ========== -->
        <record id="rule_site_building_admin" model="ir.rule">
            <field name="name">Administrator: All Buildings</field>
            <field name="model_id" ref="model_site_building"/>
