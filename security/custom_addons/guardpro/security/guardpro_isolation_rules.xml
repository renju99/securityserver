<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Additional site isolation for models that previously had ACL only.
            Pattern: Admin unrestricted; everyone else limited to user.site_ids
            (or participant-based domains for messaging).
        -->

        <!-- ========== Reception baseline site access ========== -->
        <record id="rule_client_site_reception" model="ir.rule">
            <field name="name">Reception: Assigned Projects Only</field>
            <field name="model_id" ref="model_client_site"/>
            <field name="domain_force">[('id', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_reception'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_guard_profile_reception" model="ir.rule">
            <field name="name">Reception: Guards at Assigned Projects</field>
            <field name="model_id" ref="model_guard_profile"/>
            <field name="domain_force">[('site_ids', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_reception'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========== CCTV ========== -->
        <record id="rule_cctv_camera_admin" model="ir.rule">
            <field name="name">Administrator: All CCTV Cameras</field>
            <field name="model_id" ref="model_cctv_camera"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_admin'))]"/>
        </record>
        <record id="rule_cctv_camera_assigned_sites" model="ir.rule">
            <field name="name">Non-Admin: CCTV at Assigned Projects</field>
            <field name="model_id" ref="model_cctv_camera"/>
            <field name="domain_force">[('site_id', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal')), (4, ref('group_guardpro_client_user')), (4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
        </record>

