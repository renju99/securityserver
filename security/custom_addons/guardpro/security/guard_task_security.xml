<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record Rules for Guard Tasks -->
    <record id="guard_task_rule_guard" model="ir.rule">
        <field name="name">Guard: Own Tasks</field>
        <field name="model_id" ref="model_guard_task"/>
        <field name="domain_force">[('assigned_to.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="guard_task_rule_supervisor" model="ir.rule">
        <field name="name">Supervisor: All Tasks</field>
        <field name="model_id" ref="model_guard_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_guardpro_supervisor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="guard_task_rule_manager" model="ir.rule">
        <field name="name">Manager: All Tasks</field>
        <field name="model_id" ref="model_guard_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_guardpro_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>

