            <field name="name">Guard: Read Own Performance Reviews</field>
            <field name="model_id" ref="model_guard_performance_review"/>
            <field name="domain_force">[('guard_id.user_id', '=', user.id), ('state', '=', 'approved')]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
