            <field name="model_id" ref="model_guard_performance_review"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="guard_performance_review_manager_rule" model="ir.rule">
            <field name="name">Manager/Admin: Full Access Performance Reviews</field>
            <field name="model_id" ref="model_guard_performance_review"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_manager')), (4, ref('group_guardpro_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Guard Performance Badge Record Rules -->
        <record id="guard_performance_badge_guard_rule" model="ir.rule">
            <field name="name">Guard: Read Own Performance Badges</field>
            <field name="model_id" ref="model_guard_performance_badge"/>
            <field name="domain_force">[('guard_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
