<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Guard Performance Criteria Record Rules -->
        <record id="guard_performance_criteria_guard_rule" model="ir.rule">
            <field name="name">Guard: Read Performance Criteria</field>
            <field name="model_id" ref="model_guard_performance_criteria"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="guard_performance_criteria_client_user_rule" model="ir.rule">
            <field name="name">Client User: Read Performance Criteria</field>
            <field name="model_id" ref="model_guard_performance_criteria"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_client_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="guard_performance_criteria_supervisor_rule" model="ir.rule">
            <field name="name">Supervisor/Manager: Full Access Performance Criteria</field>
            <field name="model_id" ref="model_guard_performance_criteria"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager')), (4, ref('group_guardpro_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Guard Performance Metric Record Rules -->
        <record id="guard_performance_metric_guard_rule" model="ir.rule">
            <field name="name">Guard: Read Own Performance Metrics</field>
            <field name="model_id" ref="model_guard_performance_metric"/>
            <field name="domain_force">[('guard_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="guard_performance_metric_client_user_rule" model="ir.rule">
            <field name="name">Client User: Read Performance Metrics at Assigned Sites</field>
            <field name="model_id" ref="model_guard_performance_metric"/>
            <field name="domain_force">[('guard_id.site_ids', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_client_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="guard_performance_metric_supervisor_rule" model="ir.rule">
            <field name="name">Supervisor: Read All Performance Metrics</field>
            <field name="model_id" ref="model_guard_performance_metric"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="guard_performance_metric_manager_rule" model="ir.rule">
            <field name="name">Manager/Admin: Full Access Performance Metrics</field>
            <field name="model_id" ref="model_guard_performance_metric"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_manager')), (4, ref('group_guardpro_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Guard Performance Review Record Rules -->
