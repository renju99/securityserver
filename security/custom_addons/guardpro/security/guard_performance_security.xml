            <field name="groups" eval="[(4, ref('group_guardpro_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="guard_performance_badge_manager_rule" model="ir.rule">
            <field name="name">Manager/Admin: Full Access Performance Badges</field>
            <field name="model_id" ref="model_guard_performance_badge"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_manager')), (4, ref('group_guardpro_admin'))]"/>
