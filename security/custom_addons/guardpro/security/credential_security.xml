<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Record Rules for Guard Credentials -->
        
        <!-- Guards can only see their own credentials -->
        <record id="guard_credential_guard_rule" model="ir.rule">
            <field name="name">Guard: Own Credentials Only</field>
            <field name="model_id" ref="model_guard_credential"/>
            <field name="domain_force">[('guard_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
        </record>
        
        <!-- Clients cannot see credentials -->
        <record id="guard_credential_client_rule" model="ir.rule">
            <field name="name">Client: No Access to Credentials</field>
            <field name="model_id" ref="model_guard_credential"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_client_user'))]"/>
        </record>
        
        <!-- Supervisors / Managers: credentials for guards at assigned projects -->
        <record id="guard_credential_supervisor_rule" model="ir.rule">
            <field name="name">Supervisor/Manager: Credentials at Assigned Projects</field>
            <field name="model_id" ref="model_guard_credential"/>
            <field name="domain_force">[('guard_id.site_ids', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
        </record>

        <record id="guard_credential_admin_rule" model="ir.rule">
            <field name="name">Admin: All Credentials</field>
            <field name="model_id" ref="model_guard_credential"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_admin'))]"/>
        </record>
        
        <!-- Record Rules for Background Checks -->
        
        <record id="guard_background_check_guard_rule" model="ir.rule">
            <field name="name">Guard: Own Background Checks Only</field>
            <field name="model_id" ref="model_guard_background_check"/>
            <field name="domain_force">[('guard_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
        </record>
        
        <record id="guard_background_check_supervisor_rule" model="ir.rule">
            <field name="name">Supervisor/Manager: Background Checks at Assigned Projects</field>
            <field name="model_id" ref="model_guard_background_check"/>
            <field name="domain_force">[('guard_id.site_ids', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
        </record>

        <record id="guard_background_check_admin_rule" model="ir.rule">
            <field name="name">Admin: All Background Checks</field>
            <field name="model_id" ref="model_guard_background_check"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_admin'))]"/>
        </record>
        
        <!-- Record Rules for Drug Tests -->
        
        <record id="guard_drug_test_guard_rule" model="ir.rule">
            <field name="name">Guard: Own Drug Tests Only</field>
            <field name="model_id" ref="model_guard_drug_test"/>
            <field name="domain_force">[('guard_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
        </record>
        
        <record id="guard_drug_test_supervisor_rule" model="ir.rule">
            <field name="name">Supervisor/Manager: Drug Tests at Assigned Projects</field>
            <field name="model_id" ref="model_guard_drug_test"/>
            <field name="domain_force">[('guard_id.site_ids', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
        </record>

        <record id="guard_drug_test_admin_rule" model="ir.rule">
            <field name="name">Admin: All Drug Tests</field>
            <field name="model_id" ref="model_guard_drug_test"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_admin'))]"/>
        </record>
        
        <!-- Record Rules for Vaccinations -->
        
        <record id="guard_vaccination_guard_rule" model="ir.rule">
            <field name="name">Guard: Own Vaccinations Only</field>
            <field name="model_id" ref="model_guard_vaccination"/>
            <field name="domain_force">[('guard_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
        </record>
        
        <record id="guard_vaccination_supervisor_rule" model="ir.rule">
            <field name="name">Supervisor/Manager: Vaccinations at Assigned Projects</field>
            <field name="model_id" ref="model_guard_vaccination"/>
            <field name="domain_force">[('guard_id.site_ids', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_supervisor')), (4, ref('group_guardpro_manager'))]"/>
        </record>

        <record id="guard_vaccination_admin_rule" model="ir.rule">
            <field name="name">Admin: All Vaccinations</field>
            <field name="model_id" ref="model_guard_vaccination"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_admin'))]"/>
        </record>
        
    </data>
</odoo>
