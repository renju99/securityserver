<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ================================================================ -->
        <!-- AUDIT LOG SECURITY GROUPS                                        -->
        <!-- ================================================================ -->
        
        <!-- ================================================================ -->
        <!-- RECORD RULES - Admin Only                                        -->
        <!-- ================================================================ -->
        
        <!-- System Administrator - Read Only Access (Audit logs are read-only by design) -->
        <record id="audit_log_admin_rule" model="ir.rule">
            <field name="name">System Admin: Read All Audit Logs</field>
            <field name="model_id" ref="model_audit_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
    </data>
</odoo>

