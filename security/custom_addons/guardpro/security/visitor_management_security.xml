<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Visitor rules stay site-scoped -->
    <record id="visitor_management_rule_guard" model="ir.rule">
        <field name="name">Guard: Visitors at Assigned Projects</field>
        <field name="model_id" ref="model_visitor_management"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('site_id', 'in', user.site_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_guardpro_guard_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="visitor_management_rule_reception" model="ir.rule">
        <field name="name">Reception: Visitors at Assigned Projects</field>
