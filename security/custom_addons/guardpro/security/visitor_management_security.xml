        <field name="groups" eval="[(4, ref('group_guardpro_reception'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="visitor_management_rule_supervisor" model="ir.rule">
        <field name="name">Supervisor: Visitors at Assigned Projects</field>
        <field name="model_id" ref="model_visitor_management"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('site_id', 'in', user.site_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_guardpro_supervisor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="visitor_management_rule_manager" model="ir.rule">
        <field name="name">Manager: Visitors at Assigned Projects</field>
        <field name="model_id" ref="model_visitor_management"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('site_id', 'in', user.site_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_guardpro_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Watchlist feature removed (xmlids already cleaned when present) -->

</odoo>
