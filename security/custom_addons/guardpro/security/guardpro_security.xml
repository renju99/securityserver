<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Categories -->
        <record id="module_category_guardpro" model="ir.module.category">
            <field name="name">GuardPro</field>
            <field name="description">Security Guard Management</field>
            <field name="sequence">20</field>
        </record>

        <!-- ============================================ -->
        <!-- SIMPLIFIED USER GROUPS                       -->
        <!-- ============================================ -->
        
        <!-- Guard User Group - Portal user -->
        <record id="group_guardpro_guard_portal" model="res.groups">
            <field name="name">Guard User</field>
            <field name="category_id" ref="module_category_guardpro"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="comment">Portal user access for guards. Guards can access the mobile portal to view shifts, report incidents, complete tours, and manage attendance. Access limited to their assigned sites.</field>
        </record>

        <!-- Client User Group - Backend access for clients to view their sites -->
        <record id="group_guardpro_client_user" model="res.groups">
            <field name="name">Client User</field>
            <field name="category_id" ref="module_category_guardpro"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Backend client access - can view all information (shifts, incidents, attendance, tours, checkpoints, etc.) for assigned sites. Read-only access to most data.</field>
        </record>

        <!-- Supervisor Group - Backend access -->
        <record id="group_guardpro_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="module_category_guardpro"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Backend supervisor access - can manage shifts, review incidents, approve attendance. Access limited to assigned sites.</field>
        </record>

        <!-- Manager Group - Backend access -->
        <record id="group_guardpro_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_guardpro"/>
            <field name="implied_ids" eval="[(4, ref('group_guardpro_supervisor'))]"/>
            <field name="comment">Backend management access - can manage all guards, shifts, tours, equipment. Access limited to assigned sites.</field>
        </record>

        <!-- Reception/Front Desk Group - Limited backend access -->
        <record id="group_guardpro_reception" model="res.groups">
            <field name="name">Reception/Front Desk</field>
            <field name="category_id" ref="module_category_guardpro"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Reception staff access limited to visitor management system. Can create, check-in/check-out, and manage visitors.</field>
        </record>

        <!-- Administrator Group - Backend access -->
        <record id="group_guardpro_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_guardpro"/>
            <field name="implied_ids" eval="[(4, ref('group_guardpro_manager'))]"/>
            <field name="comment">Full system access including configuration and settings. Access to all sites.</field>
        </record>

    </data>
</odoo>
