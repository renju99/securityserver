<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Record Rules for Guards to Access eLearning Courses -->
        
        <!-- Allow guards to read ALL published courses (not just guard training) -->
        <record id="slide_channel_guard_rule" model="ir.rule">
            <field name="name">Guards: Read all published courses</field>
            <field name="model_id" ref="website_slides.model_slide_channel"/>
            <field name="domain_force">[('website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Alternative rule using OR condition for both published flags -->
        <record id="slide_channel_guard_rule_alt" model="ir.rule">
            <field name="name">Guards: Access published courses (alt)</field>
            <field name="model_id" ref="website_slides.model_slide_channel"/>
            <field name="domain_force">['|', ('is_published', '=', True), ('website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Allow guards to read ALL published slides/content -->
        <record id="slide_slide_guard_rule" model="ir.rule">
            <field name="name">Guards: Read all published slides</field>
            <field name="model_id" ref="website_slides.model_slide_slide"/>
            <field name="domain_force">['|', ('is_published', '=', True), ('website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Allow guards to manage their own enrollments -->
        <record id="slide_channel_partner_guard_rule" model="ir.rule">
            <field name="name">Guards can manage their own course enrollments</field>
            <field name="model_id" ref="website_slides.model_slide_channel_partner"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Allow guards to manage their own slide progress -->
        <record id="slide_slide_partner_guard_rule" model="ir.rule">
            <field name="name">Guards can manage their own slide progress</field>
            <field name="model_id" ref="website_slides.model_slide_slide_partner"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Allow guards to read all questions -->
        <record id="slide_question_guard_rule" model="ir.rule">
            <field name="name">Guards can access all quiz questions</field>
            <field name="model_id" ref="website_slides.model_slide_question"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Allow guards to read all answers -->
        <record id="slide_answer_guard_rule" model="ir.rule">
            <field name="name">Guards can access all quiz answers</field>
            <field name="model_id" ref="website_slides.model_slide_answer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Allow guards to read course tags -->
        <record id="slide_channel_tag_guard_rule" model="ir.rule">
            <field name="name">Guards can access all course tags</field>
            <field name="model_id" ref="website_slides.model_slide_channel_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Allow guards to read tag groups -->
        <record id="slide_channel_tag_group_guard_rule" model="ir.rule">
            <field name="name">Guards can access all tag groups</field>
            <field name="model_id" ref="website_slides.model_slide_channel_tag_group"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_guard_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
    </data>
</odoo>

