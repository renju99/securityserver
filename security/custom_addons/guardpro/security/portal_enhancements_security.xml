<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- ============================================ -->
        <!-- Portal Enhancement Security Groups           -->
        <!-- ============================================ -->
        
        <!-- Resident/Tenant User Group -->
        <record id="group_guardpro_resident_user" model="res.groups">
            <field name="name">Resident/Tenant User</field>
            <field name="category_id" ref="base.module_category_services_security"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="comment">Tenant or resident with portal access to view guards, submit feedback, and view incidents at their community.</field>
        </record>
        
        <!-- Enhanced Client User Group (extends existing) -->
        <record id="group_guardpro_client_enhanced" model="res.groups">
            <field name="name">Client User (Enhanced)</field>
            <field name="category_id" ref="base.module_category_services_security"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="comment">Client user with enhanced portal access including real-time guard tracking and live incident updates.</field>
        </record>
        
        <!-- ============================================ -->
        <!-- Record Rules for Tenant/Resident             -->
        <!-- ============================================ -->
        
        <!-- Tenant/Resident: Own Records -->
        <record id="tenant_resident_user_own_rule" model="ir.rule">
            <field name="name">Tenant/Resident: Own Records</field>
            <field name="model_id" ref="model_tenant_resident"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_resident_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- ============================================ -->
        <!-- Record Rules for Incident Status Updates     -->
        <!-- ============================================ -->
        
        <!-- Client/Resident: View visible updates for their projects -->
        <record id="incident_status_update_portal_rule" model="ir.rule">
            <field name="name">Incident Status Updates: Portal Users - Site Access</field>
            <field name="model_id" ref="model_incident_status_update"/>
            <field name="domain_force">[
                ('visible_to_client', '=', True),
                ('site_id', 'in', user.site_ids.ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Manager/Supervisor: status updates at assigned projects only -->
        <record id="incident_status_update_manager_rule" model="ir.rule">
            <field name="name">Incident Status Updates: Manager/Supervisor - Assigned Projects</field>
            <field name="model_id" ref="model_incident_status_update"/>
            <field name="domain_force">[('site_id', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_manager')), (4, ref('guardpro.group_guardpro_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- ============================================ -->
        <!-- Record Rules for Live Guard Locations        -->
        <!-- ============================================ -->
        
        <!-- Client/Resident: View shared locations for their projects -->
        <record id="guard_location_live_portal_rule" model="ir.rule">
            <field name="name">Guard Live Location: Portal Users - Site Access</field>
            <field name="model_id" ref="model_guard_location_live"/>
            <field name="domain_force">[
                ('share_with_client', '=', True),
                ('site_id', 'in', user.site_ids.ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Manager/Supervisor: live locations at assigned projects only -->
        <record id="guard_location_live_manager_rule" model="ir.rule">
            <field name="name">Guard Live Location: Manager/Supervisor - Assigned Projects</field>
            <field name="model_id" ref="model_guard_location_live"/>
            <field name="domain_force">[('site_id', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('guardpro.group_guardpro_manager')), (4, ref('guardpro.group_guardpro_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- ============================================ -->
        <!-- Record Rules for Enhanced Feedback           -->
        <!-- ============================================ -->
        
        <!-- Resident: Own feedback -->
        <record id="client_feedback_resident_rule" model="ir.rule">
            <field name="name">Client Feedback: Resident - Own Feedback</field>
            <field name="model_id" ref="model_client_feedback"/>
            <field name="domain_force">[('resident_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_resident_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Enhanced Client User: Site feedback -->
        <record id="client_feedback_portal_enhanced_rule" model="ir.rule">
            <field name="name">Client Feedback: Enhanced Portal - Site Access</field>
            <field name="model_id" ref="model_client_feedback"/>
            <field name="domain_force">[('site_id', 'in', user.site_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_guardpro_client_enhanced'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- ============================================ -->
        <!-- Enhanced Incident Access for Portal          -->
        <!-- ============================================ -->
        
        <!-- Portal (Non-Manager/Supervisor/Admin): View visible incidents for their projects -->
        <!-- Note: Managers, Supervisors, and Admins have their own rules in guardpro_record_rules.xml -->
        <!-- This rule applies to portal users who are NOT in manager/supervisor/admin groups -->
        <record id="incident_report_portal_enhanced_rule" model="ir.rule">
            <field name="name">Incident Report: Portal - Visible Incidents (Non-Manager/Supervisor/Admin)</field>
            <field name="model_id" ref="guardpro.model_incident_report"/>
            <field name="domain_force">[
                ('visible_to_client', '=', True),
                ('site_id', 'in', user.site_ids.ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
    </data>
</odoo>

