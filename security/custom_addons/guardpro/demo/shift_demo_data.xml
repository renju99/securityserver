        <!-- Additional Shifts for NSHAMA Town Square - Past Week -->
        <record id="shift_ts_past_1" model="guard.shift">
            <field name="guard_id" ref="guard_john_smith"/>
            <field name="site_id" ref="site_nshama_town_square"/>
            <field name="start_datetime" eval="(datetime.now() - timedelta(days=7, hours=8)).strftime('%Y-%m-%d 08:00:00')"/>
            <field name="end_datetime" eval="(datetime.now() - timedelta(days=7)).strftime('%Y-%m-%d 16:00:00')"/>
            <field name="status">completed</field>
            <field name="shift_type">regular</field>
            <field name="assignment_type">patrol</field>
            <field name="uniform_type">standard</field>
            <field name="hourly_rate">25.00</field>
            <field name="checkin_time" eval="(datetime.now() - timedelta(days=7, hours=8)).strftime('%Y-%m-%d 07:55:00')"/>
            <field name="checkout_time" eval="(datetime.now() - timedelta(days=7)).strftime('%Y-%m-%d 16:05:00')"/>
            <field name="tour_ids" eval="[(6, 0, [ref('tour_ts_full_patrol')])]"/>
            <field name="instructions">Regular day shift patrol. Focus on retail and public areas during business hours.</field>
            <field name="notes">Shift completed successfully. No major incidents reported.</field>
        </record>

