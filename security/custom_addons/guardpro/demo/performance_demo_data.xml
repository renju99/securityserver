<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Demo: Performance Reviews -->
        <record id="demo_performance_review_1" model="guard.performance.review">
            <field name="name">PERF-00001</field>
            <field name="guard_id" ref="guard_john_smith"/>
            <field name="review_period">monthly</field>
            <field name="period_start" eval="(DateTime.now() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')"/>
            <field name="period_end" eval="(DateTime.now() - relativedelta(months=1, day=31)).strftime('%Y-%m-%d')"/>
            <field name="review_date" eval="(DateTime.now() - relativedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="state">approved</field>
            <field name="reviewer_id" ref="base.user_admin"/>
            <field name="approver_id" ref="base.user_admin"/>
            <field name="strengths">Excellent punctuality record. Always arrives on time for shifts. Completes all assigned tours with attention to detail. Very responsive to incidents.</field>
            <field name="areas_for_improvement">Could improve documentation quality in incident reports. Consider adding more detailed notes during tours.</field>
            <field name="goals">Maintain excellent punctuality. Improve incident report documentation. Complete advanced security training.</field>
            <field name="recommendation">continue</field>
            <field name="guard_acknowledged" eval="True"/>
        </record>

