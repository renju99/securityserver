            <field name="reviewer_id" ref="base.user_admin"/>
            <field name="strengths">Outstanding client feedback. Excellent communication skills. Very professional demeanor. Handles difficult situations well.</field>
            <field name="areas_for_improvement">Occasional late arrivals (5-10 minutes). Could improve tour completion rate.</field>
            <field name="goals">Improve punctuality. Complete 100% of assigned tours. Maintain high client satisfaction.</field>
            <field name="recommendation">additional_training</field>
        </record>

