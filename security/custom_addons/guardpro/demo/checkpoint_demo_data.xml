<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Checkpoints for NSHAMA Town Square -->
        <record id="checkpoint_ts_main_gate" model="checkpoint">
            <field name="name">Main Gate Entrance</field>
            <field name="code">TS-CP-001</field>
            <field name="site_id" ref="site_nshama_town_square"/>
            <field name="location_description">Main entrance gate - Security booth</field>
            <field name="latitude">24.9533</field>
            <field name="longitude">55.1653</field>
            <field name="floor">Ground</field>
            <field name="zone">Entrance</field>
            <field name="scan_type">nfc</field>
            <field name="nfc_tag_id">NFC-TS-001-MAIN-GATE</field>
            <field name="nfc_tag_type">NTAG215</field>
            <field name="status">active</field>
            <field name="requires_photo" eval="True"/>
            <field name="requires_note" eval="False"/>
            <field name="instructions">Check main gate security, verify access control system, inspect guard booth</field>
        </record>

        <record id="checkpoint_ts_retail_area" model="checkpoint">
            <field name="name">Retail Area - Central Plaza</field>
            <field name="code">TS-CP-002</field>
            <field name="site_id" ref="site_nshama_town_square"/>
            <field name="location_description">Central retail plaza near fountain</field>
            <field name="latitude">24.9540</field>
            <field name="longitude">55.1660</field>
            <field name="floor">Ground</field>
            <field name="zone">Retail</field>
            <field name="scan_type">qr</field>
            <field name="qr_code">QR-TS-002</field>
            <field name="status">active</field>
            <field name="requires_photo" eval="False"/>
            <field name="requires_note" eval="True"/>
            <field name="instructions">Check retail area security, verify all shops closed properly (night), check lighting</field>
        </record>

        <record id="checkpoint_ts_parking_north" model="checkpoint">
            <field name="name">North Parking Structure</field>
