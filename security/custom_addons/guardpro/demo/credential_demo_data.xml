<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Demo Guard Credentials -->
        
        <!-- John Smith - Valid Security License -->
        <record id="credential_john_sec_license" model="guard.credential">
            <field name="guard_id" ref="guard_john_smith"/>
            <field name="credential_type_id" ref="credential_type_security_license_1"/>
            <field name="credential_number">SEC-2024-12345</field>
            <field name="issue_date" eval="(datetime.now() - timedelta(days=180)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(datetime.now() + timedelta(days=185)).strftime('%Y-%m-%d')"/>
            <field name="issuing_authority">State Police Department</field>
            <field name="issuing_country" ref="base.us"/>
            <field name="issuing_state">California</field>
            <field name="state">valid</field>
            <field name="verified_by_id" ref="base.user_admin"/>
            <field name="verification_date" eval="(datetime.now() - timedelta(days=180)).strftime('%Y-%m-%d')"/>
        </record>
        
        <!-- John Smith - Valid First Aid Cert -->
        <record id="credential_john_first_aid" model="guard.credential">
            <field name="guard_id" ref="guard_john_smith"/>
            <field name="credential_type_id" ref="credential_type_first_aid"/>
            <field name="credential_number">FA-2023-789</field>
            <field name="issue_date" eval="(datetime.now() - timedelta(days=400)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(datetime.now() + timedelta(days=330)).strftime('%Y-%m-%d')"/>
            <field name="issuing_authority">Red Cross</field>
            <field name="state">valid</field>
        </record>
        
        <!-- Sarah Johnson - Expiring Soon -->
        <record id="credential_jane_sec_license" model="guard.credential">
            <field name="guard_id" ref="guard_sarah_johnson"/>
            <field name="credential_type_id" ref="credential_type_security_license_1"/>
            <field name="credential_number">SEC-2024-54321</field>
            <field name="issue_date" eval="(datetime.now() - timedelta(days=350)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(datetime.now() + timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="issuing_authority">State Police Department</field>
            <field name="issuing_country" ref="base.us"/>
            <field name="state">expiring_soon</field>
        </record>
        
        <!-- Demo Background Checks -->
        
        <record id="background_check_john" model="guard.background.check">
            <field name="guard_id" ref="guard_john_smith"/>
            <field name="check_type">comprehensive</field>
            <field name="check_date" eval="(datetime.now() - timedelta(days=90)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(datetime.now() + timedelta(days=275)).strftime('%Y-%m-%d')"/>
            <field name="provider_name">SecureCheck Background Services</field>
            <field name="status">clear</field>
            <field name="approved" eval="True"/>
            <field name="result">All checks passed. No criminal record found. Employment history verified.</field>
            <field name="reviewed_by_id" ref="base.user_admin"/>
            <field name="review_date" eval="(datetime.now() - timedelta(days=85)).strftime('%Y-%m-%d')"/>
            <field name="cost">150.00</field>
        </record>
        
        <record id="background_check_jane" model="guard.background.check">
            <field name="guard_id" ref="guard_sarah_johnson"/>
            <field name="check_type">criminal</field>
            <field name="check_date" eval="(datetime.now() - timedelta(days=120)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(datetime.now() + timedelta(days=245)).strftime('%Y-%m-%d')"/>
            <field name="provider_name">SecureCheck Background Services</field>
            <field name="status">clear</field>
            <field name="approved" eval="True"/>
            <field name="cost">95.00</field>
        </record>
        
        <!-- Demo Drug Tests -->
        
        <record id="drug_test_john_random" model="guard.drug.test">
            <field name="guard_id" ref="guard_john_smith"/>
            <field name="test_type">random</field>
            <field name="test_category">drug</field>
            <field name="test_date" eval="(datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="result_date" eval="(datetime.now() - timedelta(days=25)).strftime('%Y-%m-%d')"/>
            <field name="collection_method">urine</field>
            <field name="testing_facility">Acme Testing Lab</field>
            <field name="lab_name">Acme Lab Services</field>
            <field name="status">negative</field>
            <field name="substances_tested">THC, Cocaine, Amphetamines, Opiates, PCP</field>
            <field name="chain_of_custody_maintained" eval="True"/>
            <field name="action_taken">none</field>
            <field name="cost">85.00</field>
        </record>
        
        <record id="drug_test_jane_preemployment" model="guard.drug.test">
            <field name="guard_id" ref="guard_sarah_johnson"/>
            <field name="test_type">pre_employment</field>
            <field name="test_category">both</field>
            <field name="test_date" eval="(datetime.now() - timedelta(days=200)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="result_date" eval="(datetime.now() - timedelta(days=195)).strftime('%Y-%m-%d')"/>
            <field name="collection_method">urine</field>
            <field name="testing_facility">Acme Testing Lab</field>
            <field name="status">negative</field>
            <field name="substances_tested">10-panel drug screen</field>
            <field name="bac_level">0.000</field>
            <field name="action_taken">none</field>
            <field name="cost">120.00</field>
        </record>
        
        <!-- Demo Vaccinations -->
        
        <record id="vaccination_john_covid" model="guard.vaccination">
            <field name="guard_id" ref="guard_john_smith"/>
            <field name="vaccine_type">covid19</field>
            <field name="vaccine_name">Pfizer-BioNTech COVID-19</field>
            <field name="dose_number">2</field>
            <field name="total_doses_required">2</field>
            <field name="vaccination_date" eval="(datetime.now() - timedelta(days=180)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(datetime.now() + timedelta(days=185)).strftime('%Y-%m-%d')"/>
            <field name="administered_by">Dr. Sarah Johnson</field>
            <field name="facility_name">City Health Center</field>
            <field name="site_of_administration">left_arm</field>
            <field name="status">verified</field>
            <field name="lot_number">EL9269</field>
            <field name="verified_by_id" ref="base.user_admin"/>
            <field name="adverse_reaction" eval="False"/>
        </record>
        
        <record id="vaccination_john_flu" model="guard.vaccination">
            <field name="guard_id" ref="guard_john_smith"/>
            <field name="vaccine_type">influenza</field>
            <field name="vaccine_name">Flu Vaccine 2024</field>
            <field name="dose_number">1</field>
            <field name="total_doses_required">1</field>
            <field name="vaccination_date" eval="(datetime.now() - timedelta(days=60)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(datetime.now() + timedelta(days=305)).strftime('%Y-%m-%d')"/>
            <field name="administered_by">Nurse Mary Smith</field>
            <field name="facility_name">City Health Center</field>
            <field name="site_of_administration">right_arm</field>
            <field name="status">verified</field>
            <field name="adverse_reaction" eval="False"/>
        </record>
        
        <record id="vaccination_jane_hepatitis" model="guard.vaccination">
            <field name="guard_id" ref="guard_sarah_johnson"/>
            <field name="vaccine_type">hepatitis_b</field>
            <field name="dose_number">3</field>
            <field name="total_doses_required">3</field>
            <field name="vaccination_date" eval="(datetime.now() - timedelta(days=90)).strftime('%Y-%m-%d')"/>
            <field name="administered_by">Dr. Michael Brown</field>
            <field name="facility_name">County Hospital</field>
            <field name="site_of_administration">left_arm</field>
            <field name="status">verified</field>
            <field name="adverse_reaction" eval="False"/>
        </record>
        
    </data>
</odoo>

